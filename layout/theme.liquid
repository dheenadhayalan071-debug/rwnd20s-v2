<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=0">
    <meta name="theme-color" content="#030303">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name | default: 'rwnd20s.' }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="rwnd20s. — Heavy 316L stainless steel hardware, pink chrome Type-C wired earphones & analog chronographs. Free shipping above ₹999. Cash on Delivery available.">
    {% endif %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS Browser Runtime -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['Syne', 'Plus Jakarta Sans', 'sans-serif'],
              editorial: ['Playfair Display', 'Georgia', 'serif'],
              sans: ['Plus Jakarta Sans', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              'mono-tech': ['JetBrains Mono', 'monospace']
            }
          }
        }
      };
    </script>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    
    <!-- MASTER GOTHIC ATMOSPHERIC & SPOOKY FOG STYLES -->
    <style>
      .foggy-glass {
        background: rgba(12, 12, 12, 0.75) !important;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.85);
      }
      .foggy-glass:hover {
        border-color: rgba(220, 38, 38, 0.5);
        box-shadow: 0 15px 50px 0 rgba(138, 3, 3, 0.4);
      }

      /* Spooky Rolling Fog Keyframes */
      @keyframes fogDriftLeft {
        0% { transform: translateX(0) scale(1); }
        50% { transform: translateX(-5%) scale(1.05); }
        100% { transform: translateX(0) scale(1); }
      }

      @keyframes eeriePulse {
        0%, 100% { opacity: 0.2; filter: blur(140px); }
        50% { opacity: 0.45; filter: blur(110px); }
      }

      .gothic-fog-layer-1 {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(circle at 30% 40%, rgba(138, 3, 3, 0.25) 0%, transparent 60%);
        animation: eeriePulse 8s ease-in-out infinite;
      }

      .gothic-fog-layer-2 {
        position: fixed;
        bottom: 0;
        left: -20%;
        width: 140%;
        height: 60vh;
        z-index: -1;
        pointer-events: none;
        background: linear-gradient(to top, rgba(12, 12, 12, 0.9) 0%, rgba(138, 3, 3, 0.1) 40%, transparent 100%);
        opacity: 0.6;
        filter: blur(50px);
        animation: fogDriftLeft 14s ease-in-out infinite;
      }

      /* Heavy Industrial Scroll Materialization */
      .gothic-scroll-reveal {
        opacity: 0;
        transform: translateY(40px) scale(0.98);
        transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }

      .gothic-scroll-reveal.revealed {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    </style>
  </head>

  <body class="min-h-screen text-[#E9E3D5] antialiased selection:bg-red-900 selection:text-white relative z-0 bg-[#030303]">

    <!-- PERMANENT CUSTOM GOTHIC STREET BACKGROUND & FOG LAYERS -->
    <div class="fixed inset-0 z-[-1] bg-[#030303] overflow-hidden pointer-events-none">
      <div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-40 mix-blend-luminosity filter contrast-125" style="background-image: url('https://cdn.shopify.com/s/files/1/0851/2746/3165/files/file_000000001b1c820ba8f9b582c6371f3f.png?v=1793723403');"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#030303] via-transparent to-[#030303]/80"></div>
    </div>
    <div class="gothic-fog-layer-1"></div>
    <div class="gothic-fog-layer-2"></div>

    <!-- Header Section -->
    {% section 'header' %}

    <!-- Main Content -->
    <main id="MainContent" role="main" tabindex="-1" class="relative z-10">
      {{ content_for_layout }}
    </main>

    <!-- INDUSTRIAL SYS_BACK CAPSULE -->
    <div id="rwnd-sys-back-bar" class="fixed bottom-6 left-6 z-[60] hidden sm:block">
      <button type="button" onclick="if(window.history.length > 1) { window.history.back(); } else { window.location.href='/'; }" class="group inline-flex items-center gap-2.5 rounded-full border border-white/20 bg-black/80 backdrop-blur-xl px-5 py-2.5 font-mono-tech text-[11px] font-bold tracking-widest text-[#E9E3D5] uppercase shadow-[0_8px_30px_rgba(0,0,0,0.5)] transition-all duration-200 hover:border-[#E9E3D5] hover:bg-[#E9E3D5] hover:text-black cursor-pointer active:scale-95">
        <span class="text-zinc-500 group-hover:text-black">←</span>
        <span>RETURN</span>
      </button>
    </div>

    <!-- Footer Section -->
    <div class="relative z-10">
      {% section 'footer' %}
    </div>

    <!-- Slide-Out Cart Drawer -->
    {% render 'cart-drawer' %}

    <!-- Toast Container -->
    <div id="rwnd-toast-container" aria-live="polite" class="fixed right-4 bottom-4 z-[80] flex flex-col gap-2.5 max-w-sm w-full pointer-events-none"></div>

    <!-- GLOBAL INTERACTION & SCROLL ANIMATION SCRIPTS -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Back bar visibility
        const backBar = document.getElementById('rwnd-sys-back-bar');
        if (backBar && window.location.pathname !== '/' && window.location.pathname !== '') {
          backBar.classList.remove('hidden');
          backBar.classList.add('flex');
        }

        // Mobile Menu Toggle Fix
        const mobileMenu = document.getElementById('rwnd-mobile-menu');
        const menuTriggers = document.querySelectorAll('[data-toggle-mobile-menu]');
        
        menuTriggers.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            if (mobileMenu) {
              const isHidden = mobileMenu.classList.contains('hidden');
              if (isHidden) {
                mobileMenu.classList.remove('hidden');
                mobileMenu.classList.add('flex');
                document.body.style.overflow = 'hidden';
              } else {
                mobileMenu.classList.add('hidden');
                mobileMenu.classList.remove('flex');
                document.body.style.overflow = '';
              }
            }
          });
        });

        // Cart Drawer Open Triggers
        const cartTriggers = document.querySelectorAll('[data-open-cart="bag"], [data-open-cart="wishlist"]');
        cartTriggers.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const drawer = document.getElementById('rwnd-cart-drawer');
            if (drawer) {
              drawer.classList.remove('translate-x-full', 'hidden');
            } else {
              window.location.href = '/cart';
            }
          });
        });

        // Spooky Scroll Materialization Observer
        const spookyElements = document.querySelectorAll('.foggy-glass, article, section > div > div, h1, h2');
        spookyElements.forEach(el => {
          el.classList.add('gothic-scroll-reveal');
        });

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
            }
          });
        }, { 
          threshold: 0.08,
          rootMargin: '0px 0px -50px 0px' 
        });

        spookyElements.forEach(el => observer.observe(el));
      });

      // Industrial Toast Notification Helper
      function showRwndToast(title, message) {
        const container = document.getElementById('rwnd-toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = "pointer-events-auto flex flex-col rounded-2xl border border-red-900/60 bg-black/90 p-4 text-white shadow-[0_0_30px_rgba(220,38,38,0.4)] backdrop-blur-xl transition-all duration-300 translate-y-4 opacity-0";
        toast.innerHTML = `
          <div class="flex items-center justify-between border-b border-white/10 pb-2 mb-1">
            <span class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-red-500">✦ ${title}</span>
            <span class="h-1.5 w-1.5 rounded-full bg-red-600 animate-pulse"></span>
          </div>
          <p class="font-mono-tech text-xs text-zinc-300 mt-1">${message}</p>
        `;

        container.appendChild(toast);
        setTimeout(() => {
          toast.classList.remove('translate-y-4', 'opacity-0');
        }, 10);

        setTimeout(() => {
          toast.classList.add('translate-y-4', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      }
    </script>
  </body>
</html>
