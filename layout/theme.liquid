<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
    <meta name="theme-color" content="#030303">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name | default: 'rwnd20s.' }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="rwnd20s. — Heavy 316L stainless steel hardware, pink chrome Type-C wired earphones & analog chronographs. Free shipping above ₹999. Cash on Delivery available.">
    {% endif %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS Browser Runtime -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['Syne', 'Plus Jakarta Sans', 'sans-serif'],
              editorial: ['Playfair Display', 'Georgia', 'serif'],
              sans: ['Plus Jakarta Sans', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              'mono-tech': ['JetBrains Mono', 'monospace']
            }
          }
        }
      };
    </script>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    
    <!-- MASTER GOTHIC ATMOSPHERIC STYLES -->
    <style>
      html, body {
        max-width: 100vw;
        overflow-x: hidden;
        background-color: #030303 !important;
      }

      .foggy-glass {
        background: rgba(12, 12, 12, 0.85) !important;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.85);
      }
      .foggy-glass:hover {
        border-color: rgba(220, 38, 38, 0.5);
        box-shadow: 0 15px 50px 0 rgba(138, 3, 3, 0.4);
      }

      @keyframes eeriePulse {
        0%, 100% { opacity: 0.3; filter: blur(140px); }
        50% { opacity: 0.6; filter: blur(100px); }
      }

      .gothic-fog-layer {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(circle at 50% 30%, rgba(138, 3, 3, 0.35) 0%, transparent 70%);
        animation: eeriePulse 7s ease-in-out infinite;
      }
    </style>
  </head>

  <body class="min-h-screen text-[#E9E3D5] antialiased selection:bg-red-900 selection:text-white relative z-0 bg-[#030303]">

    <!-- VIVID CUSTOM GOTHIC STREET BACKGROUND (Fully Visible & Striking) -->
    <div class="fixed inset-0 z-[-2] bg-[#030303] overflow-hidden pointer-events-none w-full h-full">
      <div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-90 filter contrast-110" style="background-image: url('https://cdn.shopify.com/s/files/1/0851/2746/3165/files/file_000000001b1c820ba8f9b582c6371f3f.png?v=1793723403');"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#030303] via-[#030303]/60 to-[#030303]/40"></div>
    </div>
    <div class="gothic-fog-layer"></div>

    <!-- Header Section -->
    {% section 'header' %}

    <!-- FULL-SCREEN MOBILE NAVIGATION DRAWER -->
    <div
      id="rwnd-mobile-menu"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile Navigation"
      class="fixed inset-0 z-[120] hidden flex-col justify-between bg-[#030303]/98 p-6 text-white backdrop-blur-2xl border-l border-red-900/30"
    >
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <span class="font-display text-xl font-extrabold tracking-tighter text-white">
          {{ settings.brand_name | default: 'rwnd20s.' }}
        </span>
        <button
          type="button"
          data-toggle-mobile-menu
          aria-label="Close Menu"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-black/60 text-white hover:border-red-600 transition-colors cursor-pointer"
        >
          ✕
        </button>
      </div>

      <nav class="my-auto flex flex-col space-y-4">
        <a href="/" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold tracking-tight text-white uppercase hover:text-red-500 transition-colors">01 // HOME</a>
        <a href="/collections/all" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold tracking-tight text-white uppercase hover:text-red-500 transition-colors">02 // CATALOG</a>
        <a href="/cart" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold tracking-tight text-white uppercase hover:text-red-500 transition-colors">03 // HARDWARE BAG</a>
        <a href="/#about" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold tracking-tight text-white uppercase hover:text-red-500 transition-colors">04 // MANIFESTO</a>
      </nav>

      <div class="border-t border-white/10 pt-4 font-mono-tech text-[11px] tracking-wider text-zinc-400 uppercase">
        FREE EXPRESS SHIPPING ABOVE ₹999 · COD AVAILABLE
      </div>
    </div>

    <!-- UNIVERSAL SUB-PAGE BACK BUTTON -->
    <div id="rwnd-sys-back-bar" class="w-full max-w-7xl mx-auto px-4 pt-6 hidden">
      <button type="button" onclick="if(window.history.length > 1) { window.history.back(); } else { window.location.href='/'; }" class="group inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/80 backdrop-blur-xl px-4 py-2 font-mono-tech text-[10px] font-bold tracking-widest text-[#E9E3D5] uppercase shadow-lg transition-all hover:border-red-600 hover:bg-red-950/40 cursor-pointer">
        <span class="text-red-500">←</span>
        <span>RETURN TO BASE</span>
      </button>
    </div>

    <!-- Main Content -->
    <main id="MainContent" role="main" tabindex="-1" class="relative z-10 w-full">
      {{ content_for_layout }}
    </main>

    <!-- Footer Section -->
    <div class="relative z-10 w-full">
      {% section 'footer' %}
    </div>

    <!-- SLIDE-OUT CART DRAWER (Checkout pinned firmly to the bottom with zero dead space) -->
    <div id="rwnd-cart-drawer" class="fixed inset-0 z-[100] hidden justify-end bg-black/85 backdrop-blur-md transition-opacity">
      <div class="w-full max-w-md h-full bg-[#060606] border-l border-red-900/40 p-5 flex flex-col justify-between text-white shadow-2xl">
        
        <!-- Header & Hot Deals -->
        <div class="overflow-y-auto pr-1">
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <span class="font-display text-base font-bold uppercase tracking-wider">HARDWARE BAG</span>
            <button type="button" data-close-cart class="h-8 w-8 rounded-full border border-white/20 bg-black/60 flex items-center justify-center text-white hover:border-red-600 cursor-pointer">✕</button>
          </div>

          <div id="rwnd-drawer-items-list" class="py-3 space-y-3 border-b border-white/10">
            <p class="font-mono-tech text-xs text-zinc-400 text-center py-2">Your hardware bag is currently empty.</p>
          </div>

          <!-- HOT COMMUNITY DEALS -->
          <div class="mt-4 space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-red-500">✦ HOT COMMUNITY DEALS</span>
              <span class="font-mono-tech text-[9px] text-zinc-500 uppercase">LIMITED STOCK</span>
            </div>

            <div class="flex items-center justify-between rounded-2xl border border-white/10 bg-black/40 p-2.5 hover:border-red-600/60 transition-all">
              <div>
                <p class="font-display text-xs font-bold text-white uppercase">3-Piece Y2K Cyber Set</p>
                <p class="font-mono-tech text-[10px] text-zinc-400">Ring + Chain + Bracelet</p>
                <p class="font-mono-tech text-xs font-bold text-red-400 mt-0.5">₹1,199 <span class="text-[10px] text-zinc-500 line-through">₹1,447</span></p>
              </div>
              <a href="/collections/all" class="rounded-full border border-red-900/60 bg-red-950/40 px-3 py-1.5 font-mono-tech text-[10px] font-bold text-red-200 uppercase hover:bg-red-900 hover:text-white transition-all">
                INSPECT →
              </a>
            </div>

            <div class="flex items-center justify-between rounded-2xl border border-white/10 bg-black/40 p-2.5 hover:border-red-600/60 transition-all">
              <div>
                <p class="font-display text-xs font-bold text-white uppercase">Pink Chrome Earphones</p>
                <p class="font-mono-tech text-[10px] text-zinc-400">Type-C DAC Audio</p>
                <p class="font-mono-tech text-xs font-bold text-red-400 mt-0.5">₹999 <span class="text-[10px] text-zinc-500 line-through">₹1,499</span></p>
              </div>
              <a href="/collections/all" class="rounded-full border border-red-900/60 bg-red-950/40 px-3 py-1.5 font-mono-tech text-[10px] font-bold text-red-200 uppercase hover:bg-red-900 hover:text-white transition-all">
                INSPECT →
              </a>
            </div>
          </div>
        </div>

        <!-- Sticky Footer Checkout Action -->
        <div class="border-t border-white/10 pt-3 space-y-2 mt-2 bg-[#060606]">
          <div class="flex justify-between items-center font-mono-tech text-xs">
            <span class="text-zinc-400">SHIPPING (MDU DISPATCH)</span>
            <span class="text-emerald-400 font-bold">FREE OVER ₹999</span>
          </div>
          <a href="/checkout" class="block w-full text-center rounded-full border border-red-900/60 bg-red-950/50 py-3 font-mono-tech text-xs font-bold text-red-200 uppercase tracking-widest hover:bg-red-900 hover:text-white transition-all shadow-[0_0_20px_rgba(220,38,38,0.3)]">
            PROCEED TO SECURE CHECKOUT →
          </a>
        </div>

      </div>
    </div>

    <!-- Toast Container -->
    <div id="rwnd-toast-container" aria-live="polite" class="fixed right-4 bottom-4 z-[130] flex flex-col gap-2.5 max-w-sm w-full pointer-events-none"></div>

    <!-- GLOBAL INTERACTION SCRIPTS -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const backBar = document.getElementById('rwnd-sys-back-bar');
        if (backBar && window.location.pathname !== '/' && window.location.pathname !== '') {
          backBar.classList.remove('hidden');
        }

        const mobileMenu = document.getElementById('rwnd-mobile-menu');
        const menuTriggers = document.querySelectorAll('[data-toggle-mobile-menu]');
        
        menuTriggers.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            if (mobileMenu) {
              const isHidden = mobileMenu.classList.contains('hidden');
              if (isHidden) {
                mobileMenu.classList.remove('hidden');
                mobileMenu.classList.add('flex');
                document.body.style.overflow = 'hidden';
              } else {
                mobileMenu.classList.add('hidden');
                mobileMenu.classList.remove('flex');
                document.body.style.overflow = '';
              }
            }
          });
        });

        const cartDrawer = document.getElementById('rwnd-cart-drawer');
        const cartTriggers = document.querySelectorAll('[data-open-cart="bag"], [data-open-cart="wishlist"]');
        const closeCartBtn = document.querySelector('[data-close-cart]');

        cartTriggers.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            if (cartDrawer) {
              cartDrawer.classList.remove('hidden');
              cartDrawer.classList.add('flex');
              document.body.style.overflow = 'hidden';
            }
          });
        });

        closeCartBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          if (cartDrawer) {
            cartDrawer.classList.add('hidden');
            cartDrawer.classList.remove('flex');
            document.body.style.overflow = '';
          }
        });

        cartDrawer?.addEventListener('click', (e) => {
          if (e.target === cartDrawer) {
            cartDrawer.classList.add('hidden');
            cartDrawer.classList.remove('flex');
            document.body.style.overflow = '';
          }
        });
      });

      function showRwndToast(title, message) {
        const container = document.getElementById('rwnd-toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = "pointer-events-auto flex flex-col rounded-2xl border border-red-900/60 bg-black/90 p-4 text-white shadow-[0_0_30px_rgba(220,38,38,0.4)] backdrop-blur-xl transition-all duration-300 translate-y-4 opacity-0";
        toast.innerHTML = `
          <div class="flex items-center justify-between border-b border-white/10 pb-2 mb-1">
            <span class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-red-500">✦ ${title}</span>
            <span class="h-1.5 w-1.5 rounded-full bg-red-600 animate-pulse"></span>
          </div>
          <p class="font-mono-tech text-xs text-zinc-300 mt-1">${message}</p>
        `;

        container.appendChild(toast);
        setTimeout(() => toast.classList.remove('translate-y-4', 'opacity-0'), 10);
        setTimeout(() => {
          toast.classList.add('translate-y-4', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      }
    </script>
  </body>
</html>
