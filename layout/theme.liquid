<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#111111">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name | default: 'rwnd20s.' }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="rwnd20s. — Heavy 316L stainless steel hardware, pink chrome Type-C wired earphones & analog chronographs. Free shipping above ₹999. Cash on Delivery available.">
    {% endif %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS Browser Runtime -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['Syne', 'Plus Jakarta Sans', 'sans-serif'],
              editorial: ['Playfair Display', 'Georgia', 'serif'],
              sans: ['Plus Jakarta Sans', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              'mono-tech': ['JetBrains Mono', 'monospace']
            },
            colors: {
              chrome: {
                base: '#DCDFE5',
                panel: '#E4E7EC',
                ink: '#09090B',
                accent: '#FFFFFF'
              }
            }
          }
        }
      };
    </script>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="metallic-chrome-bg min-h-screen text-[#09090B] antialiased selection:bg-red-900 selection:text-white">

    <!-- IMMERSIVE BLOOD MOON VORTEX INTRO -->
    <style>
      .blood-vortex-out {
        animation: swirlDescent 2.5s cubic-bezier(0.7, 0, 0.3, 1) forwards;
      }
      @keyframes swirlDescent {
        0% { transform: scale(1) rotate(0deg); opacity: 1; filter: blur(0px); }
        30% { transform: scale(1.15) rotate(4deg); opacity: 1; filter: blur(1px) contrast(1.2) brightness(1.2); }
        100% { transform: scale(0.01) rotate(60deg); opacity: 0; filter: blur(30px) contrast(2); }
      }
      .goth-road-perspective {
        transform: perspective(50vh) rotateX(70deg);
        background: 
          linear-gradient(to top, #000 0%, transparent 100%),
          repeating-linear-gradient(90deg, #050505 0%, #050505 48%, #8a0303 49%, #8a0303 51%, #050505 52%, #050505 100%);
        background-size: 20vw 100px;
      }
    </style>

    <div id="rwnd-gothic-intro" class="fixed inset-0 z-[100] bg-black text-[#E9E3D5] font-mono-tech select-none overflow-hidden origin-center">
      <!-- The Blood Moon & Sky -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_center,#2b0000_0%,#000000_70%)] pointer-events-none"></div>
      <div class="absolute top-[15%] left-1/2 -translate-x-1/2 w-40 h-40 rounded-full bg-red-600 blur-[2px] shadow-[0_0_80px_40px_rgba(220,38,38,0.4)] animate-pulse pointer-events-none"></div>
      
      <!-- The 3D Goth Road -->
      <div class="absolute bottom-0 w-[200vw] h-[60vh] left-1/2 -translate-x-1/2 goth-road-perspective pointer-events-none opacity-80"></div>
      
      <!-- Streetlamp Flares -->
      <div class="absolute bottom-[20%] left-[20%] w-32 h-32 bg-amber-600/20 blur-[40px] pointer-events-none"></div>
      <div class="absolute bottom-[20%] right-[20%] w-32 h-32 bg-amber-600/20 blur-[40px] pointer-events-none"></div>

      <!-- Interface & Button -->
      <div class="relative z-20 h-full w-full flex flex-col items-center justify-between py-10 px-6">
        <div class="w-full flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="inline-block h-2 w-2 rounded-full bg-red-600 animate-pulse"></span>
            <span class="text-[10px] tracking-widest uppercase font-bold text-red-500">MDU_DISPATCH // ONLINE</span>
          </div>
          <button id="rwnd-skip-intro" class="text-[9px] text-zinc-500 hover:text-white uppercase tracking-widest cursor-pointer">SKIP [ESC]</button>
        </div>

        <!-- Center Content -->
        <div class="flex flex-col items-center text-center mt-[-10vh]">
          <p class="text-[10px] tracking-[0.6em] uppercase text-zinc-400 mb-6 drop-shadow-md">THE ARCHIVE IS BLEEDING</p>
          <h1 class="font-display text-5xl sm:text-7xl font-extrabold tracking-tighter uppercase text-white drop-shadow-[0_0_30px_rgba(220,38,38,0.6)]">
            BLOOD &<br>CHROME
          </h1>
          <button id="rwnd-ignite-btn" type="button" class="mt-12 group relative inline-flex items-center gap-3 rounded-full border border-red-900/50 bg-black/60 backdrop-blur-xl px-10 py-5 text-[12px] font-bold tracking-widest text-red-100 uppercase transition-all hover:bg-red-900 hover:text-white cursor-pointer shadow-[0_0_40px_rgba(138,3,3,0.5)] active:scale-95 hover:scale-105">
            <span>DESCEND INTO ARCHIVE</span>
          </button>
        </div>

        <div class="text-[9px] text-zinc-600 tracking-widest uppercase">ENCRYPTED // 316L HARDWARE</div>
      </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
      const introOverlay = document.getElementById('rwnd-gothic-intro');
      const igniteBtn = document.getElementById('rwnd-ignite-btn');
      const skipBtn = document.getElementById('rwnd-skip-intro');

      if (sessionStorage.getItem('rwnd_vortex_played') === 'true') {
        if (introOverlay) introOverlay.remove();
        return;
      }

      function triggerVortex() {
        sessionStorage.setItem('rwnd_vortex_played', 'true');
        introOverlay.classList.add('blood-vortex-out');
        setTimeout(() => { introOverlay.remove(); }, 2500);
      }

      igniteBtn?.addEventListener('click', triggerVortex);
      skipBtn?.addEventListener('click', triggerVortex);
    });
    </script>

    {% if settings.enable_crt_flicker != false %}
      <div aria-hidden="true" data-testid="crt-flicker-overlay" class="crt-flicker-overlay fixed inset-0 z-[55]"></div>
    {% endif %}

    <!-- Header Section -->
    {% section 'header' %}

    <!-- Main Content -->
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- INDUSTRIAL SYS_BACK CAPSULE -->
    <div id="rwnd-sys-back-bar" class="fixed bottom-6 left-6 z-[60] hidden sm:block">
      <button type="button" onclick="if(window.history.length > 1) { window.history.back(); } else { window.location.href='/'; }" class="group inline-flex items-center gap-2.5 rounded-full border border-white/20 bg-black/80 backdrop-blur-xl px-5 py-2.5 font-mono-tech text-[11px] font-bold tracking-widest text-[#E9E3D5] uppercase shadow-[0_8px_30px_rgba(0,0,0,0.5)] transition-all duration-200 hover:border-[#E9E3D5] hover:bg-[#E9E3D5] hover:text-black cursor-pointer active:scale-95">
        <span class="text-zinc-500 group-hover:text-black">←</span>
        <span>SYS_RETURN</span>
      </button>
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const backBar = document.getElementById('rwnd-sys-back-bar');
        if (backBar && window.location.pathname !== '/' && window.location.pathname !== '') {
          backBar.classList.remove('hidden');
          backBar.classList.add('flex');
        }
      });
    </script>

    <!-- Footer Section -->
    {% section 'footer' %}

    <!-- Slide-Out Cart Drawer -->
    {% render 'cart-drawer' %}

    <!-- Toast Container -->
    <div id="rwnd-toast-container" aria-live="polite" class="fixed right-4 bottom-4 z-[80] flex flex-col gap-2.5 max-w-sm w-full pointer-events-none"></div>

<!-- PHASE 3: GLOBAL SMOOTH SCROLL ANIMATIONS -->
<style>
  /* The hidden starting state for all elements */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1), transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: opacity, transform;
  }
  
  /* The revealed state when scrolling hits them */
  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Target all the elements that should animate (Manifesto cards, Product cards, Headings, Footer blocks)
    const selectors = [
      '.rounded-3xl', 
      '.rounded-2xl', 
      '#rwnd-product-grid > div', 
      'footer > div > div',
      'h2'
    ];
    
    const elementsToReveal = document.querySelectorAll(selectors.join(', '));
    
    // 2. Attach the hidden state class instantly
    elementsToReveal.forEach(el => el.classList.add('reveal-on-scroll'));

    // 3. Create the observer to watch for scrolling
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // Trigger the slide-up animation
          entry.target.classList.add('is-visible');
          // Unobserve so it only plays once per session for better performance
          observer.unobserve(entry.target); 
        }
      });
    }, { 
      rootMargin: '0px 0px -50px 0px', // Triggers right as it crosses the bottom threshold
      threshold: 0.1 
    });

    // 4. Start watching all targeted elements
    elementsToReveal.forEach(el => revealObserver.observe(el));
  });
</script>

  </body>
</html>
