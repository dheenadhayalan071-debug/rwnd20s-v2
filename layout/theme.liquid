<!-- layout/theme.liquid -->
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0A0A0C"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }} · RWND20s</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% else %}<meta name="description" content="Y2K accessories and Type-C audio from RWND20s. Old vibe. New you.">{% endif %}<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">{{ 'theme.css' | asset_url | stylesheet_tag }}{{ 'tokens.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head><body><div id="rwnd-gateway" class="gateway" aria-label="RWND20s intro"><div><p class="eyebrow">RWND20s</p><h1>Old vibe.<br>New you.</h1><button type="button" class="button-primary" id="gateway-enter">Enter the archive</button><button type="button" id="gateway-skip" class="text-link">Skip intro</button></div></div>{% section 'header' %}<main id="MainContent">{{ content_for_layout }}</main>{% section 'footer' %}{% render 'welcome-popup' %}<script>(()=>{const header=document.querySelector('.site-header');const updateHeader=()=>header?.classList.toggle('is-scrolled',window.scrollY>8);window.addEventListener('scroll',updateHeader,{passive:true});updateHeader();const gate=document.getElementById('rwnd-gateway');let seen=false;try{seen=sessionStorage.getItem('rwnd_gateway_seen')==='true'}catch(e){}const dismiss=()=>{if(!gate||gate.hidden)return;gate.classList.add('is-leaving');try{sessionStorage.setItem('rwnd_gateway_seen','true')}catch(e){}setTimeout(()=>{gate.hidden=true;window.showRwndWelcomeModal?.()},300)};if(seen){gate.hidden=true}else{document.getElementById('gateway-enter')?.addEventListener('click',dismiss);document.getElementById('gateway-skip')?.addEventListener('click',dismiss);setTimeout(dismiss,3000)}})();</script>{{ 'theme.js' | asset_url | script_tag }}</body></html>
