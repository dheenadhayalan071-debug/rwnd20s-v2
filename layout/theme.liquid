<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=0">
    <meta name="theme-color" content="#030303">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name | default: 'rwnd20s.' }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="rwnd20s. — Heavy 316L stainless steel hardware, pink chrome Type-C wired earphones & analog chronographs. Free shipping above ₹999. Cash on Delivery available.">
    {% endif %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS Browser Runtime -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['Syne', 'Plus Jakarta Sans', 'sans-serif'],
              editorial: ['Playfair Display', 'Georgia', 'serif'],
              sans: ['Plus Jakarta Sans', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              'mono-tech': ['JetBrains Mono', 'monospace']
            },
            colors: {
              chrome: {
                base: '#DCDFE5',
                panel: '#E4E7EC',
                ink: '#09090B',
                accent: '#FFFFFF'
              }
            }
          }
        }
      };
    </script>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    
    <style>
      /* Animated 3D Road to Hell */
      .road-to-hell {
        transform-origin: bottom center;
        transform: perspective(60vh) rotateX(75deg);
        background-image: 
          linear-gradient(to top, rgba(0,0,0,1) 10%, transparent 100%),
          linear-gradient(to right, rgba(0,0,0,0) 49.5%, #8a0303 49.5%, #8a0303 50.5%, rgba(0,0,0,0) 50.5%),
          repeating-linear-gradient(to bottom, transparent 0, transparent 40px, #2a0000 40px, #2a0000 42px);
        background-size: 100% 100%, 100% 100%, 100% 42px;
        animation: drive 0.5s linear infinite;
      }
      
      @keyframes drive {
        from { background-position: 0 0, 0 0, 0 0; }
        to { background-position: 0 0, 0 0, 0 42px; }
      }
    </style>
  </head>

  <!-- Removed solid background colors so the permanent 3D road is visible behind the store -->
  <body class="min-h-screen text-[#E9E3D5] antialiased selection:bg-red-900 selection:text-white relative z-0">

    <!-- PERMANENT ANIMATED BACKGROUND (Stays behind the whole site) -->
    <div class="fixed inset-0 z-[-1] bg-[#030303] overflow-hidden pointer-events-none">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_center,#1a0000_0%,#000000_80%)] opacity-90"></div>
      <div class="absolute top-[5%] left-1/2 -translate-x-1/2 w-96 h-96 rounded-full bg-red-900 blur-[120px] opacity-20"></div>
      <div class="absolute bottom-0 w-[200vw] h-[50vh] left-1/2 -translate-x-1/2 road-to-hell opacity-30"></div>
    </div>

    <!-- ATMOSPHERIC NIGHT INTRO OVERLAY (Locked to screen, no scrolling) -->
    <div id="rwnd-night-intro" class="fixed top-0 left-0 w-full h-[100dvh] overflow-hidden z-[100] flex flex-col items-center justify-center bg-[#030303] text-[#E9E3D5] font-mono-tech select-none origin-center">
      
      <!-- Intro specific heavy fog and moon -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,#3a0000_0%,#000000_70%)] opacity-80 pointer-events-none transition-opacity duration-1000" id="intro-fog"></div>
      <div class="absolute top-[25%] left-1/2 -translate-x-1/2 w-64 h-64 rounded-full bg-red-700 blur-[60px] opacity-60 animate-pulse pointer-events-none"></div>
      
      <!-- The Intro Road -->
      <div class="absolute bottom-0 w-[200vw] h-[60vh] left-1/2 -translate-x-1/2 road-to-hell opacity-60"></div>
      
      <!-- Main Content (Pulled up so it hits eye level immediately) -->
      <div class="relative z-10 flex flex-col items-center text-center px-6 -mt-16 sm:-mt-24 transition-opacity duration-500" id="intro-content">
        <p class="text-[10px] tracking-[0.6em] uppercase text-zinc-500 mb-6 drop-shadow-lg">ATMOSPHERE: MIDNIGHT</p>
        <h1 class="font-display text-5xl sm:text-7xl font-extrabold tracking-tighter uppercase text-white drop-shadow-[0_0_40px_rgba(220,38,38,0.5)]">
          THE NIGHT <br><span class="text-zinc-600">CALLS</span>
        </h1>
        <p class="mt-6 text-xs text-zinc-400 max-w-md leading-relaxed tracking-wider drop-shadow-md">
          Heavy 316L hardware engineered for the dark road.
        </p>
        <button id="rwnd-enter-night-btn" type="button" class="mt-10 group relative inline-flex items-center gap-3 rounded-full border border-white/20 bg-black/60 backdrop-blur-xl px-10 py-5 text-[11px] font-bold tracking-widest text-[#E9E3D5] uppercase transition-all hover:bg-white hover:text-black hover:shadow-[0_0_30px_rgba(255,255,255,0.3)] cursor-pointer active:scale-95">
          <span>DESCEND INTO ARCHIVE</span>
        </button>
      </div>

      <!-- Ticker Locked to Bottom -->
      <div class="absolute bottom-8 w-full px-8 flex justify-between items-center text-[9px] text-zinc-600 tracking-widest uppercase transition-opacity duration-500" id="intro-ticker">
        <span>LOC: MADURAI_TN</span>
        <span>VISIBILITY: ZERO</span>
      </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
      const introOverlay = document.getElementById('rwnd-night-intro');
      const enterBtn = document.getElementById('rwnd-enter-night-btn');
      const introContent = document.getElementById('intro-content');
      const introTicker = document.getElementById('intro-ticker');
      const introFog = document.getElementById('intro-fog');

      if (sessionStorage.getItem('rwnd_night_played') === 'true') {
        if (introOverlay) introOverlay.remove();
        return;
      }

      enterBtn?.addEventListener('click', () => {
        sessionStorage.setItem('rwnd_night_played', 'true');
        
        // 1. Hide the text instantly
        introContent.style.opacity = '0';
        introTicker.style.opacity = '0';
        introFog.style.opacity = '0';
        
        // 2. Trigger a 3.5-second violent cinematic zoom into the road/moon
        introOverlay.style.transition = 'all 3.5s cubic-bezier(0.7, 0, 0.2, 1)';
        introOverlay.style.transform = 'scale(4) translateY(20%)';
        introOverlay.style.filter = 'blur(15px) brightness(1.5)';
        introOverlay.style.opacity = '0';
        introOverlay.style.pointerEvents = 'none';
        
        // 3. Remove overlay from DOM after animation completes
        setTimeout(() => { introOverlay.remove(); }, 3500);
      });
    });
    </script>

    <!-- Header Section -->
    {% section 'header' %}

    <!-- Main Content -->
    <main id="MainContent" role="main" tabindex="-1" class="relative z-10">
      {{ content_for_layout }}
    </main>

    <!-- INDUSTRIAL SYS_BACK CAPSULE -->
    <div id="rwnd-sys-back-bar" class="fixed bottom-6 left-6 z-[60] hidden sm:block">
      <button type="button" onclick="if(window.history.length > 1) { window.history.back(); } else { window.location.href='/'; }" class="group inline-flex items-center gap-2.5 rounded-full border border-white/20 bg-black/80 backdrop-blur-xl px-5 py-2.5 font-mono-tech text-[11px] font-bold tracking-widest text-[#E9E3D5] uppercase shadow-[0_8px_30px_rgba(0,0,0,0.5)] transition-all duration-200 hover:border-[#E9E3D5] hover:bg-[#E9E3D5] hover:text-black cursor-pointer active:scale-95">
        <span class="text-zinc-500 group-hover:text-black">←</span>
        <span>RETURN</span>
      </button>
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const backBar = document.getElementById('rwnd-sys-back-bar');
        if (backBar && window.location.pathname !== '/' && window.location.pathname !== '') {
          backBar.classList.remove('hidden');
          backBar.classList.add('flex');
        }
      });
    </script>

    <!-- Footer Section -->
    <div class="relative z-10">
      {% section 'footer' %}
    </div>

    <!-- Slide-Out Cart Drawer -->
    {% render 'cart-drawer' %}

    <!-- Toast Container -->
    <div id="rwnd-toast-container" aria-live="polite" class="fixed right-4 bottom-4 z-[80] flex flex-col gap-2.5 max-w-sm w-full pointer-events-none"></div>

    <!-- PHASE 3: GLOBAL SMOOTH SCROLL ANIMATIONS -->
    <style>
      .reveal-on-scroll {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1), transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        will-change: opacity, transform;
      }
      .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
    </style>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const selectors = [
          '.rounded-3xl', 
          '.rounded-2xl', 
          '#rwnd-product-grid > div', 
          'footer > div > div',
          'h2'
        ];
        
        const elementsToReveal = document.querySelectorAll(selectors.join(', '));
        elementsToReveal.forEach(el => el.classList.add('reveal-on-scroll'));

        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target); 
            }
          });
        }, { 
          rootMargin: '0px 0px -50px 0px',
          threshold: 0.1 
        });

        elementsToReveal.forEach(el => revealObserver.observe(el));
      });
    </script>

  </body>
</html>
