<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
    <meta name="theme-color" content="#030303">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name | default: 'rwnd20s.' }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="rwnd20s. — Heavy 316L stainless steel hardware, pink chrome Type-C wired earphones & analog chronographs. Free shipping above ₹999. Cash on Delivery available.">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['Syne', 'Plus Jakarta Sans', 'sans-serif'],
              sans: ['Plus Jakarta Sans', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              'mono-tech': ['JetBrains Mono', 'monospace']
            }
          }
        }
      };
    </script>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}

    <style>
      html,
      body {
        max-width: 100vw;
        overflow-x: hidden;
        background-color: transparent !important;
        background-image: none !important;
        background-attachment: fixed !important;
      }

      body.intro-active {
        overflow: hidden !important;
        height: 100dvh !important;
      }

      .foggy-glass {
        background: rgba(6, 6, 6, 0.94) !important;
        backdrop-filter: blur(30px);
        -webkit-backdrop-filter: blur(30px);
        border: 1px solid rgba(127, 29, 29, 0.45) !important;
        box-shadow: 0 22px 60px rgba(0, 0, 0, 0.88), inset 0 1px 0 rgba(255,255,255,0.03);
      }

      .foggy-glass:hover {
        border-color: rgba(220, 38, 38, 0.62) !important;
        box-shadow: 0 30px 80px rgba(127, 0, 0, 0.28), inset 0 1px 0 rgba(255,255,255,0.05);
      }

      .foggy-glass * {
        color: inherit;
      }
    </style>
  </head>

  <body class="relative z-0 min-h-screen text-[#E9E3D5] antialiased selection:bg-red-900 selection:text-white">
    <div id="rwnd-gateway-splash" class="fixed inset-0 z-[200] flex h-[100dvh] w-screen flex-col items-center justify-center overflow-hidden bg-[#030303] text-[#E9E3D5] transition-opacity duration-1000">
      <canvas id="rwnd-fog-canvas" class="pointer-events-none absolute inset-0 z-0 h-full w-full"></canvas>
      <div class="absolute inset-0 z-[1] h-full w-full bg-[radial-gradient(circle_at_center,#450a0a_0%,#030303_80%)] opacity-80 pointer-events-none"></div>

      <div id="rwnd-entry-prompt" class="relative z-10 mx-auto flex max-w-lg flex-col items-center space-y-6 p-6 text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-red-900/60 bg-black/60 px-4 py-1.5 backdrop-blur-md">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-red-600"></span>
          <span class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-red-400">SECTOR // MDU_DISPATCH</span>
        </div>

        <h1 class="font-display text-4xl font-extrabold uppercase tracking-tighter text-white drop-shadow-2xl sm:text-6xl">
          {{ settings.brand_name | default: 'rwnd20s.' }}
        </h1>

        <p class="max-w-sm font-mono-tech text-xs text-zinc-400 sm:text-sm">
          Heavy 316L stainless steel hardware. Nocturnal industrial aesthetics.
        </p>

        <button type="button" id="rwnd-trigger-intro" class="inline-flex items-center gap-3 rounded-full border border-red-900/80 bg-red-950/40 px-8 py-4 font-mono-tech text-xs font-bold uppercase tracking-[0.24em] text-red-100 transition-all hover:bg-red-900 hover:text-white">
          <span>[ ENTER THE ARCHIVE ]</span>
          <span class="text-red-500">→</span>
        </button>
      </div>

      <div id="rwnd-video-container" class="absolute inset-0 z-20 hidden h-[100dvh] w-full items-center justify-center bg-black">
        <video id="rwnd-intro-video" class="absolute inset-0 h-full w-full bg-black object-contain" playsinline autoplay muted>
          <source src="https://cdn.shopify.com/videos/c/o/v/e8e2f809aecd408cadfa5c08fef2c7f6.mp4">
          Your browser does not support the video tag.
        </video>
        <button type="button" id="rwnd-skip-video" class="absolute bottom-8 right-8 z-30 rounded-full border border-white/20 bg-black/70 px-5 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-[0.24em] text-white">
          SKIP INTRO [ ESC ]
        </button>
      </div>
    </div>

    {% section 'header' %}

    <div id="rwnd-sys-back-bar" class="mx-auto hidden w-full max-w-7xl px-4 pt-6">
      <button type="button" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }" class="group inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/80 px-4 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-[0.2em] text-[#E9E3D5] transition-all hover:border-red-600 hover:bg-red-950/40">
        <span class="text-red-500">←</span>
        <span>RETURN TO BASE</span>
      </button>
    </div>

    <main id="MainContent" role="main" tabindex="-1" class="relative z-10 w-full">
      {{ content_for_layout }}
    </main>

    <div class="relative z-10 w-full">
      {% section 'footer' %}
    </div>

    <div id="rwnd-toast-container" aria-live="polite" class="pointer-events-none fixed bottom-4 right-4 z-[130] flex w-full max-w-sm flex-col gap-2.5"></div>

    {% render 'welcome-popup' %}

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const body = document.body;
        const splash = document.getElementById('rwnd-gateway-splash');
        const trigger = document.getElementById('rwnd-trigger-intro');
        const videoContainer = document.getElementById('rwnd-video-container');
        const video = document.getElementById('rwnd-intro-video');
        const prompt = document.getElementById('rwnd-entry-prompt');
        const canvas = document.getElementById('rwnd-fog-canvas');

        class FogDissolveCanvas {
          constructor(canvasEl) {
            this.canvas = canvasEl;
            this.ctx = canvasEl?.getContext('2d');
            this.particles = [];
            this.dissolving = false;
            this.startTime = 0;
            this.progress = 0;
            this.resize();
            window.addEventListener('resize', () => this.resize());
          }

          resize() {
            if (!this.canvas || !this.ctx) return;
            const ratio = window.devicePixelRatio || 1;
            const { innerWidth, innerHeight } = window;
            this.canvas.width = innerWidth * ratio;
            this.canvas.height = innerHeight * ratio;
            this.canvas.style.width = `${innerWidth}px`;
            this.canvas.style.height = `${innerHeight}px`;
            this.ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
            this.particles = Array.from({ length: 42 }, (_, index) => ({
              x: Math.random() * innerWidth,
              y: Math.random() * innerHeight,
              radius: 40 + Math.random() * 140,
              alpha: 0.12 + Math.random() * 0.38,
              drift: (Math.random() - 0.5) * 0.8,
              vx: (Math.random() - 0.5) * 0.7,
              vy: (Math.random() - 0.5) * 0.7,
              seed: index
            }));
          }

          setDissolving(value) {
            this.dissolving = value;
            if (value) this.startTime = performance.now();
          }

          render(now) {
            if (!this.canvas || !this.ctx) return;
            const width = this.canvas.clientWidth || window.innerWidth;
            const height = this.canvas.clientHeight || window.innerHeight;
            this.ctx.clearRect(0, 0, width, height);

            const base = this.ctx.createRadialGradient(width * 0.5, height * 0.5, 0, width * 0.5, height * 0.5, width * 0.7);
            base.addColorStop(0, 'rgba(120, 0, 0, 0.26)');
            base.addColorStop(0.4, 'rgba(78, 0, 0, 0.12)');
            base.addColorStop(1, 'rgba(3, 3, 3, 0)');
            this.ctx.fillStyle = base;
            this.ctx.fillRect(0, 0, width, height);

            for (const particle of this.particles) {
              const wobble = Math.sin((now / 900) + particle.seed) * 25;
              const x = particle.x + Math.cos((now / 1400) + particle.seed) * 28 + wobble;
              const y = particle.y + Math.sin((now / 1600) + particle.seed) * 28;
              const radius = particle.radius + Math.sin((now / 700) + particle.seed) * 18;
              const progress = this.dissolving ? Math.min((now - this.startTime) / 3000, 1) : 0;
              const expansion = this.dissolving ? progress * 1.8 : 0;
              const alpha = this.dissolving ? Math.max(0, 0.36 - progress * 0.32) : particle.alpha;

              const gradient = this.ctx.createRadialGradient(x, y, 0, x, y, radius * (1 + expansion));
              gradient.addColorStop(0, `rgba(255, 90, 90, ${alpha})`);
              gradient.addColorStop(0.35, `rgba(120, 20, 20, ${alpha * 0.7})`);
              gradient.addColorStop(0.8, 'rgba(20, 10, 12, 0)');
              this.ctx.fillStyle = gradient;
              this.ctx.beginPath();
              this.ctx.arc(x, y, radius * (1 + expansion), 0, Math.PI * 2);
              this.ctx.fill();

              particle.x += particle.vx + (this.dissolving ? 0.6 : 0);
              particle.y += particle.vy + (this.dissolving ? 0.5 : 0);

              if (particle.x < -radius) particle.x = width + radius;
              if (particle.x > width + radius) particle.x = -radius;
              if (particle.y < -radius) particle.y = height + radius;
              if (particle.y > height + radius) particle.y = -radius;
            }

            requestAnimationFrame((next) => this.render(next));
          }

          start() {
            requestAnimationFrame((now) => this.render(now));
          }
        }

        const fogCanvas = canvas ? new FogDissolveCanvas(canvas) : null;
        fogCanvas?.start();

        function closeSplash() {
          if (!splash || splash.dataset.dismissing === 'true') return;
          splash.dataset.dismissing = 'true';
          sessionStorage.setItem('rwnd_intro_seen', 'true');
          body.classList.remove('intro-active');

          if (video) {
            video.pause();
            video.currentTime = 0;
          }

          prompt?.classList.add('opacity-0', 'transition-opacity', 'duration-500');
          fogCanvas?.setDissolving(true);

          setTimeout(() => {
            splash?.classList.add('opacity-0');
            setTimeout(() => {
              splash?.remove();
              window.showRwndWelcomeModal?.();
            }, 2600);
          }, 250);
        }

        const seenIntro = sessionStorage.getItem('rwnd_intro_seen') === 'true';
        if (seenIntro) {
          splash?.remove();
          body.classList.remove('intro-active');
          return;
        }

        body.classList.add('intro-active');

        trigger?.addEventListener('click', () => {
          closeSplash();
        });

        document.getElementById('rwnd-skip-video')?.addEventListener('click', () => closeSplash());
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeSplash();
        });

        trigger?.addEventListener('click', () => {
          videoContainer?.classList.remove('hidden');
          videoContainer?.classList.add('flex');
          video?.play().catch(() => {});
        });

        video?.addEventListener('ended', closeSplash);

        const backBar = document.getElementById('rwnd-sys-back-bar');
        if (backBar && window.location.pathname !== '/' && window.location.pathname !== '') {
          backBar.classList.remove('hidden');
        }
      });

      (() => {
        const refreshCartBadges = async () => {
          try {
            const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
            if (!response.ok) return;
            const cart = await response.json();
            document.querySelectorAll('[data-cart-count]').forEach((badge) => {
              badge.textContent = String(cart.item_count || 0);
            });
          } catch (error) {
            console.error('Cart badge refresh failed:', error);
          }
        };

        async function addFormToCart(form, button) {
          if (!form || !button || button.dataset.cartSubmitting === 'true') return;

          const inputButton = button.tagName === 'INPUT';
          const originalContent = inputButton ? button.value : button.innerHTML;
          const originalClasses = button.className;
          const originalStyle = button.getAttribute('style');

          const setContent = (content) => {
            if (inputButton) button.value = content;
            else button.innerHTML = content;
          };

          const restoreButton = () => {
            setContent(originalContent);
            button.className = originalClasses;
            if (originalStyle === null) button.removeAttribute('style');
            else button.setAttribute('style', originalStyle);
            button.disabled = false;
            delete button.dataset.cartSubmitting;
          };

          button.dataset.cartSubmitting = 'true';
          button.disabled = true;
          button.style.pointerEvents = 'none';
          setContent('<span class="animate-pulse tracking-widest text-white">[ AUTHORIZING... ]</span>');

          try {
            const response = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: new FormData(form)
            });

            if (!response.ok) {
              const error = await response.json().catch(() => ({}));
              throw new Error(error.description || 'Could not add item to your hardware bag.');
            }

            await response.json();
            button.classList.remove('bg-black', 'bg-black/80', 'bg-transparent', 'text-red-100', 'border-red-900/60');
            button.classList.add('bg-red-600', 'text-white', 'border-red-900');
            button.style.backgroundColor = '#dc2626';
            button.style.color = '#ffffff';
            button.style.borderColor = '#7f1d1d';
            setContent('<span class="font-bold tracking-widest text-white">✦ ARCHIVE ADDED</span>');

            await refreshCartBadges();
            if (typeof window.fetchMainCartData === 'function') window.fetchMainCartData();
          } catch (error) {
            console.error('Cart add failed:', error);
            setContent('<span class="font-bold tracking-widest text-white">ADD FAILED</span>');
          } finally {
            setTimeout(restoreButton, 2500);
          }
        }

        document.addEventListener('click', (event) => {
          const button = event.target.closest('button[name="add"], button[type="submit"].add-to-cart, form[action*="/cart/add"] button[type="submit"]');
          const form = button?.closest('form[action*="/cart/add"]');
          if (!form || !button) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          addFormToCart(form, button);
        }, true);

        document.addEventListener('submit', (event) => {
          const form = event.target;
          if (!(form instanceof HTMLFormElement) || !form.matches('form[action*="/cart/add"]')) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          const button = form.querySelector('button[name="add"], button[type="submit"], input[type="submit"]');
          addFormToCart(form, button);
        }, true);
      })();
    </script>

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
