<!-- layout/theme.liquid -->
<!doctype html>
<html class="no-js" lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">

    <link
      rel="icon"
      type="image/png"
      href="{{ 'rwnd20s_favicon_32x32.png' | asset_url }}"
    >

    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {% if template.name == 'index' %}
        RWND20s &ndash; Y2K 316L Stainless Steel Hardware &amp; Audio
      {% else %}
        {{ page_title | escape }} &ndash; RWND20s
      {% endif %}
    </title>

    {% assign meta_description = page_description %}
    {% if meta_description == blank %}
      {% if template.name == 'product' %}
        {% assign meta_description = product.description | strip_html | truncate: 160 %}
      {% elsif template.name == 'collection' %}
        {% assign meta_description = collection.description | strip_html | truncate: 160 %}
      {% elsif template.name == 'page' %}
        {% assign meta_description = page.content | strip_html | truncate: 160 %}
      {% endif %}
    {% endif %}
    {% if meta_description == blank %}
      {% assign meta_description = 'Y2K accessories, 316L surgical stainless steel jewelry, watches, and Type-C audio from RWND20s. Dispatched from Madurai.' %}
    {% endif %}
    <meta name="description" content="{{ meta_description | escape }}">

    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:description" content="{{ meta_description | escape }}">
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:url" content="{{ canonical_url }}">
    {% if template.name == 'product' and product.featured_image %}
      <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    {% elsif settings.share_image %}
      <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | escape }}">
    <meta name="twitter:description" content="{{ meta_description | escape }}">
    {% if template.name == 'product' and product.featured_image %}
      <meta name="twitter:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    {% endif %}

    <!-- Brand Entity & Knowledge Graph Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "{{ shop.url }}/#website",
            "url": "{{ shop.url }}/",
            "name": "RWND20s",
            "alternateName": ["rwnd20s", "rwnd20s.", "RWND20s India"],
            "publisher": { "@id": "{{ shop.url }}/#organization" }
          },
          {
            "@type": "Organization",
            "@id": "{{ shop.url }}/#organization",
            "name": "RWND20s",
            "alternateName": ["rwnd20s", "rwnd20s."],
            "url": "{{ shop.url }}/",
            "logo": "https:{{ 'rwnd20s_favicon_32x32.png' | asset_url }}",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Madurai",
              "addressRegion": "Tamil Nadu",
              "addressCountry": "IN"
            },
            "sameAs": [
              "https://www.instagram.com/rwnd20s"
            ]
          }
        ]
      }
    </script>

    {% if template.name == 'product' %}
      {% assign ld_variant = product.selected_or_first_available_variant %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Product",
          "name": {{ product.title | json }},
          "url": {{ shop.url | append: product.url | json }},
          {% if product.featured_image %}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}
          "description": {{ product.description | strip_html | truncate: 300 | json }},
          "sku": {{ ld_variant.sku | json }},
          "brand": { "@type": "Brand", "name": "RWND20s" },
          "offers": {
            "@type": "Offer",
            "url": {{ shop.url | append: product.url | json }},
            "priceCurrency": "INR",
            "price": "{{ ld_variant.price | money_without_currency | remove: ',' }}",
            "availability": "https://schema.org/{% if ld_variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition"
          }
        }
      </script>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": {{ shop.url | json }}
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": {{ shop.url | append: product.url | json }}
            }
          ]
        }
      </script>
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <!-- Druk Wide (display / headline font). COMMERCIAL TYPE — per the
         license, embedding is for web-font use only; it is not to be
         redistributed as a file or converted into other formats. Served via
         the webfont host under the commercial "web font use" clause.
         Syne / Inter / system fonts remain as fallbacks. -->
    <link href="https://db.onlinewebfonts.com/c/2206d6cc490084998d531e8c1b2cbb4a?family=Druk+Wide+Bold" rel="stylesheet">

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <!-- Precompiled Tailwind stylesheet (compiled from this repo's content) —
         replaces the in-browser JIT CDN, which generated the whole utility set
         after parse and blocked paint on every page. -->
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}

    <style>
      html,
      body {
        max-width: 100vw;
        min-height: 100%;
        overflow-x: hidden;
        background-color: var(--bg-void) !important;
        color: var(--text-high-contrast);
      }
    </style>
  </head>

  <body class="relative z-0 min-h-screen font-sans text-bone antialiased selection:bg-brand selection:text-white">
    <!-- Subtle page-load veil: shows while assets settle, then fades -->
    <div class="rwnd-page-loader" id="rwnd-page-loader" aria-hidden="true">
      <div class="rwnd-loader-bar" aria-hidden="true"></div>
      <div class="rwnd-loader-wordmark">rwnd20s<span class="rwnd-loader-dot">.</span></div>
    </div>
    <a href="#MainContent" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[999] focus:border focus:border-brand focus:bg-black focus:px-4 focus:py-3 focus:font-mono-tech focus:text-xs focus:uppercase focus:text-white">
      {{ 'general.accessibility.skip_to_text' | t }}
    </a>
    <!-- Ambient Mobile Fixed Background -->
    <div 
      class="fixed inset-0 pointer-events-none -z-10 bg-cover bg-center bg-no-repeat opacity-35" 
      style="background-image: url('https://cdn.shopify.com/s/files/1/0851/2746/3165/files/file_000000001b1c820ba8f9b582c6371f3f.jpg?v=1793812649');"
    ></div>
    <div class="fixed inset-0 pointer-events-none -z-10 bg-gradient-to-b from-[#000000]/85 via-transparent to-[#000000]/95"></div>
    <div class="rwnd-ambient-glow" aria-hidden="true"></div>

    <!-- 1. ROOT MOUNTED STICKY HEADER -->
    {% section 'header' %}

    <div id="rwnd-sys-back-bar" class="mx-auto hidden w-full max-w-7xl px-4 pt-4">
      <button type="button" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }" class="group inline-flex items-center gap-2 border border-white/10 bg-panel px-4 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-[1.5px] text-white transition-all hover:border-brand">
        <span class="text-brand">←</span>
        <span>RETURN TO BASE</span>
      </button>
    </div>

    <!-- 2. MAIN STOREFRONT CONTENT -->
    <main id="MainContent" role="main" tabindex="-1" class="relative z-10 w-full min-h-[70vh]">
      {{ content_for_layout }}
    </main>

    <!-- 3. FOOTER -->
    <div class="relative z-10 w-full">
      {% section 'footer' %}
    </div>

    <div id="rwnd-toast-container" aria-live="polite" class="pointer-events-none fixed bottom-4 right-4 z-[130] flex w-full max-w-sm flex-col gap-2.5"></div>

    <!-- Architecture Snippets -->
    {% render 'welcome-popup' %}
    {% render 'whatsapp-floating' %}
    {% render 'size-guide-modal' %}

    <script>
      // System Return-To-Base Bar Visibility
      (() => {
        const backBar = document.getElementById('rwnd-sys-back-bar');
        if (backBar && window.location.pathname !== '/' && window.location.pathname !== '') {
          backBar.classList.remove('hidden');
        }
      })();
    </script>

    <script>
      // Indicative founder hand-delivery fee (₹). Checkout stays authoritative.
      window.RWND_FOUNDER_FEE = {{ settings.founder_delivery_fee | default: 499 }};
    </script>

    <script>
      // Subtle loading veil — fades once the page settles.
      (function () {
        var loader = document.getElementById('rwnd-page-loader');
        if (!loader) return;

        var done = false;
        var finish = function () {
          if (done) return;
          done = true;
          loader.classList.add('rwnd-loader-leaving');
          window.setTimeout(function () {
            loader.parentNode && loader.parentNode.removeChild(loader);
          }, 700);
        };

        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          finish();
          return;
        }

        window.addEventListener('load', function () {
          window.setTimeout(finish, 350);
        });
        // Failsafe — never trap the user on the veil.
        window.setTimeout(finish, 4000);
      })();

      // Subtle reveal-on-scroll — only on top-level sections that do not
      // contain sticky children (sticky filters must remain untouched).
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var targets = [];
        Array.prototype.forEach.call(document.querySelectorAll('main > section, main > header'), function (section) {
          if (section.querySelector('[style*="sticky"], [id*="sticky"], [class*="sticky"]')) return;
          section.classList.add('rwnd-reveal');
          targets.push(section);
        });
        if (!targets.length) return;
        document.documentElement.classList.add('rwnd-reveal-enabled');

        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('rwnd-in');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

        targets.forEach(function (section, index) {
          section.style.setProperty('--rwnd-reveal-delay', (Math.min(index, 3) * 70) + 'ms');
          observer.observe(section);
        });
      })();
    </script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
