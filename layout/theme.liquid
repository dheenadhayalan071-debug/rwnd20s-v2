<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }}</title>
    {{ content_for_header }}
    <!-- Tailwind & Custom Styles -->
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  </head>
  <body class="bg-[#DCDFE5] text-[#09090B] font-mono-tech antialiased">

    <!-- Global Initial Archive Loader -->
    <div id="rwnd-archive-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-[#09090B] text-white transition-opacity duration-300">
      <div class="text-center">
        <p class="font-mono-tech text-xs tracking-widest uppercase animate-pulse">BOOTING RWND20S.SYS...</p>
      </div>
    </div>

    <!-- Global Header Section -->
    {% section 'header' %}

    <!-- Dynamic Main Content (Renders whichever modular section matches the current page template) -->
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Global Footer Section -->
    {% section 'footer' %}

    <!-- Slide-out Cart & Wishlist Drawer -->
    {% render 'cart-drawer' %}

    <!-- Welcome Offer Popup -->
    {% render 'welcome-popup' %}

    <!-- Global Toast Notification Container -->
    <div id="rwnd-toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Main JavaScript Architecture -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
