<!-- layout/theme.liquid -->
<!doctype html>
<html class="no-js" lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">

    <link
      rel="icon"
      type="image/png"
      href="{{ 'rwnd20s_favicon_32x32.png' | asset_url }}"
    >

    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {% if template.name == 'index' %}
        RWND20s &ndash; Y2K 316L Stainless Steel Hardware &amp; Audio
      {% else %}
        {{ page_title | escape }} &ndash; RWND20s
      {% endif %}
    </title>

    {% assign meta_description = page_description %}
    {% if meta_description == blank %}
      {% if template.name == 'product' %}
        {% assign meta_description = product.description | strip_html | truncate: 160 %}
      {% elsif template.name == 'collection' %}
        {% assign meta_description = collection.description | strip_html | truncate: 160 %}
      {% elsif template.name == 'page' %}
        {% assign meta_description = page.content | strip_html | truncate: 160 %}
      {% endif %}
    {% endif %}
    {% if meta_description == blank %}
      {% assign meta_description = 'Y2K accessories, 316L surgical stainless steel jewelry, watches, and Type-C audio from RWND20s. Dispatched from Madurai.' %}
    {% endif %}
    <meta name="description" content="{{ meta_description | escape }}">

    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:description" content="{{ meta_description | escape }}">
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:url" content="{{ canonical_url }}">
    {% if template.name == 'product' and product.featured_image %}
      <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    {% elsif settings.share_image %}
      <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | escape }}">
    <meta name="twitter:description" content="{{ meta_description | escape }}">
    {% if template.name == 'product' and product.featured_image %}
      <meta name="twitter:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    {% endif %}

    <!-- Brand Entity & Knowledge Graph Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "{{ shop.url }}/#website",
            "url": "{{ shop.url }}/",
            "name": "RWND20s",
            "alternateName": ["rwnd20s", "rwnd20s.", "RWND20s India"],
            "publisher": { "@id": "{{ shop.url }}/#organization" }
          },
          {
            "@type": "Organization",
            "@id": "{{ shop.url }}/#organization",
            "name": "RWND20s",
            "alternateName": ["rwnd20s", "rwnd20s."],
            "url": "{{ shop.url }}/",
            "logo": "https:{{ 'rwnd20s_favicon_32x32.png' | asset_url }}",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Madurai",
              "addressRegion": "Tamil Nadu",
              "addressCountry": "IN"
            },
            "sameAs": [
              "https://www.instagram.com/rwnd20s"
            ]
          }
        ]
      }
    </script>

    {% if template.name == 'product' %}
      {% assign ld_variant = product.selected_or_first_available_variant %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Product",
          "name": {{ product.title | json }},
          "url": {{ shop.url | append: product.url | json }},
          {% if product.featured_image %}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}
          "description": {{ product.description | strip_html | truncate: 300 | json }},
          "sku": {{ ld_variant.sku | json }},
          "brand": { "@type": "Brand", "name": "RWND20s" },
          "offers": {
            "@type": "Offer",
            "url": {{ shop.url | append: product.url | json }},
            "priceCurrency": "INR",
            "price": "{{ ld_variant.price | money_without_currency | remove: ',' }}",
            "availability": "https://schema.org/{% if ld_variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition"
          }
        }
      </script>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": {{ shop.url | json }}
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": {{ shop.url | append: product.url | json }}
            }
          ]
        }
      </script>
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com" defer></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'rwnd-pure': '#000000',
              'rwnd-rich': '#0A0A0A',
              'rwnd-soft': '#181818',
              'rwnd-red': '#FF0033',
              'rwnd-red-dark': '#CC0029',
              'rwnd-line': 'rgba(255, 255, 255, 0.08)'
            },
            fontFamily: {
              display: ['Druk Wide', 'Syne', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
              'mono-tech': ['JetBrains Mono', 'Space Mono', 'monospace']
            },
            typography: (theme) => ({
              DEFAULT: {
                css: {
                  '--tw-prose-body': theme('colors.rwnd-line'),
                  '--tw-prose-headings': '#FFFFFF',
                  '--tw-prose-lead': theme('colors.rwnd-line'),
                  '--tw-prose-links': '#FF0033',
                  '--tw-prose-bold': '#FFFFFF',
                  '--tw-prose-counters': theme('colors.rwnd-line'),
                  '--tw-prose-bullets': theme('colors.rwnd-line'),
                  '--tw-prose-hr': 'rgba(255, 255, 255, 0.08)',
                  '--tw-prose-quotes': '#FFFFFF',
                  '--tw-prose-quote-borders': '#FF0033',
                  '--tw-prose-captions': theme('colors.rwnd-line'),
                  '--tw-prose-code': '#FF0033',
                  '--tw-prose-pre-code': '#F5F5F7',
                  '--tw-prose-pre-bg': '#0A0A0A',
                  '--tw-prose-th-borders': 'rgba(255, 255, 255, 0.08)',
                  '--tw-prose-td-borders': 'rgba(255, 255, 255, 0.08)',
                  color: '#A3A7AE',
                  fontFamily: 'JetBrains Mono, monospace',
                  fontSize: '0.875rem',
                  lineHeight: '1.75',
                  maxWidth: 'none',
                  '> *:first-child': { marginTop: '0' },
                  '> *:last-child': { marginBottom: '0' },
                  h1: { fontFamily: 'Druk Wide, Syne, sans-serif', fontWeight: '800', fontSize: 'clamp(1.5rem, 4.5vw, 2.5rem)', lineHeight: '1.1', letterSpacing: '-0.02em', textTransform: 'uppercase', color: '#FFFFFF', marginTop: '0', marginBottom: '1rem' },
                  h2: { fontFamily: 'Druk Wide, Syne, sans-serif', fontWeight: '800', fontSize: 'clamp(1.25rem, 3.5vw, 1.875rem)', lineHeight: '1.2', letterSpacing: '-0.01em', textTransform: 'uppercase', color: '#FFFFFF', marginTop: '2rem', marginBottom: '0.75rem' },
                  h3: { fontFamily: 'Druk Wide, Syne, sans-serif', fontWeight: '700', fontSize: '1.125rem', lineHeight: '1.3', textTransform: 'uppercase', color: '#FFFFFF', marginTop: '1.5rem', marginBottom: '0.5rem' },
                  h4: { fontFamily: 'Druk Wide, Syne, sans-serif', fontWeight: '700', fontSize: '1rem', lineHeight: '1.4', textTransform: 'uppercase', color: '#FFFFFF', marginTop: '1.25rem', marginBottom: '0.5rem' },
                  p: { marginTop: '1rem', marginBottom: '1rem' },
                  a: { color: '#FF0033', textDecoration: 'underline', textUnderlineOffset: '2px', '&:hover': { color: '#CC0029' } },
                  strong: { color: '#FFFFFF', fontWeight: '700' },
                  code: { color: '#FF0033', fontFamily: 'JetBrains Mono, monospace', fontSize: '0.875em', backgroundColor: 'rgba(255, 0, 51, 0.1)', padding: '0.125rem 0.375rem', borderRadius: '0.25rem' },
                  pre: { backgroundColor: '#0A0A0A', border: '1px solid rgba(255, 255, 255, 0.08)', borderRadius: '0.5rem', padding: '1rem', overflowX: 'auto', marginTop: '1.5rem', marginBottom: '1.5rem' },
                  'pre code': { backgroundColor: 'transparent', padding: '0', color: '#F5F5F7', fontSize: '0.8125rem' },
                  blockquote: { borderLeft: '3px solid #FF0033', paddingLeft: '1rem', marginLeft: '0', marginRight: '0', fontStyle: 'normal', color: '#A3A7AE', marginTop: '1.5rem', marginBottom: '1.5rem' },
                  ul: { listStyleType: 'disc', paddingLeft: '1.5rem', marginTop: '1rem', marginBottom: '1rem' },
                  ol: { listStyleType: 'decimal', paddingLeft: '1.5rem', marginTop: '1rem', marginBottom: '1rem' },
                  li: { marginTop: '0.5rem', marginBottom: '0.5rem' },
                  hr: { borderColor: 'rgba(255, 255, 255, 0.08)', borderTopWidth: '1px', marginTop: '2rem', marginBottom: '2rem' },
                  img: { borderRadius: '0.5rem', marginTop: '1.5rem', marginBottom: '1.5rem' },
                  table: { fontSize: '0.8125rem', lineHeight: '1.6', width: '100%', borderCollapse: 'collapse', marginTop: '1.5rem', marginBottom: '1.5rem' },
                  th: { fontWeight: '700', textAlign: 'left', padding: '0.75rem 1rem', borderBottom: '1px solid rgba(255, 255, 255, 0.08)', color: '#FFFFFF', textTransform: 'uppercase', fontSize: '0.75rem', letterSpacing: '0.06em' },
                  td: { padding: '0.75rem 1rem', borderBottom: '1px solid rgba(255, 255, 255, 0.04)', color: '#A3A7AE' },
                }
              }
            })
          }
        },
        plugins: [
          require('tailwindcss/typography')
        ]
      };
    </script>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'rwnd-home-hero.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}

    <style>
      html,
      body {
        max-width: 100vw;
        min-height: 100%;
        overflow-x: hidden;
        background-color: var(--bg-void) !important;
        color: var(--text-high-contrast);
      }
    </style>
  </head>

  <body class="relative z-0 min-h-screen font-sans text-[#F0F0F0] antialiased selection:bg-[#FF0033] selection:text-white rwnd-ambient-bg">
    <a href="#MainContent" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[999] focus:border focus:border-[#FF0033] focus:bg-black focus:px-4 focus:py-3 focus:font-mono-tech focus:text-xs focus:uppercase focus:text-white">
      {{ 'general.accessibility.skip_to_text' | t }}
    </a>
    <!-- Ambient Background (CSS-driven to eliminate FOUC) -->
    <div class="rwnd-ambient-bg-layer rwnd-ambient-bg-image"></div>
    <div class="rwnd-ambient-bg-layer rwnd-ambient-bg-gradient"></div>

    <!-- 1. ROOT MOUNTED STICKY HEADER -->
    {% section 'header' %}

    <div id="rwnd-sys-back-bar" class="mx-auto hidden w-full max-w-7xl px-4 pt-4">
      <button type="button" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }" class="group inline-flex items-center gap-2 border border-white/10 bg-[#0A0A0A] px-4 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-[1.5px] text-white transition-all hover:border-[#FF0033]">
        <span class="text-[#FF0033]">←</span>
        <span>RETURN TO BASE</span>
      </button>
    </div>

    <!-- 2. MAIN STOREFRONT CONTENT -->
    <main id="MainContent" role="main" tabindex="-1" class="relative z-10 w-full min-h-[70vh]">
      {{ content_for_layout }}
    </main>

    <!-- 3. FOOTER -->
    <div class="relative z-10 w-full">
      {% section 'footer' %}
    </div>

    <div id="rwnd-toast-container" aria-live="polite" class="pointer-events-none fixed bottom-4 right-4 z-[130] flex w-full max-w-sm flex-col gap-2.5"></div>

    <!-- Architecture Snippets -->
    {% render 'cart-drawer' %}
    {% render 'welcome-popup' %}
    {% render 'whatsapp-floating' %}
    {% render 'size-guide-modal' %}

    <script>
      // System Return-To-Base Bar Visibility
      (() => {
        const backBar = document.getElementById('rwnd-sys-back-bar');
        if (backBar && window.location.pathname !== '/' && window.location.pathname !== '') {
          backBar.classList.remove('hidden');
        }
      })();
    </script>

    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
