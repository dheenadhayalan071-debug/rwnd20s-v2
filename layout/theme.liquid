<!-- layout/theme.liquid -->
<!doctype html>
<html class="no-js" lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
    <meta name="theme-color" content="#000000">

    <link
      rel="icon"
      type="image/png"
      href="{{ 'rwnd20s_favicon_32x32.png' | asset_url }}"
    >

    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {% if template.name == 'index' %}
        RWND20s &ndash; Y2K 316L Stainless Steel Hardware &amp; Audio
      {% else %}
        {{ page_title | escape }} &ndash; RWND20s
      {% endif %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="Y2K accessories, 316L surgical stainless steel jewelry, watches, and Type-C audio from RWND20s. Dispatched from Madurai.">
    {% endif %}

    <!-- Brand Entity & Knowledge Graph Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://rwnd20s.in/#website",
            "url": "https://rwnd20s.in/",
            "name": "RWND20s",
            "alternateName": ["rwnd20s", "rwnd20s.", "RWND20s India"],
            "publisher": { "@id": "https://rwnd20s.in/#organization" }
          },
          {
            "@type": "Organization",
            "@id": "https://rwnd20s.in/#organization",
            "name": "RWND20s",
            "alternateName": ["rwnd20s", "rwnd20s."],
            "url": "https://rwnd20s.in/",
            "logo": "https:{{ 'rwnd20s_favicon_32x32.png' | asset_url }}",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Madurai",
              "addressRegion": "Tamil Nadu",
              "addressCountry": "IN"
            },
            "sameAs": [
              "https://www.instagram.com/rwnd20s"
            ]
          }
        ]
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'rwnd-pure': '#000000',
              'rwnd-rich': '#0A0A0A',
              'rwnd-soft': '#181818',
              'rwnd-red': '#FF0033',
              'rwnd-red-dark': '#CC0029',
              'rwnd-line': 'rgba(255, 255, 255, 0.08)'
            },
            fontFamily: {
              display: ['Druk Wide', 'Syne', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
              'mono-tech': ['JetBrains Mono', 'Space Mono', 'monospace']
            }
          }
        }
      };
    </script>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}

    <style>
      html,
      body {
        max-width: 100vw;
        min-height: 100%;
        overflow-x: hidden;
        background-color: var(--bg-void) !important;
        color: var(--text-high-contrast);
      }
    </style>
  </head>

  <body class="relative z-0 min-h-screen font-sans text-[#F0F0F0] antialiased selection:bg-[#FF0033] selection:text-white">
    <!-- Ambient Mobile Fixed Background -->
    <div 
      class="fixed inset-0 pointer-events-none -z-10 bg-cover bg-center bg-no-repeat opacity-35" 
      style="background-image: url('https://cdn.shopify.com/s/files/1/0851/2746/3165/files/file_000000001b1c820ba8f9b582c6371f3f.jpg?v=1793812649');"
    ></div>
    <div class="fixed inset-0 pointer-events-none -z-10 bg-gradient-to-b from-[#000000]/85 via-transparent to-[#000000]/95"></div>

    <!-- 1. ROOT MOUNTED STICKY HEADER -->
    {% section 'header' %}

    <div id="rwnd-sys-back-bar" class="mx-auto hidden w-full max-w-7xl px-4 pt-4">
      <button type="button" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }" class="group inline-flex items-center gap-2 border border-white/10 bg-[#0A0A0A] px-4 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-[1.5px] text-white transition-all hover:border-[#FF0033]">
        <span class="text-[#FF0033]">←</span>
        <span>RETURN TO BASE</span>
      </button>
    </div>

    <!-- 2. MAIN STOREFRONT CONTENT -->
    <main id="MainContent" role="main" tabindex="-1" class="relative z-10 w-full min-h-[70vh]">
      {{ content_for_layout }}
    </main>

    <!-- 3. FOOTER -->
    <div class="relative z-10 w-full">
      {% section 'footer' %}
    </div>

    <div id="rwnd-toast-container" aria-live="polite" class="pointer-events-none fixed bottom-4 right-4 z-[130] flex w-full max-w-sm flex-col gap-2.5"></div>

    <!-- Architecture Snippets -->
    {% render 'cart-drawer' %}
    {% render 'welcome-popup' %}
    {% render 'whatsapp-floating' %}
    {% render 'size-guide-modal' %}

    <script>
      // System Return-To-Base Bar Visibility
      (() => {
        const backBar = document.getElementById('rwnd-sys-back-bar');
        if (backBar && window.location.pathname !== '/' && window.location.pathname !== '') {
          backBar.classList.remove('hidden');
        }
      })();

      // Global AJAX Cart Sync & Drawer Hook
      (() => {
        const refreshCartBadges = async () => {
          try {
            const res = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
            if (!res.ok) return;
            const cart = await res.json();
            document.querySelectorAll('[data-cart-count]').forEach((badge) => {
              badge.textContent = String(cart.item_count || 0);
            });
            const drawerCount = document.getElementById('drawer-cart-count');
            if (drawerCount) drawerCount.textContent = String(cart.item_count || 0);
          } catch (err) {
            console.error('Badge refresh error:', err);
          }
        };

        async function addFormToCart(form, button) {
          if (!form || !button || button.dataset.submitting === 'true') return;

          const origContent = button.innerHTML;
          button.dataset.submitting = 'true';
          button.disabled = true;
          button.innerHTML = '<span class="animate-pulse font-mono-tech tracking-widest text-white">[ SECURING... ]</span>';

          try {
            const res = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: new FormData(form)
            });

            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              throw new Error(err.description || 'Could not add piece.');
            }

            await res.json();
            button.innerHTML = '<span class="font-mono-tech font-bold tracking-widest text-white">✦ SECURED IN BAG</span>';
            await refreshCartBadges();
            
            if (typeof window.fetchMainCartData === 'function') {
              window.fetchMainCartData();
            }

            if (window.location.pathname !== '/cart' && typeof window.openCartDrawer === 'function') {
              window.openCartDrawer();
            }
          } catch (err) {
            console.error('Add failed:', err);
            button.innerHTML = '<span class="font-mono-tech font-bold tracking-widest text-[#FF0033]">ERROR OCCURRED</span>';
          } finally {
            window.setTimeout(() => {
              button.innerHTML = origContent;
              button.disabled = false;
              delete button.dataset.submitting;
            }, 2000);
          }
        }

        document.addEventListener('click', (e) => {
          const button = e.target.closest('button[name="add"], form[action*="/cart/add"] button[type="submit"]');
          const form = button?.closest('form[action*="/cart/add"]');
          if (!form || !button) return;
          e.preventDefault();
          e.stopImmediatePropagation();
          addFormToCart(form, button);
        }, true);
      })();
    </script>

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
