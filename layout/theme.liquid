<!-- layout/theme.liquid -->
<!doctype html>
<html class="no-js" lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title | escape }} &ndash; {{ shop.name | default: 'RWND20s' | escape }}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="Y2K accessories, 316L hardware, and Type-C audio from RWND20s. Old vibe. New you.">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'rwnd-pure': '#000000',
              'rwnd-rich': '#0A0A0A',
              'rwnd-soft': '#1A1A1A',
              'rwnd-red': '#FF0033',
              'rwnd-red-dark': '#CC0029',
              'rwnd-line': '#2A2A2F'
            },
            fontFamily: {
              display: ['Syne', 'Plus Jakarta Sans', 'sans-serif'],
              sans: ['Plus Jakarta Sans', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              'mono-tech': ['JetBrains Mono', 'monospace']
            }
          }
        }
      };
    </script>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}

    <style>
      :root {
        --black-pure: #000000;
        --black-rich: #0A0A0A;
        --black-soft: #1A1A1A;
        --red-primary: #FF0033;
        --red-dark: #CC0029;
        --red-glow: rgba(255, 0, 51, 0.3);
        --white-pure: #FFFFFF;
        --white-soft: rgba(255, 255, 255, 0.7);
        --white-muted: rgba(255, 255, 255, 0.5);
        --line: #2A2A2F;

        /* Backward-Compatibility Aliases */
        --ink: var(--black-pure);
        --surface: var(--black-rich);
        --chrome: var(--white-soft);
        --bone: var(--white-pure);
        --muted: var(--white-muted);
        --blood: var(--red-primary);
        --blood-hover: var(--red-dark);
        --moon: var(--red-glow);

        --glass-bg: rgba(10, 10, 10, 0.72);
        --glass-bg-strong: rgba(10, 10, 10, 0.92);
        --glass-border: rgba(255, 255, 255, 0.12);
        --glass-highlight: rgba(255, 255, 255, 0.05);
        --glass-blur: 16px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        border-radius: 0px !important;
      }

      html,
      body {
        max-width: 100vw;
        min-height: 100%;
        overflow-x: hidden;
        background-color: var(--black-pure) !important;
        color: var(--white-pure);
      }

      #rwnd-gateway {
        opacity: 1;
        transition: opacity 300ms ease, transform 300ms ease;
      }

      #rwnd-gateway.is-leaving {
        opacity: 0;
        pointer-events: none;
      }

      @media (prefers-reduced-motion: reduce) {
        #rwnd-gateway {
          transition: none !important;
        }
      }
    </style>
  </head>

  <body class="relative z-0 min-h-screen font-mono-tech text-[#F5F5F7] antialiased selection:bg-[#FF0033] selection:text-white">
    <!-- Stable Mobile-Friendly Fixed Background Layer -->
    <div 
      class="fixed inset-0 pointer-events-none -z-10 bg-cover bg-center bg-no-repeat opacity-40" 
      style="background-image: url('https://cdn.shopify.com/s/files/1/0851/2746/3165/files/file_000000001b1c820ba8f9b582c6371f3f.jpg?v=1793812649');"
    ></div>
    <div class="fixed inset-0 pointer-events-none -z-10 bg-gradient-to-b from-[#000000]/80 via-transparent to-[#000000]/95"></div>

    <!-- Main Content Container: Clean Immediate Rendering -->
    <main id="MainContent" role="main" tabindex="-1" class="relative z-10 w-full min-h-[70vh]">
      {{ content_for_layout }}
    </main>

    <div class="relative z-10 w-full">
      {% section 'footer' %}
    </div>

    <div id="rwnd-toast-container" aria-live="polite" class="pointer-events-none fixed bottom-4 right-4 z-[130] flex w-full max-w-sm flex-col gap-2.5"></div>

    <!-- Reusable Architecture Snippets -->
    {% render 'cart-drawer' %}
    {% render 'welcome-popup' %}
    {% render 'whatsapp-floating' %}
    {% render 'size-guide-modal' %}

    <script>
      // Gateway Dismissal & Welcome Popup Trigger Hook
      (() => {
        const gate = document.getElementById('rwnd-gateway');
        let seen = false;
        try {
          seen = sessionStorage.getItem('rwnd_gateway_seen') === 'true';
        } catch (e) {}

        const dismiss = () => {
          if (!gate || gate.dataset.dismissed === 'true') return;
          gate.dataset.dismissed = 'true';
          gate.classList.add('is-leaving');
          try {
            sessionStorage.setItem('rwnd_gateway_seen', 'true');
          } catch (e) {}
          window.setTimeout(() => {
            gate.remove();
            if (typeof window.showRwndWelcomeModal === 'function') {
              window.showRwndWelcomeModal();
            }
          }, 300);
        };

        if (seen) {
          gate?.remove();
        } else {
          document.getElementById('gateway-enter')?.addEventListener('click', dismiss);
          document.getElementById('gateway-skip')?.addEventListener('click', dismiss);
          window.setTimeout(dismiss, 3000);
        }

        const backBar = document.getElementById('rwnd-sys-back-bar');
        if (backBar && window.location.pathname !== '/' && window.location.pathname !== '') {
          backBar.classList.remove('hidden');
        }
      })();

      // Global AJAX Cart Sync & Drawer Hook
      (() => {
        const refreshCartBadges = async () => {
          try {
            const res = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
            if (!res.ok) return;
            const cart = await res.json();
            document.querySelectorAll('[data-cart-count]').forEach((badge) => {
              badge.textContent = String(cart.item_count || 0);
            });
            const drawerCount = document.getElementById('drawer-cart-count');
            if (drawerCount) drawerCount.textContent = String(cart.item_count || 0);
          } catch (err) {
            console.error('Badge refresh error:', err);
          }
        };

        async function addFormToCart(form, button) {
          if (!form || !button || button.dataset.submitting === 'true') return;

          const origContent = button.innerHTML;
          button.dataset.submitting = 'true';
          button.disabled = true;
          button.innerHTML = '<span class="animate-pulse tracking-widest text-white">[ SECURING... ]</span>';

          try {
            const res = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: new FormData(form)
            });

            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              throw new Error(err.description || 'Could not add piece.');
            }

            await res.json();
            button.innerHTML = '<span class="font-bold tracking-widest text-white">✦ SECURED IN BAG</span>';
            await refreshCartBadges();
            
            // Sync full page cart if open
            if (typeof window.fetchMainCartData === 'function') {
              window.fetchMainCartData();
            }

            // Open slide-in drawer on cart addition unless on full /cart page
            if (window.location.pathname !== '/cart' && typeof window.openCartDrawer === 'function') {
              window.openCartDrawer();
            }
          } catch (err) {
            console.error('Add failed:', err);
            button.innerHTML = '<span class="font-bold tracking-widest text-[#FF0033]">ERROR OCCURRED</span>';
          } finally {
            window.setTimeout(() => {
              button.innerHTML = origContent;
              button.disabled = false;
              delete button.dataset.submitting;
            }, 2000);
          }
        }

        document.addEventListener('click', (e) => {
          const button = e.target.closest('button[name="add"], form[action*="/cart/add"] button[type="submit"]');
          const form = button?.closest('form[action*="/cart/add"]');
          if (!form || !button) return;
          e.preventDefault();
          e.stopImmediatePropagation();
          addFormToCart(form, button);
        }, true);
      })();
    </script>

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
