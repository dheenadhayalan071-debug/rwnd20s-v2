<!-- layout/theme.liquid -->
<!doctype html>
<html class="no-js" lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
    <meta name="theme-color" content="#0A0A0C">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title | escape }} &ndash; {{ shop.name | default: 'RWND20s' | escape }}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="Y2K accessories, 316L hardware, and Type-C audio from RWND20s. Old vibe. New you.">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['Syne', 'Plus Jakarta Sans', 'sans-serif'],
              sans: ['Plus Jakarta Sans', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              'mono-tech': ['JetBrains Mono', 'monospace']
            }
          }
        }
      };
    </script>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}

    <style>
      :root {
        --ink: #0A0A0C;
        --surface: #131316;
        --line: #2A2A2F;
        --chrome: #C8CDD3;
        --bone: #F5F5F7;
        --muted: #A3A7AE;
        --blood: #FF0033;
        --blood-hover: #E0213F;
        --moon: rgba(255, 0, 51, 0.25);
        --magenta: #D946EF;

        --glass-bg: rgba(19, 19, 22, 0.68);
        --glass-bg-strong: rgba(19, 19, 22, 0.86);
        --glass-border: rgba(200, 205, 211, 0.14);
        --glass-highlight: rgba(245, 245, 247, 0.06);
        --glass-blur: 14px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        border-radius: 0px !important;
      }

      html,
      body {
        max-width: 100vw;
        min-height: 100%;
        overflow-x: hidden;
        background-color: var(--ink) !important;
        background-image: url('https://cdn.shopify.com/s/files/1/0851/2746/3165/files/file_000000001b1c820ba8f9b582c6371f3f.jpg?v=1793812649') !important;
        background-size: cover !important;
        background-position: center center !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        color: var(--bone);
      }

      .foggy-glass {
        background: rgba(19, 19, 22, 0.94) !important;
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid var(--line) !important;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9);
      }

      .foggy-glass:hover {
        border-color: var(--blood) !important;
      }

      .glass {
        background: linear-gradient(to bottom, var(--glass-highlight), transparent), var(--glass-bg);
        border: 1px solid var(--glass-border);
        box-shadow: inset 0 1px 0 var(--glass-highlight), 0 8px 24px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(var(--glass-blur)) saturate(120%);
        -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(120%);
      }

      #rwnd-gateway {
        opacity: 1;
        transition: opacity 300ms ease, transform 300ms ease;
      }

      #rwnd-gateway.is-leaving {
        opacity: 0;
        pointer-events: none;
      }

      @media (prefers-reduced-motion: reduce) {
        #rwnd-gateway {
          transition: none !important;
        }
      }
    </style>
  </head>

  <body class="relative z-0 min-h-screen font-mono-tech text-[#F5F5F7] antialiased selection:bg-[#FF0033] selection:text-[#F5F5F7]">
    <!-- Gateway Splash (3-second auto-dismiss with Skip) -->
    <div id="rwnd-gateway" class="fixed inset-0 z-[200] flex h-[100dvh] w-screen flex-col items-center justify-center bg-[#0A0A0C]/98 p-6 text-center backdrop-blur-xl" aria-label="RWND20s intro">
      <div class="relative z-10 mx-auto flex max-w-md flex-col items-center space-y-6">
        <div class="inline-flex items-center gap-2 border border-[#FF0033]/60 bg-[#131316] px-3.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#C8CDD3]">
          <span class="h-1.5 w-1.5 animate-pulse bg-[#FF0033]"></span>
          DROP 01 // DISPATCHED FROM MADURAI
        </div>

        <h1 class="font-display text-4xl font-extrabold uppercase tracking-tight text-[#F5F5F7] sm:text-6xl">
          Old vibe.<br>New you.
        </h1>

        <p class="max-w-xs text-xs text-[#A3A7AE] sm:text-sm">
          Y2K hardware, 316L chains, and Type-C nocturnal audio.
        </p>

        <div class="flex w-full flex-col gap-3 pt-2">
          <button type="button" id="gateway-enter" class="flex h-14 w-full items-center justify-center border border-[#FF0033] bg-[#FF0033] px-8 text-xs font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:bg-[#E0213F] cursor-pointer">
            ENTER THE ARCHIVE →
          </button>
          <button type="button" id="gateway-skip" class="text-xs uppercase tracking-wider text-[#A3A7AE] hover:text-[#F5F5F7] cursor-pointer py-1">
            Skip intro
          </button>
        </div>
      </div>
    </div>

    {% section 'header' %}

    <div id="rwnd-sys-back-bar" class="mx-auto hidden w-full max-w-7xl px-4 pt-6">
      <button type="button" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }" class="group inline-flex items-center gap-2 border border-[#2A2A2F] bg-[#131316] px-4 py-2 text-[10px] font-bold uppercase tracking-[0.12em] text-[#F5F5F7] transition-all hover:border-[#FF0033]">
        <span class="text-[#FF0033]">←</span>
        <span>RETURN TO BASE</span>
      </button>
    </div>

    <main id="MainContent" role="main" tabindex="-1" class="relative z-10 w-full">
      {{ content_for_layout }}
    </main>

    <div class="relative z-10 w-full">
      {% section 'footer' %}
    </div>

    <div id="rwnd-toast-container" aria-live="polite" class="pointer-events-none fixed bottom-4 right-4 z-[130] flex w-full max-w-sm flex-col gap-2.5"></div>

    {% render 'cart-drawer' %}
    {% render 'welcome-popup' %}

    <script>
      // Gateway Dismissal & Welcome Popup Trigger Hook
      (() => {
        const gate = document.getElementById('rwnd-gateway');
        let seen = false;
        try {
          seen = sessionStorage.getItem('rwnd_gateway_seen') === 'true';
        } catch (e) {}

        const dismiss = () => {
          if (!gate || gate.dataset.dismissed === 'true') return;
          gate.dataset.dismissed = 'true';
          gate.classList.add('is-leaving');
          try {
            sessionStorage.setItem('rwnd_gateway_seen', 'true');
          } catch (e) {}
          window.setTimeout(() => {
            gate.remove();
            if (typeof window.showRwndWelcomeModal === 'function') {
              window.showRwndWelcomeModal();
            }
          }, 300);
        };

        if (seen) {
          gate?.remove();
        } else {
          document.getElementById('gateway-enter')?.addEventListener('click', dismiss);
          document.getElementById('gateway-skip')?.addEventListener('click', dismiss);
          window.setTimeout(dismiss, 3000);
        }

        const backBar = document.getElementById('rwnd-sys-back-bar');
        if (backBar && window.location.pathname !== '/' && window.location.pathname !== '') {
          backBar.classList.remove('hidden');
        }
      })();

      // Global AJAX Cart Sync & Drawer Hook
      (() => {
        const refreshCartBadges = async () => {
          try {
            const res = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
            if (!res.ok) return;
            const cart = await res.json();
            document.querySelectorAll('[data-cart-count]').forEach((badge) => {
              badge.textContent = String(cart.item_count || 0);
            });
            const drawerCount = document.getElementById('drawer-cart-count');
            if (drawerCount) drawerCount.textContent = String(cart.item_count || 0);
          } catch (err) {
            console.error('Badge refresh error:', err);
          }
        };

        async function addFormToCart(form, button) {
          if (!form || !button || button.dataset.submitting === 'true') return;

          const origContent = button.innerHTML;
          button.dataset.submitting = 'true';
          button.disabled = true;
          button.innerHTML = '<span class="animate-pulse tracking-widest text-[#F5F5F7]">[ SECURING... ]</span>';

          try {
            const res = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: new FormData(form)
            });

            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              throw new Error(err.description || 'Could not add piece.');
            }

            await res.json();
            button.innerHTML = '<span class="font-bold tracking-widest text-[#F5F5F7]">✦ SECURED IN BAG</span>';
            await refreshCartBadges();
            
            // Sync full page cart if open
            if (typeof window.fetchMainCartData === 'function') {
              window.fetchMainCartData();
            }

            // Open slide-in drawer on cart addition unless on full /cart page
            if (window.location.pathname !== '/cart' && typeof window.openCartDrawer === 'function') {
              window.openCartDrawer();
            }
          } catch (err) {
            console.error('Add failed:', err);
            button.innerHTML = '<span class="font-bold tracking-widest text-[#FF0033]">ERROR OCCURRED</span>';
          } finally {
            window.setTimeout(() => {
              button.innerHTML = origContent;
              button.disabled = false;
              delete button.dataset.submitting;
            }, 2000);
          }
        }

        document.addEventListener('click', (e) => {
          const button = e.target.closest('button[name="add"], form[action*="/cart/add"] button[type="submit"]');
          const form = button?.closest('form[action*="/cart/add"]');
          if (!form || !button) return;
          e.preventDefault();
          e.stopImmediatePropagation();
          addFormToCart(form, button);
        }, true);
      })();
    </script>

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
