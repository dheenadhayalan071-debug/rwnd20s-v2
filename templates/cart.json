<!-- templates/cart.liquid or sections/main-cart.liquid -->
<div class="metallic-chrome-bg min-h-screen pt-28 pb-20 px-4 sm:px-6 lg:px-8 text-[#09090B] font-mono-tech">
  <div class="max-w-4xl mx-auto">
    
    <!-- Page Header -->
    <div class="border-b border-black/15 pb-6 flex items-end justify-between">
      <div>
        <div class="inline-flex items-center gap-1.5 rounded-full border border-black/15 bg-white px-3 py-1 text-[11px] font-bold tracking-wider uppercase shadow-xs mb-3">
          <span>✦ SECURE ARCHIVE BAG</span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight uppercase">
          YOUR HARDWARE BAG
        </h1>
      </div>
      <a href="/collections/all" class="hidden sm:inline-flex items-center gap-2 rounded-full border border-black/20 bg-white px-5 py-2.5 text-xs font-bold uppercase tracking-wider hover:bg-black hover:text-white transition cursor-pointer">
        ← CONTINUE SHOPPING
      </a>
    </div>

    <!-- Main Cart Form / Container -->
    <form action="{{ routes.cart_url }}" method="post" id="cart" class="mt-8">
      {% if cart.item_count > 0 %}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          
          <!-- Cart Items List (2 Columns) -->
          <div class="lg:col-span-2 space-y-4">
            {% for item in cart.items %}
              <div class="flex gap-4 rounded-3xl border border-black/15 bg-white p-4 sm:p-5 shadow-sm">
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" class="h-24 w-24 sm:h-28 sm:w-28 shrink-0 rounded-2xl border border-black/10 bg-[#EEF0F4] object-contain p-2">
                
                <div class="flex flex-1 flex-col justify-between">
                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <h3 class="font-display text-sm sm:text-base font-bold uppercase tracking-tight">
                        <a href="{{ item.url }}" class="hover:underline">{{ item.product.title }}</a>
                      </h3>
                      {% unless item.product.has_only_default_variant %}
                        <p class="mt-0.5 text-xs text-[#52525B]">{{ item.variant.title }}</p>
                      {% endunless %}
                    </div>
                    <!-- Remove Item Link -->
                    <a href="{{ item.url_to_remove }}" class="text-xs font-bold text-[#71717A] hover:text-[#09090B] p-1 cursor-pointer" aria-label="Remove item">
                      ✕
                    </a>
                  </div>

                  <div class="mt-4 flex items-center justify-between">
                    <!-- Quantity Adjuster -->
                    <div class="inline-flex items-center rounded-full border border-black/20 bg-[#EEF0F4] px-2 py-1">
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="h-6 w-6 flex items-center justify-center rounded-full font-bold text-xs hover:bg-white">-</a>
                      <span class="w-8 text-center text-xs font-bold">{{ item.quantity }}</span>
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="h-6 w-6 flex items-center justify-center rounded-full font-bold text-xs hover:bg-white">+</a>
                    </div>

                    <!-- Item Price -->
                    <div class="text-right">
                      <span class="text-sm sm:text-base font-bold">{{ item.final_line_price | money }}</span>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>

          <!-- Order Summary Sidebar (1 Column) -->
          <div class="lg:col-span-1">
            <div class="sticky top-28 rounded-3xl border border-black/20 bg-white p-6 shadow-md space-y-5">
              <h2 class="font-display text-lg font-extrabold uppercase border-b border-black/10 pb-3">
                SUMMARY
              </h2>

              <!-- Subtotal -->
              <div class="flex items-center justify-between text-sm">
                <span class="text-[#52525B]">Subtotal</span>
                <span class="font-bold">{{ cart.total_price | money }}</span>
              </div>

              <!-- Shipping Notice -->
              <div class="rounded-2xl border border-black/10 bg-[#EEF0F4] p-3 text-xs text-[#3F3F46]">
                {% if cart.total_price >= 99900 %}
                  <p class="font-bold text-[#09090B]">✦ FREE Express Shipping Unlocked!</p>
                {% else %}
                  <p>Add <strong class="text-[#09090B]">{{ 99900 | minus: cart.total_price | money }}</strong> more for FREE Shipping.</p>
                {% endif %}
              </div>

              <!-- Checkout Actions -->
              <div class="space-y-3 pt-2">
                <button type="submit" name="checkout" class="w-full rounded-full border border-black bg-[#09090B] py-4 text-xs font-bold tracking-widest text-white uppercase transition-colors hover:bg-white hover:text-[#09090B] cursor-pointer shadow-sm">
                  PROCEED TO SECURE CHECKOUT →
                </button>
                <a href="/collections/all" class="block w-full text-center py-2 text-xs text-[#52525B] underline hover:text-[#09090B]">
                  Continue Shopping
                </a>
              </div>
            </div>
          </div>

        </div>
      {% else %}
        <!-- Empty Cart State -->
        <div class="flex h-96 flex-col items-center justify-center text-center rounded-3xl border border-black/15 bg-white p-8">
          <p class="font-display text-xl font-bold uppercase">YOUR ARCHIVE BAG IS EMPTY</p>
          <p class="mt-2 text-xs text-[#52525B] max-w-sm">Explore our heavy 316L stainless steel hardware, pink chrome earphones, and analog chronographs.</p>
          <a href="/collections/all" class="mt-6 rounded-full border border-black bg-[#09090B] px-8 py-3.5 text-xs font-bold tracking-widest text-white uppercase transition hover:bg-white hover:text-[#09090B]">
            EXPLORE DROP 01 →
          </a>
        </div>
      {% endif %}
    </form>

  </div>
</div>
