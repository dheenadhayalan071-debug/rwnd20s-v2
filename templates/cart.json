<!-- sections/main-cart.liquid -->
<div class="relative min-h-screen pt-28 pb-20 px-4 sm:px-6 lg:px-8 text-[#E9E3D5] font-mono-tech">
  <div class="max-w-4xl mx-auto">
    
    <!-- Page Header -->
    <div class="border-b border-white/15 pb-6 flex items-end justify-between">
      <div>
        <div class="inline-flex items-center gap-1.5 rounded-full border border-red-900/50 bg-red-950/40 px-3 py-1 text-[11px] font-bold tracking-wider uppercase text-red-400 backdrop-blur-md shadow-sm mb-3">
          <span>✦ SECURE ARCHIVE BAG</span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight uppercase text-white drop-shadow-md">
          YOUR HARDWARE BAG
        </h1>
      </div>
      <a href="/collections/all" class="hidden sm:inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/60 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:border-red-600 hover:bg-red-950/40 transition cursor-pointer backdrop-blur-md">
        ← CONTINUE SHOPPING
      </a>
    </div>

    <!-- Main Cart Form / Container -->
    <form action="{{ routes.cart_url }}" method="post" id="cart" class="mt-8">
      {% if cart.item_count > 0 %}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          
          <!-- Cart Items List (2 Columns) -->
          <div class="lg:col-span-2 space-y-4">
            {% for item in cart.items %}
              <div class="flex gap-4 rounded-3xl border border-white/15 foggy-glass p-4 sm:p-5 shadow-xl backdrop-blur-md">
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" class="h-24 w-24 sm:h-28 sm:w-28 shrink-0 rounded-2xl border border-white/10 bg-black object-contain p-2 filter contrast-125">
                
                <div class="flex flex-1 flex-col justify-between">
                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <h3 class="font-display text-sm sm:text-base font-bold uppercase tracking-tight text-white">
                        <a href="{{ item.url }}" class="hover:text-red-400 transition-colors">{{ item.product.title }}</a>
                      </h3>
                      {% unless item.product.has_only_default_variant %}
                        <p class="mt-0.5 text-xs text-zinc-400">{{ item.variant.title }}</p>
                      {% endunless %}
                    </div>
                    <!-- Remove Item Link -->
                    <a href="{{ item.url_to_remove }}" class="text-xs font-bold text-zinc-500 hover:text-red-400 p-1 cursor-pointer transition-colors" aria-label="Remove item">
                      ✕
                    </a>
                  </div>

                  <div class="mt-4 flex items-center justify-between">
                    <!-- Quantity Adjuster -->
                    <div class="inline-flex items-center rounded-full border border-white/20 bg-black/60 px-2 py-1">
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="h-6 w-6 flex items-center justify-center rounded-full font-bold text-xs text-zinc-300 hover:bg-white hover:text-black transition">-</a>
                      <span class="w-8 text-center text-xs font-bold text-white">{{ item.quantity }}</span>
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="h-6 w-6 flex items-center justify-center rounded-full font-bold text-xs text-zinc-300 hover:bg-white hover:text-black transition">+</a>
                    </div>

                    <!-- Item Price -->
                    <div class="text-right">
                      <span class="text-sm sm:text-base font-bold text-white">{{ item.final_line_price | money }}</span>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>

          <!-- Order Summary Sidebar (1 Column) -->
          <div class="lg:col-span-1">
            <div class="sticky top-28 rounded-3xl border border-white/15 foggy-glass p-6 shadow-2xl space-y-5 backdrop-blur-xl">
              <h2 class="font-display text-lg font-extrabold uppercase border-b border-white/10 pb-3 text-white">
                SUMMARY
              </h2>

              <!-- Subtotal -->
              <div class="flex items-center justify-between text-xs sm:text-sm">
                <span class="text-zinc-400">Subtotal</span>
                <span class="font-bold text-white">{{ cart.total_price | money }}</span>
              </div>

              <!-- Shipping Notice -->
              <div class="rounded-2xl border border-white/10 bg-black/50 p-3 text-xs text-zinc-300">
                {% if cart.total_price >= 99900 %}
                  <p class="font-bold text-emerald-400">✦ FREE Express Shipping Unlocked!</p>
                {% else %}
                  <p>Add <strong class="text-white">{{ 99900 | minus: cart.total_price | money }}</strong> more for FREE Express Shipping.</p>
                {% endif %}
              </div>

              <!-- Checkout Actions -->
              <div class="space-y-3 pt-2">
                <button type="submit" name="checkout" class="w-full rounded-full border border-red-900/60 bg-red-950/60 py-4 text-xs font-bold tracking-widest text-red-100 uppercase transition-all shadow-[0_0_25px_rgba(220,38,38,0.4)] hover:bg-red-900 hover:text-white cursor-pointer backdrop-blur-md">
                  PROCEED TO SECURE CHECKOUT →
                </button>
                <a href="/collections/all" class="block w-full text-center py-2 text-xs text-zinc-400 underline hover:text-white transition-colors">
                  Continue Shopping
                </a>
              </div>
            </div>
          </div>

        </div>
      {% else %}
        <!-- Empty Cart State -->
        <div class="flex h-96 flex-col items-center justify-center text-center rounded-3xl border border-white/15 foggy-glass p-8 shadow-2xl backdrop-blur-xl">
          <p class="font-display text-xl font-bold uppercase text-white">YOUR ARCHIVE BAG IS EMPTY</p>
          <p class="mt-2 text-xs text-zinc-400 max-w-sm">Explore our heavy 316L stainless steel hardware, pink chrome earphones, and analog chronographs.</p>
          <a href="/collections/all" class="mt-6 rounded-full border border-red-900/60 bg-red-950/50 px-8 py-3.5 text-xs font-bold tracking-widest text-red-100 uppercase transition hover:bg-red-900 hover:text-white shadow-[0_0_20px_rgba(220,38,38,0.3)]">
            EXPLORE DROP 01 →
          </a>
        </div>
      {% endif %}
    </form>

  </div>
</div>

{% schema %}
{
  "name": "Cart Main Layout",
  "settings": []
}
{% endschema %}
