<!-- snippets/cart-drawer.liquid -->
<div id="rwnd-cart-drawer-overlay" class="fixed inset-0 z-[160] bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
  <div id="rwnd-cart-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-[#0A0A0A] border-l border-[#2A2A2F] flex flex-col justify-between translate-x-full transition-transform duration-300 font-mono-tech text-[#F5F5F7]">
    
    <!-- Drawer Header -->
    <div class="border-b border-[#2A2A2F] p-4 sm:p-6 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="font-display text-base font-extrabold uppercase tracking-tight text-white">YOUR HARDWARE BAG</span>
        <span id="drawer-cart-count" class="bg-[#FF0033] px-2 py-0.5 text-[10px] font-bold text-white">
          {{ cart.item_count }}
        </span>
      </div>
      <button type="button" id="close-cart-drawer" class="h-8 w-8 flex items-center justify-center text-[#A3A7AE] hover:text-white text-lg cursor-pointer">
        ✕
      </button>
    </div>

    <!-- Free Delivery Progress Bar -->
    <div class="border-b border-[#2A2A2F] bg-[#131316] p-3 px-4 sm:px-6 text-[10px] uppercase">
      {% assign free_shipping_threshold = 99900 %}
      {% if cart.total_price >= free_shipping_threshold %}
        <p class="text-[#FF0033] font-bold">✓ FREE SHIPPING UNLOCKED (ORDERS ₹999+)</p>
      {% else %}
        {% assign needed = free_shipping_threshold | minus: cart.total_price %}
        <p class="text-[#A3A7AE]">ADD <span class="text-white font-bold">{{ needed | money }}</span> MORE FOR FREE DELIVERY</p>
      {% endif %}
    </div>

    <!-- Drawer Item List -->
    <div id="drawer-items-list" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4">
      {% if cart.item_count == 0 %}
        <div class="flex h-full flex-col items-center justify-center text-center py-12">
          <p class="text-xs uppercase text-[#A3A7AE] tracking-widest">// BAG IS EMPTY</p>
          <a href="/collections/all" class="mt-4 border border-[#FF0033] bg-[#FF0033] px-6 py-2.5 text-xs font-bold uppercase text-white hover:bg-[#E0213F]">
            EXPLORE ARCHIVE →
          </a>
        </div>
      {% else %}
        {% for item in cart.items %}
          <div class="border border-[#2A2A2F] bg-[#131316] p-3 flex gap-3 relative group">
            <div class="aspect-square w-16 bg-[#0A0A0C] border border-[#2A2A2F] shrink-0 flex items-center justify-center overflow-hidden">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="h-full w-full object-contain">
              {% else %}
                <span class="text-[9px] text-[#A3A7AE]">NO IMG</span>
              {% endif %}
            </div>

            <div class="flex-1 flex flex-col justify-between">
              <div class="pr-5">
                <a href="{{ item.url }}" class="font-display text-xs font-bold uppercase text-white line-clamp-1 hover:text-[#FF0033]">
                  {{ item.product.title | escape }}
                </a>
                {% unless item.product.has_only_default_variant %}
                  <p class="text-[10px] text-[#A3A7AE] uppercase">{{ item.variant.title | escape }}</p>
                {% endunless %}
                <p class="text-xs font-bold text-white mt-1">{{ item.final_price | money }}</p>
              </div>

              <!-- Quantity Row -->
              <div class="flex items-center gap-2 mt-2">
                <div class="flex items-center border border-[#2A2A2F] bg-[#0A0A0C]">
                  <button type="button" onclick="updateDrawerItemQty('{{ item.key }}', {{ item.quantity | minus: 1 }})" class="h-6 w-6 flex items-center justify-center text-white hover:text-[#FF0033] text-xs cursor-pointer">−</button>
                  <span class="w-6 text-center text-[10px] font-bold text-white">{{ item.quantity }}</span>
                  <button type="button" onclick="updateDrawerItemQty('{{ item.key }}', {{ item.quantity | plus: 1 }})" class="h-6 w-6 flex items-center justify-center text-white hover:text-[#FF0033] text-xs cursor-pointer">+</button>
                </div>
              </div>
            </div>

            <!-- Remove Button -->
            <button type="button" onclick="updateDrawerItemQty('{{ item.key }}', 0)" class="absolute top-2 right-2 text-[#A3A7AE] hover:text-[#FF0033] text-xs p-1 cursor-pointer">
              ✕
            </button>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Drawer Footer & Checkout Controls -->
    {% if cart.item_count > 0 %}
      <div class="border-t border-[#2A2A2F] bg-[#131316] p-4 sm:p-6 space-y-4">
        <div class="space-y-1.5 text-xs">
          <div class="flex justify-between text-[#A3A7AE]">
            <span>SUBTOTAL:</span>
            <span class="text-white font-bold">{{ cart.items_subtotal_price | money }}</span>
          </div>
          <div class="flex justify-between text-[#A3A7AE]">
            <span>SHIPPING:</span>
            {% if cart.total_price >= 99900 %}
              <span class="text-[#FF0033] font-bold">FREE (₹999+ ✓)</span>
            {% else %}
              <span class="text-white font-bold">₹49 (FLAT)</span>
            {% endif %}
          </div>
          <div class="border-t border-[#2A2A2F] pt-2 flex justify-between text-sm font-bold text-white">
            <span>TOTAL:</span>
            <span class="text-white font-bold">{{ cart.total_price | money }}</span>
          </div>
        </div>

        <div class="space-y-2">
          <a href="/checkout" class="flex h-12 w-full items-center justify-center bg-[#FF0033] font-mono-tech text-xs font-bold uppercase tracking-wider text-white hover:bg-[#E0213F] transition-all">
            CHECKOUT →
          </a>
          <a href="/cart" class="flex h-10 w-full items-center justify-center border border-[#2A2A2F] bg-[#0A0A0C] font-mono-tech text-[10px] font-bold uppercase tracking-wider text-[#A3A7AE] hover:text-white hover:border-[#FF0033] transition-all">
            VIEW FULL CART
          </a>
        </div>

        <!-- Trust Badges Bar -->
        <div class="grid grid-cols-3 gap-1 border-t border-[#2A2A2F] pt-3 text-[9px] uppercase text-[#A3A7AE] text-center">
          <div>🛡️ Secure</div>
          <div>💰 COD Avail</div>
          <div>🚚 24h Dispatch</div>
        </div>
      </div>
    {% endif %}

  </div>
</div>

<script>
  // Drawer Open / Close / Update State Engine
  function openCartDrawer() {
    const overlay = document.getElementById('rwnd-cart-drawer-overlay');
    const drawer = document.getElementById('rwnd-cart-drawer');
    if (overlay && drawer) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      drawer.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeCartDrawer() {
    const overlay = document.getElementById('rwnd-cart-drawer-overlay');
    const drawer = document.getElementById('rwnd-cart-drawer');
    if (overlay && drawer) {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      drawer.classList.add('translate-x-full');
      document.body.style.overflow = '';
    }
  }

  document.getElementById('close-cart-drawer')?.addEventListener('click', closeCartDrawer);
  document.getElementById('rwnd-cart-drawer-overlay')?.addEventListener('click', (e) => {
    if (e.target.id === 'rwnd-cart-drawer-overlay') closeCartDrawer();
  });

  async function updateDrawerItemQty(lineKey, newQty) {
    try {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: lineKey, quantity: newQty })
      });
      window.location.reload();
    } catch (err) {
      console.error('Failed to change drawer item qty:', err);
    }
  }
</script>
