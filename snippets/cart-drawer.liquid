<!-- snippets/cart-drawer.liquid -->
<div
  id="rwnd-cart-drawer-overlay"
  class="fixed inset-0 z-[210] bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 font-mono-tech"
  aria-modal="true"
  role="dialog"
  aria-label="Shopping bag"
>
  <div
    id="rwnd-cart-drawer"
    class="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-[#0A0A0A] border-l border-[#2A2A2F] flex flex-col justify-between translate-x-full transition-transform duration-300 font-mono-tech text-[#F5F5F7] shadow-2xl"
  >

    <!-- Drawer Header -->
    <div class="border-b border-[#2A2A2F] p-4 sm:p-5 flex items-center justify-between bg-[#0A0A0A] shrink-0">
      <div class="flex items-center gap-2">
        <span class="font-display text-base font-extrabold uppercase tracking-tight text-white">YOUR HARDWARE BAG</span>
        <span id="drawer-cart-count" class="flex h-5 min-w-[20px] items-center justify-center bg-[#FF0033] px-1 text-[10px] font-bold text-white border border-black">
          {{ cart.item_count }}
        </span>
      </div>
      <button
        type="button"
        onclick="window.closeCartDrawer()"
        class="h-8 w-8 flex items-center justify-center text-[#A3A7AE] hover:text-[#FF0033] text-lg cursor-pointer"
        aria-label="Close Bag"
      >
        ✕
      </button>
    </div>

    <!-- Free Delivery Progress Bar (₹999 threshold, informational only) -->
    <div class="border-b border-[#2A2A2F] bg-[#131316] p-3 px-4 sm:px-5 text-[10px] uppercase shrink-0">
      <div id="drawer-shipping-text" class="font-bold tracking-wider">
        {% if cart.total_price >= 99900 %}
          <span class="text-[#00FF88]">✓ FREE DELIVERY THRESHOLD MET (ORDERS ₹999+)</span>
        {% else %}
          {% assign needed = 99900 | minus: cart.total_price %}
          <span class="text-[#A3A7AE]">ADD <strong class="text-white">{{ needed | money }}</strong> MORE FOR FREE DELIVERY</span>
        {% endif %}
      </div>
      <div class="mt-2 h-1.5 w-full bg-[#000000] border border-[#2A2A2F] overflow-hidden">
        {% assign prog = cart.total_price | times: 100 | divided_by: 99900 %}
        {% if prog > 100 %}{% assign prog = 100 %}{% endif %}
        <div id="drawer-shipping-bar" class="h-full bg-[#FF0033] transition-all duration-300" style="width: {{ prog }}%;"></div>
      </div>
    </div>

    <!-- Drawer Item List Container (server-rendered fallback) -->
    <div id="drawer-items-list" class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-3">
      {% if cart.item_count == 0 %}
        <div class="flex h-full flex-col items-center justify-center text-center py-12">
          <p class="text-xs uppercase text-[#A3A7AE] tracking-widest">// BAG IS EMPTY</p>
          <a href="{{ routes.all_products_collection_url }}" class="mt-4 border border-[#FF0033] bg-[#FF0033] px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-[#CC0029] transition-colors">
            EXPLORE ARCHIVE →
          </a>
        </div>
      {% else %}
        {% for item in cart.items %}
          <div class="border border-[#2A2A2F] bg-[#131316] p-3 flex gap-3 relative group">
            <div class="aspect-square w-16 bg-[#000000] border border-[#2A2A2F] shrink-0 flex items-center justify-center overflow-hidden">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="160" height="160" class="h-full w-full object-contain">
              {% else %}
                <span class="text-[9px] text-[#A3A7AE]">NO IMG</span>
              {% endif %}
            </div>

            <div class="flex-1 min-w-0 flex flex-col justify-between">
              <div class="pr-5">
                <a href="{{ item.url }}" class="font-display text-xs font-bold uppercase text-white line-clamp-1 hover:text-[#FF0033] transition-colors">
                  {{ item.product.title | escape }}
                </a>
                {% unless item.product.has_only_default_variant %}
                  <p class="text-[10px] text-[#A3A7AE] uppercase truncate mt-0.5">{{ item.variant.title | escape }}</p>
                {% endunless %}
                <p class="text-xs font-bold text-white mt-1">{{ item.final_line_price | money }}</p>
              </div>

              <div class="flex items-center gap-2 mt-2">
                <div class="flex items-center border border-[#2A2A2F] bg-[#000000]">
                  <button
                    type="button"
                    data-rwnd-line-key="{{ item.key }}"
                    data-rwnd-qty="{{ item.quantity | minus: 1 }}"
                    class="h-6 w-6 flex items-center justify-center text-white hover:bg-[#2A2A2F] hover:text-[#FF0033] text-xs cursor-pointer select-none"
                    aria-label="Decrease quantity"
                  >−</button>
                  <span class="w-6 text-center text-[10px] font-bold text-white">{{ item.quantity }}</span>
                  <button
                    type="button"
                    data-rwnd-line-key="{{ item.key }}"
                    data-rwnd-qty="{{ item.quantity | plus: 1 }}"
                    class="h-6 w-6 flex items-center justify-center text-white hover:bg-[#2A2A2F] hover:text-[#FF0033] text-xs cursor-pointer select-none"
                    aria-label="Increase quantity"
                  >+</button>
                </div>
              </div>
            </div>

            <button
              type="button"
              data-rwnd-line-key="{{ item.key }}"
              data-rwnd-qty="0"
              class="absolute top-2 right-2 text-[#A3A7AE] hover:text-[#FF0033] text-xs p-1 cursor-pointer"
              aria-label="Remove item"
            >
              ✕
            </button>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Drawer Footer -->
    <div id="drawer-footer-panel" class="border-t border-[#2A2A2F] bg-[#131316] p-4 sm:p-5 space-y-3.5 shrink-0 max-h-[64vh] overflow-y-auto {% if cart.item_count == 0 %}hidden{% endif %}">

      <!-- DISPATCH PROTOCOL SELECTOR -->
      <div class="border border-[#2A2A2F] bg-[#0A0A0A] p-2.5 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-mono-tech text-[9px] font-bold uppercase tracking-wider text-[#FF0033]">
            // DISPATCH PROTOCOL
          </span>
          <span class="font-mono-tech text-[8px] uppercase text-[#737373]">SELECT MODE</span>
        </div>

        <div class="grid grid-cols-1 gap-1.5">
          <label class="flex items-center justify-between gap-2 border border-[#2A2A2F] bg-[#131316] p-2 cursor-pointer transition-colors has-[:checked]:border-[#FF0033] has-[:checked]:bg-[#FF0033]/10">
            <div class="flex items-start gap-2">
              <input
                type="radio"
                name="rwnd_drawer_dispatch_mode"
                value="Standard Courier (PAN-India)"
                checked
                class="mt-0.5 accent-[#FF0033]"
              >
              <div>
                <span class="font-mono-tech text-[10px] font-bold uppercase text-white block">STANDARD COURIER</span>
                <span class="font-sans text-[10px] text-[#A3A7AE]">24h MDU dispatch · Rate shown at checkout</span>
              </div>
            </div>
            <span class="shrink-0 font-mono-tech text-[9px] font-bold text-white">RATE AT CHECKOUT / FREE</span>
          </label>

          <label class="flex items-center justify-between gap-2 border border-[#2A2A2F] bg-[#131316] p-2 cursor-pointer transition-colors has-[:checked]:border-[#FF0033] has-[:checked]:bg-[#FF0033]/10">
            <div class="flex items-start gap-2">
              <input
                type="radio"
                name="rwnd_drawer_dispatch_mode"
                value="Hand Delivery by Founders (Madurai Only)"
                class="mt-0.5 accent-[#FF0033]"
              >
              <div>
                <span class="font-mono-tech text-[10px] font-bold uppercase text-white block">HAND DELIVERY BY FOUNDERS</span>
                <span class="font-sans text-[10px] text-[#A3A7AE]">Personal drop-off · Madurai 625001–625020 only</span>
              </div>
            </div>
            <span class="shrink-0 border border-[#FF0033]/50 bg-[#FF0033]/15 px-1.5 py-0.5 font-mono-tech text-[9px] font-bold text-[#FF0033]">MDU · RATE AT CHECKOUT</span>
          </label>
        </div>

        <div id="rwnd-drawer-mdu-pin-wrap" class="hidden pt-1 space-y-1">
          <label for="rwnd-drawer-mdu-pin-input" class="sr-only">Madurai delivery PIN code</label>
          <input
            type="text"
            id="rwnd-drawer-mdu-pin-input"
            maxlength="6"
            inputmode="numeric"
            placeholder="ENTER MADURAI PIN (E.G. 625020)"
            class="h-9 w-full border border-white/15 bg-[#000000] px-2.5 font-mono-tech text-[11px] text-white uppercase focus:border-[#FF0033] focus:outline-none"
          >
          <p id="rwnd-drawer-mdu-pin-status" class="font-mono-tech text-[9px] uppercase text-[#A3A7AE]">
            ● ENTER 6-DIGIT MADURAI PINCODE (625001–625020)
          </p>
        </div>
      </div>

      <!-- Authoritative Shopify totals -->
      <div class="space-y-1 text-xs">
        <div class="flex justify-between text-[#A3A7AE]">
          <span>ITEMS SUBTOTAL:</span>
          <span id="drawer-subtotal-val" class="text-white font-bold">{{ cart.items_subtotal_price | money }}</span>
        </div>
        <div class="flex justify-between text-[#A3A7AE]">
          <span>SHIPPING / FEES:</span>
          <span id="drawer-shipping-val" class="text-white font-bold">CALCULATED AT CHECKOUT</span>
        </div>
        <div class="border-t border-[#2A2A2F] pt-2 flex items-baseline justify-between text-sm font-bold text-white">
          <span>TOTAL:</span>
          <span id="drawer-total-val" class="font-display text-base text-white font-extrabold">{{ cart.total_price | money }}</span>
        </div>
        <p class="pt-1 font-mono-tech text-[9px] uppercase tracking-wider text-[#737373]">
          Discounts and shipping are validated by Shopify at checkout.
        </p>
      </div>

      <!-- Checkout & Cart Actions -->
      <div class="space-y-2">
        <a
          href="/checkout"
          id="drawer-checkout-link"
          onclick="window.handleDrawerCheckout(event)"
          class="flex h-12 w-full items-center justify-center bg-[#FF0033] font-mono-tech text-xs font-bold uppercase tracking-widest text-white hover:bg-[#CC0029] transition-all cursor-pointer shadow-lg"
        >
          CHECKOUT →
        </a>
        <a
          href="{{ routes.cart_url }}"
          class="flex h-9 w-full items-center justify-center border border-[#2A2A2F] bg-[#0A0A0C] font-mono-tech text-[10px] font-bold uppercase tracking-wider text-[#A3A7AE] hover:text-white hover:border-[#FF0033] transition-all"
        >
          VIEW FULL CART
        </a>
      </div>

      <!-- Monochrome Vector Trust Badges -->
      <div class="grid grid-cols-3 gap-1 border-t border-[#2A2A2F] pt-2.5 text-[9px] uppercase text-[#A3A7AE] text-center">
        <div class="flex items-center justify-center gap-1">
          <svg class="h-3 w-3 shrink-0 stroke-[#FF0033]" viewBox="0 0 24 24" fill="none" stroke-width="1.75" aria-hidden="true">
            <path d="M12 2L3 6v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V6l-9-4z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
          <span>SECURE</span>
        </div>
        <div class="flex items-center justify-center gap-1">
          <svg class="h-3 w-3 shrink-0 stroke-[#FF0033]" viewBox="0 0 24 24" fill="none" stroke-width="1.75" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span>COD AVAIL</span>
        </div>
        <div class="flex items-center justify-center gap-1">
          <svg class="h-3 w-3 shrink-0 stroke-[#FF0033]" viewBox="0 0 24 24" fill="none" stroke-width="1.75" aria-hidden="true">
            <rect x="1" y="4" width="14" height="12"/>
            <path d="M15 8h4l3 3v5h-7V8z"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="17.5" cy="18.5" r="2.5"/>
          </svg>
          <span>24H MDU</span>
        </div>
      </div>
    </div>

  </div>
</div>
