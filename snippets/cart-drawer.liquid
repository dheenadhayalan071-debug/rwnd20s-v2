<!-- snippets/cart-drawer.liquid -->
<div
  id="rwnd-cart-drawer"
  class="fixed inset-0 z-50 hidden justify-end bg-black/60 backdrop-blur-sm"
>
  <div class="relative flex w-full max-w-md flex-col bg-[#DCDFE5] text-[#09090B] shadow-2xl h-full sm:h-auto sm:max-h-[90vh] sm:rounded-l-3xl overflow-hidden">
    
    <!-- Drawer Header -->
    <div class="flex items-center justify-between border-b border-black/15 px-6 py-4 bg-white">
      <div role="tablist" class="flex items-center gap-2">
        <button type="button" data-drawer-tab="bag" class="rounded-full border border-[#09090B] bg-white px-4 py-2 font-mono-tech text-xs font-bold tracking-wider text-[#09090B] uppercase">
          HARDWARE BAG
        </button>
        <button type="button" data-drawer-tab="wishlist" class="rounded-full border border-[#09090B]/20 bg-white/50 px-4 py-2 font-mono-tech text-xs font-bold tracking-wider text-[#3F3F46] uppercase">
          WISHLIST
        </button>
      </div>
      <button type="button" data-close-cart class="flex h-8 w-8 items-center justify-center rounded-full border border-black/20 bg-white text-xs font-bold text-[#09090B] hover:bg-black hover:text-white cursor-pointer">
        ✕
      </button>
    </div>

    <!-- Scrollable Items Area (Prevents massive gaps) -->
    <div class="flex-1 overflow-y-auto p-4 space-y-3" id="rwnd-cart-items">
      <!-- Dynamic cart items load here -->
    </div>

    <!-- Fixed Footer Summary & Checkout -->
    <div class="border-t border-black/15 bg-white p-6 shrink-0 space-y-4">
      <div id="rwnd-shipping-message" class="font-mono-tech text-xs text-[#3F3F46]">
        Free shipping unlocked on orders above ₹999
      </div>
      
      <div class="w-full bg-[#E4E7EC] h-1.5 rounded-full overflow-hidden">
        <div id="rwnd-shipping-bar" class="bg-[#09090B] h-full w-0 transition-all duration-300"></div>
      </div>

      <div class="space-y-1.5 font-mono-tech text-xs">
        <div class="flex justify-between text-[#3F3F46]">
          <span>SUBTOTAL</span>
          <span id="rwnd-cart-subtotal" class="font-bold text-[#09090B]">₹0</span>
        </div>
        <div id="rwnd-cart-discount-row" class="hidden justify-between text-emerald-700">
          <span>WELCOME PASS (5%)</span>
          <span id="rwnd-cart-discount-amount">-₹0</span>
        </div>
        <div class="flex justify-between text-sm font-bold text-[#09090B] border-t border-black/10 pt-2">
          <span>TOTAL</span>
          <span id="rwnd-cart-total">₹0</span>
        </div>
      </div>

      <form action="/checkout" method="post">
        <button
          type="submit"
          name="checkout"
          class="w-full rounded-full bg-[#09090B] py-4 font-mono-tech text-xs font-bold tracking-widest text-white uppercase shadow-lg transition-transform active:scale-[0.99] hover:bg-zinc-800 cursor-pointer"
        >
          PROCEED TO SECURE CHECKOUT →
        </button>
      </form>
    </div>

  </div>
</div>
