<!-- snippets/cart-drawer.liquid -->
<div 
  id="rwnd-cart-drawer-overlay" 
  class="fixed inset-0 z-[210] bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 font-mono-tech"
  aria-modal="true" 
  role="dialog"
>
  <div 
    id="rwnd-cart-drawer" 
    class="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-[#0A0A0A] border-l border-[#2A2A2F] flex flex-col justify-between translate-x-full transition-transform duration-300 font-mono-tech text-[#F5F5F7] shadow-2xl"
  >
    
    <!-- Drawer Header -->
    <div class="border-b border-[#2A2A2F] p-4 sm:p-5 flex items-center justify-between bg-[#0A0A0A] shrink-0">
      <div class="flex items-center gap-2">
        <span class="font-display text-base font-extrabold uppercase tracking-tight text-white">YOUR HARDWARE BAG</span>
        <span id="drawer-cart-count" class="flex h-5 min-w-[20px] items-center justify-center bg-[#FF0033] px-1 text-[10px] font-bold text-white border border-black">
          {{ cart.item_count }}
        </span>
      </div>
      <button 
        type="button" 
        onclick="window.closeCartDrawer()" 
        class="h-8 w-8 flex items-center justify-center text-[#A3A7AE] hover:text-[#FF0033] text-lg cursor-pointer"
        aria-label="Close Bag"
      >
        ✕
      </button>
    </div>

    <!-- Free Delivery Progress Bar (₹999 Threshold) -->
    <div class="border-b border-[#2A2A2F] bg-[#131316] p-3 px-4 sm:px-5 text-[10px] uppercase shrink-0">
      <div id="drawer-shipping-text" class="font-bold tracking-wider">
        {% if cart.total_price >= 99900 %}
          <span class="text-[#00FF88]">✓ FREE SHIPPING UNLOCKED (ORDERS ₹999+)</span>
        {% else %}
          {% assign needed = 99900 | minus: cart.total_price %}
          <span class="text-[#A3A7AE]">ADD <strong class="text-white">{{ needed | money }}</strong> MORE FOR FREE DELIVERY</span>
        {% endif %}
      </div>
      <div class="mt-2 h-1.5 w-full bg-[#000000] border border-[#2A2A2F] overflow-hidden">
        {% assign prog = cart.total_price | times: 100 | divided_by: 99900 %}
        {% if prog > 100 %}{% assign prog = 100 %}{% endif %}
        <div id="drawer-shipping-bar" class="h-full bg-[#FF0033] transition-all duration-300" style="width: {{ prog }}%;"></div>
      </div>
    </div>

    <!-- Drawer Item List Container -->
    <div id="drawer-items-list" class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-3">
      {% if cart.item_count == 0 %}
        <div class="flex h-full flex-col items-center justify-center text-center py-12">
          <p class="text-xs uppercase text-[#A3A7AE] tracking-widest">// BAG IS EMPTY</p>
          <a href="/collections/all" class="mt-4 border border-[#FF0033] bg-[#FF0033] px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-[#CC0029] transition-colors">
            EXPLORE ARCHIVE →
          </a>
        </div>
      {% else %}
        {% for item in cart.items %}
          <div class="border border-[#2A2A2F] bg-[#131316] p-3 flex gap-3 relative group">
            <div class="aspect-square w-16 bg-[#000000] border border-[#2A2A2F] shrink-0 flex items-center justify-center overflow-hidden">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="h-full w-full object-contain">
              {% else %}
                <span class="text-[9px] text-[#A3A7AE]">NO IMG</span>
              {% endif %}
            </div>

            <div class="flex-1 min-w-0 flex flex-col justify-between">
              <div class="pr-5">
                <a href="{{ item.url }}" class="font-display text-xs font-bold uppercase text-white line-clamp-1 hover:text-[#FF0033] transition-colors">
                  {{ item.product.title | escape }}
                </a>
                {% unless item.product.has_only_default_variant %}
                  <p class="text-[10px] text-[#A3A7AE] uppercase truncate mt-0.5">{{ item.variant.title | escape }}</p>
                {% endunless %}
                <p class="text-xs font-bold text-white mt-1">{{ item.final_line_price | money }}</p>
              </div>

              <!-- Quantity Controls (Pure AJAX, No Reload) -->
              <div class="flex items-center gap-2 mt-2">
                <div class="flex items-center border border-[#2A2A2F] bg-[#000000]">
                  <button 
                    type="button" 
                    onclick="window.updateDrawerItemQty('{{ item.key }}', {{ item.quantity | minus: 1 }})" 
                    class="h-6 w-6 flex items-center justify-center text-white hover:bg-[#2A2A2F] hover:text-[#FF0033] text-xs cursor-pointer select-none"
                    aria-label="Decrease quantity"
                  >−</button>
                  <span class="w-6 text-center text-[10px] font-bold text-white">{{ item.quantity }}</span>
                  <button 
                    type="button" 
                    onclick="window.updateDrawerItemQty('{{ item.key }}', {{ item.quantity | plus: 1 }})" 
                    class="h-6 w-6 flex items-center justify-center text-white hover:bg-[#2A2A2F] hover:text-[#FF0033] text-xs cursor-pointer select-none"
                    aria-label="Increase quantity"
                  >+</button>
                </div>
              </div>
            </div>

            <!-- Remove Button -->
            <button 
              type="button" 
              onclick="window.updateDrawerItemQty('{{ item.key }}', 0)" 
              class="absolute top-2 right-2 text-[#A3A7AE] hover:text-[#FF0033] text-xs p-1 cursor-pointer"
              aria-label="Remove item"
            >
              ✕
            </button>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Drawer Dynamic Footer -->
    <div id="drawer-footer-panel" class="border-t border-[#2A2A2F] bg-[#131316] p-4 sm:p-5 space-y-3.5 shrink-0 max-h-[62vh] overflow-y-auto {% if cart.item_count == 0 %}hidden{% endif %}">
      
      <!-- DISPATCH PROTOCOL SELECTOR (STANDARD COURIER VS. MADURAI FOUNDER HAND DELIVERY) -->
      <div class="border border-[#2A2A2F] bg-[#0A0A0A] p-2.5 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-mono-tech text-[9px] font-bold uppercase tracking-wider text-[#FF0033]">
            // DISPATCH PROTOCOL
          </span>
          <span class="font-mono-tech text-[8px] uppercase text-[#737373]">SELECT MODE</span>
        </div>

        <div class="grid grid-cols-1 gap-1.5">
          <!-- Option 1: Standard PAN-India Courier -->
          <label class="flex items-center justify-between gap-2 border border-[#2A2A2F] bg-[#131316] p-2 cursor-pointer transition-colors has-[:checked]:border-[#FF0033] has-[:checked]:bg-[#FF0033]/10">
            <div class="flex items-start gap-2">
              <input
                type="radio"
                name="rwnd_drawer_dispatch_mode"
                value="Standard Courier (PAN-India)"
                checked
                onchange="window.toggleDrawerMaduraiPin(false)"
                class="mt-0.5 accent-[#FF0033]"
              >
              <div>
                <span class="font-mono-tech text-[10px] font-bold uppercase text-white block">STANDARD COURIER</span>
                <span class="font-sans text-[10px] text-[#A3A7AE]">24h MDU dispatch · Free ₹999+</span>
              </div>
            </div>
            <span class="shrink-0 font-mono-tech text-[9px] font-bold text-white">₹49 / FREE</span>
          </label>

          <!-- Option 2: Hand Delivery by Founders (Madurai Only) -->
          <label class="flex items-center justify-between gap-2 border border-[#2A2A2F] bg-[#131316] p-2 cursor-pointer transition-colors has-[:checked]:border-[#FF0033] has-[:checked]:bg-[#FF0033]/10">
            <div class="flex items-start gap-2">
              <input
                type="radio"
                name="rwnd_drawer_dispatch_mode"
                value="Hand Delivery by Founders (Madurai Only)"
                onchange="window.toggleDrawerMaduraiPin(true)"
                class="mt-0.5 accent-[#FF0033]"
              >
              <div>
                <span class="font-mono-tech text-[10px] font-bold uppercase text-white block">HAND DELIVERY BY FOUNDERS</span>
                <span class="font-sans text-[10px] text-[#A3A7AE]">Personal drop-off · Strictly Madurai (625xxx)</span>
              </div>
            </div>
            <span class="shrink-0 border border-[#FF0033]/50 bg-[#FF0033]/15 px-1.5 py-0.5 font-mono-tech text-[8px] font-bold text-[#FF0033]">MDU ONLY</span>
          </label>
        </div>

        <!-- Madurai PIN Verification Input -->
        <div id="rwnd-drawer-mdu-pin-wrap" class="hidden pt-1 space-y-1">
          <input
            type="text"
            id="rwnd-drawer-mdu-pin-input"
            maxlength="6"
            inputmode="numeric"
            placeholder="ENTER MADURAI PIN (E.G. 625020)"
            oninput="window.validateDrawerMaduraiPin(this)"
            class="h-9 w-full border border-white/15 bg-[#000000] px-2.5 font-mono-tech text-[11px] text-white uppercase focus:border-[#FF0033] focus:outline-none"
          >
          <p id="rwnd-drawer-mdu-pin-status" class="font-mono-tech text-[9px] uppercase text-[#A3A7AE]">
            ● ENTER 6-DIGIT MADURAI PINCODE (625001–625020)
          </p>
        </div>
      </div>

      <!-- Monetary Breakdown -->
      <div class="space-y-1 text-xs">
        <div class="flex justify-between text-[#A3A7AE]">
          <span>SUBTOTAL:</span>
          <span id="drawer-subtotal-val" class="text-white font-bold">{{ cart.total_price | money }}</span>
        </div>
        <div class="flex justify-between text-[#A3A7AE]">
          <span>SHIPPING:</span>
          <span id="drawer-shipping-val">
            {% if cart.total_price >= 99900 %}
              <span class="text-[#00FF88] font-bold">FREE (₹999+ ✓)</span>
            {% else %}
              <span class="text-white font-bold">₹49 (FLAT)</span>
            {% endif %}
          </span>
        </div>
        <div class="border-t border-[#2A2A2F] pt-2 flex items-baseline justify-between text-sm font-bold text-white">
          <span>TOTAL:</span>
          <span id="drawer-total-val" class="font-display text-base text-white font-extrabold">{{ cart.total_price | money }}</span>
        </div>
      </div>

      <!-- Checkout & Cart Actions -->
      <div class="space-y-2">
        <a 
          href="/checkout" 
          id="drawer-checkout-link"
          onclick="window.handleDrawerCheckout(event)"
          class="flex h-12 w-full items-center justify-center bg-[#FF0033] font-mono-tech text-xs font-bold uppercase tracking-widest text-white hover:bg-[#CC0029] transition-all cursor-pointer shadow-lg"
        >
          CHECKOUT →
        </a>
        <a 
          href="/cart" 
          class="flex h-9 w-full items-center justify-center border border-[#2A2A2F] bg-[#0A0A0C] font-mono-tech text-[10px] font-bold uppercase tracking-wider text-[#A3A7AE] hover:text-white hover:border-[#FF0033] transition-all"
        >
          VIEW FULL CART
        </a>
      </div>

      <!-- Monochrome Vector Trust Badges -->
      <div class="grid grid-cols-3 gap-1 border-t border-[#2A2A2F] pt-2.5 text-[9px] uppercase text-[#A3A7AE] text-center">
        <div class="flex items-center justify-center gap-1">
          <svg class="h-3 w-3 shrink-0 stroke-[#FF0033]" viewBox="0 0 24 24" fill="none" stroke-width="1.75">
            <path d="M12 2L3 6v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V6l-9-4z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
          <span>SECURE</span>
        </div>
        <div class="flex items-center justify-center gap-1">
          <svg class="h-3 w-3 shrink-0 stroke-[#FF0033]" viewBox="0 0 24 24" fill="none" stroke-width="1.75">
            <rect x="2" y="5" width="20" height="14"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span>COD AVAIL</span>
        </div>
        <div class="flex items-center justify-center gap-1">
          <svg class="h-3 w-3 shrink-0 stroke-[#FF0033]" viewBox="0 0 24 24" fill="none" stroke-width="1.75">
            <rect x="1" y="4" width="14" height="12"/>
            <path d="M15 8h4l3 3v5h-7V8z"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="17.5" cy="18.5" r="2.5"/>
          </svg>
          <span>24H MDU</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  // Global Drawer Hooks
  window.openCartDrawer = function() {
    const overlay = document.getElementById('rwnd-cart-drawer-overlay');
    const drawer = document.getElementById('rwnd-cart-drawer');
    if (overlay && drawer) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      drawer.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
      window.fetchDrawerCart();
    }
  };

  window.closeCartDrawer = function() {
    const overlay = document.getElementById('rwnd-cart-drawer-overlay');
    const drawer = document.getElementById('rwnd-cart-drawer');
    if (overlay && drawer) {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      drawer.classList.add('translate-x-full');
      document.body.style.overflow = '';
    }
  };

  document.getElementById('rwnd-cart-drawer-overlay')?.addEventListener('click', (e) => {
    if (e.target.id === 'rwnd-cart-drawer-overlay') window.closeCartDrawer();
  });

  // Dispatch Protocol & Madurai PIN Handlers (Drawer)
  window.toggleDrawerMaduraiPin = function(isFounderDelivery) {
    const wrap = document.getElementById('rwnd-drawer-mdu-pin-wrap');
    const pinInput = document.getElementById('rwnd-drawer-mdu-pin-input');
    const status = document.getElementById('rwnd-drawer-mdu-pin-status');
    if (!wrap) return;

    if (isFounderDelivery) {
      wrap.classList.remove('hidden');
      pinInput?.focus();
    } else {
      wrap.classList.add('hidden');
      if (pinInput) pinInput.value = '';
      if (status) {
        status.textContent = '● ENTER 6-DIGIT MADURAI PINCODE (625001–625020)';
        status.style.color = '#A3A7AE';
      }
    }
    window.syncDrawerDispatchAttributes();
  };

  window.validateDrawerMaduraiPin = function(input, shouldSync = true) {
    const status = document.getElementById('rwnd-drawer-mdu-pin-status');
    const val = input.value.replace(/\D/g, '');
    input.value = val;

    if (val.length < 6) {
      status.textContent = '● ENTER 6-DIGIT MADURAI PINCODE (625001–625020)';
      status.style.color = '#A3A7AE';
      return false;
    }

    if (val.startsWith('625')) {
      status.textContent = '✓ MADURAI ZONE VERIFIED — FOUNDER DROP-OFF UNLOCKED';
      status.style.color = '#00FF88';
      if (shouldSync) window.syncDrawerDispatchAttributes();
      return true;
    } else {
      status.textContent = '✕ OUTSIDE MADURAI — SELECT STANDARD COURIER';
      status.style.color = '#FF0033';
      return false;
    }
  };

  window.syncDrawerDispatchAttributes = function() {
    const mode = document.querySelector('input[name="rwnd_drawer_dispatch_mode"]:checked')?.value || 'Standard Courier (PAN-India)';
    const pin = document.getElementById('rwnd-drawer-mdu-pin-input')?.value || '';
    return fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        attributes: {
          'Dispatch Mode': mode,
          'Madurai Delivery PIN': pin
        }
      })
    }).catch(() => {});
  };

  window.handleDrawerCheckout = async function(e) {
    const mode = document.querySelector('input[name="rwnd_drawer_dispatch_mode"]:checked')?.value || '';
    const pinInput = document.getElementById('rwnd-drawer-mdu-pin-input');
    const status = document.getElementById('rwnd-drawer-mdu-pin-status');

    if (mode.includes('Hand Delivery by Founders')) {
      const isValid = pinInput && window.validateDrawerMaduraiPin(pinInput, false);
      if (!isValid) {
        e.preventDefault();
        pinInput?.focus();
        if (status) {
          status.textContent = '✕ VALID 625XXX MADURAI PIN REQUIRED FOR FOUNDER DELIVERY';
          status.style.color = '#FF0033';
        }
        return;
      }
    }

    e.preventDefault();
    const targetUrl = e.currentTarget.href;
    await window.syncDrawerDispatchAttributes();
    window.location.href = targetUrl;
  };

  function restoreDrawerDispatchSelection(cart) {
    if (!cart || !cart.attributes) return;
    const savedMode = cart.attributes['Dispatch Mode'];
    const savedPin = cart.attributes['Madurai Delivery PIN'] || '';
    if (!savedMode) return;

    document.querySelectorAll('input[name="rwnd_drawer_dispatch_mode"]').forEach((r) => {
      if (r.value === savedMode) r.checked = true;
    });

    const isFounder = savedMode.includes('Hand Delivery by Founders');
    const wrap = document.getElementById('rwnd-drawer-mdu-pin-wrap');
    const pinInput = document.getElementById('rwnd-drawer-mdu-pin-input');
    if (isFounder && wrap) {
      wrap.classList.remove('hidden');
      if (pinInput && savedPin) {
        pinInput.value = savedPin;
        window.validateDrawerMaduraiPin(pinInput, false);
      }
    }
  }

  // Quantity Modifier (Zero Page Reloads)
  window.updateDrawerItemQty = async function(lineKey, newQty) {
    try {
      const res = await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: lineKey, quantity: Math.max(0, newQty) })
      });

      if (!res.ok) throw new Error('Failed to update line quantity');
      await window.fetchDrawerCart();

      // Sync full-page cart if open on /cart
      if (typeof window.fetchMainCartData === 'function') {
        window.fetchMainCartData();
      }
    } catch (err) {
      console.error('Drawer modification error:', err);
    }
  };

  // Dynamic In-Drawer Re-render Engine
  window.fetchDrawerCart = async function() {
    try {
      const res = await fetch('/cart.js', { headers: { 'Accept': 'application/json' } });
      if (!res.ok) return;
      const cart = await res.json();

      restoreDrawerDispatchSelection(cart);

      // Sync header & drawer badge counters
      document.querySelectorAll('[data-cart-count]').forEach(el => el.textContent = cart.item_count);
      const dCount = document.getElementById('drawer-cart-count');
      if (dCount) dCount.textContent = cart.item_count;

      // Update free shipping bar
      const shipBar = document.getElementById('drawer-shipping-bar');
      const shipText = document.getElementById('drawer-shipping-text');
      const shipVal = document.getElementById('drawer-shipping-val');
      const pct = Math.min(100, Math.round((cart.total_price / 99900) * 100));
      
      if (shipBar) shipBar.style.width = pct + '%';
      if (shipText) {
        if (cart.total_price >= 99900) {
          shipText.innerHTML = '<span class="text-[#00FF88]">✓ FREE SHIPPING UNLOCKED (ORDERS ₹999+)</span>';
          if (shipVal) shipVal.innerHTML = '<span class="text-[#00FF88] font-bold">FREE (₹999+ ✓)</span>';
        } else {
          const rem = ((99900 - cart.total_price) / 100).toFixed(2);
          shipText.innerHTML = `<span class="text-[#A3A7AE]">ADD <strong class="text-white">₹${rem}</strong> MORE FOR FREE DELIVERY</span>`;
          if (shipVal) shipVal.innerHTML = '<span class="text-white font-bold">₹49 (FLAT)</span>';
        }
      }

      // Update monetary totals
      const formattedTotal = '₹' + (cart.total_price / 100).toFixed(2);
      const subtotalEl = document.getElementById('drawer-subtotal-val');
      const totalEl = document.getElementById('drawer-total-val');
      if (subtotalEl) subtotalEl.textContent = formattedTotal;
      if (totalEl) totalEl.textContent = formattedTotal;

      // Check for saved welcome promo discount in storage
      const chkLink = document.getElementById('drawer-checkout-link');
      if (chkLink) {
        const hasWelcome = localStorage.getItem('rwnd_welcome_claimed') === 'true' || localStorage.getItem('rwnd_welcome_dismissed') === 'true';
        chkLink.href = hasWelcome ? '/checkout?discount=RWND10' : '/checkout';
      }

      // Toggle Footer & Build Item Markup
      const list = document.getElementById('drawer-items-list');
      const footerPanel = document.getElementById('drawer-footer-panel');

      if (cart.items.length === 0) {
        if (footerPanel) footerPanel.classList.add('hidden');
        if (list) {
          list.innerHTML = `
            <div class="flex h-full flex-col items-center justify-center text-center py-12">
              <p class="text-xs uppercase text-[#A3A7AE] tracking-widest">// BAG IS EMPTY</p>
              <a href="/collections/all" class="mt-4 border border-[#FF0033] bg-[#FF0033] px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-[#CC0029] transition-colors">
                EXPLORE ARCHIVE →
              </a>
            </div>
          `;
        }
        return;
      }

      if (footerPanel) footerPanel.classList.remove('hidden');
      if (list) {
        list.innerHTML = cart.items.map(item => `
          <div class="border border-[#2A2A2F] bg-[#131316] p-3 flex gap-3 relative group">
            <div class="aspect-square w-16 bg-[#000000] border border-[#2A2A2F] shrink-0 flex items-center justify-center overflow-hidden">
              ${item.image ? `<img src="${item.image}" alt="${item.title}" class="h-full w-full object-contain">` : `<span class="text-[9px] text-[#A3A7AE]">NO IMG</span>`}
            </div>
            <div class="flex-1 min-w-0 flex flex-col justify-between">
              <div class="pr-5">
                <a href="${item.url}" class="font-display text-xs font-bold uppercase text-white line-clamp-1 hover:text-[#FF0033] transition-colors">
                  ${item.product_title}
                </a>
                ${item.variant_title && item.variant_title !== 'Default Title' ? `<p class="text-[10px] text-[#A3A7AE] uppercase truncate mt-0.5">${item.variant_title}</p>` : ''}
                <p class="text-xs font-bold text-white mt-1">₹${(item.final_line_price / 100).toFixed(2)}</p>
              </div>
              <div class="flex items-center gap-2 mt-2">
                <div class="flex items-center border border-[#2A2A2F] bg-[#000000]">
                  <button 
                    type="button" 
                    onclick="window.updateDrawerItemQty('${item.key}', ${item.quantity - 1})" 
                    class="h-6 w-6 flex items-center justify-center text-white hover:bg-[#2A2A2F] hover:text-[#FF0033] text-xs cursor-pointer select-none"
                    aria-label="Decrease quantity"
                  >−</button>
                  <span class="w-6 text-center text-[10px] font-bold text-white">${item.quantity}</span>
                  <button 
                    type="button" 
                    onclick="window.updateDrawerItemQty('${item.key}', ${item.quantity + 1})" 
                    class="h-6 w-6 flex items-center justify-center text-white hover:bg-[#2A2A2F] hover:text-[#FF0033] text-xs cursor-pointer select-none"
                    aria-label="Increase quantity"
                  >+</button>
                </div>
              </div>
            </div>
            <button 
              type="button" 
              onclick="window.updateDrawerItemQty('${item.key}', 0)" 
              class="absolute top-2 right-2 text-[#A3A7AE] hover:text-[#FF0033] text-xs p-1 cursor-pointer"
              aria-label="Remove item"
            >
              ✕
            </button>
          </div>
        `).join('');
      }
    } catch (err) {
      console.error('Drawer sync failure:', err);
    }
  };
</script>
