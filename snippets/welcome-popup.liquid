<!-- snippets/welcome-popup.liquid -->
<div id="rwnd-welcome-modal" class="fixed inset-0 z-[210] hidden items-center justify-center bg-black/85 backdrop-blur-md p-4 transition-opacity duration-300 opacity-0">
  <div class="relative w-full max-w-md rounded-3xl border border-red-900/50 bg-[#060606] p-6 sm:p-8 text-[#E9E3D5] shadow-[0_0_50px_rgba(220,38,38,0.3)] overflow-hidden">
    
    <!-- Close Button -->
    <button type="button" onclick="closeWelcomeModal()" class="absolute top-4 right-4 h-8 w-8 rounded-full border border-white/20 bg-black/60 flex items-center justify-center text-xs font-bold text-white hover:border-red-600 cursor-pointer">
      ✕
    </button>

    <div class="space-y-4 text-center">
      <span class="inline-block rounded-full border border-red-900/60 bg-red-950/50 px-3.5 py-1 font-mono-tech text-[10px] font-bold tracking-widest text-red-400 uppercase">
        ✦ WELCOME PASS // DROP 01
      </span>

      <h3 class="font-display text-2xl font-extrabold uppercase tracking-tight text-white">
        JOIN THE INNER CIRCLE
      </h3>

      <p class="font-mono-tech text-xs text-zinc-400 leading-relaxed">
        Unlock <strong class="text-white">10% off</strong> your first hardware dispatch. Secure early access to upcoming nocturnal drops.
      </p>

      <!-- Klaviyo / Shopify Customer Email Form -->
      <form method="post" action="/contact#contact_form" id="rwnd-newsletter-form" class="space-y-3 pt-2" onsubmit="handleEmailSubmission(event)">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="contact[tags]" value="newsletter, welcome-popup-subscriber">
        
        <div class="relative">
          <input 
            type="email" 
            name="contact[email]" 
            required 
            placeholder="ENTER YOUR EMAIL..." 
            class="w-full rounded-full border border-white/20 bg-black/60 px-5 py-3.5 font-mono-tech text-xs text-white placeholder-zinc-500 uppercase focus:border-red-600 focus:outline-none"
          >
        </div>

        <button type="submit" class="w-full rounded-full border border-red-900/60 bg-red-950/60 py-3.5 font-mono-tech text-xs font-bold tracking-widest text-red-100 uppercase shadow-[0_0_20px_rgba(220,38,38,0.4)] hover:bg-red-900 hover:text-white transition-all cursor-pointer">
          CLAIM 10% OFF PASS →
        </button>
      </form>

      <p class="font-mono-tech text-[10px] text-zinc-500 uppercase tracking-wider">
        No spam. Only high-end industrial drops.
      </p>
    </div>

  </div>
</div>

<script>
  window.showRwndWelcomeModal = function() {
    // Check if user already submitted or closed it before
    if (localStorage.getItem('rwnd_welcome_claimed') === 'true') return;

    const modal = document.getElementById('rwnd-welcome-modal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => modal.classList.remove('opacity-0'), 50);
    }
  };

  function closeWelcomeModal() {
    const modal = document.getElementById('rwnd-welcome-modal');
    if (modal) {
      modal.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        localStorage.setItem('rwnd_welcome_claimed', 'true');
      }, 300);
    }
  }

  function handleEmailSubmission(e) {
    e.preventDefault();
    localStorage.setItem('rwnd_welcome_claimed', 'true');
    
    if (typeof showRwndToast === 'function') {
      showRwndToast('WELCOME PASS SECURED', 'Check your inbox for your 10% discount code.');
    }
    closeWelcomeModal();
  }
</script>
