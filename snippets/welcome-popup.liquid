<!-- snippets/welcome-popup.liquid -->
<!-- Canonical Shopify pattern: form.posted_successfully? checked INSIDE the form tag. -->
<div
  id="rwnd-welcome-modal"
  class="fixed inset-0 z-[190] flex items-center justify-center bg-black/90 p-4 backdrop-blur-xl transition-[opacity,visibility] duration-300 opacity-0 pointer-events-none invisible"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="rwnd-welcome-title"
  role="dialog"
  inert
>
  <div class="relative w-full max-w-md border border-line bg-panel p-6 sm:p-8 text-center font-mono-tech shadow-2xl">
    <button
      type="button"
      id="close-welcome-modal"
      class="absolute top-4 right-4 h-8 w-8 flex items-center justify-center text-xs font-bold text-muted hover:text-brand cursor-pointer"
      aria-label="Close"
    >
      ✕
    </button>

    <div class="inline-flex items-center gap-2 border border-brand/60 bg-surface px-3.5 py-1 text-[10px] font-bold uppercase tracking-[1.5px] text-bone">
      <span class="h-1.5 w-1.5 bg-brand animate-pulse"></span>
      DROP 01 // DISPATCHED FROM MADURAI
    </div>

    {% form 'customer', id: 'rwnd-welcome-form', class: 'mt-6' %}
      <input type="hidden" name="return_to" value="{{ canonical_url }}">
      <input type="hidden" name="contact[tags]" value="newsletter, welcome_10off, drop-01">

      {%- if form.posted_successfully? -%}
        <div id="welcome-success-state" class="border border-brand bg-surface p-5 text-center space-y-2.5">
          <h2 id="rwnd-welcome-title" class="font-display text-2xl sm:text-3xl font-extrabold uppercase tracking-tight text-white leading-none">
            DISPATCH<br>ACCESS GRANTED.
          </h2>
          <div class="inline-block bg-brand px-3 py-1 font-mono-tech text-sm font-extrabold tracking-widest text-white">
            RWND10
          </div>
          <p class="text-[10px] text-muted">Use code RWND10 at checkout. It is validated against your cart by Shopify.</p>
          <a
            href="{{ routes.all_products_collection_url }}"
            id="welcome-shop-now"
            class="mt-2 block w-full text-center font-mono-tech text-xs font-bold uppercase tracking-wider text-white underline cursor-pointer"
          >
            [ ENTER THE ARCHIVE ]
          </a>
        </div>
      {%- else -%}
        <h2 id="rwnd-welcome-title" class="font-display text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-white leading-none">
          OLD VIBE.<br>NEW YOU.
        </h2>

        <p class="mt-3 text-xs sm:text-sm text-muted leading-relaxed">
          Sign up for exclusive Drop 01 archive dispatches and restocks. New subscribers receive the RWND10 welcome code.
        </p>

        <div class="mt-5 text-left">
          <label for="rwnd-welcome-email" class="sr-only">Email address</label>
          <input
            type="email"
            id="rwnd-welcome-email"
            name="contact[email]"
            placeholder="ENTER YOUR EMAIL..."
            required
            autocomplete="email"
            class="h-12 w-full bg-surface border border-line px-4 font-mono-tech text-xs text-white uppercase focus:border-brand focus:outline-none"
          >
        </div>

        {%- if form.errors -%}
          <p class="mt-2 text-left text-[11px] uppercase font-bold text-brand" role="alert">
            ✕ {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </p>
        {%- endif -%}

        <button
          type="submit"
          id="rwnd-welcome-submit"
          class="mt-3 h-12 w-full bg-brand font-mono-tech text-xs font-bold uppercase tracking-widest text-white hover:bg-brand-dark transition-all cursor-pointer flex items-center justify-center"
        >
          CLAIM WELCOME CODE →
        </button>
      {%- endif -%}
    {% endform %}

    <p class="mt-4 text-[10px] uppercase tracking-wider text-muted">
      DISPATCHED FROM MADURAI · NO SPAM
    </p>
  </div>
</div>

<script>
  (() => {
    const modal = document.getElementById('rwnd-welcome-modal');
    const closeBtn = document.getElementById('close-welcome-modal');
    const shopNowBtn = document.getElementById('welcome-shop-now');
    const form = document.getElementById('rwnd-welcome-form');

    const CLAIMED_KEY = 'rwnd_welcome_claimed';
    const SESSION_KEY = 'rwnd_popup_session_closed';

    if (!modal) return;

    const successState = document.getElementById('welcome-success-state');
    const errorState = document.querySelector('#rwnd-welcome-form [role="alert"]');

    const showToast = (title, subtitle) => {
      if (typeof window.showRwndToast === 'function') {
        window.showRwndToast(title, subtitle || '');
      }
    };

    // Feedback fires the instant the user hits Enter — the native submit then
    // handles the page itself (including Shopify's spam-protection challenge).
    form?.addEventListener('submit', () => {
      showToast('ACCESS REQUEST SENT', 'VERIFYING YOU ARE HUMAN — YOU MAY BE ASKED TO CHECK IN');
    });

    let openTimer = null;

    const clearOpenTimer = () => {
      if (openTimer !== null) {
        window.clearTimeout(openTimer);
        openTimer = null;
      }
    };

    const openModal = () => {
      clearOpenTimer();
      modal.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
      modal.removeAttribute('aria-hidden');
      modal.removeAttribute('inert');
      if ('inert' in HTMLElement.prototype) modal.inert = false;
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    };

    const dismissModal = () => {
      clearOpenTimer();
      modal.classList.add('opacity-0', 'pointer-events-none', 'invisible');
      modal.setAttribute('aria-hidden', 'true');
      modal.setAttribute('inert', '');
      if ('inert' in HTMLElement.prototype) modal.inert = true;
      document.body.style.overflow = '';
      sessionStorage.setItem(SESSION_KEY, 'true');
    };

    const veilGone = () => {
      const veil = document.getElementById('rwnd-page-loader');
      if (!veil) {
        scheduleAutoOpen();
        return;
      }
      if (veil.classList.contains('rwnd-loader-leaving')) {
        scheduleAutoOpen();
        return;
      }
      const timeout = window.setTimeout(scheduleAutoOpen, 5000);
      const observer = new MutationObserver(() => {
        if (veil.classList.contains('rwnd-loader-leaving')) {
          window.clearTimeout(timeout);
          observer.disconnect();
          scheduleAutoOpen();
        }
      });
      observer.observe(veil, { attributes: true, attributeFilter: ['class'] });
    };

    const scheduleAutoOpen = () => {
      if (successState) {
        // Success was confirmed server-side — remember it so the popup never
        // re-offers the welcome code to this user again, and surface it.
        localStorage.setItem(CLAIMED_KEY, 'true');
        if (!sessionStorage.getItem(SESSION_KEY) && !openTimer) {
          openTimer = window.setTimeout(() => {
            openModal();
            showToast('DISPATCH ACCESS GRANTED', 'USE CODE RWND10 AT CHECKOUT');
          }, 400);
        }
        return;
      }
      if (errorState) {
        // The native submit came back with errors — tell the user what happened.
        window.setTimeout(() => {
          showToast('TRANSMISSION FAILED', 'CHECK EMAIL AND TRY AGAIN');
        }, 50);
        if (!sessionStorage.getItem(SESSION_KEY) && !openTimer) {
          openTimer = window.setTimeout(openModal, 300);
        }
        return;
      }
      if (!localStorage.getItem(CLAIMED_KEY) && !sessionStorage.getItem(SESSION_KEY) && !openTimer) {
        openTimer = window.setTimeout(openModal, 1200);
      }
    };

    // Never stack the popup on top of the page-load veil — open once it settles.
    veilGone();

    closeBtn?.addEventListener('click', dismissModal);
    shopNowBtn?.addEventListener('click', (event) => {
      localStorage.setItem(CLAIMED_KEY, 'true');
      sessionStorage.setItem(SESSION_KEY, 'true');
      // Let the native navigation to the archive proceed.
      event.preventDefault();
      showToast('ENTERING THE ARCHIVE', 'RWND10 SAVED TO THIS DEVICE');
      window.location.href = shopNowBtn.getAttribute('href') || '/collections/all';
    });
    modal.addEventListener('click', (event) => {
      if (event.target === modal) dismissModal();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
        dismissModal();
      }
    });
  })();
</script>
