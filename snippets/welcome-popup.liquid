<!-- snippets/welcome-popup.liquid -->
<div id="rwnd-welcome-modal" class="welcome-overlay" hidden aria-hidden="true"><section class="welcome-panel" role="dialog" aria-modal="true" aria-labelledby="welcome-title"><button type="button" class="welcome-close" data-close-welcome aria-label="Close">×</button><p class="eyebrow">RWND20s · Y2K</p><h2 id="welcome-title">Old vibe. New you.</h2><p>Sign up for updates from RWND20s.</p><form method="post" action="/contact#contact_form"><input type="hidden" name="form_type" value="customer"><input type="hidden" name="contact[tags]" value="newsletter"><label for="welcome-email">Email address</label><input id="welcome-email" type="email" name="contact[email]" required autocomplete="email"><button class="button-primary" type="submit">Sign up</button></form></section></div>
<script>
(()=>{const modal=document.getElementById('rwnd-welcome-modal');let shown=false;window.showRwndWelcomeModal=()=>{if(!modal||shown)return;let closed=false;try{closed=sessionStorage.getItem('rwnd_welcome_closed')==='true'}catch(e){}if(closed)return;shown=true;modal.hidden=false;modal.setAttribute('aria-hidden','false')};window.closeWelcomeModal=()=>{if(!modal)return;modal.hidden=true;modal.setAttribute('aria-hidden','true');try{sessionStorage.setItem('rwnd_welcome_closed','true')}catch(e){}};modal?.querySelector('[data-close-welcome]')?.addEventListener('click',window.closeWelcomeModal);modal?.addEventListener('click',e=>{if(e.target===modal)window.closeWelcomeModal()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!modal.hidden)window.closeWelcomeModal()});})();
</script>
