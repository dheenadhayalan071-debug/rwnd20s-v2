<!-- snippets/welcome-popup.liquid -->
<div 
  id="rwnd-welcome-modal" 
  class="fixed inset-0 z-[190] flex items-center justify-center bg-black/90 p-4 backdrop-blur-xl transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-modal="true" 
  role="dialog"
>
  <div class="relative w-full max-w-md border border-[#2A2A2F] bg-[#0A0A0A] p-6 sm:p-8 text-center font-mono-tech shadow-2xl">
    <!-- Close Button -->
    <button 
      type="button" 
      id="close-welcome-modal" 
      class="absolute top-4 right-4 text-xs font-bold text-[#A3A7AE] hover:text-[#FF0033] cursor-pointer"
      aria-label="Close"
    >
      ✕
    </button>

    <!-- Top Badge -->
    <div class="inline-flex items-center gap-2 border border-[#FF0033]/60 bg-[#131316] px-3.5 py-1 text-[10px] font-bold uppercase tracking-[1.5px] text-[#F5F5F7]">
      <span class="h-1.5 w-1.5 bg-[#FF0033] animate-pulse"></span>
      DROP 01 // DISPATCHED FROM MADURAI
    </div>

    <!-- Title -->
    <h2 class="mt-4 font-display text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-white leading-none">
      OLD VIBE.<br>NEW YOU.
    </h2>

    <!-- Subtitle -->
    <p class="mt-3 text-xs sm:text-sm text-[#A3A7AE] leading-relaxed">
      Sign up for exclusive Drop 01 archive dispatches, restocks, and claim 10% off your first hardware order.
    </p>

    <!-- Form Container -->
    <div id="welcome-form-container" class="mt-6">
      <form id="rwnd-welcome-form" class="flex flex-col gap-3 text-left">
        <input 
          type="email" 
          id="rwnd-welcome-email"
          name="email" 
          placeholder="ENTER YOUR EMAIL..." 
          required 
          autocomplete="email"
          class="h-12 w-full bg-[#131316] border border-[#2A2A2F] px-4 font-mono-tech text-xs text-white uppercase focus:border-[#FF0033] focus:outline-none"
        >
        <button 
          type="submit" 
          id="rwnd-welcome-submit"
          class="h-12 w-full bg-[#FF0033] font-mono-tech text-xs font-bold uppercase tracking-widest text-white hover:bg-[#CC0029] transition-all cursor-pointer flex items-center justify-center"
        >
          CLAIM 10% CODE →
        </button>
      </form>

      <!-- In-Modal Voucher State (Replaces Form on Submission) -->
      <div id="welcome-success-state" class="hidden border border-[#FF0033] bg-[#131316] p-4 text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-white block">DISPATCH ACCESS GRANTED</span>
        <div class="inline-block bg-[#FF0033] px-3 py-1 font-mono-tech text-sm font-extrabold tracking-widest text-white">
          RWND10
        </div>
        <p class="text-[10px] text-[#A3A7AE]">10% off applied. Code saved to your clipboard.</p>
        <button 
          type="button" 
          id="welcome-shop-now"
          class="mt-2 block w-full text-center font-mono-tech text-xs font-bold uppercase tracking-wider text-white underline cursor-pointer"
        >
          [ ENTER THE ARCHIVE ]
        </button>
      </div>
    </div>

    <!-- Footer Micro-copy -->
    <p class="mt-4 text-[10px] uppercase tracking-wider text-[#A3A7AE]">
      DISPATCHED FROM MADURAI · NO SPAM
    </p>
  </div>
</div>

<script>
  (() => {
    const modal = document.getElementById('rwnd-welcome-modal');
    const closeBtn = document.getElementById('close-welcome-modal');
    const form = document.getElementById('rwnd-welcome-form');
    const emailInput = document.getElementById('rwnd-welcome-email');
    const submitBtn = document.getElementById('rwnd-welcome-submit');
    const successState = document.getElementById('welcome-success-state');
    const shopNowBtn = document.getElementById('welcome-shop-now');

    const STORAGE_KEY = 'rwnd_welcome_claimed';

    // Show after 1.5 seconds if user has not already acted
    if (!localStorage.getItem(STORAGE_KEY)) {
      window.setTimeout(() => {
        if (!modal) return;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        document.body.style.overflow = 'hidden';
      }, 1500);
    }

    const dismissModal = () => {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      localStorage.setItem(STORAGE_KEY, 'true');
    };

    closeBtn?.addEventListener('click', dismissModal);
    shopNowBtn?.addEventListener('click', dismissModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) dismissModal();
    });

    // Intercept submit via AJAX: eliminates full-page reload & bottom anchor jumping
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const email = emailInput?.value?.trim();
      if (!email) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'SECURING CODE...';
      }

      // Mark modal dismissed immediately so it never reopens
      localStorage.setItem(STORAGE_KEY, 'true');

      // Attempt clipboard copy of discount code
      try {
        if (navigator.clipboard) {
          navigator.clipboard.writeText('RWND10');
        }
      } catch (err) {}

      // Background dispatch to Shopify customer newsletter endpoint
      try {
        const payload = new URLSearchParams();
        payload.append('form_type', 'customer');
        payload.append('utf8', '✓');
        payload.append('contact[tags]', 'newsletter, welcome_10off');
        payload.append('contact[email]', email);

        await fetch('/contact#contact_form', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
          },
          body: payload.toString()
        });
      } catch (err) {
        // Suppress network or cross-navigation exceptions
      }

      // Show in-modal voucher code without shifting or jumping the scroll position
      form.classList.add('hidden');
      if (successState) successState.classList.remove('hidden');
    });
  })();
</script>
