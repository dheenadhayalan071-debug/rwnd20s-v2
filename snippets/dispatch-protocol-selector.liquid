<!-- snippets/dispatch-protocol-selector.liquid -->
<!-- Shared dispatch protocol selector used by main-cart.liquid and cart-drawer.liquid -->
<!--
  Context variables expected:
  - dispatch_name_prefix: unique prefix for radio name (e.g., "rwnd_dispatch_mode" for main cart, "rwnd_drawer_dispatch_mode" for drawer)
  - pin_wrap_id: unique ID for the Madurai PIN wrapper (e.g., "rwnd-main-mdu-pin-wrap" for main cart, "rwnd-drawer-mdu-pin-wrap" for drawer)
  - pin_input_id: unique ID for the PIN input (e.g., "rwnd-main-mdu-pin-input" for main cart, "rwnd-drawer-mdu-pin-input" for drawer)
  - pin_status_id: unique ID for the PIN status message (e.g., "rwnd-main-mdu-pin-status" for main cart, "rwnd-drawer-mdu-pin-status" for drawer)
  - label_class: additional class for the section label (optional)
  - radio_class: additional class for radio labels (optional)
  - pin_input_class: additional class for PIN input (optional)
  - section_class: additional class for the outer section (optional)
-->

<div class="border border-[#2A2A2F] bg-[#0A0A0A] p-2.5 space-y-2 {{ section_class }}">
  <div class="flex items-center justify-between">
    <span class="font-mono-tech text-[9px] font-bold uppercase tracking-wider text-[#FF0033] {{ label_class }}">
      // DISPATCH PROTOCOL
    </span>
    <span class="font-mono-tech text-[8px] uppercase text-[#737373]">SELECT MODE</span>
  </div>

  <div class="grid grid-cols-1 gap-1.5">
    <label class="flex items-center justify-between gap-2 border border-[#2A2A2F] bg-[#131316] p-2 cursor-pointer transition-colors has-[:checked]:border-[#FF0033] has-[:checked]:bg-[#FF0033]/10 {{ radio_class }}">
      <div class="flex items-start gap-2">
        <input
          type="radio"
          name="{{ dispatch_name_prefix }}"
          value="Standard Courier (PAN-India)"
          checked
          class="mt-0.5 accent-[#FF0033]"
        >
        <div>
          <span class="font-mono-tech text-[10px] font-bold uppercase text-white block">STANDARD COURIER</span>
          <span class="font-sans text-[10px] text-[#A3A7AE]">24h MDU dispatch · Rate shown at checkout</span>
        </div>
      </div>
      <span class="shrink-0 font-mono-tech text-[9px] font-bold text-white">RATE AT CHECKOUT / FREE</span>
    </label>

    <label class="flex items-center justify-between gap-2 border border-[#2A2A2F] bg-[#131316] p-2 cursor-pointer transition-colors has-[:checked]:border-[#FF0033] has-[:checked]:bg-[#FF0033]/10 {{ radio_class }}">
      <div class="flex items-start gap-2">
        <input
          type="radio"
          name="{{ dispatch_name_prefix }}"
          value="Hand Delivery by Founders (Madurai Only)"
          class="mt-0.5 accent-[#FF0033]"
        >
        <div>
          <span class="font-mono-tech text-[10px] font-bold uppercase text-white block">HAND DELIVERY BY FOUNDERS</span>
          <span class="font-sans text-[10px] text-[#A3A7AE]">Personal drop-off · Madurai 625001–625020 only</span>
        </div>
      </div>
      <span class="shrink-0 border border-[#FF0033]/50 bg-[#FF0033]/15 px-1.5 py-0.5 font-mono-tech text-[9px] font-bold text-[#FF0033]">MDU · RATE AT CHECKOUT</span>
    </label>
  </div>

  <div id="{{ pin_wrap_id }}" class="hidden pt-1 space-y-1">
    <label for="{{ pin_input_id }}" class="sr-only">Madurai delivery PIN code</label>
    <input
      type="text"
      id="{{ pin_input_id }}"
      maxlength="6"
      inputmode="numeric"
      placeholder="ENTER MADURAI PIN (E.G. 625020)"
      class="h-9 w-full border border-white/15 bg-[#000000] px-2.5 font-mono-tech text-[11px] text-white uppercase focus:border-[#FF0033] focus:outline-none {{ pin_input_class }}"
    >
    <p id="{{ pin_status_id }}" class="font-mono-tech text-[9px] uppercase text-[#A3A7AE]">
      ● ENTER 6-DIGIT MADURAI PINCODE (625001–625020)
    </p>
  </div>
</div>