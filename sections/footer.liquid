<!-- sections/footer.liquid -->
<footer class="relative z-20 w-full border-t border-[#FF0033] bg-[#000000] text-[#F5F5F7] font-mono-tech">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    
    <!-- Top Brand & Logistics Banner -->
    <div class="border border-[#2A2A2F] bg-[#131316] p-6 sm:p-8 mb-12 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <span class="font-display text-2xl sm:text-3xl font-extrabold tracking-tighter text-[#F5F5F7]">rwnd20s.</span>
        <p class="mt-1 text-xs text-[#A3A7AE]">Old vibe. New you.</p>
        <p class="mt-0.5 text-xs font-bold text-[#FF0033] uppercase tracking-wider">Dispatched from Madurai</p>
      </div>

      <div class="border-l-2 border-[#FF0033] bg-[#0A0A0C] px-4 py-3 text-xs uppercase tracking-wider text-[#C8CDD3]">
        <span class="text-[#FF0033] font-bold">⚠ NOTICE:</span> FREE DELIVERY ON ₹999+ · DELIVERED IN 48 HOURS IN SOUTH INDIA
      </div>
    </div>

          <!-- Column 1: Drop 01 -->
      <div>
        <h3 class="mb-4 border-b border-[#2A2A2F] pb-2 text-xs font-bold uppercase tracking-[1.5px] text-[#FF0033]">
          DROP 01
        </h3>
        <ul class="space-y-2.5 text-xs text-[#A3A7AE]">
          <li><a href="/collections/all" class="hover:text-white transition-colors">Shop All Pieces</a></li>
          <li><a href="/collections/all?filter=cyber-set" class="hover:text-white transition-colors">3-Piece Set</a></li>
          <li><a href="/collections/all?filter=rings" class="hover:text-white transition-colors">Rings</a></li>
          <li><a href="/collections/all?filter=chains" class="hover:text-white transition-colors">Chains</a></li>
          <li><a href="/collections/all?filter=bracelets" class="hover:text-white transition-colors">Bracelets</a></li>
          <li><a href="/collections/all?filter=audio" class="hover:text-white transition-colors">Pink Audio</a></li>
          <li><a href="/collections/all?filter=watch" class="hover:text-white transition-colors">Timepieces (Pre-Order)</a></li>
        </ul>
      </div>

      <!-- Column 2: Policies -->
      <div>
        <h3 class="mb-4 border-b border-[#2A2A2F] pb-2 text-xs font-bold uppercase tracking-[1.5px] text-[#FF0033]">
          POLICIES
        </h3>
        <ul class="space-y-2.5 text-xs text-[#A3A7AE]">
          <li><a href="/pages/shipping" class="hover:text-white transition-colors">Shipping</a></li>
          <li><a href="/pages/returns-and-refunds" class="hover:text-white transition-colors">Returns</a></li>
          <li><a href="/pages/cancellation" class="hover:text-white transition-colors">Cancellation</a></li>
          <li><a href="/pages/pre-order-policy" class="hover:text-white transition-colors">Pre-Order</a></li>
          <li><a href="/pages/privacy-policy" class="hover:text-white transition-colors">Privacy</a></li>
          <li><a href="/pages/terms-of-service" class="hover:text-white transition-colors">Terms</a></li>
        </ul>
      </div>

      <!-- Column 3: Support -->
      <div>
        <h3 class="mb-4 border-b border-[#2A2A2F] pb-2 text-xs font-bold uppercase tracking-[1.5px] text-[#FF0033]">
          SUPPORT
        </h3>
        <ul class="space-y-2.5 text-xs text-[#A3A7AE]">
          <li><a href="/pages/contact" class="hover:text-white transition-colors">Contact</a></li>
          <li><a href="/pages/grievance-officer" class="hover:text-white transition-colors">Grievance</a></li>
          <li><a href="/pages/seller-details" class="hover:text-white transition-colors">Seller Info</a></li>
          <li><a href="/pages/faq" class="hover:text-white transition-colors">FAQ</a></li>
          <li><a href="/pages/size-guide" class="hover:text-white transition-colors">Size Guide</a></li>
          <li><a href="/pages/track-order" class="hover:text-white transition-colors">Track Order</a></li>
        </ul>
      </div>

      <!-- Column 4: Connect -->
      <div>
        <h3 class="mb-4 border-b border-[#2A2A2F] pb-2 text-xs font-bold uppercase tracking-[1.5px] text-[#FF0033]">
          CONNECT
        </h3>
        <ul class="space-y-2.5 text-xs text-[#A3A7AE]">
          <li>
            <a href="https://instagram.com/rwnd20s" target="_blank" rel="noopener" class="hover:text-white transition-colors">
              Instagram
            </a>
          </li>
          <li>
            <a href="mailto:support@rwnd20s.in" class="hover:text-white transition-colors">
              Email
            </a>
          </li>
        </ul>

        <div class="mt-6">
          <a 
            href="https://wa.me" 
            target="_blank" 
            rel="noopener" 
            class="inline-flex h-11 w-full items-center justify-center border border-[#2A2A2F] bg-[#131316] text-[11px] font-bold uppercase tracking-wider text-white transition-colors hover:border-[#FF0033] hover:text-[#FF0033]"
          >
            CHAT ON WHATSAPP →
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar: Disclaimers & Copyright -->
    <div class="mt-12 border-t border-[#2A2A2F] pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-[10px] uppercase tracking-wider text-[#A3A7AE] text-center md:text-left">
      <div>
        <p>© {{ 'now' | date: '%Y' }} RWND20S. DISPATCHED FROM MADURAI. ALL RIGHTS RESERVED.</p>
        <p class="mt-1 text-[#FF0033]">RETURNS ACCEPTED ONLY FOR DEFECTIVE OR WRONG ITEMS (48-HR WINDOW WITH UNBOXING VIDEO).</p>
      </div>

      <!-- Payment Icons Row -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 text-[9px] font-bold">
        <span class="border border-[#2A2A2F] bg-[#131316] px-2 py-1 text-white">VISA</span>
        <span class="border border-[#2A2A2F] bg-[#131316] px-2 py-1 text-white">MASTERCARD</span>
        <span class="border border-[#2A2A2F] bg-[#131316] px-2 py-1 text-white">RUPAY</span>
        <span class="border border-[#2A2A2F] bg-[#131316] px-2 py-1 text-[#FF0033]">UPI</span>
        <span class="border border-[#2A2A2F] bg-[#131316] px-2 py-1 text-white">GPAY</span>
        <span class="border border-[#2A2A2F] bg-[#131316] px-2 py-1 text-white">PHONEPE</span>
        <span class="border border-[#FF0033] bg-[#0A0A0C] px-2 py-1 text-white">COD</span>
      </div>
    </div>

  </div>
</footer>

