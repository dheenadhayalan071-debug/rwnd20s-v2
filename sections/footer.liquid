        <span class="font-mono-tech text-[10px] font-bold uppercase tracking-[0.12em] text-[#C8CDD3]">
          [ RWND20S.SYS // BRAND MANIFESTO ]
        </span>
        <span class="h-2 w-2 bg-[#C8102E] animate-pulse"></span>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-7">
          <p class="font-mono-tech text-[10px] font-bold uppercase tracking-[0.12em] text-[#C8102E]">
            04 // AFTER DARK, NO FILTER
          </p>
          <h2 class="mt-2 font-display text-2xl font-extrabold uppercase leading-tight tracking-tight text-[#F5F5F7] sm:text-4xl">
            AFTER DARK, NO RULES.
          </h2>
