<!-- sections/footer.liquid -->
<section id="about" class="relative z-10 mt-10 overflow-hidden border-t border-[#2A2A2F] sm:mt-16 font-mono-tech text-[#F5F5F7]">
  <!-- Brand Manifesto Block -->
  <div class="relative z-10 mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <div class="border border-[#2A2A2F] bg-[#131316] p-6 sm:p-10 lg:p-12 rounded-none">
