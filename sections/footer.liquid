        <div class="z-10 shrink-0 border-r border-white/15 bg-[#111111] px-4 py-1 text-[10px] font-bold tracking-widest text-red-500 uppercase shadow-[5px_0_15px_rgba(0,0,0,0.8)]">
          LIMITED DROPS
        </div>
        <div class="overflow-hidden whitespace-nowrap">
          <div class="flex items-center gap-8 pl-6 animate-[ticker_30s_linear_infinite]">
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-zinc-400 uppercase">
              <span class="text-red-700">✦</span> LIMITED DROP 01 // 3-PIECE Y2K CYBER SET — <span class="text-white">₹1,199</span> (STASH ₹2,894 · SAVE ₹1,695)
            </span>
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-zinc-400 uppercase">
              <span class="text-red-700">✦</span> LIMITED DROP // PINK CHROME WIRED EARPHONES (TYPE-C) — <span class="text-white">₹999</span> (STASH ₹2,998)
            </span>
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-zinc-400 uppercase">
              <span class="text-red-700">✦</span> BESTSELLER // CYBER SIGNET RING — <span class="text-white">₹349</span> (STASH ₹998 · 316L STAINLESS STEEL)
            </span>
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-zinc-400 uppercase">
              <span class="text-red-700">✦</span> CORE ARCHIVE // HEAVY CHAIN + PENDANT — <span class="text-white">₹549</span> (STASH ₹1,598)
            </span>
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-zinc-400 uppercase">
              <span class="text-red-700">✦</span> CORE ARCHIVE // INDUSTRIAL CHAIN BRACELET — <span class="text-white">₹549</span> (STASH ₹1,598 · ₹0 COD ADVANCE)
            </span>
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-zinc-400 uppercase">
              <span class="text-red-700">✦</span> PHASE 2 // Y2K ANALOG-DIGITAL WATCH — <span class="text-white">₹1,999 PREPAID</span> (STASH ₹4,998)
            </span>
          </div>
        </div>
      </div>
    </div>
    <style>
      @keyframes ticker {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .animate-\\[ticker_30s_linear_infinite\\] {
        animation: ticker 30s linear infinite;
      }
    </style>
  </footer>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    setInterval(() => {
      const counter = document.getElementById('rwnd-retro-uptime');
      if(!counter) return;
      let text = counter.innerText;
      let parts = text.match(/\d+/g);
      if(parts && parts.length >= 4) {
        let offset = parts.length - 4;
        let s = parseInt(parts[offset+3]) + 1;
        let m = parseInt(parts[offset+2]);
        let h = parseInt(parts[offset+1]);
        let d = parseInt(parts[offset]);
        if(s > 59) { s = 0; m++; }
        if(m > 59) { m = 0; h++; }
        if(h > 23) { h = 0; d++; }
        counter.innerText = `SYSTEM UPTIME: ${d}D ${h.toString().padStart(2,'0')}H ${m.toString().padStart(2,'0')}M ${s.toString().padStart(2,'0')}S`;
      }
    }, 1000);
  });
</script>

{% schema %}
{
  "name": "Footer & Retro Terminal",
  "settings": [
    {
      "type": "text",
      "id": "dispatch_city",
      "label": "Dispatch Studio City",
      "default": "Madurai, Tamil Nadu"
    }
  ]
}
{% endschema %}
