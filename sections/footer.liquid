<!-- sections/footer.liquid -->
<section id="about" class="metallic-chrome-bg border-t border-black/15">
  <!-- Brand Manifesto & FAQ -->
  <div class="mx-auto max-w-[1280px] px-4 py-12 sm:px-6 lg:px-8">
    <div class="overflow-hidden rounded-3xl border border-black/20 bg-white shadow-md">
      <div class="retro-window-bar flex items-center justify-between border-b border-black/15 px-5 py-2.5">
        <span class="font-mono-tech text-[11px] font-bold tracking-widest text-[#09090B] uppercase">
          [ ⏪ RWND20S.SYS // BRAND MANIFESTO ]
        </span>
        <span class="font-mono-tech text-[10px] font-semibold text-[#3F3F46] uppercase">
          METALLIC CHROME · BLACK &amp; WHITE EDITION
        </span>
      </div>

      <div class="grid grid-cols-1 gap-8 p-6 sm:p-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="font-mono-tech text-xs font-bold tracking-widest text-[#3F3F46] uppercase">
            04 · ENGINEERED FOR THE MILLENNIUM REWIND
          </p>
          <h2 class="mt-2 font-display text-2xl font-extrabold tracking-tight text-[#09090B] uppercase sm:text-4xl">
            HEAVY METAL HARDWARE. ZERO FAST-FASHION TRINKETS.
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-[#27272A]">
            Born from an obsession with late-90s and early-2000s industrial object design, <strong class="text-[#09090B]">rwnd20s.</strong> builds heavy 316L stainless steel signet rings, pendant chains, link bracelets, pink chrome Type-C wired earphones, and brushed steel analog-digital chronographs.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-3.5 lg:col-span-5">
          <div class="rounded-2xl border border-black/15 bg-[#EEF0F4] p-4">
            <span class="font-mono-tech text-xl font-bold text-[#09090B]">316L</span>
            <p class="mt-1 text-xs text-[#3F3F46]">Surgical-Grade Stainless Steel</p>
          </div>
          <div class="rounded-2xl border border-black/15 bg-[#EEF0F4] p-4">
            <span class="font-mono-tech text-xl font-bold text-[#09090B]">TYPE-C</span>
            <p class="mt-1 text-xs text-[#3F3F46]">Pink Chrome Wired Earphones + Case</p>
          </div>
          <div class="rounded-2xl border border-black/15 bg-[#EEF0F4] p-4">
            <span class="font-mono-tech text-xl font-bold text-[#09090B]">SAVE ₹1,695</span>
            <p class="mt-1 text-xs text-[#3F3F46]">3-Piece Y2K Cyber Set Bundle</p>
          </div>
          <div class="rounded-2xl border border-black/15 bg-[#EEF0F4] p-4">
            <span class="font-mono-tech text-xl font-bold text-[#09090B]">₹999+</span>
            <p class="mt-1 text-xs text-[#3F3F46]">Free Express Shipping Across India</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Columns -->
  <footer class="border-t border-black/15 bg-white/60">
    <div class="mx-auto max-w-[1280px] px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <span class="font-display text-2xl font-extrabold text-[#09090B]">
            {{ settings.brand_name | default: 'rwnd20s.' }}
          </span>
          <p class="mt-3 max-w-sm text-xs leading-relaxed text-[#27272A]">
            Heavy 316L stainless steel hardware, pink chrome Type-C wired earphones, and analog-digital chronographs crafted in limited numbered batches.
          </p>
          <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-black/15 bg-white px-3.5 py-1.5 font-mono-tech text-[11px] font-bold text-[#09090B] shadow-2xs">
            <span>HQ &amp; DISPATCH: {{ section.settings.dispatch_city | upcase }}</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:col-span-7">
          <div>
            <h3 class="font-mono-tech text-xs font-bold tracking-wider text-[#09090B] uppercase">DROP 01 HARDWARE</h3>
            <ul class="mt-3 space-y-2 text-xs text-[#27272A]">
              <li><a href="#shop" class="hover:text-[#09090B]">3-Piece Y2K Cyber Set</a></li>
              <li><a href="#shop" class="hover:text-[#09090B]">Pink Chrome Wired Earphones</a></li>
              <li><a href="#shop" class="hover:text-[#09090B]">Cyber Signet Ring</a></li>
              <li><a href="#shop" class="hover:text-[#09090B]">Heavy Chain + Pendant</a></li>
              <li><a href="#shop" class="hover:text-[#09090B]">Chain Bracelet</a></li>
            </ul>
          </div>

          <div>
            <h3 class="font-mono-tech text-xs font-bold tracking-wider text-[#09090B] uppercase">ARCHIVE LEDGER</h3>
            <ul class="mt-3 space-y-2 text-xs text-[#27272A]">
              <li><a href="#testimonials" class="hover:text-[#09090B]">Collector Cardholders</a></li>
              <li><a href="#about" class="hover:text-[#09090B]">316L Steel Guarantee</a></li>
              <li><a href="#shop" class="hover:text-[#09090B]">48-Hour Unboxing Policy</a></li>
            </ul>
          </div>

          <div>
            <h3 class="font-mono-tech text-xs font-bold tracking-wider text-[#09090B] uppercase">STUDIO &amp; DISPATCH</h3>
            <ul class="mt-3 space-y-2 text-xs text-[#27272A]">
              <li class="font-semibold text-[#09090B]">{{ section.settings.dispatch_city }}</li>
              <li>Free Shipping Above ₹999</li>
              <li>Cash on Delivery (₹0 Advance)</li>
              <li>24–48h Express Pan-India Dispatch</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-black/15 pt-6 text-xs text-[#3F3F46] sm:flex-row">
        <p>© {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: 'rwnd20s.' }} All rights reserved.</p>
        <p class="font-mono-tech text-[11px] font-semibold text-[#09090B]">
          METALLIC CHROME HARDWARE ARCHIVE · {{ section.settings.dispatch_city | upcase }}
        </p>
      </div>
    </div>

    <!-- DOS-Style Retro Status Footer Bar with Blinking Terminal Block Cursor -->
    <div
      data-testid="retro-status-footer"
      class="retro-scanlines metallic-chrome-panel relative overflow-hidden border-t border-black/20 font-mono-tech text-[11px] text-[#09090B]"
    >
      <div class="mx-auto flex max-w-[1280px] flex-col justify-between gap-2 border-b border-black/15 px-4 py-2.5 sm:flex-row sm:items-center sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 rounded border border-black/20 bg-white px-2 py-0.5 text-[10px] font-bold tracking-widest text-[#09090B] uppercase shadow-2xs">
            <span class="h-1.5 w-1.5 rounded-full bg-[#09090B] animate-pulse"></span>
            DOS // TERMINAL v2.04
          </span>
          <span class="font-semibold tracking-wider text-[#09090B]">
            C:\RWND20S\ARCHIVE.EXE&gt; STATUS --NODE=MADURAI_TN
            <span
              data-testid="terminal-block-cursor"
              aria-hidden="true"
              class="terminal-block-cursor ml-1"
            >█</span>
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-4 text-[10px] tracking-widest text-[#27272A] uppercase">
          <span>SERVER STATUS: <strong class="text-[#09090B]">ONLINE (200 OK)</strong></span>
          <span id="rwnd-retro-uptime">SYSTEM UPTIME: 2D 00H 00M 42S</span>
          <span class="text-[#09090B]">LOC: {{ section.settings.dispatch_city | upcase }}</span>
        </div>
      </div>

      <!-- Scrolling Ticker of Recent Limited Drops (Doubled Stash Prices) -->
      <div class="relative flex items-center overflow-hidden bg-white/70 py-2">
        <div class="z-10 shrink-0 border-r border-black/20 bg-white px-3 py-0.5 text-[10px] font-bold tracking-widest text-[#09090B] uppercase">
          LIMITED DROPS
        </div>
        <div class="overflow-hidden whitespace-nowrap">
          <div class="retro-ticker-track items-center gap-8 pl-6">
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-[#09090B] uppercase">
              ✦ LIMITED DROP 01 // 3-PIECE Y2K CYBER SET — ₹1,199 (STASH ₹2,894 · SAVE ₹1,695)
            </span>
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-[#09090B] uppercase">
              ✦ LIMITED DROP // PINK CHROME WIRED EARPHONES (TYPE-C) — ₹999 (STASH ₹2,998)
            </span>
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-[#09090B] uppercase">
              ✦ BESTSELLER // CYBER SIGNET RING — ₹349 (STASH ₹998 · 316L STAINLESS STEEL)
            </span>
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-[#09090B] uppercase">
              ✦ CORE ARCHIVE // HEAVY CHAIN + PENDANT — ₹549 (STASH ₹1,598)
            </span>
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-[#09090B] uppercase">
              ✦ CORE ARCHIVE // INDUSTRIAL CHAIN BRACELET — ₹549 (STASH ₹1,598 · ₹0 COD ADVANCE)
            </span>
            <span class="inline-flex items-center gap-2 text-[11px] tracking-wider text-[#09090B] uppercase">
              ✦ PHASE 2 // Y2K ANALOG-DIGITAL WATCH — ₹1,999 PREPAID (STASH ₹4,998)
            </span>
          </div>
        </div>
      </div>
    </div>
  </footer>
</section>

{% schema %}
{
  "name": "Footer & Retro Terminal",
  "settings": [
    {
      "type": "text",
      "id": "dispatch_city",
      "label": "Dispatch Studio City",
      "default": "Madurai, Tamil Nadu"
    }
  ]
}
{% endschema %}
