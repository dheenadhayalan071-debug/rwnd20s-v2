        <div class="grid grid-cols-2 gap-3 lg:col-span-5">
          <div class="border border-[#2A2A2F] bg-[#0A0A0C] p-4 rounded-none">
            <span class="font-mono-tech text-base sm:text-xl font-bold text-[#F5F5F7]">316L</span>
            <p class="mt-1 text-[10px] text-[#A3A7AE] uppercase tracking-wider">Stainless Steel Chains</p>
          </div>
          <div class="border border-[#2A2A2F] bg-[#0A0A0C] p-4 rounded-none">
            <span class="font-mono-tech text-base sm:text-xl font-bold text-[#F5F5F7]">TYPE-C</span>
            <p class="mt-1 text-[10px] text-[#A3A7AE] uppercase tracking-wider">Pink Chrome Audio</p>
          </div>
          <div class="border border-[#C8102E]/60 bg-[#C8102E]/10 p-4 rounded-none">
