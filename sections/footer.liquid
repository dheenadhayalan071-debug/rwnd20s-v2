<!-- sections/footer.liquid -->
{%- comment -%} Guarded destinations: fall back to the catalogue/contact desk if a handle is missing. {%- endcomment -%}
{% assign all_url = routes.all_products_collection_url %}
{% assign rings_url = collections['rings'].url | default: all_url %}
{% assign chains_url = collections['chains'].url | default: collections['necklaces'].url | default: all_url %}
{% assign bracelets_url = collections['bracelets'].url | default: all_url %}
{% assign earphones_url = collections['earphones'].url | default: all_url %}
{% assign watches_url = collections['watches'].url | default: all_url %}
{% assign cyber_set_url = all_products['3-piece-y2k-cyber-set'].url | default: all_url %}
{% assign contact_url = pages['contact'].url | default: all_url %}
{% assign shipping_url = pages['shipping'].url | default: contact_url %}
{% assign returns_url = pages['returns'].url | default: contact_url %}
{% assign cancellation_url = pages['cancellation'].url | default: contact_url %}
{% assign preorder_url = pages['pre-order'].url | default: contact_url %}
{% assign privacy_url = pages['privacy-policy'].url | default: contact_url %}
{% assign terms_url = pages['terms'].url | default: contact_url %}
{% assign faq_url = pages['faq'].url | default: contact_url %}
{% assign size_guide_url = pages['size-guide'].url | default: contact_url %}
{% assign track_order_url = pages['track-order'].url | default: contact_url %}
<footer class="w-full border-t border-line bg-panel px-4 py-10 font-mono-tech text-bone sm:px-6 sm:py-16 lg:px-8">
  <div class="mx-auto max-w-7xl">
    
    <!-- Top Notice Box -->
    <div class="border-l-2 border-brand bg-surface p-4 text-xs mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <div>
        <p class="font-bold text-white uppercase">⚠ NOTICE: FREE DELIVERY ON ORDERS ₹999+ · DELIVERED IN 48 HOURS IN SOUTH INDIA</p>
        <p class="text-[11px] text-muted mt-0.5">Dispatched directly from our Madurai logistics facility.</p>
      </div>
      <a href="{{ all_url }}" class="text-[10px] font-bold text-brand uppercase hover:underline shrink-0">ORDER ARCHIVE →</a>
    </div>

    <!-- Native Shopify Customer Email Dispatch Strip -->
    <div class="border border-line bg-surface p-5 sm:p-6 mb-10 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-[1.5px] text-brand block">// DROP 01 ARCHIVE ALERTS</span>
        <p class="font-display text-base sm:text-lg font-extrabold uppercase text-white mt-0.5">
          JOIN THE DISPATCH LIST · GET 10% OFF (RWND10)
        </p>
      </div>

      <div class="w-full lg:max-w-md">
        {% form 'customer', id: 'rwnd-footer-newsletter', class: 'w-full' %}
          <input type="hidden" name="contact[tags]" value="newsletter, footer-dispatch, drop-01">

          {% if form.posted_successfully? %}
            <div class="border border-success bg-card px-4 py-3 text-xs font-bold uppercase text-success">
              ✓ SUBSCRIBED · USE CODE <span class="text-white">RWND10</span> AT CHECKOUT
            </div>
          {% else %}
            <div class="flex flex-col sm:flex-row gap-2">
              <input
                type="email"
                name="contact[email]"
                required
                placeholder="ENTER YOUR EMAIL..."
                autocomplete="email"
                aria-label="Email address"
                class="h-11 flex-1 border border-line bg-card px-3.5 text-xs text-white uppercase placeholder-muted focus:border-brand focus:outline-none"
              >
              <button
                type="submit"
                class="h-11 px-5 bg-brand text-xs font-bold uppercase tracking-widest text-white hover:bg-brand-dark transition-colors cursor-pointer shrink-0"
              >
                SUBSCRIBE →
              </button>
            </div>
            {% if form.errors %}
              <p class="mt-1.5 text-[10px] font-bold uppercase text-brand">
                ✕ {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
              </p>
            {% endif %}
          {% endif %}
        {% endform %}
      </div>
    </div>

    <!-- 2-Column Mobile / 4-Column Desktop Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pb-10 border-b border-line text-xs">
      
      <!-- Column 1: Drop 01 (Direct Smart Collection Links) -->
      <div>
        <h3 class="mb-3 border-b border-line pb-2 text-xs font-bold uppercase tracking-[1.5px] text-brand">
          DROP 01
        </h3>
        <ul class="space-y-2 text-muted">
          <li><a href="{{ all_url }}" class="hover:text-white transition-colors">Shop All Pieces</a></li>
          <li><a href="{{ cyber_set_url }}" class="hover:text-white transition-colors">3-Piece Mystery Set</a></li>
          <li><a href="{{ rings_url }}" class="hover:text-white transition-colors">316L Rings</a></li>
          <li><a href="{{ chains_url }}" class="hover:text-white transition-colors">Chains &amp; Pendants</a></li>
          <li><a href="{{ bracelets_url }}" class="hover:text-white transition-colors">Link Bracelets</a></li>
          <li><a href="{{ earphones_url }}" class="hover:text-white transition-colors">Pink Audio</a></li>
          <li><a href="{{ watches_url }}" class="hover:text-white transition-colors">Timepieces (Pre-Order)</a></li>
        </ul>
      </div>

      <!-- Column 2: Policies -->
      <div>
        <h3 class="mb-3 border-b border-line pb-2 text-xs font-bold uppercase tracking-[1.5px] text-brand">
          POLICIES
        </h3>
        <ul class="space-y-2 text-muted">
          <li><a href="{{ shipping_url }}" class="hover:text-white transition-colors">Shipping</a></li>
          <li><a href="{{ returns_url }}" class="hover:text-white transition-colors">Returns</a></li>
          <li><a href="{{ cancellation_url }}" class="hover:text-white transition-colors">Cancellation</a></li>
          <li><a href="{{ preorder_url }}" class="hover:text-white transition-colors">Pre-Order</a></li>
          <li><a href="{{ privacy_url }}" class="hover:text-white transition-colors">Privacy</a></li>
          <li><a href="{{ terms_url }}" class="hover:text-white transition-colors">Terms</a></li>
        </ul>
      </div>

      <!-- Column 3: Support -->
      <div>
        <h3 class="mb-3 border-b border-line pb-2 text-xs font-bold uppercase tracking-[1.5px] text-brand">
          SUPPORT
        </h3>
        <ul class="space-y-2 text-muted">
          <li><a href="{{ contact_url }}" class="hover:text-white transition-colors">Contact</a></li>
          <li><a href="{{ contact_url }}" class="hover:text-white transition-colors">Grievance</a></li>
          <li><a href="{{ contact_url }}" class="hover:text-white transition-colors">Seller Info</a></li>
          <li><a href="{{ faq_url }}" class="hover:text-white transition-colors">FAQ</a></li>
          <li><a href="{{ size_guide_url }}" class="hover:text-white transition-colors">Size Guide</a></li>
          <li><a href="{{ track_order_url }}" class="hover:text-white transition-colors">Track Order</a></li>
        </ul>
      </div>

      <!-- Column 4: Connect -->
      <div>
        <h3 class="mb-3 border-b border-line pb-2 text-xs font-bold uppercase tracking-[1.5px] text-brand">
          CONNECT
        </h3>
        <ul class="space-y-2 text-muted">
          <li><a href="https://instagram.com/rwnd20s" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram</a></li>
          <li><a href="mailto:rwnd20s@gmail.com" class="hover:text-white transition-colors">Email</a></li>
          <li class="pt-3">
            <a href="https://wa.me/918921946228?text=Hey!%20Connecting%20from%20RWND20S%20storefront." target="_blank" class="inline-flex h-9 items-center justify-center border border-brand bg-surface px-3 text-[10px] font-bold uppercase tracking-wider text-white hover:bg-brand transition-colors">
              CHAT ON WHATSAPP →
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Rights & Payment Icons -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[10px] text-muted uppercase">
      <div>
        <p>© 2026 RWND20S. DISPATCHED FROM MADURAI. ALL RIGHTS RESERVED.</p>
        <p class="text-brand mt-0.5">RETURNS ACCEPTED ONLY FOR DEFECTIVE OR WRONG ITEMS (48-HR WINDOW WITH UNBOXING VIDEO).</p>
      </div>
      <div class="flex flex-wrap gap-1 text-[9px] text-white">
        <span class="border border-line bg-surface px-2 py-1">VISA</span>
        <span class="border border-line bg-surface px-2 py-1">MASTERCARD</span>
        <span class="border border-line bg-surface px-2 py-1">RUPAY</span>
        <span class="border border-brand bg-brand/20 px-2 py-1 text-brand">UPI</span>
        <span class="border border-line bg-surface px-2 py-1">GPAY</span>
        <span class="border border-line bg-surface px-2 py-1">PHONEPE</span>
        <span class="border border-brand bg-panel px-2 py-1 text-white">COD</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
