          <div class="border border-[#2A2A2F] bg-[#0A0A0C] p-4 rounded-none">
            <span class="font-mono-tech text-base sm:text-xl font-bold text-[#F5F5F7]">₹999+</span>
            <p class="mt-1 text-[10px] text-[#A3A7AE] uppercase tracking-wider">Free Delivery</p>
