            <ul class="space-y-2 text-xs font-mono-tech text-[#A3A7AE]">
              <li><a href="/pages/shipping" class="hover:text-[#F5F5F7] transition-colors">Shipping Policy</a></li>
              <li><a href="/pages/returns-and-refunds" class="hover:text-[#F5F5F7] transition-colors">Returns & Refunds</a></li>
              <li><a href="/pages/cancellation" class="hover:text-[#F5F5F7] transition-colors">Cancellation</a></li>
              <li><a href="/pages/pre-order-policy" class="hover:text-[#F5F5F7] transition-colors">Pre-Order Policy</a></li>
              <li><a href="/pages/privacy-policy" class="hover:text-[#F5F5F7] transition-colors">Privacy Policy</a></li>
              <li><a href="/pages/terms-of-service" class="hover:text-[#F5F5F7] transition-colors">Terms of Service</a></li>
