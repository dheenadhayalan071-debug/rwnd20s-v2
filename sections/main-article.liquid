<!-- sections/main-article.liquid -->
<!-- DARK THEME REFACTOR - Aligned with night-calls/main-storefront/main-home aesthetic -->
<div class="relative w-full bg-[#050505] text-[#F5F5F7] py-12 px-4 sm:px-6 lg:px-12 font-mono-tech">
  <div class="mx-auto max-w-4xl">
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="mb-8 font-mono-tech text-xs text-[#A3A7AE]">
      <ol class="flex items-center gap-2 uppercase tracking-wider">
        <li><a href="{{ routes.root_url }}" class="hover:text-[#FF0033] transition-colors">BASE</a></li>
        <li class="text-[#FF0033]">/</li>
        <li><a href="{{ blog.url }}" class="hover:text-[#FF0033] transition-colors">JOURNAL</a></li>
        <li class="text-[#FF0033]">/</li>
        <li class="text-[#F5F5F7] font-bold truncate max-w-[200px] sm:max-w-none">{{ article.title }}</li>
      </ol>
    </nav>

    <!-- Article Container -->
    <article class="rounded-none border border-[#2A2A2F] bg-[#131316] p-6 sm:p-12 shadow-2xl">
      <div class="border-b border-[#2A2A2F] pb-6 mb-8">
        <div class="flex items-center justify-between font-mono-tech text-xs text-[#A3A7AE] uppercase tracking-widest mb-3">
          <span>PUBLISHED: {{ article.published_at | date: "%d %b %Y" }}</span>
          <span>AUTHOR: {{ article.author | default: 'RWND20S' }}</span>
        </div>
        <h1 class="font-display text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-[#F5F5F7]">
          {{ article.title }}
        </h1>
      </div>

      {% if article.image %}
        <div class="rounded-none bg-[#0A0A0C] overflow-hidden aspect-video mb-8 border border-[#2A2A2F]">
          <img src="{{ article.image | image_url: width: 1200 }}" width="1200" height="675" alt="{{ article.title | escape }}" class="h-full w-full object-cover">
        </div>
      {% endif %}

      <!-- Article Content Body -->
      <div class="prose font-mono-tech text-xs sm:text-sm text-[#A3A7AE] leading-relaxed space-y-4 max-w-none">
        {{ article.content }}
      </div>

      <!-- Footer Navigation & Back to Journal -->
      <div class="mt-12 pt-6 border-t border-[#2A2A2F] flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="{{ blog.url }}" class="rounded-full border border-[#FF0033] bg-[#FF0033] px-6 py-3 font-mono-tech text-xs font-bold text-white uppercase tracking-wider hover:bg-[#CC0029] hover:border-[#CC0029] transition-colors">
          ← BACK TO ARCHIVE JOURNAL
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="rounded-full border border-[#2A2A2F] bg-[#131316] px-6 py-3 font-mono-tech text-xs font-bold text-[#F5F5F7] uppercase tracking-wider hover:border-[#FF0033] hover:text-[#FF0033] transition-colors">
          EXPLORE DROP 01 HARDWARE
        </a>
      </div>
    </article>
  </div>
</div>

{% schema %}
{
  "name": "Article Main View",
  "settings": []
}
{% endschema %}