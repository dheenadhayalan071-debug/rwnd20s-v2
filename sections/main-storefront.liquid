<!-- sections/main-storefront.liquid -->
{% if section.settings.collection != blank and collections[section.settings.collection] != blank %}
  {% assign archive_collection = collections[section.settings.collection] %}
{% else %}
  {% assign archive_collection = collections['all'] %}
{% endif %}

{% assign spotlight_product = blank %}
{% for product in archive_collection.products %}
  {% assign handle_down = product.handle | downcase %}
  {% assign title_down = product.title | downcase %}
  {% if spotlight_product == blank and handle_down contains 'cyber-set' or title_down contains 'cyber set' %}
    {% assign spotlight_product = product %}
  {% endif %}
{% endfor %}
{% if spotlight_product == blank and archive_collection.products.size > 0 %}
  {% assign spotlight_product = archive_collection.products.first %}
{% endif %}

<!-- ========================================================================= -->
<!-- 2.1 HERO SECTION                                                          -->
<!-- ========================================================================= -->
<section class="relative min-h-[90vh] sm:min-h-screen w-full flex flex-col justify-between items-center text-center px-4 pt-28 pb-12 overflow-hidden border-b border-[#2A2A2F] bg-[#0A0A0C]">
  <!-- Background Layer (Video / Fallback Still + Gradient Overlay) -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    {% if section.settings.hero_video_url != blank %}
      <video class="w-full h-full object-cover opacity-35" autoplay muted loop playsinline>
        <source src="{{ section.settings.hero_video_url }}" type="video/mp4">
      </video>
    {% else %}
      <div class="w-full h-full bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#C8102E]/20 via-[#131316] to-[#0A0A0C]"></div>
    {% endif %}
    <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0C] via-transparent to-[#0A0A0C] opacity-90"></div>
  </div>

  <!-- Centered Content Stack -->
  <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center justify-center my-auto">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 border border-[#FF0033]/60 bg-[#131316] px-3.5 py-1 font-mono-tech text-[11px] sm:text-xs font-bold uppercase tracking-[1.5px] text-[#F5F5F7]">
      <span class="h-2 w-2 bg-[#FF0033] animate-pulse"></span>
      {{ section.settings.hero_badge | default: 'DROP 01 // DISPATCHED FROM MADURAI' }}
    </div>

    <!-- Headline -->
    <h1 class="mt-6 font-display text-5xl sm:text-7xl lg:text-[110px] font-extrabold uppercase leading-[0.9] tracking-[-2px] text-[#F5F5F7]">
      Y2K<br>
      HARDWARE<br>
      <span class="text-[#FF0033]">AFTER DARK.</span>
    </h1>

    <!-- Subhead -->
    <p class="mt-6 max-w-xl font-mono-tech text-sm sm:text-base leading-relaxed text-[#A3A7AE] opacity-90">
      After dark, no rules. High-polish stainless steel and nocturnal audio for those who operate off the grid.
    </p>

    <!-- CTA Row -->
    <div class="mt-8 flex w-full max-w-md flex-col sm:flex-row items-center justify-center gap-3">
      <a href="#shop" class="flex h-14 w-full sm:w-auto flex-1 items-center justify-center border border-[#FF0033] bg-[#FF0033] px-8 font-mono-tech text-xs font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:bg-[#E0213F]">
        SHOP DROP 01 →
      </a>
      <a href="#about" class="flex h-14 w-full sm:w-auto flex-1 items-center justify-center border border-[#C8CDD3] bg-transparent px-8 font-mono-tech text-xs font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:border-[#FF0033] hover:text-[#FF0033]">
        VIEW MANIFESTO
      </a>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <a href="#drop-status-bar" class="relative z-10 flex flex-col items-center gap-1 font-mono-tech text-[10px] uppercase tracking-[2px] text-[#A3A7AE] hover:text-white transition-colors animate-bounce cursor-pointer">
    <span>↓ SCROLL</span>
  </a>
</section>

<!-- ========================================================================= -->
<!-- 2.2 DROP STATUS BAR (URGENCY MARQUEE)                                     -->
<!-- ========================================================================= -->
<section id="drop-status-bar" class="relative z-20 h-20 w-full overflow-hidden bg-[#FF0033] text-black font-mono-tech flex items-center border-y border-black">
  <div class="rwnd-marquee-track flex whitespace-nowrap text-sm sm:text-base font-bold tracking-[2px] uppercase select-none">
    <div class="flex items-center gap-8 px-4">
      <span>● LIVE NOW</span>
      <span>·</span>
      <span>DROP 01</span>
      <span>·</span>
      <span>Y2K HARDWARE</span>
      <span>·</span>
      <span>STOCK: 247/500 UNITS REMAINING</span>
      <span>·</span>
      <span class="flex items-center gap-1">NEXT DROP IN: <strong id="hero-countdown" class="underline">14D 06H 22M</strong></span>
      <span>·</span>
      <span>DISPATCHED IN 24H FROM MADURAI</span>
      <span>·</span>
    </div>
    <div class="flex items-center gap-8 px-4" aria-hidden="true">
      <span>● LIVE NOW</span>
      <span>·</span>
      <span>DROP 01</span>
      <span>·</span>
      <span>Y2K HARDWARE</span>
      <span>·</span>
      <span>STOCK: 247/500 UNITS REMAINING</span>
      <span>·</span>
      <span class="flex items-center gap-1">NEXT DROP IN: <strong>14D 06H 22M</strong></span>
      <span>·</span>
      <span>DISPATCHED IN 24H FROM MADURAI</span>
      <span>·</span>
    </div>
  </div>
</section>

<!-- ========================================================================= -->
<!-- 2.3 CATEGORY SELECTION GRID (2x2 Mobile, 4-Col Desktop)                   -->
<!-- ========================================================================= -->
<section class="w-full bg-[#0A0A0C] p-0.5">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-0.5 max-w-7xl mx-auto">
    <!-- Tile 01 -->
    <a href="/products/3-piece-y2k-cyber-set" class="group relative aspect-square w-full overflow-hidden border border-[#2A2A2F] bg-[#131316] p-6 flex flex-col justify-end transition-all hover:border-[#FF0033]">
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10 transition-opacity group-hover:opacity-75"></div>
      <div class="absolute inset-0 flex items-center justify-center opacity-40 group-hover:scale-105 group-hover:opacity-60 transition-all duration-500">
        <svg class="h-24 w-24 text-[#2A2A2F]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="1.5" d="M12 2l3 7h7l-5.5 4.5 2 7.5-6.5-4.5-6.5 4.5 2-7.5-5.5-4.5h7z"/></svg>
      </div>
      <div class="relative z-20">
        <span class="font-mono-tech text-xs font-bold text-[#FF0033]">01 //</span>
        <h3 class="mt-1 font-display text-base sm:text-xl font-bold uppercase text-white leading-tight">3-PIECE CYBER SET</h3>
        <span class="mt-2 inline-block font-mono-tech text-[10px] uppercase tracking-wider text-[#A3A7AE] group-hover:text-white transition-colors">SHOP →</span>
      </div>
