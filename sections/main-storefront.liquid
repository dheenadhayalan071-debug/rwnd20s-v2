<!-- sections/main-storefront.liquid -->
{% section 'main-home' %}
<section class="product-grid-wrap"><h2>Premium Drop</h2><div class="product-grid">
  {% assign featured_collection = collections['premium-drop'] %}
  {% if featured_collection != blank %}{% for featured_product in featured_collection.products %}
    <article class="product-card"><a href="{{ featured_product.url }}">{% if featured_product.featured_image %}<img src="{{ featured_product.featured_image | image_url: width: 640 }}" alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}" width="640" height="640" loading="lazy">{% endif %}<h3>{{ featured_product.title | escape }}</h3></a><p>{{ featured_product.price | money }}</p></article>
  {% endfor %}{% endif %}
</div></section>
{% schema %}{"name":"Storefront","settings":[]}{% endschema %}
