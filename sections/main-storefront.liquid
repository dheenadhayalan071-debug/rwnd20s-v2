<!-- sections/main-storefront.liquid -->
{% if section.settings.collection != blank and collections[section.settings.collection] != blank %}
  {% assign archive_collection = collections[section.settings.collection] %}
{% else %}
  {% assign archive_collection = collections['all'] %}
{% endif %}

{% assign hero_cyber = blank %}
{% assign hero_audio = blank %}
{% assign hero_watch = blank %}

{% for product in archive_collection.products %}
  {% assign title_key = product.title | downcase %}
  {% assign handle_key = product.handle | downcase %}
  {% if hero_cyber == blank %}
    {% if title_key contains 'cyber set' or handle_key contains 'cyber-set' %}
      {% assign hero_cyber = product %}
    {% endif %}
  {% endif %}
  {% if hero_audio == blank %}
    {% if title_key contains 'earphone' or handle_key contains 'earphone' or handle_key contains 'audio' %}
      {% assign hero_audio = product %}
    {% endif %}
  {% endif %}
  {% if hero_watch == blank %}
    {% if title_key contains 'watch' or title_key contains 'chronograph' or handle_key contains 'watch' %}
      {% assign hero_watch = product %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign first_product = archive_collection.products[0] %}
{% assign second_product = archive_collection.products[1] %}
{% assign third_product = archive_collection.products[2] %}

{% if hero_cyber == blank %}{% assign hero_cyber = first_product %}{% endif %}
{% if hero_audio == blank %}
  {% if second_product and second_product.id != hero_cyber.id %}
    {% assign hero_audio = second_product %}
  {% elsif first_product and first_product.id != hero_cyber.id %}
    {% assign hero_audio = first_product %}
  {% endif %}
{% endif %}
{% if hero_watch == blank %}
  {% if third_product and third_product.id != hero_cyber.id and third_product.id != hero_audio.id %}
    {% assign hero_watch = third_product %}
  {% endif %}
{% endif %}

<!-- Hero Stage Section -->
<section class="rwnd-home-hero relative mx-auto max-w-7xl px-4 py-4 sm:px-6 sm:py-8 lg:px-8">
  <div class="mx-auto flex w-full max-w-5xl flex-col items-center justify-center text-center">
    <div class="mb-4 max-w-2xl">
      <div class="inline-flex items-center gap-2 border border-[#C8102E]/60 bg-[#131316] px-3.5 py-1 font-mono-tech text-[10px] font-bold uppercase tracking-[0.12em] text-[#F5F5F7] rounded-none">
        <span class="h-1.5 w-1.5 bg-[#C8102E] animate-pulse"></span>
        {{ section.settings.hero_badge | escape }}
      </div>
      <h1 class="mt-3 font-display text-3xl font-extrabold uppercase tracking-tight text-[#F5F5F7] sm:text-5xl lg:text-6xl">
        <span class="block">{{ section.settings.hero_title_line_1 | escape }}</span>
        <span class="mt-1 block text-[#C8CDD3]">{{ section.settings.hero_title_line_2 | escape }}</span>
      </h1>
      <p class="mx-auto mt-3 max-w-xl font-mono-tech text-xs leading-relaxed text-[#A3A7AE] sm:text-sm">
        {{ section.settings.hero_subtitle | escape }}
      </p>
    </div>

    <!-- Stage Switcher Tabs (0px geometry, high-contrast) -->
    <div role="tablist" aria-label="Featured archive pieces" class="relative z-10 flex w-full flex-wrap items-center justify-center gap-2">
      {% if hero_cyber %}
        <button id="hero-tab-0" role="tab" type="button" data-hero-btn="0" aria-selected="true" aria-controls="hero-slide-0" class="rwnd-hero-tab border border-[#C8102E] bg-[#C8102E] px-4 py-2 font-mono-tech text-xs font-bold uppercase tracking-wider text-[#F5F5F7] transition-all rounded-none cursor-pointer">
          01 // 3-PIECE CYBER SET
        </button>
      {% endif %}
      {% if hero_audio %}
        <button id="hero-tab-1" role="tab" type="button" data-hero-btn="1" aria-selected="false" aria-controls="hero-slide-1" class="rwnd-hero-tab border border-[#2A2A2F] bg-[#131316] px-4 py-2 font-mono-tech text-xs font-medium uppercase tracking-wider text-[#A3A7AE] transition-all hover:border-[#C8CDD3] hover:text-[#F5F5F7] rounded-none cursor-pointer">
          02 // CHROME AUDIO
        </button>
      {% endif %}
      {% if hero_watch %}
        <button id="hero-tab-2" role="tab" type="button" data-hero-btn="2" aria-selected="false" aria-controls="hero-slide-2" class="rwnd-hero-tab border border-[#2A2A2F] bg-[#131316] px-4 py-2 font-mono-tech text-xs font-medium uppercase tracking-wider text-[#A3A7AE] transition-all hover:border-[#C8CDD3] hover:text-[#F5F5F7] rounded-none cursor-pointer">
          03 // TIMEPIECE (PRE-ORDER)
        </button>
      {% endif %}
    </div>

    <!-- Hero Slides Container -->
    <div class="relative mx-auto mt-4 flex w-full max-w-xl flex-col items-center justify-start text-center sm:mt-6">
      {% if hero_cyber %}{% render 'hero-product-slide', hero_product: hero_cyber, hero_index: 0 %}{% endif %}
      {% if hero_audio %}{% render 'hero-product-slide', hero_product: hero_audio, hero_index: 1 %}{% endif %}
      {% if hero_watch %}{% render 'hero-product-slide', hero_product: hero_watch, hero_index: 2 %}{% endif %}

      {% if archive_collection.products.size == 0 %}
        <div class="relative z-10 flex min-h-[260px] w-full flex-col items-center justify-center border border-[#2A2A2F] bg-[#131316] p-6 text-center rounded-none">
          <p class="font-mono-tech text-[10px] font-bold uppercase tracking-[0.12em] text-[#C8102E]">DISPATCH STATUS</p>
          <h2 class="mt-2 font-display text-xl font-extrabold uppercase text-[#F5F5F7]">NO ARTIFACTS IN THIS ARCHIVE</h2>
          <p class="mt-2 max-w-sm font-mono-tech text-xs leading-relaxed text-[#A3A7AE]">The archive is currently silent. Recheck when the next batch drops.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<!-- Collection Grid Section -->
<section id="shop" class="mx-auto max-w-7xl border-t border-[#2A2A2F] px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between sm:gap-3">
    <div>
      <p class="font-mono-tech text-[10px] font-bold uppercase tracking-[0.12em] text-[#C8102E]">
        DROP 01 // ARCHIVE COLLECTION
      </p>
      <h2 class="mt-1 font-display text-2xl font-extrabold uppercase tracking-tight text-[#F5F5F7] sm:text-3xl">
        Y2K HARDWARE ARCHIVE
      </h2>
    </div>
    <p id="rwnd-showing-count" class="font-mono-tech text-xs font-semibold text-[#A3A7AE]">
      {{ archive_collection.products.size }} PIECES // DISPATCHED FROM MADURAI
    </p>
  </div>

  <div id="rwnd-product-grid" class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
    {% for product in archive_collection.products %}
      {% assign is_bundle = false %}
      {% assign p_handle = product.handle | downcase %}
      {% if p_handle contains 'bundle' or p_handle contains 'cyber-set' %}
        {% assign is_bundle = true %}
      {% endif %}

      <article class="group flex flex-col justify-between border border-[#2A2A2F] bg-[#131316] p-4 transition-all duration-300 hover:border-[#C8102E] rounded-none">
        <div class="relative flex aspect-square w-full items-center justify-center overflow-hidden border border-[#2A2A2F] bg-[#0A0A0C] p-4 rounded-none">
          <a href="{{ product.url }}" class="flex h-full w-full items-center justify-center">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="800" height="800" loading="lazy" class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105">
            {% else %}
              <span class="font-mono-tech text-xs font-bold uppercase text-[#A3A7AE]">{{ product.title | escape }}</span>
            {% endif %}
          </a>

          {% if is_bundle %}
            <span class="absolute left-3 top-3 border border-[#C8102E] bg-[#0A0A0C] px-2 py-0.5 font-mono-tech text-[10px] font-bold uppercase text-[#C8102E] rounded-none">
              SAVE ₹248
            </span>
          {% endif %}
        </div>

        <div class="flex flex-1 flex-col justify-between pt-4">
          <div>
            <p class="font-mono-tech text-[10px] font-bold uppercase tracking-[0.12em] text-[#C8CDD3]">
              {% if is_bundle %}
                3-PIECE SET
              {% elsif product.tags contains 'earphones' or product.type contains 'Audio' %}
                WIRED TYPE-C
              {% elsif product.tags contains 'watch' or product.type contains 'Watch' %}
                PRE-ORDER
              {% else %}
                HARDWARE SPEC
              {% endif %}
            </p>
            <h3 class="rwnd-product-title mt-1 font-display text-base font-bold tracking-tight text-[#F5F5F7] uppercase">
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h3>
            <p class="mt-1 font-mono-tech text-xs text-[#A3A7AE]">
              {% if product.tags contains 'chains' or product.tags contains 'bracelets' %}
                316L stainless steel
              {% elsif product.tags contains 'earphones' %}
                Pink chrome finish
              {% else %}
                Y2K metallic archive
              {% endif %}
            </p>
          </div>

          <div class="mt-4 flex items-center justify-between border-t border-[#2A2A2F] pt-4">
            <div class="flex items-baseline gap-2">
              <span class="font-mono-tech text-base font-bold text-[#F5F5F7]">{{ product.price | money }}</span>
            </div>
            <a href="{{ product.url }}" class="inline-flex items-center justify-center border border-[#2A2A2F] bg-[#0A0A0C] px-4 py-2 font-mono-tech text-[11px] font-bold uppercase text-[#F5F5F7] transition-colors hover:border-[#C8102E] hover:bg-[#C8102E] rounded-none">
              INSPECT →
            </a>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = [...document.querySelectorAll('.rwnd-hero-tab')];
    const slides = [...document.querySelectorAll('.rwnd-hero-slide')];

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.heroBtn;

        tabs.forEach((item) => {
          const selected = item === tab;
          item.setAttribute('aria-selected', String(selected));
          if (selected) {
            item.className = 'rwnd-hero-tab border border-[#C8102E] bg-[#C8102E] px-4 py-2 font-mono-tech text-xs font-bold uppercase tracking-wider text-[#F5F5F7] transition-all rounded-none cursor-pointer';
          } else {
            item.className = 'rwnd-hero-tab border border-[#2A2A2F] bg-[#131316] px-4 py-2 font-mono-tech text-xs font-medium uppercase tracking-wider text-[#A3A7AE] transition-all hover:border-[#C8CDD3] hover:text-[#F5F5F7] rounded-none cursor-pointer';
          }
        });

        slides.forEach((slide) => {
          const active = slide.dataset.heroStageSlide === target;
          slide.classList.toggle('hidden', !active);
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Main Storefront Stage",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Archive Collection"
    },
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Hero Badge",
      "default": "DROP 01 // DISPATCHED FROM MADURAI"
    },
    {
      "type": "text",
      "id": "hero_title_line_1",
      "label": "Hero Title Line 1",
      "default": "Y2K HARDWARE"
    },
    {
      "type": "text",
      "id": "hero_title_line_2",
      "label": "Hero Title Line 2",
      "default": "AFTER DARK."
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "After dark, no rules. High-polish stainless steel and nocturnal audio for those who operate off the grid."
    }
  ],
  "presets": [
    {
      "name": "Main Storefront Stage"
    }
  ]
}
{% endschema %}
