    <!-- Tile 02 -->
    <a href="/collections/all" class="group relative aspect-square w-full overflow-hidden border border-[#2A2A2F] bg-[#131316] p-6 flex flex-col justify-end transition-all hover:border-[#FF0033]">
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10 transition-opacity group-hover:opacity-75"></div>
      <div class="absolute inset-0 flex items-center justify-center opacity-40 group-hover:scale-105 group-hover:opacity-60 transition-all duration-500">
        <svg class="h-24 w-24 text-[#2A2A2F]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="7" stroke-width="1.5"/></svg>
      </div>
      <div class="relative z-20">
        <span class="font-mono-tech text-xs font-bold text-[#FF0033]">02 //</span>
        <h3 class="mt-1 font-display text-base sm:text-xl font-bold uppercase text-white leading-tight">CHAINS & RINGS</h3>
        <span class="mt-2 inline-block font-mono-tech text-[10px] uppercase tracking-wider text-[#A3A7AE] group-hover:text-white transition-colors">SHOP →</span>
      </div>
    </a>

    <!-- Tile 03 -->
    <a href="/collections/earphones" class="group relative aspect-square w-full overflow-hidden border border-[#2A2A2F] bg-[#131316] p-6 flex flex-col justify-end transition-all hover:border-[#FF0033]">
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10 transition-opacity group-hover:opacity-75"></div>
      <div class="absolute inset-0 flex items-center justify-center opacity-40 group-hover:scale-105 group-hover:opacity-60 transition-all duration-500">
        <svg class="h-24 w-24 text-[#2A2A2F]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="1.5" d="M3 18v-6a9 9 0 0118 0v6M3 18a3 3 0 003 3h1V15H4a1 1 0 00-1 1v2zm18 0a3 3 0 01-3 3h-1V15h3a1 1 0 011 1v2z"/></svg>
      </div>
      <div class="relative z-20">
        <span class="font-mono-tech text-xs font-bold text-[#FF0033]">03 //</span>
        <h3 class="mt-1 font-display text-base sm:text-xl font-bold uppercase text-white leading-tight">PINK CHROME AUDIO</h3>
        <span class="mt-2 inline-block font-mono-tech text-[10px] uppercase tracking-wider text-[#A3A7AE] group-hover:text-white transition-colors">SHOP →</span>
      </div>
    </a>

    <!-- Tile 04 -->
    <a href="/products/w-01-analog-chronograph" class="group relative aspect-square w-full overflow-hidden border border-[#2A2A2F] bg-[#131316] p-6 flex flex-col justify-end transition-all hover:border-[#FF0033]">
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10 transition-opacity group-hover:opacity-75"></div>
      <div class="absolute inset-0 flex items-center justify-center opacity-40 group-hover:scale-105 group-hover:opacity-60 transition-all duration-500">
        <svg class="h-24 w-24 text-[#2A2A2F]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6" stroke-width="1.5"/><path stroke-width="1.5" d="M12 2v4m0 12v4"/></svg>
      </div>
      <div class="relative z-20">
        <span class="font-mono-tech text-xs font-bold text-[#FF0033]">04 //</span>
        <h3 class="mt-1 font-display text-base sm:text-xl font-bold uppercase text-white leading-tight">TIMEPIECES [PRE-ORDER]</h3>
        <span class="mt-2 inline-block font-mono-tech text-[10px] uppercase tracking-wider text-[#A3A7AE] group-hover:text-white transition-colors">SHOP →</span>
