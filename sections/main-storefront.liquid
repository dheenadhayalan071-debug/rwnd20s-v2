        <span class="text-xl sm:text-2xl font-bold text-white group-hover:text-[#FF0033] transition-colors">316L</span>
        <p class="mt-1 text-[10px] uppercase text-[#A3A7AE]">Stainless Steel Chains</p>
      </a>
      <a href="/collections/earphones" class="group border border-[#2A2A2F] bg-[#0A0A0C] p-4 transition-all hover:border-[#FF0033]">
        <span class="text-xl sm:text-2xl font-bold text-white group-hover:text-[#FF0033] transition-colors">TYPE-C</span>
        <p class="mt-1 text-[10px] uppercase text-[#A3A7AE]">Pink Chrome Audio</p>
