<!-- STYLES & INTERACTION LOGIC                                                -->
<!-- ========================================================================= -->
<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .rwnd-marquee-track {
    display: flex;
    width: 200%;
    animation: marquee 20s linear infinite;
  }
  .rwnd-marquee-track:hover {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .rwnd-marquee-track { animation: none; }
  }
</style>

<script>
  // Community Dispatch Modal Controls
  window.openRwndDispatchModal = function(btn) {
    const modal = document.getElementById('rwnd-dispatch-modal');
    if (!modal) return;

    document.getElementById('rwnd-disp-handle').textContent = btn.dataset.handle;
    document.getElementById('rwnd-disp-city').textContent = '· ' + btn.dataset.city;
    document.getElementById('rwnd-disp-caption').textContent = btn.dataset.caption;
    document.getElementById('rwnd-disp-prod-title').textContent = btn.dataset.prodTitle;
    document.getElementById('rwnd-disp-prod-price').textContent = btn.dataset.prodPrice;
    document.getElementById('rwnd-disp-prod-url').href = btn.dataset.prodUrl;

    const imgEl = document.getElementById('rwnd-disp-img');
    const emptyEl = document.getElementById('rwnd-disp-empty');
    if (btn.dataset.img) {
      imgEl.src = btn.dataset.img;
      imgEl.classList.remove('hidden');
      emptyEl.classList.add('hidden');
    } else {
      imgEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeRwndDispatchModal = function() {
    const modal = document.getElementById('rwnd-dispatch-modal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  document.getElementById('rwnd-dispatch-modal')?.addEventListener('click', (e) => {
    if (e.target.id === 'rwnd-dispatch-modal') window.closeRwndDispatchModal();
  });
</script>

