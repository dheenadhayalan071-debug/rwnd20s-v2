<!-- ========================================================================= -->
<!-- 2.4 FEATURED PRODUCT SPOTLIGHT (50/50 Split Showcase)                    -->
<!-- ========================================================================= -->
{% if spotlight_product %}
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-b border-[#2A2A2F]">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
    <!-- Left: Large Image Container -->
    <div class="relative aspect-square w-full overflow-hidden border border-[#2A2A2F] bg-[#131316] p-6 flex items-center justify-center">
      {% if spotlight_product.featured_image %}
        <img 
          src="{{ spotlight_product.featured_image | image_url: width: 900 }}" 
          alt="{{ spotlight_product.title | escape }}" 
          width="900" 
          height="900"
          loading="lazy" 
          class="h-full w-full object-contain"
        >
      {% else %}
        <div class="font-mono-tech text-xs uppercase tracking-widest text-[#A3A7AE]">SPOTLIGHT ASSET</div>
      {% endif %}
      <span class="absolute top-4 left-4 border border-[#FF0033] bg-black px-2.5 py-1 font-mono-tech text-[10px] font-bold uppercase text-[#FF0033]">
        BESTSELLER
      </span>
    </div>

    <!-- Right: Specifications & Direct Purchase Action -->
    <div class="flex flex-col justify-center">
      <span class="font-mono-tech text-xs font-bold uppercase tracking-[0.14em] text-[#FF0033]">
        // MDU_DISPATCH · HEAVYWEIGHT BRUTALISM
      </span>
      <h2 class="mt-2 font-display text-3xl sm:text-5xl font-extrabold uppercase text-white">
        {{ spotlight_product.title | default: '3-PIECE Y2K CYBER SET' }}
      </h2>

      <!-- Price & Savings Badge -->
      <div class="mt-4 flex items-center gap-3">
        <span class="font-mono-tech text-2xl font-extrabold text-white">
          {{ spotlight_product.price | money }}
        </span>
        {% if spotlight_product.compare_at_price > spotlight_product.price %}
          <span class="font-mono-tech text-sm text-[#A3A7AE] line-through">
            {{ spotlight_product.compare_at_price | money }}
          </span>
          <span class="border border-[#FF0033] bg-[#FF0033]/20 px-2 py-0.5 font-mono-tech text-xs font-bold text-[#FF0033]">
            SAVE ₹248
          </span>
        {% endif %}
      </div>

      <p class="mt-4 font-mono-tech text-xs sm:text-sm text-[#A3A7AE] leading-relaxed">
        316L stainless steel. Nocturnal audio. Built for after-dark operators. High-polish finish designed to resist oxidation.
      </p>

      <!-- Cart Action Form -->
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="mt-6">
        <input type="hidden" name="id" value="{{ spotlight_product.selected_or_first_available_variant.id }}">
        
        <div class="flex flex-col sm:flex-row gap-3">
          <button 
            type="submit" 
            class="flex-1 h-14 bg-[#FF0033] font-mono-tech text-xs font-bold uppercase tracking-wider text-white hover:bg-[#E0213F] transition-all cursor-pointer flex items-center justify-center"
          >
            + ADD TO HARDWARE BAG — {{ spotlight_product.price | money }}
          </button>
          <a 
            href="/checkout" 
            class="h-14 px-8 border border-[#2A2A2F] bg-[#131316] font-mono-tech text-xs font-bold uppercase tracking-wider text-white hover:border-[#FF0033] transition-all flex items-center justify-center"
          >
            INSTANT CHECKOUT →
          </a>
        </div>
      </form>

      <!-- Trust Badges Row -->
      <div class="mt-8 grid grid-cols-3 gap-2 border-t border-[#2A2A2F] pt-4 font-mono-tech text-[10px] uppercase text-[#A3A7AE] text-center">
        <div class="p-2 border border-[#2A2A2F] bg-[#0A0A0C]">🛡️ COD Available</div>
        <div class="p-2 border border-[#2A2A2F] bg-[#0A0A0C]">🚚 48-Hr Dispatch</div>
        <div class="p-2 border border-[#2A2A2F] bg-[#0A0A0C]">↩️ Defect Return</div>
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- ========================================================================= -->
<!-- 2.5 PRODUCT GRID — "SHOP THE ARCHIVE"                                     -->
<!-- ========================================================================= -->
<section id="shop" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-b border-[#2A2A2F]">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[#2A2A2F] pb-6">
    <div>
      <span class="font-mono-tech text-xs font-bold uppercase tracking-[1.5px] text-[#FF0033]">
        DROP 01 // ARCHIVE COLLECTION
      </span>
      <h2 class="mt-1 font-display text-2xl sm:text-4xl font-extrabold uppercase text-white">
        Y2K HARDWARE ARCHIVE
      </h2>
    </div>
    <div class="flex items-center gap-4">
      <span class="font-mono-tech text-xs text-[#A3A7AE]">
        {{ archive_collection.products.size }} PIECES // DISPATCHED FROM MADURAI
      </span>
      <a href="/collections/all" class="font-mono-tech text-xs font-bold uppercase text-[#FF0033] hover:underline">
        [VIEW ALL →]
      </a>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    {% for product in archive_collection.products limit: 8 %}
      {% assign is_bundle = false %}
      {% assign p_handle = product.handle | downcase %}
      {% assign p_title = product.title | downcase %}
      {% if p_handle contains 'cyber-set' or p_title contains 'cyber set' %}
        {% assign is_bundle = true %}
      {% endif %}

      <article class="group relative flex flex-col justify-between border border-[#2A2A2F] bg-[#131316] p-3 sm:p-4 transition-all hover:border-[#FF0033]">
        <div class="relative aspect-[4/5] w-full overflow-hidden border border-[#2A2A2F] bg-[#0A0A0C] flex items-center justify-center">
          <a href="{{ product.url }}" class="flex h-full w-full items-center justify-center">
            {% if product.featured_image %}
              <img 
                src="{{ product.featured_image | image_url: width: 600 }}" 
                alt="{{ product.title | escape }}" 
                width="600" 
                height="750" 
                loading="lazy" 
                class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
              >
            {% else %}
              <span class="font-mono-tech text-[10px] text-[#A3A7AE] uppercase">{{ product.title | escape }}</span>
            {% endif %}
          </a>

          <!-- Badges -->
          {% if is_bundle %}
            <span class="absolute top-2 left-2 border border-[#FF0033] bg-[#0A0A0C] px-1.5 py-0.5 font-mono-tech text-[9px] font-bold text-[#FF0033]">
              SAVE ₹248
            </span>
          {% elsif product.tags contains 'watch' or product.type contains 'Watch' %}
            <span class="absolute top-2 right-2 border border-[#FF0033] bg-[#FF0033]/20 px-1.5 py-0.5 font-mono-tech text-[9px] font-bold text-[#FF0033]">
              PRE-ORDER
            </span>
          {% else %}
            <span class="absolute top-2 right-2 border border-[#2A2A2F] bg-[#0A0A0C] px-1.5 py-0.5 font-mono-tech text-[9px] font-bold text-[#A3A7AE]">
              DROP 01
            </span>
          {% endif %}
        </div>

        <div class="mt-3 flex flex-col justify-between flex-1">
          <div>
            <h3 class="font-display text-xs sm:text-sm font-bold uppercase text-white line-clamp-1">
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h3>
            <div class="mt-1 flex items-baseline gap-2 font-mono-tech text-xs sm:text-sm font-bold text-white">
              <span>{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="text-[10px] text-[#A3A7AE] line-through">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>

          <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="mt-3">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button 
              type="submit" 
              class="w-full h-10 border border-[#2A2A2F] bg-[#0A0A0C] font-mono-tech text-[10px] font-bold uppercase tracking-wider text-white hover:bg-[#FF0033] hover:border-[#FF0033] transition-colors cursor-pointer"
            >
              + QUICK ADD
            </button>
          </form>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<!-- ========================================================================= -->
<!-- 2.6 BRAND MANIFESTO SECTION                                              -->
<!-- ========================================================================= -->
