<!-- sections/main-storefront.liquid -->
{% assign configured_collection = section.settings.collection %}
{% if configured_collection != blank %}
  {% assign archive_collection = configured_collection %}
{% else %}
  {% assign archive_collection = collections['all'] %}
{% endif %}

{% assign spotlight_product = blank %}
{% for product in archive_collection.products %}
  {% assign handle_down = product.handle | downcase %}
  {% assign title_down = product.title | downcase %}
  {% if spotlight_product == blank and (handle_down contains 'cyber-set' or title_down contains 'cyber set') %}
    {% assign spotlight_product = product %}
  {% endif %}
{% endfor %}
{% if spotlight_product == blank and archive_collection.products.size > 0 %}
  {% assign spotlight_product = archive_collection.products.first %}
{% endif %}

{%- comment -%} Guarded destinations: fall back to the full catalogue if a handle is missing. {%- endcomment -%}
{% assign cyber_set_url = all_products['3-piece-y2k-cyber-set'].url | default: routes.all_products_collection_url %}
{% assign rings_url = collections['rings'].url | default: routes.all_products_collection_url %}
{% assign earphones_url = collections['earphones'].url | default: routes.all_products_collection_url %}
{% assign watches_url = collections['watches'].url | default: routes.all_products_collection_url %}
{% assign shipping_page_url = pages['shipping'].url | default: pages['contact'].url | default: routes.all_products_collection_url %}

<!-- ========================================================================= -->
<!-- 2.1 HERO SECTION (10/10 BLUEPRINT SPECIFICATION)                          -->
<!-- ========================================================================= -->
<section class="relative min-h-[100dvh] w-full flex flex-col justify-center items-center text-center px-5 pt-24 pb-12 overflow-hidden border-b border-line bg-[#050505]">
  {% assign hero_image_url = blank %}
  {% assign hero_image_w = blank %}
  {% assign hero_image_h = blank %}
  {% if section.settings.hero_image %}
    {% assign hero_image_url = section.settings.hero_image | image_url: width: 1200 %}
  {% elsif spotlight_product.featured_image %}
    {% assign hero_image_url = spotlight_product.featured_image | image_url: width: 1200 %}
  {% else %}
    {% assign hero_image_url = 'hero-default.webp' | asset_url %}
    {% assign hero_image_w = 1671 %}
    {% assign hero_image_h = 941 %}
  {% endif %}

  <!-- Imagery Backdrop: video takes priority when configured, otherwise the
       product image — heavy, moody, and kept behind the mesh + scrim. -->
  {% if section.settings.hero_video_url != blank %}
    <div class="absolute inset-0 z-0 pointer-events-none">
      <video class="w-full h-full object-cover opacity-30 mix-blend-screen" autoplay muted loop playsinline>
        <source src="{{ section.settings.hero_video_url }}" type="video/mp4">
      </video>
    </div>
  {% else %}
    {% comment %} Hero backdrop — eager-loaded, high priority; opacity tuned so the image reads through the scrim layer. {% endcomment %}
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
      <img
        src="{{ hero_image_url }}"
        alt=""
       {% if hero_image_w != blank %}
        width="{{ hero_image_w }}"
        height="{{ hero_image_h }}"
        {% endif %}
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="h-full w-full object-cover opacity-[0.62]"
      >
      <div class="absolute inset-0 bg-gradient-to-b from-black/45 via-transparent to-black/85"></div>
      <div class="absolute inset-0" style="background: radial-gradient(circle at 50% 42%, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.5) 78%);"></div>
    </div>
  {% endif %}

  <!-- Atmosphere Layer: Radial Glow & Cyber Mesh Grid -->
  <div
    class="absolute inset-0 z-[1] pointer-events-none"
    style="
      background-image:
        radial-gradient(circle at 50% 38%, rgba(255, 0, 51, 0.25) 0%, rgba(0, 0, 0, 0.95) 72%),
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 100% 100%, 32px 32px, 32px 32px;
    "
  ></div>

  <!-- Centered Content Stack -->
  <div class="relative z-10 mx-auto flex w-full max-w-md flex-col items-center justify-center my-auto">
    <!-- Top Eyebrow Tag -->
    <div class="inline-flex items-center gap-2 border border-brand/60 bg-brand/10 px-3.5 py-1.5 font-mono-tech text-[11px] font-bold uppercase tracking-[1.5px] text-white shadow-[0_0_12px_rgba(255,0,51,0.2)]">
      <span class="h-1.5 w-1.5 bg-brand shadow-[0_0_8px_#FF0033] animate-pulse"></span>
      {{ section.settings.hero_badge | default: 'DROP 01 // DISPATCHED FROM MADURAI' }}
    </div>

    <!-- Main Headline with Red Accent Glow -->
    <h1 class="mt-5 font-display text-center uppercase tracking-tight leading-[0.95]">
      <span class="block text-[clamp(2.1rem,8.5vw,4.5rem)] text-white font-extrabold">
        {{ section.settings.hero_title_line_1 | default: 'Y2K HARDWARE' }}
      </span>
      <span class="block text-[clamp(2.3rem,9.2vw,4.8rem)] text-brand font-black drop-shadow-[0_0_20px_rgba(255,0,51,0.4)]">
        {{ section.settings.hero_title_line_2 | default: 'AFTER DARK.' }}
      </span>
    </h1>

    <!-- Subhead -->
    <p class="mt-4 max-w-[340px] w-full font-mono-tech text-[13px] leading-relaxed text-white/70 text-center break-words [overflow-wrap:break-word] px-1">
      {{ section.settings.hero_subtitle | default: 'After dark, no rules. High-polish stainless steel and nocturnal audio for those who operate off the grid.' }}
    </p>

    <!-- Dispatch note (no fabricated scarcity) -->
    <div class="mt-6 inline-flex items-center gap-2 font-mono-tech text-[10px] font-bold uppercase tracking-wider text-brand bg-card border border-brand/30 px-3 py-1">
      <span class="h-1.5 w-1.5 rounded-full bg-brand shadow-[0_0_8px_#FF0033] animate-ping"></span>
      <span>DROP 01 // 316L HARDWARE · DISPATCHED FROM MADURAI</span>
    </div>

    <!-- CTA Group -->
    <div class="mt-6 flex w-full max-w-[340px] flex-col gap-3">
      <a 
        href="#shop" 
        class="rwnd-lift flex h-[52px] w-full items-center justify-center gap-2 bg-brand font-mono-tech text-[13px] font-bold uppercase tracking-[1.5px] text-white shadow-[0_4px_20px_rgba(255,0,51,0.35)] transition-all active:scale-[0.98] active:bg-brand-dark hover:bg-brand-dark"
      >
        SHOP DROP 01 →
      </a>
      <a 
        href="#about" 
        class="flex h-[52px] w-full items-center justify-center border border-white/30 bg-transparent font-mono-tech text-[13px] font-medium uppercase tracking-[1.5px] text-white transition-all active:scale-[0.98] active:border-white active:bg-white/5 hover:border-white"
      >
        VIEW MANIFESTO
      </a>
    </div>
  </div>

  <!-- Animated Scroll Indicator -->
  <a 
    href="#drop-status-bar" 
    class="relative z-10 mt-auto pt-4 flex flex-col items-center gap-1 font-mono-tech text-[9px] uppercase tracking-[2px] text-white/40 hover:text-white transition-colors cursor-pointer"
  >
    <span>EXPLORE ARCHIVE</span>
    <span class="text-xs animate-bounce">↓</span>
  </a>
</section>

<!-- ========================================================================= -->
<!-- 2.2 DROP STATUS BAR (URGENCY MARQUEE)                                     -->
<!-- ========================================================================= -->
<section id="drop-status-bar" class="relative z-20 h-20 w-full overflow-hidden bg-brand text-black font-mono-tech flex items-center border-y border-black">
  <div class="rwnd-marquee-track flex whitespace-nowrap text-sm sm:text-base font-bold tracking-[2px] uppercase select-none">
    <div class="flex items-center gap-8 px-4">
      <span>● LIVE NOW</span>
      <span>·</span>
      <span>DROP 01</span>
      <span>·</span>
      <span>316L STAINLESS STEEL</span>
      <span>·</span>
      <span>MYSTERY VAULT</span>
      <span>·</span>
      <span>OFF-GRID</span>
      <span>·</span>
      <span>DISPATCHED IN 24H FROM MADURAI</span>
      <span>·</span>
    </div>
    <div class="flex items-center gap-8 px-4" aria-hidden="true">
      <span>● LIVE NOW</span>
      <span>·</span>
      <span>DROP 01</span>
      <span>·</span>
      <span>316L STAINLESS STEEL</span>
      <span>·</span>
      <span>MYSTERY VAULT</span>
      <span>·</span>
      <span>OFF-GRID</span>
      <span>·</span>
      <span>DISPATCHED IN 24H FROM MADURAI</span>
      <span>·</span>
    </div>
  </div>
</section>

<!-- ========================================================================= -->
<!-- 2.3 CATEGORY SELECTION GRID (2x2 Mobile, 4-Col Desktop)                   -->
<!-- ========================================================================= -->
<section class="w-full bg-card p-0.5">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-0.5 max-w-7xl mx-auto">
    <!-- Tile 01: Mystery 3-Piece Set -->
    <a href="{{ cyber_set_url }}" class="group relative aspect-square w-full overflow-hidden border border-line bg-surface p-5 sm:p-6 flex flex-col justify-end transition-all hover:border-brand">
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10 transition-opacity group-hover:opacity-75"></div>
      <div class="absolute inset-0 flex items-center justify-center opacity-40 group-hover:scale-105 group-hover:opacity-60 transition-all duration-500">
        <svg class="h-20 w-20 sm:h-24 sm:w-24 text-line" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
      </div>
      <div class="relative z-20">
        <span class="font-mono-tech text-xs font-bold text-brand">01 // MYSTERY</span>
        <h3 class="mt-1 font-display text-base sm:text-xl font-bold uppercase text-white leading-tight">3-PIECE CYBER VAULT</h3>
        <span class="mt-2 inline-block font-mono-tech text-[10px] uppercase tracking-wider text-muted group-hover:text-white transition-colors">UNLOCK BOX →</span>
      </div>
    </a>

    <!-- Tile 02: Rings & Chains -->
    <a href="{{ rings_url }}" class="group relative aspect-square w-full overflow-hidden border border-line bg-surface p-5 sm:p-6 flex flex-col justify-end transition-all hover:border-brand">
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10 transition-opacity group-hover:opacity-75"></div>
      <div class="absolute inset-0 flex items-center justify-center opacity-40 group-hover:scale-105 group-hover:opacity-60 transition-all duration-500">
        <svg class="h-20 w-20 sm:h-24 sm:w-24 text-line" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="7" stroke-width="1.5"/></svg>
      </div>
      <div class="relative z-20">
        <span class="font-mono-tech text-xs font-bold text-brand">02 // 316L STEEL</span>
        <h3 class="mt-1 font-display text-base sm:text-xl font-bold uppercase text-white leading-tight">RINGS & CHAINS</h3>
        <span class="mt-2 inline-block font-mono-tech text-[10px] uppercase tracking-wider text-muted group-hover:text-white transition-colors">BROWSE DESIGNS →</span>
      </div>
    </a>

    <!-- Tile 03: Pink Chrome Audio -->
    <a href="{{ earphones_url }}" class="group relative aspect-square w-full overflow-hidden border border-line bg-surface p-5 sm:p-6 flex flex-col justify-end transition-all hover:border-brand">
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10 transition-opacity group-hover:opacity-75"></div>
      <div class="absolute inset-0 flex items-center justify-center opacity-40 group-hover:scale-105 group-hover:opacity-60 transition-all duration-500">
        <svg class="h-20 w-20 sm:h-24 sm:w-24 text-line" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="1.5" d="M3 18v-6a9 9 0 0118 0v6M3 18a3 3 0 003 3h1V15H4a1 1 0 00-1 1v2zm18 0a3 3 0 01-3 3h-1V15h3a1 1 0 011 1v2z"/></svg>
      </div>
      <div class="relative z-20">
        <span class="font-mono-tech text-xs font-bold text-brand">03 // TYPE-C DAC</span>
        <h3 class="mt-1 font-display text-base sm:text-xl font-bold uppercase text-white leading-tight">PINK CHROME AUDIO</h3>
        <span class="mt-2 inline-block font-mono-tech text-[10px] uppercase tracking-wider text-muted group-hover:text-white transition-colors">SHOP →</span>
      </div>
    </a>

    <!-- Tile 04: Timepieces -->
    <a href="{{ watches_url }}" class="group relative aspect-square w-full overflow-hidden border border-line bg-surface p-5 sm:p-6 flex flex-col justify-end transition-all hover:border-brand">
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10 transition-opacity group-hover:opacity-75"></div>
      <div class="absolute inset-0 flex items-center justify-center opacity-40 group-hover:scale-105 group-hover:opacity-60 transition-all duration-500">
        <svg class="h-20 w-20 sm:h-24 sm:w-24 text-line" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6" stroke-width="1.5"/><path stroke-width="1.5" d="M12 2v4m0 12v4"/></svg>
      </div>
      <div class="relative z-20">
        <span class="font-mono-tech text-xs font-bold text-brand">04 // PRE-ORDER</span>
        <h3 class="mt-1 font-display text-base sm:text-xl font-bold uppercase text-white leading-tight">ANALOG TIMEPIECES</h3>
        <span class="mt-2 inline-block font-mono-tech text-[10px] uppercase tracking-wider text-muted group-hover:text-white transition-colors">RESERVE →</span>
      </div>
    </a>
  </div>
</section>

<!-- ========================================================================= -->
<!-- 2.4 FEATURED PRODUCT SPOTLIGHT (MYSTERY VAULT 50/50 SPLIT)                -->
<!-- ========================================================================= -->
{% if spotlight_product %}
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-b border-line">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
    <!-- Left: Large Image Container -->
    <div class="relative aspect-square w-full overflow-hidden border border-line bg-surface p-6 flex items-center justify-center">
      {% if spotlight_product.featured_image %}
        <img 
          src="{{ spotlight_product.featured_image | image_url: width: 900 }}" 
          alt="{{ spotlight_product.title | escape }}" 
          width="900" 
          height="900"
          loading="lazy" 
          class="h-full w-full object-contain"
        >
      {% else %}
        <div class="font-mono-tech text-xs uppercase tracking-widest text-muted">MYSTERY VAULT ASSET</div>
      {% endif %}
      <span class="absolute top-4 left-4 border border-brand bg-black px-2.5 py-1 font-mono-tech text-[10px] font-bold uppercase text-brand">
        CLASSIFIED MYSTERY DROP
      </span>
    </div>

    <!-- Right: Specifications & Direct Purchase Action -->
    <div class="flex flex-col justify-center">
      <span class="font-mono-tech text-xs font-bold uppercase tracking-[0.14em] text-brand">
        // BLIND ARCHIVE CURATION · FREE SIZE / ADJUSTABLE
      </span>
      <h2 class="mt-2 font-display text-3xl sm:text-5xl font-extrabold uppercase text-white">
        {{ spotlight_product.title | default: '3-PIECE MYSTERY CYBER SET' }}
      </h2>

      <!-- Price & Savings Badge (must match the variant added to the cart) -->
      {% assign spotlight_variant = spotlight_product.selected_or_first_available_variant %}
      <div class="mt-4 flex items-center gap-3">
        <span class="font-mono-tech text-2xl font-extrabold text-white">
          {{ spotlight_variant.price | money }}
        </span>
        {% if spotlight_variant.compare_at_price > spotlight_variant.price %}
          {% assign spot_save = spotlight_variant.compare_at_price | minus: spotlight_variant.price %}
          <span class="font-mono-tech text-sm text-muted line-through">
            {{ spotlight_variant.compare_at_price | money }}
          </span>
          <span class="border border-brand bg-brand/20 px-2 py-0.5 font-mono-tech text-xs font-bold text-brand">
            SAVE {{ spot_save | money }}
          </span>
        {% endif %}
      </div>

      <p class="mt-4 font-mono-tech text-xs sm:text-sm text-muted leading-relaxed">
        1 Mystery Chain + Pendant, 1 Mystery Link Bracelet, and 1 Mystery Chrome Ring. All pieces are 316L stainless steel with universal adjustable sizing.
      </p>

      <div class="mt-3 border-l-2 border-brand bg-surface px-3 py-2 font-mono-tech text-[11px] text-ice">
        ⚠ MYSTERY LOADOUT: Designs are randomly selected from Drop 01 stock. Final sale—exchanges only for defects (48-hr unboxing video required).
      </div>

      <!-- Cart Action Form -->
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="mt-6">
        <input type="hidden" name="id" value="{{ spotlight_product.selected_or_first_available_variant.id }}">
        
        <div class="flex flex-col sm:flex-row gap-3">
          <button
            type="submit"
            {% unless spotlight_product.available %}disabled{% endunless %}
            class="flex-1 h-14 bg-brand font-mono-tech text-xs font-bold uppercase tracking-wider text-white hover:bg-brand-dark transition-all cursor-pointer flex items-center justify-center disabled:cursor-not-allowed disabled:opacity-40"
          >
            {% if spotlight_product.available %}+ UNLOCK MYSTERY SET — {{ spotlight_variant.price | money }}{% else %}SOLD OUT{% endif %}
          </button>
          <button
            type="button"
            data-rwnd-instant-checkout
            {% unless spotlight_product.available %}disabled{% endunless %}
            class="h-14 px-8 border border-line bg-surface font-mono-tech text-xs font-bold uppercase tracking-wider text-white hover:border-brand transition-all flex items-center justify-center cursor-pointer disabled:cursor-not-allowed disabled:opacity-40"
          >
            INSTANT CHECKOUT →
          </button>
        </div>
      </form>

      <!-- Trust Badges Row -->
      <div class="mt-8 grid grid-cols-3 gap-2 border-t border-line pt-4 font-mono-tech text-[10px] uppercase text-muted text-center">
        <div class="p-2 border border-line bg-card">🛡️ COD Available</div>
        <div class="p-2 border border-line bg-card">⚙️ Free Size Fit</div>
        <div class="p-2 border border-line bg-card">🚚 24-Hr MDU</div>
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- ========================================================================= -->
<!-- 2.5 PRODUCT GRID — "SHOP THE ARCHIVE"                                     -->
<!-- ========================================================================= -->
<section id="shop" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-b border-line">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-line pb-6">
    <div>
      <span class="font-mono-tech text-xs font-bold uppercase tracking-[1.5px] text-brand">
        DROP 01 // ARCHIVE COLLECTION
      </span>
      <h2 class="mt-1 font-display text-2xl sm:text-4xl font-extrabold uppercase text-white">
        Y2K HARDWARE ARCHIVE
      </h2>
    </div>
    <div class="flex items-center gap-4">
      <span class="font-mono-tech text-xs text-muted">
        {{ archive_collection.products.size }} PIECES // DISPATCHED FROM MADURAI
      </span>
      <a href="{{ routes.all_products_collection_url }}" class="font-mono-tech text-xs font-bold uppercase text-brand hover:underline">
        [VIEW ALL →]
      </a>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    {% for product in archive_collection.products limit: 8 %}
      {% assign is_bundle = false %}
      {% assign p_handle = product.handle | downcase %}
      {% assign p_title = product.title | downcase %}
      {% if p_handle contains 'cyber-set' or p_title contains 'cyber set' %}
        {% assign is_bundle = true %}
      {% endif %}

      <article class="group relative flex flex-col justify-between border border-line bg-surface p-3 sm:p-4 transition-all hover:border-brand">
        <div class="relative aspect-[4/5] w-full overflow-hidden border border-line bg-card flex items-center justify-center">
          <a href="{{ product.url }}" class="flex h-full w-full items-center justify-center">
            {% if product.featured_image %}
              <img 
                src="{{ product.featured_image | image_url: width: 600 }}" 
                alt="{{ product.title | escape }}" 
                width="600" 
                height="750" 
                loading="lazy" 
                class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
              >
            {% else %}
              <span class="font-mono-tech text-[10px] text-muted uppercase text-center px-2">{{ product.title | escape }}</span>
            {% endif %}
          </a>

           <!-- Badges -->
          {% if is_bundle %}
            <span class="absolute top-2 left-2 border border-brand bg-card px-1.5 py-0.5 font-mono-tech text-[9px] font-bold text-brand">
              MYSTERY VAULT
            </span>
          {% elsif product.tags contains 'watch' or product.tags contains 'pre-order' or product.type contains 'Watch' %}
            <span class="absolute top-2 right-2 border border-brand bg-brand/20 px-1.5 py-0.5 font-mono-tech text-[9px] font-bold text-brand">
              PRE-ORDER
            </span>
          {% else %}
            <span class="absolute top-2 right-2 border border-line bg-card px-1.5 py-0.5 font-mono-tech text-[9px] font-bold text-muted">
              DROP 01
            </span>
          {% endif %}
        </div>

        <div class="mt-3 flex flex-col justify-between flex-1">
          <div>
            <h3 class="font-display text-xs sm:text-sm font-bold uppercase text-white line-clamp-1">
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h3>
            <div class="mt-1 flex items-baseline gap-2 font-mono-tech text-xs sm:text-sm font-bold text-white">
              {% if product.price_varies %}
                <span>FROM {{ product.price_min | money }}</span>
                {% if product.compare_at_price_max > product.price_min %}
                  <span class="text-[10px] text-muted line-through">{{ product.compare_at_price_max | money }}</span>
                {% endif %}
              {% else %}
                <span>{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="text-[10px] text-muted line-through">{{ product.compare_at_price | money }}</span>
                {% endif %}
              {% endif %}
            </div>
          </div>

          {% if product.price_varies %}
            <a href="{{ product.url }}" class="mt-3 flex h-10 w-full items-center justify-center border border-line bg-card font-mono-tech text-[10px] font-bold uppercase tracking-wider text-white hover:border-brand transition-colors">
              VIEW OPTIONS
            </a>
          {% elsif product.available %}
            <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="mt-3">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button
                type="submit"
                class="w-full h-10 border border-line bg-card font-mono-tech text-[10px] font-bold uppercase tracking-wider text-white hover:bg-brand hover:border-brand transition-colors cursor-pointer"
              >
                + QUICK ADD
              </button>
            </form>
          {% else %}
            <button type="button" disabled class="mt-3 w-full h-10 border border-line bg-card font-mono-tech text-[10px] font-bold uppercase tracking-wider text-muted cursor-not-allowed">
              SOLD OUT
            </button>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<!-- ========================================================================= -->
<!-- 2.6 BRAND MANIFESTO SECTION                                              -->
<!-- ========================================================================= -->
<section id="about" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-b border-line">
  <div class="mx-auto max-w-3xl border border-line bg-surface p-6 sm:p-12 text-center">
    <div class="inline-flex items-center gap-2 border border-brand/60 bg-black px-3 py-1 font-mono-tech text-[10px] font-bold uppercase tracking-[1.5px] text-white">
      <span class="h-1.5 w-1.5 bg-brand"></span>
      [ RWND20S.SYS // BRAND MANIFESTO ]
    </div>

