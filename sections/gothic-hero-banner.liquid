<!-- sections/gothic-hero-banner.liquid -->
<div class="rwnd-gothic-banner">

  <!-- Atmospheric Blood-Red Moon & Vintage Street Lamp Glow Background -->
  <div class="rwnd-gothic-banner-bg">
    <!-- Blood-Red Moon (Top Center) -->
    <div class="rwnd-gothic-banner-moon"></div>
    <div class="rwnd-gothic-banner-moon-core"></div>

    <!-- Retro Street Lamp Cone Light Effect -->
    <div class="rwnd-gothic-banner-lamp"></div>

    <!-- Dark Asphalt Road Perspective Lines (Subtle SVG Overlay) -->
    <div class="rwnd-gothic-banner-road-texture"></div>
  </div>

  <!-- Top Navigation Status -->
  <div class="relative z-10 flex items-center justify-between border-b border-white/10 pb-4">
    <div class="rwnd-gothic-banner-status flex items-center gap-2">
      <span class="rwnd-gothic-banner-status-dot"></span>
      <span class="text-[10px] uppercase tracking-widest text-[#E9E3D5]/70">SECTOR // MDU_DISPATCH</span>
    </div>
    <span class="text-[10px] uppercase tracking-widest text-zinc-500">ATMOSPHERE: NOCTURNE</span>
  </div>

  <!-- Center Hero Content -->
  <div class="relative z-10 my-auto max-w-3xl py-12">
    <div class="rwnd-gothic-banner-badge inline-flex items-center gap-2 mb-6">
      <span>✦ DROP 01 // ARCHIVE VAULT</span>
    </div>

    <h1 class="rwnd-gothic-banner-title">
      MIDNIGHT <br><span class="rwnd-gothic-banner-title-red">HIGHWAY</span>
    </h1>

    <p class="rwnd-gothic-banner-desc mt-4">
      Heavy 316L stainless steel hardware, analog chronographs, and pink chrome audio engineered for the underground. Walk the dark road.
    </p>

    <!-- Brutalist CTAs -->
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="{{ routes.all_products_collection_url }}" class="rwnd-gothic-banner-cta-primary cursor-pointer">
        EXPLORE DROP 01 →
      </a>
      <a href="#about" class="rwnd-gothic-banner-cta-secondary cursor-pointer">
        VIEW MANIFESTO
      </a>
    </div>
  </div>

  <!-- Bottom Ticker -->
  <div class="rwnd-gothic-banner-ticker">
    <span>LAT: 9.9252° N</span>
    <span>ENCRYPTED VIBE // SECURE</span>
  </div>
</div>

{% schema %}
{
  "name": "Gothic Blood Moon Banner",
  "settings": [],
  "presets": [
    {
      "name": "Gothic Blood Moon Banner"
    }
  ]
}
{% endschema %}