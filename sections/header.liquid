<!-- sections/header.liquid -->
<header-system id="rwnd-header-system" class="fixed top-0 left-0 z-[120] w-full transition-transform duration-300">
  <!-- 1.1 TOP ANNOUNCEMENT BAR -->
  <aside id="rwnd-announcement-bar" class="relative z-10 w-full bg-[#000000] border-b border-[#2A2A2F] text-white">
    <div class="mx-auto flex h-[36px] sm:h-[40px] max-w-7xl items-center justify-between px-4 sm:px-6">
      <div class="w-6 hidden sm:block"></div>

      <!-- Rotating Messages Container -->
      <div id="announcement-track" class="relative flex-1 h-full flex items-center justify-center overflow-hidden">
        <div class="announcement-item active flex items-center gap-2 font-mono-tech text-[11px] uppercase tracking-[1.5px] transition-opacity duration-500">
          <span class="h-1.5 w-1.5 bg-[#FF0033]"></span>
          <span>FREE DELIVERY ON ORDERS ₹999+</span>
        </div>
        <div class="announcement-item flex items-center gap-2 font-mono-tech text-[11px] uppercase tracking-[1.5px] transition-opacity duration-500 opacity-0 pointer-events-none absolute">
          <span class="h-1.5 w-1.5 bg-[#FF0033]"></span>
          <span>COD AVAILABLE PAN-INDIA</span>
        </div>
        <div class="announcement-item flex items-center gap-2 font-mono-tech text-[11px] uppercase tracking-[1.5px] transition-opacity duration-500 opacity-0 pointer-events-none absolute">
          <span class="h-1.5 w-1.5 bg-[#FF0033]"></span>
          <span>DISPATCHED IN 24HRS FROM MADURAI</span>
        </div>
        <div class="announcement-item flex items-center gap-2 font-mono-tech text-[11px] uppercase tracking-[1.5px] transition-opacity duration-500 opacity-0 pointer-events-none absolute">
          <span class="h-1.5 w-1.5 bg-[#FF0033]"></span>
          <span>DROP 01 // LIMITED STOCK</span>
        </div>
      </div>

      <!-- Dismiss Button -->
      <button 
        type="button" 
        id="dismiss-announcement" 
        aria-label="Dismiss Announcement"
        class="flex h-6 w-6 items-center justify-center text-[#A3A7AE] hover:text-white transition-colors cursor-pointer"
      >
        ✕
      </button>
    </div>
  </aside>

  <!-- 1.2 MAIN NAVIGATION -->
