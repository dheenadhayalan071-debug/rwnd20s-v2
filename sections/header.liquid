<!-- sections/header.liquid -->
<style>
  @media (min-width: 1024px) {
    #rwnd-mega-menu.rwnd-open {
      visibility: visible !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }
    #rwnd-mega-menu.rwnd-open #HeaderShopTrigger {
      color: #FF0033;
    }
  }

  /* ==========================================================================
     UNIFIED HEADER & ANNOUNCEMENT BAR (CLEAN, NO BUTTON SOUP)
     ========================================================================== */
  .announcement-bar {
    width: 100%;
    height: 32px;
    background-color: #050505;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 161;
  }

  .announcement-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.68rem;
    color: #CCCCCC;
    letter-spacing: 0.05em;
    padding: 0 16px;
    text-align: center;
    max-width: 100%;
    overflow: hidden;
  }

  .announcement-inner .pulse-pip {
    width: 5px;
    height: 5px;
    background-color: var(--red-core, #FF0033);
    box-shadow: 0 0 6px var(--red-core, #FF0033);
    display: inline-block;
    flex-shrink: 0;
  }

  .announcement-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Sticky Main Header */
  .site-header {
    position: sticky;
    top: 0;
    width: 100%;
    height: 56px;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 160;
  }

  .header-container {
    max-width: 1200px;
    height: 100%;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Brand Logo */
  .brand-logo {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .brand-logo .logo-text {
    font-family: var(--font-display, 'Druk Wide Bold', 'Syne', sans-serif);
    font-size: clamp(1.1rem, 4vw, 1.35rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    text-transform: uppercase;
  }

  .brand-logo .text-red {
    color: var(--red-core, #FF0033);
  }

  /* Integrated Action Group (Single Hairline Container) */
  .header-actions {
    display: flex;
    align-items: center;
    background: #0A0A0A;
    border: 1px solid rgba(255, 255, 255, 0.1);
    height: 38px;
  }

  .action-btn {
    background: transparent;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    width: 40px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    cursor: pointer;
    position: relative;
    transition: background-color 0.15s ease;
    padding: 0;
  }

  .action-btn:last-child {
    border-right: none;
  }

  .action-btn:active {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .header-icon {
    width: 17px;
    height: 17px;
    stroke: #FFFFFF;
  }

  /* Bag Counter Pill */
  .action-btn--cart {
    width: auto;
    padding: 0 10px;
    gap: 6px;
    text-decoration: none;
  }

  .cart-pill {
    background: var(--red-core, #FF0033);
    color: #FFFFFF;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 1px 5px;
    min-width: 16px;
    text-align: center;
    line-height: 1.2;
  }

  /* Minimalist Brutalist Burger */
  .menu-burger {
    width: 16px;
    height: 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .burger-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: #FFFFFF;
  }
</style>

