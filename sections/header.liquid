<!-- sections/header.liquid -->
<div class="relative z-40 w-full border-b border-[#2A2A2F] bg-[#0A0A0C] px-3 py-2 text-center">
  <div class="mx-auto flex max-w-7xl items-center justify-center gap-3">
    <p class="truncate font-mono-tech text-[11px] font-medium uppercase tracking-[0.12em] text-[#F5F5F7]">
      {{ section.settings.announcement_text | escape }}
    </p>
    <button id="rwnd-open-welcome-popup" type="button" class="hidden items-center border border-[#C8102E] bg-[#C8102E]/20 px-2.5 py-0.5 font-mono-tech text-[10px] font-semibold text-[#F5F5F7] transition-colors hover:bg-[#C8102E] md:inline-flex rounded-none">
      ACCESS ARCHIVE
    </button>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-[#2A2A2F] bg-[#0A0A0C]/95 backdrop-blur-2xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name | default: 'rwnd20s.' | escape }}" class="inline-flex shrink-0 items-center whitespace-nowrap transition-opacity hover:opacity-80">
      <span class="font-display text-xl font-extrabold tracking-tighter text-[#F5F5F7] sm:text-2xl">{{ settings.brand_name | default: 'rwnd20s.' | escape }}</span>
    </a>

    <!-- Desktop Navigation (Phase 1 Complete with Watches) -->
    <nav aria-label="Main Navigation" class="hidden items-center gap-7 lg:flex xl:gap-8">
      <a href="{{ routes.root_url }}" class="border-b border-[#C8102E] pb-0.5 font-mono-tech text-xs uppercase tracking-widest text-[#F5F5F7]">Home</a>
      <a href="/collections/all" class="font-mono-tech text-xs uppercase tracking-widest text-[#A3A7AE] transition-colors hover:text-[#F5F5F7]">Shop All</a>
      <a href="/collections/rings" class="font-mono-tech text-xs uppercase tracking-widest text-[#A3A7AE] transition-colors hover:text-[#F5F5F7]">Rings</a>
      <a href="/collections/chains" class="font-mono-tech text-xs uppercase tracking-widest text-[#A3A7AE] transition-colors hover:text-[#F5F5F7]">Chains</a>
      <a href="/collections/bracelets" class="font-mono-tech text-xs uppercase tracking-widest text-[#A3A7AE] transition-colors hover:text-[#F5F5F7]">Bracelets</a>
      <a href="/collections/earphones" class="font-mono-tech text-xs uppercase tracking-widest text-[#A3A7AE] transition-colors hover:text-[#F5F5F7]">Earphones</a>
      <a href="/collections/watches" class="font-mono-tech text-xs uppercase tracking-widest text-[#A3A7AE] transition-colors hover:text-[#F5F5F7]">Watches</a>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <!-- Search Trigger -->
      <button type="button" data-toggle-search aria-controls="rwnd-search-panel" aria-expanded="false" aria-label="Open search" class="inline-flex h-10 w-10 items-center justify-center border border-[#2A2A2F] bg-[#131316] text-[#F5F5F7] transition-all hover:border-[#C8102E] rounded-none">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      </button>

      <!-- Cart Button (0px geometry, strict blood accent) -->
      <a href="{{ routes.cart_url }}" aria-label="Hardware Bag" class="inline-flex items-center gap-2 border border-[#2A2A2F] bg-[#131316] px-3 py-2 font-mono-tech text-[11px] font-semibold text-[#F5F5F7] transition-all hover:border-[#C8102E] rounded-none">
        <svg class="h-3.5 w-3.5 text-[#C8102E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
        <span class="hidden sm:inline">BAG</span>
        <span data-cart-count class="inline-flex h-4 min-w-[16px] items-center justify-center bg-[#C8102E] px-1 font-mono-tech text-[10px] font-bold text-[#F5F5F7] rounded-none">{{ cart.item_count }}</span>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button type="button" data-toggle-mobile-menu aria-label="Open Menu" aria-controls="rwnd-mobile-menu" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center border border-[#2A2A2F] bg-[#131316] text-[#F5F5F7] transition-all hover:border-[#C8102E] lg:hidden rounded-none">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
</header>

<!-- Search Overlay Modal -->
<div id="rwnd-search-panel" class="fixed inset-0 z-[150] hidden items-start justify-center bg-[#0A0A0C]/90 px-4 pt-[15vh] backdrop-blur-md" role="dialog" aria-modal="true" aria-label="Search the archive">
  <div class="w-full max-w-xl border border-[#2A2A2F] bg-[#131316] p-4 shadow-2xl sm:p-6 rounded-none">
    <div class="mb-4 flex items-center justify-between">
      <p class="font-mono-tech text-xs font-bold uppercase tracking-[0.12em] text-[#C8CDD3]">SEARCH ARCHIVE</p>
      <button type="button" data-close-search aria-label="Close search" class="inline-flex h-8 w-8 items-center justify-center border border-[#2A2A2F] text-[#F5F5F7] hover:border-[#C8102E] rounded-none">×</button>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="flex gap-2">
      <label class="sr-only" for="rwnd-search-input">Search products</label>
      <input id="rwnd-search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="RINGS, CHAINS, WATCHES..." autocomplete="off" class="min-h-12 min-w-0 flex-1 border border-[#2A2A2F] bg-[#0A0A0C] px-4 font-mono-tech text-sm text-[#F5F5F7] placeholder:text-[#A3A7AE] focus:border-[#C8102E] focus:outline-none rounded-none" />
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="min-h-12 border border-[#C8102E] bg-[#C8102E] px-6 font-mono-tech text-xs font-bold uppercase tracking-wider text-[#F5F5F7] hover:bg-[#E0213F] rounded-none cursor-pointer">SEARCH</button>
    </form>
  </div>
</div>

<!-- Mobile Drawer Navigation -->
<div id="rwnd-mobile-menu" role="dialog" aria-modal="true" aria-label="Mobile Navigation" class="fixed inset-0 z-[120] hidden flex-col justify-between bg-[#0A0A0C] p-6 text-[#F5F5F7] backdrop-blur-3xl">
  <div class="flex items-center justify-between border-b border-[#2A2A2F] pb-4">
    <span class="font-display text-xl font-extrabold tracking-tighter text-[#F5F5F7]">{{ settings.brand_name | default: 'rwnd20s.' | escape }}</span>
    <button type="button" data-toggle-mobile-menu aria-label="Close Menu" class="inline-flex h-10 w-10 items-center justify-center border border-[#2A2A2F] bg-[#131316] text-[#F5F5F7] hover:border-[#C8102E] rounded-none">×</button>
  </div>

  <nav aria-label="Mobile collections" class="my-auto flex flex-col">
    <a href="{{ routes.root_url }}" data-toggle-mobile-menu class="border-b border-[#2A2A2F] py-3 font-display text-xl font-extrabold uppercase tracking-tight text-[#F5F5F7] transition-colors hover:text-[#C8102E]">01 // HOME</a>
    <a href="/collections/all" data-toggle-mobile-menu class="border-b border-[#2A2A2F] py-3 font-display text-xl font-extrabold uppercase tracking-tight text-[#F5F5F7] transition-colors hover:text-[#C8102E]">02 // SHOP ALL</a>
    <a href="/collections/rings" data-toggle-mobile-menu class="border-b border-[#2A2A2F] py-3 font-display text-xl font-extrabold uppercase tracking-tight text-[#F5F5F7] transition-colors hover:text-[#C8102E]">03 // RINGS</a>
    <a href="/collections/chains" data-toggle-mobile-menu class="border-b border-[#2A2A2F] py-3 font-display text-xl font-extrabold uppercase tracking-tight text-[#F5F5F7] transition-colors hover:text-[#C8102E]">04 // CHAINS</a>
    <a href="/collections/bracelets" data-toggle-mobile-menu class="border-b border-[#2A2A2F] py-3 font-display text-xl font-extrabold uppercase tracking-tight text-[#F5F5F7] transition-colors hover:text-[#C8102E]">05 // BRACELETS</a>
    <a href="/collections/earphones" data-toggle-mobile-menu class="border-b border-[#2A2A2F] py-3 font-display text-xl font-extrabold uppercase tracking-tight text-[#F5F5F7] transition-colors hover:text-[#C8102E]">06 // EARPHONES</a>
    <a href="/collections/watches" data-toggle-mobile-menu class="border-b border-[#2A2A2F] py-3 font-display text-xl font-extrabold uppercase tracking-tight text-[#F5F5F7] transition-colors hover:text-[#C8102E]">07 // WATCHES</a>
    <a href="{{ routes.cart_url }}" data-toggle-mobile-menu class="border-b border-[#2A2A2F] py-3 font-display text-xl font-extrabold uppercase tracking-tight text-[#F5F5F7] transition-colors hover:text-[#C8102E]">08 // HARDWARE BAG</a>
  </nav>

  <div class="border-t border-[#2A2A2F] pt-4 font-mono-tech text-[10px] uppercase tracking-wider text-[#A3A7AE]">
    FREE DELIVERY ON ₹999+ · COD AVAILABLE · DISPATCHED FROM MADURAI
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Search Panel Handlers
    const panel = document.getElementById('rwnd-search-panel');
    const input = document.getElementById('rwnd-search-input');
    const toggleSearch = document.querySelector('[data-toggle-search]');
    const closeSearch = panel?.querySelector('[data-close-search]');

    const openSearch = () => {
      if (!panel) return;
      panel.classList.remove('hidden');
      panel.classList.add('flex');
      toggleSearch?.setAttribute('aria-expanded', 'true');
      window.setTimeout(() => input?.focus(), 50);
    };

    const closeSearchModal = () => {
      panel?.classList.add('hidden');
      panel?.classList.remove('flex');
      toggleSearch?.setAttribute('aria-expanded', 'false');
    };

    toggleSearch?.addEventListener('click', openSearch);
    closeSearch?.addEventListener('click', closeSearchModal);
    panel?.addEventListener('click', (e) => { if (e.target === panel) closeSearchModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSearchModal(); });

    // Mobile Menu Drawer Handlers
    const mobileMenu = document.getElementById('rwnd-mobile-menu');
    const menuToggles = document.querySelectorAll('[data-toggle-mobile-menu]');

    menuToggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!mobileMenu) return;
        const isHidden = mobileMenu.classList.contains('hidden');
        if (isHidden) {
          mobileMenu.classList.remove('hidden');
          mobileMenu.classList.add('flex');
          document.body.style.overflow = 'hidden';
        } else {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('flex');
          document.body.style.overflow = '';
        }
      });
    });

    // Welcome Popup Trigger Hook
    const welcomeBtn = document.getElementById('rwnd-open-welcome-popup');
    welcomeBtn?.addEventListener('click', () => {
      if (typeof window.showRwndWelcomeModal === 'function') {
        window.showRwndWelcomeModal();
      }
    });
  });
</script>

{% schema %}
{
  "name": "Header & Announcement",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Top Announcement Bar Text",
      "default": "Free delivery on ₹999+ · COD available · Dispatched from Madurai"
    }
  ]
}
{% endschema %}
