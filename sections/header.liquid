<!-- sections/header.liquid -->
<div class="announcement-bar">{{ section.settings.announcement_text | escape }}</div>
<header class="site-header">
  <a class="wordmark" href="{{ routes.root_url }}" aria-label="RWND20s home">rwnd20s.</a>
  <nav aria-label="Main navigation" class="desktop-nav">
    <a href="/collections/all">Shop all</a><a href="/collections/rings">Rings</a><a href="/collections/chains">Chains</a><a href="/collections/bracelets">Bracelets</a><a href="/collections/earphones">Earphones</a><a href="/collections/watches">Watches</a>
  </nav>
  <div class="header-actions"><a href="{{ routes.search_url }}" aria-label="Search">Search</a><a href="{{ routes.cart_url }}" aria-label="Shopping bag">Bag ({{ cart.item_count }})</a></div>
</header>
{% schema %}{"name":"Header","settings":[{"type":"text","id":"announcement_text","label":"Announcement","default":"Free delivery on ₹999 and above. Below ₹999, ₹49."}]}{% endschema %}
