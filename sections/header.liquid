<script>
  // Mobile menu, full-screen search & SHOP mega menu live here.
  (function () {
    const shopTrigger = document.getElementById('HeaderShopTrigger');
    const megaMenu = document.getElementById('rwnd-mega-menu');

    function setShopMenu(open) {
      if (!shopTrigger || !megaMenu) return;
      shopTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      megaMenu.classList.toggle('rwnd-open', open);
    }

    shopTrigger?.addEventListener('click', () => setShopMenu(!megaMenu?.classList.contains('rwnd-open')));
    shopTrigger?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        setShopMenu(!megaMenu?.classList.contains('rwnd-open'));
      }
    });
    if (megaMenu) {
      megaMenu.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setShopMenu(false);
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && megaMenu?.classList.contains('rwnd-open')) setShopMenu(false);
    });
    document.addEventListener('click', (e) => {
      if (!megaMenu?.classList.contains('rwnd-open')) return;
      if (shopTrigger?.contains(e.target) || megaMenu.contains(e.target)) return;
      setShopMenu(false);
    });
  })();

  // Mobile Hamburger Drawer Toggle
  (() => {
    const openBtn = document.getElementById('HeaderMenuTrigger');
    const closeBtn = document.getElementById('close-mobile-menu');
    const overlay = document.getElementById('mobile-drawer-overlay');
    const drawer = document.getElementById('mobile-drawer');

    const openMenu = () => {
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      drawer?.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      drawer?.classList.add('translate-x-full');
      document.body.style.overflow = '';
    };

    openBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeMenu();
    });
  })();

  // Full-Screen Search Overlay
  (() => {
    const searchOpen = document.getElementById('HeaderSearchTrigger');
    const searchClose = document.getElementById('close-search-trigger');
    const searchOverlay = document.getElementById('fullscreen-search-overlay');

    searchOpen?.addEventListener('click', () => {
      searchOverlay?.classList.remove('opacity-0', 'pointer-events-none');
    });

    searchClose?.addEventListener('click', () => {
      searchOverlay?.classList.add('opacity-0', 'pointer-events-none');
    });
  })();
</script>

