<!-- sections/footer.liquid -->
<section id="about" class="relative z-10 mt-6 overflow-hidden border-t border-red-950/40 sm:mt-16">
  <div class="pointer-events-none absolute bottom-1/2 left-1/2 h-[300px] w-[500px] -translate-x-1/2 bg-red-900/20 blur-[120px]"></div>

  <div class="relative z-10 mx-auto max-w-[1280px] px-4 py-7 sm:px-6 sm:py-12 lg:px-8 lg:py-16">
    <div class="overflow-hidden rounded-3xl border border-red-900/30 foggy-glass p-5 shadow-[0_0_60px_rgba(138,3,3,0.15)] sm:p-8 lg:p-12">
      <div class="mb-5 flex items-center justify-between border-b border-white/10 pb-3 sm:mb-8 sm:pb-4">
        <span class="font-mono-tech text-[9px] font-bold uppercase tracking-[0.14em] text-red-300 sm:text-[11px] sm:tracking-widest">[ RWND20S // OLD VIBE. NEW YOU. ]</span>
        <span class="h-2 w-2 rounded-full bg-red-600 animate-pulse"></span>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-7">
          <p class="font-mono-tech text-[10px] font-bold uppercase tracking-[0.16em] text-red-300 sm:text-xs sm:tracking-widest">Y2K // DARK STREET STYLE</p>
          <h2 class="mt-2 font-display text-2xl font-extrabold uppercase leading-tight tracking-tight text-white sm:mt-3 sm:text-3xl lg:text-5xl">BACK TO THE FUTURE, ON THE EDGE.</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#E9E3D5] sm:mt-5 sm:text-base">Metal hardware, chrome accents, and a few sharp essentials for the after-dark circuit.</p>
        </div>

        <div class="grid grid-cols-2 gap-3 lg:col-span-5 lg:gap-4">
          <div class="rounded-2xl border border-white/10 bg-black/70 p-3 transition-colors hover:border-red-600 sm:p-5">
            <span class="font-mono-tech text-lg font-bold text-white sm:text-2xl">316L</span>
            <p class="mt-1 text-[10px] text-[#E9E3D5] sm:text-xs">STAINLESS STEEL</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-black/70 p-3 transition-colors hover:border-red-600 sm:p-5">
            <span class="font-mono-tech text-lg font-bold text-white sm:text-2xl">TYPE-C</span>
            <p class="mt-1 text-[10px] text-[#E9E3D5] sm:text-xs">WIRED AUDIO</p>
          </div>
          <div class="rounded-2xl border border-red-900/50 bg-red-950/30 p-3 transition-colors hover:border-red-500 sm:p-5">
            <span class="font-mono-tech text-base font-bold text-red-300 sm:text-2xl">Y2K</span>
            <p class="mt-1 text-[10px] text-[#E9E3D5] sm:text-xs">CYBER GOTH</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-black/70 p-3 transition-colors hover:border-red-600 sm:p-5">
            <span class="font-mono-tech text-lg font-bold text-white sm:text-2xl">₹999+</span>
            <p class="mt-1 text-[10px] text-[#E9E3D5] sm:text-xs">FREE DELIVERY</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <footer class="mt-5 border-t border-white/10 bg-black/80 backdrop-blur-xl sm:mt-12">
    <div class="mx-auto max-w-[1280px] px-4 py-7 sm:px-6 sm:py-12 lg:px-8">
      <div class="grid grid-cols-1 gap-7 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-5">
          <span class="font-display text-2xl font-extrabold tracking-tighter text-white">rwnd20s.</span>
          <p class="mt-2 max-w-sm text-xs leading-relaxed text-[#E9E3D5]">Old vibe. New you. Y2K accessories, Type-C audio, and small-batch essentials.</p>
          <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-red-900/40 bg-black px-4 py-1.5 font-mono-tech text-[10px] font-bold text-red-300">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-red-600"></span><span>Dispatched from Madurai</span>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:col-span-7">
          <div>
            <h3 class="mb-3 border-b border-white/10 pb-2 font-mono-tech text-xs font-bold uppercase tracking-wider text-white">Shop</h3>
            <ul class="space-y-2 text-xs text-[#E9E3D5]">
              <li><a href="/collections/all" class="hover:text-white">All products</a></li>
              <li><a href="/collections/rings" class="hover:text-white">Rings</a></li>
              <li><a href="/collections/chains" class="hover:text-white">Chains</a></li>
            </ul>
          </div>
          <div>
            <h3 class="mb-3 border-b border-white/10 pb-2 font-mono-tech text-xs font-bold uppercase tracking-wider text-white">Info</h3>
            <ul class="space-y-2 text-xs text-[#E9E3D5]">
              <li><a href="/pages/shipping" class="hover:text-white">Shipping</a></li>
              <li><a href="/pages/returns-and-refunds" class="hover:text-white">Returns</a></li>
              <li><a href="/pages/contact" class="hover:text-white">Contact</a></li>
            </ul>
          </div>
          <div>
            <h3 class="mb-3 border-b border-white/10 pb-2 font-mono-tech text-xs font-bold uppercase tracking-wider text-white">Support</h3>
            <ul class="space-y-2 text-xs text-[#E9E3D5]">
              <li><a href="/pages/faq" class="hover:text-white">FAQ</a></li>
              <li><a href="/pages/privacy-policy" class="hover:text-white">Privacy</a></li>
              <li><a href="/pages/terms-of-service" class="hover:text-white">Terms</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </footer>
</section>

{% schema %}
{
  "name": "Footer & Manifesto",
  "settings": []
}
{% endschema %}
