<!-- sections/main-product.liquid -->
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign title_key = product.title | downcase %}
{% assign handle_key = product.handle | downcase %}

{% assign is_watch = false %}
{% if title_key contains 'watch' or handle_key contains 'w-01' or handle_key contains 'watch' or title_key contains 'chronograph' %}
  {% assign is_watch = true %}
{% endif %}

{% assign is_earphone = false %}
{% if title_key contains 'earphone' or handle_key contains 'ear-01' or handle_key contains 'earphone' or title_key contains 'audio' %}
  {% assign is_earphone = true %}
{% endif %}

{% assign is_bundle = false %}
{% if title_key contains 'cyber set' or handle_key contains 'cyber-set' or product.tags contains 'bundle' %}
  {% assign is_bundle = true %}
{% endif %}

{%- comment -%} NATIVE METAOBJECT REVIEWS CALCULATION {%- endcomment -%}
{% assign meta_reviews = product.metafields.custom.reviews.value %}
{% assign review_count = 0 %}
{% assign rating_sum = 0 %}
{% assign count_5 = 0 %}
{% assign count_4 = 0 %}
{% assign count_3 = 0 %}

{% if meta_reviews != blank %}
  {% for rev in meta_reviews %}
    {% assign r_val = rev.rating.value.rating | default: rev.rating.value | default: 5 | round %}
    {% assign review_count = review_count | plus: 1 %}
    {% assign rating_sum = rating_sum | plus: r_val %}
    {% if r_val == 5 %}{% assign count_5 = count_5 | plus: 1 %}{% endif %}
    {% if r_val == 4 %}{% assign count_4 = count_4 | plus: 1 %}{% endif %}
    {% if r_val == 3 %}{% assign count_3 = count_3 | plus: 1 %}{% endif %}
  {% endfor %}
{% endif %}

{% if review_count > 0 %}
  {% assign avg_x10 = rating_sum | times: 10 | divided_by: review_count %}
  {% assign avg_whole = avg_x10 | divided_by: 10 %}
  {% assign avg_dec = avg_x10 | modulo: 10 %}
  {% assign avg_display = avg_whole | append: '.' | append: avg_dec %}
  {% assign pct_5 = count_5 | times: 100 | divided_by: review_count %}
  {% assign pct_4 = count_4 | times: 100 | divided_by: review_count %}
  {% assign pct_3 = count_3 | times: 100 | divided_by: review_count %}
{% else %}
  {% assign review_count = 3 %}
  {% assign avg_display = '4.9' %}
  {% assign count_5 = 3 %}
  {% assign count_4 = 0 %}
  {% assign count_3 = 0 %}
  {% assign pct_5 = 100 %}
  {% assign pct_4 = 0 %}
  {% assign pct_3 = 0 %}
{% endif %}

<style>
  .pdp-shell {
    width: 100%;
    background-color: #000000;
    color: #F0F0F0;
    padding: 16px 16px 96px;
  }
  @media (min-width: 1024px) {
    .pdp-shell { padding: 32px 32px 72px; }
  }
  .pdp-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .pdp-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
      align-items: start;
    }
  }
  .pdp-container {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .pdp-telemetry-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .pdp-status-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tech-chip {
    padding: 4px 8px;
    background-color: #121212;
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #A3A3A3;
  }
  .tech-chip--red {
    background-color: rgba(255, 0, 51, 0.12);
    border-color: rgba(255, 0, 51, 0.35);
    color: #FF0033;
  }
  .pdp-title {
    font-family: 'Druk Wide', 'Syne', sans-serif;
    font-size: clamp(1.3rem, 5vw, 2rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: #FFFFFF;
    text-transform: uppercase;
    margin: 0;
  }
  .pdp-sub-row {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .pdp-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .loadout-manifest {
    background-color: #0A0A0A;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-left: 2px solid #FF0033;
    padding: 16px;
  }
  .manifest-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .manifest-list {
    list-style: none;
    margin: 12px 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .manifest-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  @media (min-width: 640px) {
    .trust-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 6px;
  }
  .accordion-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .accordion-trigger {
    list-style: none;
    padding: 15px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #FFFFFF;
  }
  .accordion-trigger::-webkit-details-marker { display: none; }
  .accordion-icon {
    color: #FF0033;
    font-size: 16px;
    transition: transform 150ms ease;
  }
  .accordion-item[open] .accordion-icon { transform: rotate(45deg); }
  .specs-table {
    width: 100%;
    border-collapse: collapse;
  }
  .specs-table td {
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    vertical-align: top;
  }
  .specs-table td:first-child {
    width: 36%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #737373;
    text-transform: uppercase;
  }
  .specs-table td:last-child {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #F0F0F0;
  }
</style>

<div class="pdp-shell">
  <div class="pdp-grid">
    
    <!-- LEFT COLUMN: MEDIA GALLERY -->
    <div class="lg:sticky lg:top-24 flex flex-col-reverse md:flex-row gap-3">
      {% if product.images.size > 1 %}
        <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-y-auto max-h-[540px] pb-1 md:pb-0">
          {% for image in product.images %}
            <button 
              type="button" 
              onclick="switchRwndProductImage('{{ image | image_url: width: 1200 }}', this)" 
              class="rwnd-thumb relative aspect-square w-16 shrink-0 border {% if forloop.first %}border-[#FF0033]{% else %}border-white/10{% endif %} bg-[#0A0A0A] p-1 transition-colors hover:border-[#FF0033] cursor-pointer"
            >
              <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title | escape }}" class="h-full w-full object-cover">
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <div class="relative aspect-square w-full flex-1 overflow-hidden border border-white/10 bg-[#0A0A0A] p-4 sm:p-6 group">
        <span class="tech-chip tech-chip--red absolute left-3 top-3 z-10 max-w-[calc(100%-1.5rem)] truncate">
          {% if is_watch %}
            TIMEPIECE // W-01
          {% elsif is_earphone %}
            AUDIO // EAR-01
          {% elsif is_bundle %}
            MYSTERY VAULT
          {% else %}
            DROP 01
          {% endif %}
        </span>

        <div class="h-full w-full flex items-center justify-center overflow-hidden">
          {% if product.featured_image or product.images.size > 0 %}
            <img 
              id="rwnd-main-product-img"
              src="{{ product.featured_image | default: product.images[0] | image_url: width: 1200 }}" 
              alt="{{ product.title | escape }}"
              width="1200" 
              height="1200" 
              fetchpriority="high"
              class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-110"
            >
          {% else %}
            <span class="font-mono-tech text-[11px] uppercase tracking-wider text-[#737373]">MEDIA ARCHIVE PENDING</span>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: REFACTORED BUY BOX ARCHITECTURE -->
    <section class="pdp-container">
      
      <!-- Breadcrumbs & Status Chips -->
      <div class="pdp-telemetry-bar">
        <a href="/collections/all" class="font-mono-tech text-[11px] font-bold uppercase tracking-wider text-[#FF0033] hover:underline">
          ← ARCHIVE
        </a>
        <div class="pdp-status-chips">
          <span class="tech-chip tech-chip--red">DROP 01</span>
          <span class="tech-chip">{% if is_earphone %}TYPE-C DAC{% else %}316L SURGICAL STEEL{% endif %}</span>
          <span class="tech-chip">ADJUSTABLE FIT</span>
        </div>
      </div>

      <!-- Product Title & Rating -->
      <div>
        <h1 class="pdp-title">{{ product.title | escape }}</h1>
        <div class="pdp-sub-row">
          <a href="#reviews" class="inline-flex items-center gap-2">
            <span class="text-[#FF0033] text-xs tracking-wider">★★★★★</span>
            <span class="font-mono-tech text-[11px] uppercase text-white">
              {{ avg_display }} <span class="text-[#A3A3A3]">({{ review_count }} TRANSMISSIONS)</span>
            </span>
          </a>
          <span class="font-mono-tech text-[10px] uppercase tracking-wider text-[#737373]">MDU_DISPATCH // TAMIL NADU</span>
        </div>
      </div>

      <!-- Pricing Unit (Zero Box Bloat) -->
      <div class="pdp-price-row">
        <div class="flex items-baseline gap-2.5 font-mono-tech">
          <span class="text-2xl sm:text-3xl font-extrabold text-white" id="pdp-live-price">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="text-sm text-[#737373] line-through">{{ current_variant.compare_at_price | money }}</span>
          {% endif %}
        </div>
        {% if current_variant.compare_at_price > current_variant.price %}
          {% assign savings = current_variant.compare_at_price | minus: current_variant.price %}
          {% assign savings_pct = savings | times: 100 | divided_by: current_variant.compare_at_price %}
          <span class="tech-chip tech-chip--red">
            SAVE {{ savings_pct }}% [{{ savings | money }} OFF]
          </span>
        {% endif %}
      </div>

      <!-- Inventory Ticker -->
      <div class="flex items-center gap-2 font-mono-tech text-[11px] uppercase tracking-wider text-[#A3A3A3]">
        <span class="h-2 w-2 bg-[#FF0033] animate-pulse"></span>
        {% if current_variant.available %}
          {% if current_variant.inventory_quantity > 0 %}
            <span><strong class="text-white">LOW ALLOCATION:</strong> ONLY {{ current_variant.inventory_quantity }} UNITS REMAIN IN VAULT</span>
          {% else %}
            <span><strong class="text-white">STATUS:</strong> READY FOR 24H DISPATCH</span>
          {% endif %}
        {% else %}
          <span><strong class="text-[#FF0033]">DEPLETED:</strong> BATCH SOLD OUT</span>
        {% endif %}
      </div>

      <!-- Streamlined Loadout Box (Bundles Only) -->
      {% if is_bundle %}
        <div class="loadout-manifest">
          <div class="manifest-header">
            <span class="font-mono-tech text-[11px] font-bold uppercase tracking-wider text-[#FF0033]">// VAULT CONTENTS (BLIND CURATION)</span>
            <span class="font-mono-tech text-[10px] uppercase text-[#737373]">3 PIECES INCLUDED</span>
          </div>
          <ul class="manifest-list">
            <li>
              <span class="font-mono-tech text-[11px] font-bold text-[#FF0033] pt-0.5">01</span>
              <div class="flex flex-col">
                <strong class="font-sans text-[13px] font-semibold text-white">Heavyweight Pendant Chain</strong>
                <span class="font-sans text-xs text-[#A3A3A3]">50cm length · 316L Solid Stainless Steel</span>
              </div>
            </li>
            <li>
              <span class="font-mono-tech text-[11px] font-bold text-[#FF0033] pt-0.5">02</span>
              <div class="flex flex-col">
                <strong class="font-sans text-[13px] font-semibold text-white">Industrial Link Bracelet</strong>
                <span class="font-sans text-xs text-[#A3A3A3]">Universal adjustable clasp · Sweat/Waterproof</span>
              </div>
            </li>
            <li>
              <span class="font-mono-tech text-[11px] font-bold text-[#FF0033] pt-0.5">03</span>
              <div class="flex flex-col">
                <strong class="font-sans text-[13px] font-semibold text-white">Cyber Chrome Statement Ring</strong>
                <span class="font-sans text-xs text-[#A3A3A3]">Engineered open-band (Universal sizing)</span>
              </div>
            </li>
          </ul>
          <div class="pt-2.5 border-t border-white/10">
            <span class="font-mono-tech text-[10px] uppercase tracking-wider text-[#737373]">
              ℹ Pieces curated at random from Drop 01 Vault. 100% tarnish-proof guarantee.
            </span>
          </div>
        </div>
      {% endif %}

      {% if is_earphone %}
        <div class="border-l-2 border-[#FF0033] bg-[#0A0A0A] p-3.5">
          <strong class="font-sans text-xs font-semibold text-white block">Type-C Native Digital DAC.</strong>
          <span class="font-sans text-xs text-[#A3A3A3]">Compatible with Type-C Android and iPhone 15/16 series. Not for 3.5mm jacks.</span>
        </div>
      {% endif %}

      <!-- Actions / Buy Box -->
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="rwnd-product-form" class="flex flex-col gap-2.5">
        <input type="hidden" name="id" id="rwnd-selected-variant-id" value="{{ current_variant.id }}">

        {% unless product.has_only_default_variant %}
          <div class="space-y-2 pb-1">
            <div class="flex items-center justify-between">
              <span class="font-mono-tech text-[11px] uppercase tracking-wider text-[#A3A3A3]">SELECT SPECIFICATION:</span>
              <a href="/pages/size-guide" onclick="openSizeGuideModal(event)" class="font-mono-tech text-[11px] uppercase text-white underline">Size Guide →</a>
            </div>
            <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
              {% for variant in product.variants %}
                <button 
                  type="button" 
                  {% if variant.available %}
                    onclick="selectRwndVariant('{{ variant.id }}', '{{ variant.price | money }}', this)"
                  {% else %}
                    disabled
                  {% endif %}
                  class="rwnd-var-btn h-11 border {% if variant.id == current_variant.id %}border-[#FF0033] bg-[#FF0033]/15 text-white{% else %}border-white/10 bg-[#0A0A0A] text-[#A3A3A3]{% endif %} font-mono-tech text-xs font-bold uppercase hover:border-[#FF0033] transition-colors disabled:opacity-30 disabled:line-through cursor-pointer"
                >
                  {{ variant.title | escape }}
                </button>
              {% endfor %}
            </div>
          </div>
        {% endunless %}

        <!-- Quantity & Primary CTA Row -->
        <div class="flex gap-2.5">
          <div class="flex items-center bg-[#0A0A0A] border border-white/10 h-[52px]">
            <button type="button" onclick="adjustRwndQty(-1)" class="w-9 h-full text-white hover:text-[#FF0033] text-base cursor-pointer" aria-label="Decrease quantity">−</button>
            <input type="number" id="rwnd-qty-input" name="quantity" value="1" min="1" max="10" readonly class="w-9 h-full p-0 text-center bg-transparent border-0 font-mono-tech text-xs font-bold text-white focus:outline-none">
            <button type="button" onclick="adjustRwndQty(1)" class="w-9 h-full text-white hover:text-[#FF0033] text-base cursor-pointer" aria-label="Increase quantity">+</button>
          </div>

          <button 
            type="submit" 
            name="add" 
            id="AddToCart"
            {% unless current_variant.available %}disabled{% endunless %}
            class="flex-1 h-[52px] px-4 bg-[#FF0033] border border-[#FF0033] text-white font-mono-tech text-xs font-bold uppercase tracking-wider hover:bg-[#CC0029] transition-colors flex items-center justify-between gap-2 cursor-pointer disabled:opacity-40"
          >
            {% if current_variant.available %}
              <span>{% if is_bundle %}CLAIM HARDWARE LOADOUT{% else %}ADD TO HARDWARE BAG{% endif %}</span>
              <span id="btn-price-display">{{ current_variant.price | money }}</span>
            {% else %}
              <span>SOLD OUT</span>
            {% endif %}
          </button>
        </div>

        <!-- 1-Click Instant Checkout -->
        <a href="/checkout" class="w-full h-12 bg-[#0A0A0A] border border-white/10 hover:border-[#FF0033] text-white font-mono-tech text-[11px] font-bold uppercase tracking-wider flex items-center justify-center transition-colors">
          ⚡ INSTANT CHECKOUT (UPI / COD / CARDS)
        </a>
      </form>

      <!-- Trust Bar (Minimal Hairline Grid) -->
      <div class="trust-grid">
        <div class="trust-item">
          <span class="text-sm">🛡️</span>
          <span class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] leading-tight">LIFETIME TARNISH PROOF</span>
        </div>
        <div class="trust-item">
          <span class="text-sm">🚚</span>
          <span class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] leading-tight">24H DISPATCH (MDU HUB)</span>
        </div>
        <div class="trust-item">
          <span class="text-sm">💵</span>
          <span class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] leading-tight">CASH ON DELIVERY</span>
        </div>
        <div class="trust-item">
          <span class="text-sm">🔄</span>
          <span class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] leading-tight">DEFECT REPLACEMENT</span>
        </div>
      </div>

      <!-- Accordions (Clean Flush Line Dividers) -->
      <div class="flex flex-col">
        <details class="accordion-item" open>
          <summary class="accordion-trigger">
            <span>HARDWARE SPECIFICATIONS</span>
            <span class="accordion-icon">+</span>
          </summary>
          <div class="pb-4">
            {% if product.description != blank %}
              <div class="font-sans text-sm text-[#A3A3A3] leading-relaxed mb-3">{{ product.description }}</div>
            {% endif %}
            <table class="specs-table">
              <tr>
                <td>MATERIAL</td>
                <td>{% if is_earphone %}High-Density Alloy + Braided Shielding{% else %}316L Surgical Grade Solid Stainless Steel{% endif %}</td>
              </tr>
              <tr>
                <td>COATING</td>
                <td>Vacuum PVD High-Polish Chrome (Zero fading)</td>
              </tr>
              <tr>
                <td>FIT PROFILE</td>
                <td>Universal Adjustable / Free Size</td>
              </tr>
              <tr>
                <td>HYPOALLERGENIC</td>
                <td>100% Nickel &amp; Lead-Free (Zero skin greening)</td>
              </tr>
            </table>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-trigger">
            <span>SHIPPING &amp; DISPATCH PROTOCOL</span>
            <span class="accordion-icon">+</span>
          </summary>
          <div class="pb-4 font-sans text-sm text-[#A3A3A3] leading-relaxed space-y-1.5">
            <p>All orders are packed in sealed security poly-mailers and dispatched directly from our Madurai fulfillment hub within 24 hours.</p>
            <ul class="list-disc pl-4 space-y-1">
              <li><strong class="text-white">South India:</strong> Delivered in 48–72 hours.</li>
              <li><strong class="text-white">Rest of India:</strong> Delivered in 3–5 business days.</li>
              <li>Free delivery on orders ₹999+ (₹49 flat under ₹999).</li>
            </ul>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-trigger">
            <span>REPLACEMENT &amp; WARRANTY</span>
            <span class="accordion-icon">+</span>
          </summary>
          <div class="pb-4 font-sans text-sm text-[#A3A3A3] leading-relaxed">
            <p>
              {% if is_bundle %}Due to heavy discounting on Mystery Blind Drops, items cannot be swapped for personal aesthetic preference. {% endif %}
              If any piece arrives damaged, defective, or incorrect, we offer a <strong class="text-white">100% free immediate replacement</strong>. 
              Simply ping our WhatsApp support desk with your order number and uncut unboxing video within 48 hours of delivery.
            </p>
          </div>
        </details>
      </div>
    </section>
  </div>

  <!-- BELOW THE FOLD: COMPLETE THE LOOK & REVIEWS -->
  <div class="mx-auto max-w-7xl">
    
    <!-- COMPLETE THE LOOK -->
    <section class="mt-16 border-t border-white/10 pt-12">
      <div class="mb-6">
        <span class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-[#FF0033] block">// SYNERGISTIC ARCHIVE</span>
        <h2 class="font-display text-xl sm:text-2xl font-black uppercase text-white mt-1">COMPLETE THE LOOK</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {% for complementary in collections['all'].products limit: 5 %}
          {% if complementary.id != product.id %}
            <div class="border border-white/10 bg-[#0A0A0A] p-3 flex flex-col justify-between group hover:border-[#FF0033] transition-colors">
              <a href="{{ complementary.url }}" class="block">
                <div class="aspect-square bg-[#000000] border border-white/5 flex items-center justify-center overflow-hidden mb-3">
                  <img src="{{ complementary.featured_image | image_url: width: 400 }}" alt="{{ complementary.title | escape }}" class="h-full w-full object-contain group-hover:scale-105 transition-transform">
                </div>
                <h3 class="font-sans text-xs font-bold text-white truncate">{{ complementary.title | escape }}</h3>
                <p class="font-mono-tech text-xs text-[#A3A3A3] mt-1">{{ complementary.price | money }}</p>
              </a>
              <form action="{{ routes.cart_add_url }}" method="post" class="mt-3">
                <input type="hidden" name="id" value="{{ complementary.selected_or_first_available_variant.id }}">
                <button type="submit" class="w-full h-9 border border-white/10 bg-[#121212] font-mono-tech text-[10px] font-bold uppercase hover:bg-[#FF0033] hover:border-[#FF0033] text-white transition-colors cursor-pointer">
                  + ADD
                </button>
              </form>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <!-- ELEVATED REVIEWS TERMINAL -->
    <section id="reviews" class="mt-16 border border-[#FF0033]/40 border-t-2 border-t-[#FF0033] bg-[#0D0D10] p-5 sm:p-8 shadow-[0_0_40px_rgba(255,0,51,0.08)]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-white/10 pb-5 mb-6">
        <div>
          <span class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-[#FF0033] block">// OPERATOR TRANSMISSIONS</span>
          <h2 class="font-display text-xl sm:text-2xl font-black uppercase text-white mt-1">VERIFIED FIELD REVIEWS</h2>
        </div>
        <button
          type="button"
          onclick="openRwndReviewModal()"
    <!-- REVIEWS SECTION (STREAMLINED TRANSMISSION LOG) -->
    <section id="reviews" class="reviews-section">
      <div class="reviews-header">
        <div class="mono-tag text-[#FF0033]">// OPERATOR TRANSMISSIONS</div>
        <h2 class="reviews-title">FIELD VERIFIED LOGS</h2>
      </div>

      <!-- Summary Score Bar (Clean 1-Line Minimalist HUD) -->
      <div class="review-score-hud">
        <div class="score-main">
          <span class="score-number">{{ avg_display }}</span>
          <div class="score-stars">
            <span class="stars">★★★★★</span>
            <span class="mono-tag text-[#737373]">{{ review_count }} TRANSMISSIONS</span>
          </div>
        </div>
        <button type="button" onclick="openRwndReviewModal()" class="btn-review-write mono-tag">
          + LOG TRANSMISSION
        </button>
      </div>

      <!-- Review Cards (Hairline Left Border Accent, Zero Bulky Inner Boxes) -->
      <div id="rwnd-reviews-grid" class="reviews-stream">
        {% if meta_reviews != blank %}
          {% for rev in meta_reviews %}
            {% assign r_stars = rev.rating.value.rating | default: rev.rating.value | default: 5 | round %}
            <div class="review-entry">
              <div class="space-y-2.5">
                <div class="entry-meta">
                  <span class="stars">{% for i in (1..r_stars) %}★{% endfor %}</span>
                  <span class="entry-status mono-tag">VERIFIED_DISPATCH</span>
                </div>
                <p class="entry-quote">"{{ rev.body.value | escape }}"</p>
              </div>
              <div class="entry-author mono-tag">
                <span class="text-white font-bold">{{ rev.author.value | escape }}</span>
                {% if rev.city.value != blank %}
                  <span class="text-[#737373]"> · {{ rev.city.value | escape }}</span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="review-entry">
            <div class="space-y-2.5">
              <div class="entry-meta">
                <span class="stars">★★★★★</span>
                <span class="entry-status mono-tag">VERIFIED_DISPATCH</span>
              </div>
              <p class="entry-quote">
                "Heavyweight feel is legit. Doesn't feel cheap or hollow like typical commercial sets. The chain has substantial density and zero skin reaction after 2 weeks of constant wear."
              </p>
            </div>
            <div class="entry-author mono-tag">
              <span class="text-white font-bold">ROHIT M.</span> <span class="text-[#737373]">· CHENNAI [TN]</span>
            </div>
          </div>

          <div class="review-entry">
            <div class="space-y-2.5">
              <div class="entry-meta">
                <span class="stars">★★★★★</span>
                <span class="entry-status mono-tag">VERIFIED_DISPATCH</span>
              </div>
              <p class="entry-quote">
                "Madurai to Bangalore took exactly 48 hours. The vacuum-sealed chrome packaging was immaculate. Ring adjustment is sturdy, doesn't bend out of shape."
              </p>
            </div>
            <div class="entry-author mono-tag">
              <span class="text-white font-bold">ANIRUDH S.</span> <span class="text-[#737373]">· BENGALURU [KA]</span>
            </div>
          </div>

          <div class="review-entry">
            <div class="space-y-2.5">
              <div class="entry-meta">
                <span class="stars">★★★★★</span>
                <span class="entry-status mono-tag">VERIFIED_DISPATCH</span>
              </div>
              <p class="entry-quote">
                "Zero oxidation or discoloration after intense gym sessions and rain exposure. Real 316L alloy."
              </p>
            </div>
            <div class="entry-author mono-tag">
              <span class="text-white font-bold">RAHUL D.</span> <span class="text-[#737373]">· COIMBATORE [TN]</span>
            </div>
          </div>
        {% endif %}
      </div>
    </section>

<!-- FULL-SCREEN WRITE REVIEW MODAL (z-210) -->
<div
  id="rwnd-review-modal"
  class="fixed inset-0 z-[210] hidden items-center justify-center bg-black/95 backdrop-blur-xl p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
>
  <div class="relative my-auto w-full max-w-lg border border-[#FF0033] border-t-2 bg-[#0D0D10] p-5 sm:p-7 shadow-[0_0_50px_rgba(255,0,51,0.2)]">
    <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-5">
      <div>
        <span class="font-mono-tech text-[10px] uppercase text-[#FF0033] block">// FIELD TRANSMISSION TERMINAL</span>
        <h3 class="font-display text-base sm:text-lg font-bold uppercase text-white mt-0.5 truncate max-w-[260px] sm:max-w-sm">REVIEW: {{ product.title | escape }}</h3>
      </div>
      <button type="button" onclick="closeRwndReviewModal()" class="h-9 w-9 border border-white/10 bg-[#141418] text-xs font-bold text-[#A3A3A3] hover:border-[#FF0033] hover:text-[#FF0033] cursor-pointer">✕</button>
    </div>

    <form id="rwnd-native-review-form" onsubmit="submitRwndNativeReview(event)" class="space-y-4">
      <input type="hidden" id="rwnd-rev-rating-input" value="5">

      <div>
        <label class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] block mb-1.5">SELECT RATING *</label>
        <div class="flex gap-2">
          {% for s in (1..5) %}
            <button type="button" data-star="{{ s }}" onclick="setRwndReviewStars({{ s }})" class="rwnd-star-btn h-11 flex-1 border border-[#FF0033] bg-[#FF0033]/20 text-base font-bold text-[#FF0033] cursor-pointer">★</button>
          {% endfor %}
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] block mb-1">YOUR NAME *</label>
          <input type="text" id="rwnd-rev-name" required placeholder="E.G. ARJUN K." class="h-11 w-full bg-[#141418] border border-white/10 px-3 font-mono-tech text-xs text-white uppercase focus:border-[#FF0033] focus:outline-none">
        </div>
        <div>
          <label class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] block mb-1">CITY *</label>
          <input type="text" id="rwnd-rev-city" required placeholder="E.G. CHENNAI" class="h-11 w-full bg-[#141418] border border-white/10 px-3 font-mono-tech text-xs text-white uppercase focus:border-[#FF0033] focus:outline-none">
        </div>
      </div>

      <div>
        <label class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] block mb-1">EMAIL (PRIVATE) *</label>
        <input type="email" id="rwnd-rev-email" required placeholder="YOUR@EMAIL.COM" class="h-11 w-full bg-[#141418] border border-white/10 px-3 font-mono-tech text-xs text-white focus:border-[#FF0033] focus:outline-none">
      </div>

      <div>
        <label class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] block mb-1">HARDWARE PHOTO (OPTIONAL)</label>
        <label for="rwnd-rev-photo-input" class="h-11 border border-dashed border-white/20 hover:border-[#FF0033] bg-[#141418] px-3 flex items-center justify-center gap-2 font-mono-tech text-[11px] uppercase text-white cursor-pointer">
          <span class="text-[#FF0033]">+</span>
          <span id="rwnd-rev-photo-label">ATTACH / SNAP PHOTO</span>
        </label>
        <input type="file" id="rwnd-rev-photo-input" accept="image/*" class="hidden" onchange="handleRwndReviewPhoto(this)">

        <div id="rwnd-rev-photo-preview-wrap" class="hidden mt-2 flex items-center justify-between border border-white/10 bg-[#141418] p-2">
          <div class="flex items-center gap-3">
            <img id="rwnd-rev-photo-preview" src="" alt="Preview" class="h-11 w-11 object-cover border border-[#FF0033]">
            <span class="font-mono-tech text-[10px] uppercase text-[#00FF88]">✓ PHOTO READY</span>
          </div>
          <button type="button" onclick="clearRwndReviewPhoto()" class="font-mono-tech text-[10px] uppercase text-[#FF0033] underline cursor-pointer">REMOVE</button>
        </div>
      </div>

      <div>
        <label class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] block mb-1">FIELD REPORT *</label>
        <textarea id="rwnd-rev-body" rows="3" required placeholder="Weight, 316L finish, delivery speed..." class="w-full bg-[#141418] border border-white/10 p-3 font-sans text-sm text-white focus:border-[#FF0033] focus:outline-none"></textarea>
      </div>

      <p id="rwnd-rev-status" class="font-mono-tech text-[10px] uppercase text-[#A3A3A3] min-h-[16px]"></p>

      <button type="submit" id="rwnd-rev-submit-btn" class="h-12 w-full bg-[#FF0033] font-mono-tech text-xs font-bold uppercase tracking-widest text-white hover:bg-[#CC0029] cursor-pointer">
        TRANSMIT REVIEW →
      </button>
    </form>
  </div>
</div>

<!-- STICKY MOBILE CONVERSION BAR (z-110) -->
<div class="fixed bottom-0 left-0 z-[110] w-full border-t border-white/10 bg-[#0A0A0A]/95 backdrop-blur-md p-3 sm:hidden flex items-center justify-between gap-3">
  <div>
    <span class="font-mono-tech text-[9px] uppercase text-[#737373] block">TOTAL</span>
    <span class="font-mono-tech text-sm font-bold text-white" id="sticky-mobile-price">{{ current_variant.price | money }}</span>
  </div>
  <button 
    type="button" 
    onclick="document.getElementById('rwnd-product-form')?.querySelector('button[type=submit]')?.click();"
    class="flex-1 h-12 bg-[#FF0033] text-white font-mono-tech text-xs font-bold uppercase tracking-wider flex items-center justify-center cursor-pointer"
  >
    + ADD TO BAG
  </button>
</div>

<script>
  let rwndCompressedPhotoDataUrl = '';

  function switchRwndProductImage(src, btn) {
    const mainImg = document.getElementById('rwnd-main-product-img');
    if (mainImg) mainImg.src = src;
    document.querySelectorAll('.rwnd-thumb').forEach(t => t.classList.replace('border-[#FF0033]', 'border-white/10'));
    btn.classList.replace('border-white/10', 'border-[#FF0033]');
  }

  function adjustRwndQty(delta) {
    const input = document.getElementById('rwnd-qty-input');
    if (!input) return;
    let val = parseInt(input.value) || 1;
    val = Math.min(10, Math.max(1, val + delta));
    input.value = val;
  }

  function selectRwndVariant(id, price, btn) {
    const varInput = document.getElementById('rwnd-selected-variant-id');
    const priceDisplay = document.getElementById('btn-price-display');
    const livePrice = document.getElementById('pdp-live-price');
    const stickyPrice = document.getElementById('sticky-mobile-price');
    if (varInput) varInput.value = id;
    if (priceDisplay) priceDisplay.textContent = price;
    if (livePrice) livePrice.textContent = price;
    if (stickyPrice) stickyPrice.textContent = price;

    document.querySelectorAll('.rwnd-var-btn').forEach(b => {
      b.classList.remove('border-[#FF0033]', 'bg-[#FF0033]/15', 'text-white');
      b.classList.add('border-white/10', 'bg-[#0A0A0A]', 'text-[#A3A3A3]');
    });
    btn.classList.add('border-[#FF0033]', 'bg-[#FF0033]/15', 'text-white');
    btn.classList.remove('border-white/10', 'bg-[#0A0A0A]', 'text-[#A3A3A3]');
  }

  function openRwndReviewModal() {
    const modal = document.getElementById('rwnd-review-modal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeRwndReviewModal() {
    const modal = document.getElementById('rwnd-review-modal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.getElementById('rwnd-review-modal')?.addEventListener('click', (e) => {
    if (e.target.id === 'rwnd-review-modal') closeRwndReviewModal();
  });

  function setRwndReviewStars(rating) {
    document.getElementById('rwnd-rev-rating-input').value = rating;
    document.querySelectorAll('.rwnd-star-btn').forEach(btn => {
      const s = parseInt(btn.dataset.star);
      if (s <= rating) {
        btn.classList.add('border-[#FF0033]', 'bg-[#FF0033]/20', 'text-[#FF0033]');
        btn.classList.remove('border-white/10', 'bg-[#141418]', 'text-[#A3A3A3]');
      } else {
        btn.classList.remove('border-[#FF0033]', 'bg-[#FF0033]/20', 'text-[#FF0033]');
        btn.classList.add('border-white/10', 'bg-[#141418]', 'text-[#A3A3A3]');
      }
    });
  }

function handleRwndReviewPhoto(input) {
    const file = input.files && input.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const MAX_DIM = 600;
        let w = img.width, h = img.height;
        if (w > h && w > MAX_DIM) { h = Math.round((h * MAX_DIM) / w); w = MAX_DIM; }
        else if (h > MAX_DIM) { w = Math.round((w * MAX_DIM) / h); h = MAX_DIM; }
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        rwndCompressedPhotoDataUrl = canvas.toDataURL('image/jpeg', 0.75);
        document.getElementById('rwnd-rev-photo-preview').src = rwndCompressedPhotoDataUrl;
        document.getElementById('rwnd-rev-photo-preview-wrap').classList.remove('hidden');
        document.getElementById('rwnd-rev-photo-label').textContent = 'CHANGE PHOTO';
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  }

  function clearRwndReviewPhoto() {
    rwndCompressedPhotoDataUrl = '';
    const input = document.getElementById('rwnd-rev-photo-input');
    if (input) input.value = '';
    document.getElementById('rwnd-rev-photo-preview-wrap').classList.add('hidden');
    document.getElementById('rwnd-rev-photo-label').textContent = 'ATTACH / SNAP PHOTO';
  }

  function appendReviewCardToDom(rev) {
    const grid = document.getElementById('rwnd-reviews-grid');
    if (!grid) return;
    const starsStr = '★'.repeat(rev.rating || 5);
    const photoHtml = rev.photo
      ? `<div class="mt-3 aspect-square w-20 overflow-hidden border border-[#FF0033]/50 bg-[#000000]"><img src="${rev.photo}" alt="Hardware photo" class="h-full w-full object-cover"></div>`
      : '';
    const card = document.createElement('div');
    card.className = 'border border-[#FF0033]/70 bg-[#141418] p-5 flex flex-col justify-between';
    card.innerHTML = `
      <div>
        <div class="flex items-center justify-between">
          <span class="text-[#FF0033] text-sm tracking-wider">${starsStr}</span>
          <span class="tech-chip" style="color:#00FF88;border-color:rgba(0,255,136,0.4);">LOGGED</span>
        </div>
        ${photoHtml}
        <p class="font-sans text-sm text-[#F0F0F0] leading-relaxed mt-3">"${rev.body.replace(/</g, '&lt;')}"</p>
      </div>
      <p class="font-mono-tech text-[10px] uppercase text-[#737373] mt-4 pt-2.5 border-t border-white/10">
        <strong class="text-white">${rev.name.replace(/</g, '&lt;')}</strong> · ${rev.city.replace(/</g, '&lt;')}
      </p>
    `;
    grid.prepend(card);
  }

  async function submitRwndNativeReview(e) {
    e.preventDefault();
    const form = e.target;
    const statusEl = document.getElementById('rwnd-rev-status');
    const btn = document.getElementById('rwnd-rev-submit-btn');

    const rating = parseInt(document.getElementById('rwnd-rev-rating-input').value) || 5;
    const name = document.getElementById('rwnd-rev-name').value.trim().toUpperCase();
    const city = document.getElementById('rwnd-rev-city').value.trim().toUpperCase();
    const email = document.getElementById('rwnd-rev-email').value.trim();
    const body = document.getElementById('rwnd-rev-body').value.trim();
    const hasPhoto = Boolean(rwndCompressedPhotoDataUrl);

    const compiledBody =
      `PRODUCT: {{ product.title | escape }} ({{ product.handle }})\n` +
      `RATING: ${rating}/5\nAUTHOR: ${name}\nCITY: ${city}\n` +
      `PHOTO ATTACHED: ${hasPhoto ? 'YES' : 'NO'}\nREVIEW: ${body}`;

    btn.disabled = true;
    btn.textContent = '[ TRANSMITTING... ]';

    try {
      const payload = new URLSearchParams();
      payload.append('form_type', 'contact');
      payload.append('utf8', '✓');
      payload.append('contact[subject]', `NEW PRODUCT REVIEW: {{ product.title | escape }}`);
      payload.append('contact[email]', email);
      payload.append('contact[body]', compiledBody);

      await fetch('/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: payload.toString()
      });

      const reviewObj = { rating, name, city, body, photo: rwndCompressedPhotoDataUrl };
      const storageKey = 'rwnd_reviews_{{ product.handle }}';
      try {
        const existing = JSON.parse(localStorage.getItem(storageKey) || '[]');
        existing.unshift(reviewObj);
        localStorage.setItem(storageKey, JSON.stringify(existing.slice(0, 10)));
      } catch (err) {}

      appendReviewCardToDom(reviewObj);
      form.reset();
      clearRwndReviewPhoto();
      setRwndReviewStars(5);
      statusEl.textContent = '';

      closeRwndReviewModal();
      document.getElementById('rwnd-reviews-grid')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (err) {
      statusEl.textContent = '✕ TRANSMISSION ERROR — TRY AGAIN';
      statusEl.style.color = '#FF0033';
    } finally {
      btn.disabled = false;
      btn.textContent = 'TRANSMIT REVIEW →';
    }
  }

  (() => {
    try {
      const saved = JSON.parse(localStorage.getItem('rwnd_reviews_{{ product.handle }}') || '[]');
      saved.reverse().forEach(appendReviewCardToDom);
    } catch (e) {}
  })();
</script>

