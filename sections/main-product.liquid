<!-- sections/main-product.liquid -->
{% assign current_variant = product.selected_or_first_available_variant %}

<section class="metallic-chrome-bg py-12 sm:py-16">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Left: Product Image Gallery -->
      <div class="lg:col-span-7">
        <div class="overflow-hidden rounded-3xl border border-black/15 bg-white p-6 shadow-md">
          {% if product.featured_image %}
            <img
              id="rwnd-pdp-main-image"
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              class="aspect-square w-full rounded-2xl bg-[#D4D8E0] object-contain p-4"
            >
          {% else %}
            <div class="flex aspect-square w-full items-center justify-center rounded-2xl bg-[#D4D8E0] p-8 text-center">
              <span class="font-display text-2xl font-extrabold text-[#09090B] uppercase">{{ product.title | default: 'RWND20S. ARCHIVE ARTIFACT' }}</span>
            </div>
          {% endif %}

          {% if product.images.size > 1 %}
            <div class="mt-4 grid grid-cols-4 gap-3">
              {% for image in product.images %}
                <button
                  type="button"
                  onclick="document.getElementById('rwnd-pdp-main-image').src='{{ image | image_url: width: 1000 }}'"
                  class="overflow-hidden rounded-xl border border-black/15 bg-[#D4D8E0] p-2 hover:border-[#09090B] cursor-pointer"
                >
                  <img
                    src="{{ image | image_url: width: 240 }}"
                    alt="{{ image.alt | default: product.title | escape }}"
                    class="h-16 w-full object-contain"
                  >
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Right: Product Details, Variant Picker & Add to Bag -->
      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-black/15 bg-white p-6 sm:p-8 shadow-md">
          <span class="inline-block rounded-full border border-black/15 bg-[#EEF0F4] px-3 py-1 font-mono-tech text-[10px] font-bold tracking-widest text-[#09090B] uppercase">
            {{ product.type | default: 'DROP 01 HARDWARE' }}
          </span>

          <h1 class="mt-3 font-display text-2xl font-extrabold tracking-tight text-[#09090B] uppercase sm:text-3xl">
            {{ product.title }}
          </h1>

          <div class="mt-4 flex items-baseline gap-3">
            <span class="font-mono-tech text-2xl font-bold text-[#09090B]">
              {{ current_variant.price | money }}
            </span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="font-mono-tech text-sm text-[#52525B] line-through">
                {{ current_variant.compare_at_price | money }}
              </span>
              {% assign saved_amount = current_variant.compare_at_price | minus: current_variant.price %}
              <span class="rounded border border-black/15 bg-[#EEF0F4] px-2 py-0.5 font-mono-tech text-[11px] font-bold text-[#09090B]">
                SAVE {{ saved_amount | money }}
              </span>
            {% endif %}
          </div>

          <div class="mt-5 text-sm leading-relaxed text-[#27272A]">
            {{ product.description }}
          </div>

          {% form 'product', product, id: 'rwnd-product-form', class: 'mt-6 space-y-4' %}
            <div>
              <label for="rwnd-pdp-variant-select" class="block font-mono-tech text-[11px] font-bold text-[#09090B] uppercase">
                Select Size / Finish Variant
              </label>
              <select
                id="rwnd-pdp-variant-select"
                name="id"
                class="mt-1.5 w-full rounded-xl border border-black/20 bg-white px-4 py-3 font-mono-tech text-xs font-bold text-[#09090B] focus:border-[#09090B] focus:outline-none"
              >
                {% for variant in product.variants %}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == current_variant %}selected="selected"{% endif %}
                    {% unless variant.available %}disabled="disabled"{% endunless %}
                  >
                    {{ variant.title }} — {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>
            </div>

            <div>
              <label for="rwnd-pdp-quantity" class="block font-mono-tech text-[11px] font-bold text-[#09090B] uppercase">
                Quantity
              </label>
              <input
                id="rwnd-pdp-quantity"
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="mt-1.5 w-24 rounded-xl border border-black/20 bg-white px-3.5 py-2.5 font-mono-tech text-xs font-bold text-[#09090B]"
              >
            </div>

            <button
              type="submit"
              data-add-to-cart
              variant-id="{{ current_variant.id }}"
              {% unless current_variant.available %}disabled="disabled"{% endunless %}
              class="w-full rounded-full border border-black bg-[#09090B] px-6 py-4 font-mono-tech text-xs font-bold tracking-widest text-white uppercase transition-colors hover:bg-white hover:text-[#09090B] cursor-pointer"
            >
              {% if current_variant.available %}
                {{ 'products.product.add_to_cart' | t }}
              {% else %}
                {{ 'products.product.sold_out' | t }}
              {% endif %}
            </button>
          {% endform %}

          {% if section.settings.show_cod_policy %}
            <div class="mt-6 rounded-2xl border border-black/15 bg-[#EEF0F4] p-4 font-mono-tech text-xs text-[#27272A]">
              <p class="font-bold text-[#09090B]">✓ DISPATCH &amp; COD POLICY (MADURAI, TAMIL NADU)</p>
              <p class="mt-1">
                Free Express Shipping above ₹999. Accessories ship with ₹0-advance Cash on Delivery across India.
              </p>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product Page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cod_policy",
      "label": "Show COD & Dispatch Policy Box",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Main Product Page"
    }
  ]
}
{% endschema %}
