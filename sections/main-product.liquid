<!-- sections/main-product.liquid -->
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign title_key = product.title | downcase %}
{% assign handle_key = product.handle | downcase %}
{% assign is_watch = false %}{% if title_key contains 'watch' or handle_key contains 'w-01' or handle_key contains 'watch' %}{% assign is_watch = true %}{% endif %}
{% assign is_earphone = false %}{% if title_key contains 'earphone' or handle_key contains 'ear-01' or handle_key contains 'earphone' %}{% assign is_earphone = true %}{% endif %}
<main class="product-page">
  <div class="product-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1000" height="1000" fetchpriority="high">{% endif %}</div>
  <div class="product-info">
    {% if is_watch %}<p class="status-badge">PRE-ORDER</p>{% endif %}
    <p class="eyebrow">{{ product.vendor | default: 'RWND20s' | escape }}</p><h1>{{ product.title | escape }}</h1>
    {% if is_watch %}
      <p class="price">₹1,999 prepaid</p><p class="price">₹2,199 COD</p>
      <p>Dispatches within 14 working days of pre-order confirmation.</p>
      <h2>Specifications</h2><p>Dual-display analog-digital movement, brushed alloy casing, hardened mineral glass, adjustable stainless steel link strap, stopwatch and LED backlighting.</p>
      <p>Battery: Pre-installed standard SR626SW / CR2016 cell included. Operational life approx. 12–18 months.</p>
      <p>Water rating: Daily splash resistance (3 ATM / 30M). Not suitable for swimming, showers, or submersion.</p>
      <p>Included: 1x Y2K Cyber Chronograph, 1x obsidian padded presentation tin, 1x sizing adjustment pin, warranty verification card.</p>
      <p>Serial-numbered Drop 01 archive release. Verified hardware piece.</p>
      <p>1-for-1 replacement on arrival defects reported within 48 hours with an unboxing video.</p>
      <p>₹150 advance is non-refundable. It covers part of the delivery cost if an order is refused or returned.</p>
      <p>Cash on delivery is not available for this item yet.</p>
    {% else %}
      <p class="price">{{ current_variant.price | money }}</p>
    {% endif %}
    {% unless product.has_only_default_variant %}
      <fieldset class="variant-list"><legend>Select option</legend>
        {% for variant in product.variants %}
          <label class="variant-option {% unless variant.available %}is-sold-out{% endunless %}"><input type="radio" name="variant-choice" value="{{ variant.id }}" {% if variant.id == current_variant.id %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}><span>{{ variant.title | escape }}</span>{% unless variant.available %}<span>Sold out</span>{% endunless %}</label>
        {% endfor %}
      </fieldset>
    {% endunless %}
    {% if is_earphone %}<aside class="compatibility-warning"><p>Type-C only. Not compatible with iPhone 14 and older, or with phones that have a 3.5mm jack.</p><p>Check that your phone supports USB-C audio before ordering.</p><p>Includes protective case. No adapter. No battery.</p></aside>{% endif %}
    {% unless is_watch %}<div>{{ product.description }}</div>{% endunless %}
    <form action="{{ routes.cart_add_url }}" method="post"><input type="hidden" name="id" value="{{ current_variant.id }}"><label>Quantity <input type="number" name="quantity" value="1" min="1"></label><button class="button-primary" type="submit" name="add">Add to bag</button></form>
    <section class="product-delivery"><h2>Shipping</h2><p>Free delivery on ₹999 and above. Below ₹999, ₹49.</p><p>Delivered in about 48 hours in South India.</p><p>In-stock items dispatch within 24 hours on working days. Pre-order items dispatch on their stated date.</p><h2>Returns</h2><p>Returns are accepted only for defective or wrong items. Report within 48 hours with an unboxing video. Replacement or refund. Prepaid refunds go to the original payment method; COD refunds go by UPI or bank transfer.</p></section>
  </div>
</main>
<script>
document.querySelectorAll('.variant-option input').forEach((input)=>input.addEventListener('change',()=>{if(input.checked) location.href='?variant='+encodeURIComponent(input.value)}));
</script>
{% schema %}{"name":"Product page","settings":[]}{% endschema %}
