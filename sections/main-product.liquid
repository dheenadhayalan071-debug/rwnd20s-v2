<!-- sections/main-product.liquid -->
<div class="relative w-full bg-transparent px-4 py-8 font-mono-tech text-[#F5F5F7] sm:px-6 sm:py-12 lg:px-12">
  <div class="mx-auto max-w-6xl">
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% assign title_key = product.title | downcase %}
    {% assign handle_key = product.handle | downcase %}
    
    {% assign is_watch = false %}
    {% if title_key contains 'watch' or handle_key contains 'w-01' or handle_key contains 'watch' or title_key contains 'chronograph' %}
      {% assign is_watch = true %}
    {% endif %}

    {% assign is_earphone = false %}
    {% if title_key contains 'earphone' or handle_key contains 'ear-01' or handle_key contains 'earphone' or title_key contains 'audio' %}
      {% assign is_earphone = true %}
    {% endif %}

    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2 lg:gap-12">
      <!-- Product Media -->
      <div>
        <div class="relative flex aspect-square w-full items-center justify-center overflow-hidden border border-[#2A2A2F] bg-[#131316] p-4 sm:p-8 rounded-none">
          <span class="absolute left-4 top-4 z-10 border border-[#2A2A2F] bg-[#0A0A0C] px-3 py-1 font-mono-tech text-[10px] font-bold uppercase tracking-[0.12em] text-[#C8CDD3] rounded-none">
            {% if is_watch %}
              TIMEPIECE SPEC // W-01
            {% elsif is_earphone %}
              AUDIO SPEC // EAR-01
            {% else %}
              DROP 01 // ARCHIVE PIECE
            {% endif %}
          </span>

          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="1000"
              height="1000"
              fetchpriority="high"
              class="h-full w-full object-contain transition-transform duration-500 hover:scale-105"
            >
          {% else %}
            <div class="font-mono-tech text-xs uppercase tracking-widest text-[#A3A7AE]">
              NO ASSET AVAILABLE
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Product Details & Conversion -->
      <div class="space-y-6">
        <div>
          {% if is_watch %}
            <span class="inline-block border border-[#C8102E] bg-[#C8102E]/20 px-2.5 py-0.5 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-[#C8102E] rounded-none mb-2">
              PRE-ORDER
            </span>
          {% endif %}
          <p class="font-mono-tech text-xs font-bold uppercase tracking-[0.12em] text-[#C8CDD3]">
            {{ product.vendor | default: 'RWND20s' | escape }}
          </p>
          <h1 class="mt-2 font-display text-2xl font-extrabold uppercase tracking-tight text-[#F5F5F7] sm:text-4xl">
            {{ product.title | escape }}
          </h1>
        </div>

        <!-- Pricing Block -->
        <div class="border-y border-[#2A2A2F] py-4">
          {% if is_watch %}
            <div class="space-y-1">
              <div class="flex items-baseline gap-4">
                <span class="font-mono-tech text-2xl font-extrabold text-[#F5F5F7]">₹1,999</span>
                <span class="font-mono-tech text-xs uppercase text-[#A3A7AE]">Prepaid Price</span>
              </div>
              <div class="flex items-baseline gap-4">
                <span class="font-mono-tech text-xl font-bold text-[#A3A7AE]">₹2,199</span>
                <span class="font-mono-tech text-xs uppercase text-[#A3A7AE]">Cash on Delivery</span>
              </div>
              <p class="pt-2 font-mono-tech text-xs text-[#C8CDD3]">
                Dispatches within 14 working days of pre-order confirmation.
              </p>
            </div>
          {% else %}
            <div class="flex items-center justify-between">
              <span class="font-mono-tech text-2xl font-extrabold text-[#F5F5F7] sm:text-3xl">
                {{ current_variant.price | money }}
              </span>
              <span class="border border-[#2A2A2F] bg-[#131316] px-3 py-1 font-mono-tech text-[10px] font-bold uppercase tracking-wider text-[#A3A7AE] rounded-none">
                DISPATCHED FROM MADURAI
              </span>
            </div>
          {% endif %}
        </div>

        <!-- Variant Selection (Strict 0px Button Grid) -->
        {% unless product.has_only_default_variant %}
          <div class="space-y-3">
            <label class="block font-mono-tech text-xs font-bold uppercase tracking-[0.12em] text-[#C8CDD3]">
              SELECT SPECIFICATION
            </label>
            <div class="grid grid-cols-2 gap-2">
              {% for variant in product.variants %}
                <button
                  type="button"
                  {% if variant.available %}
                    onclick="window.location.href='?variant={{ variant.id }}'"
                  {% else %}
                    disabled
                  {% endif %}
                  class="border p-3 text-left font-mono-tech text-xs font-bold uppercase tracking-wider transition-all rounded-none {% if variant.id == current_variant.id %}border-[#C8102E] bg-[#C8102E]/20 text-[#F5F5F7]{% else %}border-[#2A2A2F] bg-[#131316] text-[#A3A7AE] hover:border-[#C8CDD3] hover:text-[#F5F5F7]{% endif %} {% unless variant.available %}opacity-40 cursor-not-allowed line-through{% endunless %}"
                >
                  <span>{{ variant.title | escape }}</span>
                  {% unless variant.available %}
                    <span class="block text-[10px] text-[#C8102E] font-normal pt-0.5">Sold out</span>
                  {% endunless %}
                </button>
              {% endfor %}
            </div>
          </div>
        {% endunless %}

        <!-- Compatibility Warning for Earphones -->
        {% if is_earphone %}
          <aside class="border-l-2 border-[#C8102E] bg-[#131316] p-4 space-y-1.5 rounded-none">
            <p class="font-mono-tech text-xs font-bold text-[#F5F5F7]">
              Type-C only. Not compatible with iPhone 14 and older, or with phones that have a 3.5mm jack.
            </p>
            <p class="font-mono-tech text-xs text-[#A3A7AE]">
              Check that your phone supports USB-C audio before ordering.
            </p>
            <p class="font-mono-tech text-[11px] text-[#A3A7AE]">
              Includes protective case. No adapter. No battery required.
            </p>
          </aside>
        {% endif %}

        <!-- Add to Bag Form & Direct CTA -->
        <div class="space-y-3 pt-2">
          <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button
              type="submit"
              name="add"
              {% unless current_variant.available %}disabled{% endunless %}
              class="w-full h-14 border border-[#C8102E] bg-[#C8102E] font-mono-tech text-xs font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:bg-[#E0213F] rounded-none cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            >
              {% if current_variant.available %}
                {% if is_watch %}[ PRE-ORDER TIMEPIECE ]{% else %}[ + ADD TO HARDWARE BAG ]{% endif %}
              {% else %}
                [ SOLD OUT ]
              {% endif %}
            </button>
          </form>

          <a
            href="/checkout"
            class="flex w-full h-14 items-center justify-center border border-[#2A2A2F] bg-[#131316] font-mono-tech text-xs font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:border-[#C8CDD3] rounded-none"
          >
            INSTANT CHECKOUT →
          </a>
        </div>

        <!-- Specifications & Details Accordions -->
        <div class="space-y-3 border-t border-[#2A2A2F] pt-6">
          {% if is_watch %}
            <div class="border border-[#2A2A2F] bg-[#131316] p-4 rounded-none space-y-2">
              <h2 class="font-mono-tech text-xs font-bold uppercase tracking-[0.12em] text-[#C8CDD3]">
                TIMEPIECE SPECIFICATIONS
              </h2>
              <p class="font-mono-tech text-xs leading-relaxed text-[#A3A7AE]">
                Dual-display analog-digital movement, brushed alloy casing, hardened mineral glass, adjustable stainless steel link strap, stopwatch and LED backlighting.
              </p>
              <div class="pt-2 space-y-1 font-mono-tech text-[11px] text-[#A3A7AE]">
                <p>• Battery: Pre-installed standard SR626SW / CR2016 cell. Operational life approx. 12–18 months.</p>
                <p>• Water rating: Daily splash resistance (3 ATM / 30M). Not suitable for swimming or submersion.</p>
                <p>• Included: 1x Y2K Chronograph, 1x presentation tin, 1x sizing pin, warranty card.</p>
                <p>• Serial-numbered Drop 01 archive release. Verified hardware piece.</p>
                <p class="pt-1 text-[#F5F5F7]">• ₹150 advance is non-refundable. It covers part of the delivery cost if an order is refused or returned.</p>
              </div>
            </div>
          {% else %}
            <div class="border border-[#2A2A2F] bg-[#131316] p-4 rounded-none">
              <h2 class="font-mono-tech text-xs font-bold uppercase tracking-[0.12em] text-[#C8CDD3]">
                MATERIAL SPECIFICATION
              </h2>
              <div class="mt-2 font-mono-tech text-xs leading-relaxed text-[#A3A7AE]">
                {% if product.tags contains 'chains' or product.tags contains 'bracelets' %}
                  <p>Solid 316L stainless steel hardware. Engineered to resist daily corrosion and sweat.</p>
                {% elsif is_earphone %}
                  <p>Metallic pink chrome finish housing with reinforced braided cabling and digital DAC Type-C connector.</p>
                {% else %}
                  <p>{{ product.description | strip_html | default: 'Y2K archive hardware piece. Engineered for durability and nocturnal aesthetics.' }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}

          <div class="border border-[#2A2A2F] bg-[#131316] p-4 rounded-none space-y-2">
            <h2 class="font-mono-tech text-xs font-bold uppercase tracking-[0.12em] text-[#C8CDD3]">
              SHIPPING & RETURNS
            </h2>
            <div class="font-mono-tech text-xs leading-relaxed text-[#A3A7AE] space-y-1.5">
              <p>• Free delivery on ₹999 and above. Below ₹999, ₹49.</p>
              <p>• Delivered in about 48 hours in South India.</p>
              <p>• In-stock items dispatch within 24 hours on working days. Pre-order items dispatch on their stated timeline.</p>
              <p>• Returns accepted only for defective or wrong items. Report within 48 hours with an unboxing video. Replacement or refund.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Page Main",
  "settings": []
}
{% endschema %}
