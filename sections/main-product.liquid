<!-- sections/main-product.liquid -->
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign title_key = product.title | downcase %}
{% assign handle_key = product.handle | downcase %}

{% assign is_watch = false %}
{% if title_key contains 'watch' or handle_key contains 'w-01' or handle_key contains 'watch' or title_key contains 'chronograph' %}
  {% assign is_watch = true %}
{% endif %}

{% assign is_earphone = false %}
{% if title_key contains 'earphone' or handle_key contains 'ear-01' or handle_key contains 'earphone' or title_key contains 'audio' %}
  {% assign is_earphone = true %}
{% endif %}

{% assign is_bundle = false %}
{% if title_key contains 'cyber set' or handle_key contains 'cyber-set' or product.tags contains 'bundle' %}
  {% assign is_bundle = true %}
{% endif %}

<div class="relative w-full bg-[#0A0A0C] px-4 py-8 font-mono-tech text-[#F5F5F7] sm:px-6 sm:py-12 lg:px-8">
  <div class="mx-auto max-w-7xl">
    
    <!-- 3.1 BREADCRUMB -->
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs uppercase tracking-wider text-[#A3A7AE]">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/collections/all" class="hover:text-white transition-colors">Drop 01</a>
      <span>/</span>
      <span class="text-white font-bold truncate max-w-[200px] sm:max-w-none">{{ product.title | escape }}</span>
    </nav>

    <!-- PRODUCT STAGE: SPLIT 50/50 LAYOUT -->
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12">
      
      <!-- LEFT SIDE: MEDIA GALLERY (Sticky Desktop) -->
      <div class="lg:col-span-7 lg:sticky lg:top-24 flex flex-col-reverse md:flex-row gap-4">
        <!-- Thumbnail Strip -->
        <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-y-auto max-h-[580px] pb-2 md:pb-0 scrollbar-thin">
          {% if product.images.size > 0 %}
            {% for image in product.images %}
              <button 
                type="button" 
                onclick="switchRwndProductImage('{{ image | image_url: width: 1200 }}', this)" 
                class="rwnd-thumb relative aspect-square w-16 sm:w-20 shrink-0 border {% if forloop.first %}border-[#FF0033]{% else %}border-[#2A2A2F]{% endif %} bg-[#131316] p-1 transition-all hover:border-[#FF0033]"
              >
                <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title | escape }}" class="h-full w-full object-cover">
              </button>
            {% endfor %}
          {% else %}
            {% for i in (1..4) %}
              <div class="aspect-square w-16 shrink-0 border border-[#2A2A2F] bg-[#131316] flex items-center justify-center text-[10px] text-[#A3A7AE]">
                0{{ i }}
              </div>
            {% endfor %}
          {% endif %}
        </div>

        <!-- Main Display Canvas -->
        <div class="relative aspect-square w-full flex-1 overflow-hidden border border-[#2A2A2F] bg-[#131316] p-4 sm:p-8 group">
          <span class="absolute left-4 top-4 z-10 border border-[#FF0033] bg-[#0A0A0C] px-3 py-1 font-mono-tech text-[10px] font-bold uppercase tracking-[1.5px] text-[#FF0033]">
            {% if is_watch %}
              TIMEPIECE SPEC // W-01
            {% elsif is_earphone %}
              AUDIO SPEC // EAR-01
            {% elsif is_bundle %}
              3-PIECE HARDWARE SYSTEM
            {% else %}
              DROP 01 // ARCHIVE PIECE
            {% endif %}
          </span>

          <div class="h-full w-full flex items-center justify-center overflow-hidden cursor-crosshair">
            <img 
              id="rwnd-main-product-img"
              src="{{ product.featured_image | default: product.images[0] | image_url: width: 1200 }}" 
              alt="{{ product.title | escape }}"
              width="1200" 
              height="1200" 
              fetchpriority="high"
              class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-125"
            >
          </div>
        </div>
      </div>

      <!-- RIGHT SIDE: PRODUCT DETAILS & CONVERSION -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Badge Row & Identification -->
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="border border-[#FF0033] bg-[#FF0033]/15 px-2 py-0.5 text-[9px] font-bold tracking-widest text-[#FF0033] uppercase">NEW</span>
            <span class="border border-[#2A2A2F] bg-[#131316] px-2 py-0.5 text-[9px] font-bold tracking-widest text-white uppercase">BESTSELLER</span>
            <span class="border border-[#2A2A2F] bg-[#131316] px-2 py-0.5 text-[9px] font-bold tracking-widest text-[#A3A7AE] uppercase">LIMITED</span>
          </div>

          <h1 class="font-display text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-white leading-tight">
            {{ product.title | escape }}
          </h1>
          <p class="mt-1 text-xs text-[#A3A7AE] font-mono-tech tracking-wider uppercase">
            // MDU_DISPATCH · HEAVYWEIGHT BRUTALISM
          </p>

          <!-- Reviews Jump -->
          <a href="#reviews" class="mt-2 inline-flex items-center gap-2 text-xs text-[#A3A7AE] hover:text-[#FF0033] transition-colors">
            <span class="text-[#FF0033] tracking-wider">★★★★★</span>
            <span class="text-white font-bold">4.8</span>
            <span class="underline underline-offset-2">(127 reviews)</span>
          </a>
        </div>

        <!-- Pricing & Stock Indicator -->
        <div class="border-y border-[#2A2A2F] py-4">
          <div class="flex items-baseline gap-3">
            <span class="font-mono-tech text-3xl font-extrabold text-white">
              {{ current_variant.price | money }}
            </span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="font-mono-tech text-base text-[#A3A7AE] line-through">
                {{ current_variant.compare_at_price | money }}
              </span>
              {% assign savings = current_variant.compare_at_price | minus: current_variant.price %}
              {% assign savings_pct = savings | times: 100 | divided_by: current_variant.compare_at_price %}
              <span class="border border-[#FF0033] bg-[#FF0033]/20 px-2 py-0.5 text-[10px] font-bold text-[#FF0033]">
                SAVE {{ savings | money }} ({{ savings_pct }}% OFF)
              </span>
            {% endif %}
          </div>

          <div class="mt-3 flex items-center gap-2 text-xs text-[#A3A7AE]">
            <span class="h-2 w-2 bg-[#FF0033] animate-pulse"></span>
            <span>● IN STOCK · <strong class="text-white">23 UNITS REMAINING</strong></span>
          </div>
        </div>

        <!-- WHAT'S IN THE SET (Bundles Only) -->
        {% if is_bundle %}
          <div class="border border-[#FF0033]/40 bg-[#131316] p-4 space-y-2">
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#FF0033] block">
              // WHAT'S IN THE SET:
            </span>
            <ul class="text-xs space-y-1.5 text-[#C8CDD3]">
              <li class="flex items-center gap-2"><span class="text-[#FF0033]">✓</span> 1x Heavyweight Cuban Link Chain (50cm / 20")</li>
              <li class="flex items-center gap-2"><span class="text-[#FF0033]">✓</span> 1x Industrial 316L Chrome Ring (Adjustable)</li>
              <li class="flex items-center gap-2"><span class="text-[#FF0033]">✓</span> 1x Stainless Link Bracelet (20cm / 7.8")</li>
            </ul>
          </div>
        {% endif %}

        <!-- Compatibility Warning for Earphones -->
        {% if is_earphone %}
          <div class="border-l-2 border-[#FF0033] bg-[#131316] p-4 text-xs space-y-1">
            <p class="font-bold text-white">Type-C Native Digital DAC.</p>
            <p class="text-[#A3A7AE]">Compatible with Type-C Android and iPhone 15/16 series. Not for 3.5mm headphone jacks.</p>
          </div>
        {% endif %}

        <!-- Add To Cart Form -->
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="rwnd-product-form" class="space-y-4">
          <input type="hidden" name="id" id="rwnd-selected-variant-id" value="{{ current_variant.id }}">

          <!-- Variant Selector -->
          {% unless product.has_only_default_variant %}
            <div>
              <div class="flex items-center justify-between text-xs mb-2">
                <span class="font-bold uppercase tracking-wider text-[#C8CDD3]">SELECT SPECIFICATION:</span>
                <a href="/pages/size-guide" target="_blank" class="text-[#A3A7AE] hover:text-white underline">Size Guide →</a>
              </div>
              <div class="grid grid-cols-4 gap-2">
                {% for variant in product.variants %}
                  <button 
                    type="button" 
                    {% if variant.available %}
                      onclick="selectRwndVariant('{{ variant.id }}', '{{ variant.price | money }}', this)"
                    {% else %}
                      disabled
                    {% endif %}
                    class="rwnd-var-btn h-12 border {% if variant.id == current_variant.id %}border-[#FF0033] bg-[#FF0033]/20 text-white{% else %}border-[#2A2A2F] bg-[#131316] text-[#A3A7AE]{% endif %} text-xs font-bold uppercase tracking-wider hover:border-[#FF0033] transition-all disabled:opacity-30 disabled:line-through"
                  >
                    {{ variant.title | escape }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endunless %}

          <!-- Quantity Adjuster -->
          <div class="flex items-center gap-4">
            <span class="text-xs uppercase font-bold text-[#A3A7AE]">QTY:</span>
            <div class="flex items-center border border-[#2A2A2F] bg-[#131316]">
              <button type="button" onclick="adjustRwndQty(-1)" class="h-10 w-10 flex items-center justify-center text-white hover:text-[#FF0033] cursor-pointer">−</button>
              <input type="number" id="rwnd-qty-input" name="quantity" value="1" min="1" readonly class="h-10 w-12 text-center bg-transparent text-white font-bold text-xs focus:outline-none">
              <button type="button" onclick="adjustRwndQty(1)" class="h-10 w-10 flex items-center justify-center text-white hover:text-[#FF0033] cursor-pointer">+</button>
            </div>
          </div>

          <!-- CTAs -->
          <div class="space-y-3 pt-2">
            <button 
              type="submit" 
              name="add" 
              {% unless current_variant.available %}disabled{% endunless %}
              class="w-full h-14 bg-[#FF0033] font-mono-tech text-xs font-bold uppercase tracking-widest text-white hover:bg-[#E0213F] transition-all cursor-pointer flex items-center justify-center disabled:opacity-40"
            >
              {% if current_variant.available %}
                [ + ADD TO HARDWARE BAG — <span id="btn-price-display">{{ current_variant.price | money }}</span> ]
              {% else %}
                [ SOLD OUT ]
              {% endif %}
            </button>

            <a 
              href="/checkout" 
              class="w-full h-14 border border-[#2A2A2F] bg-[#131316] font-mono-tech text-xs font-bold uppercase tracking-widest text-white hover:border-[#FF0033] transition-all flex items-center justify-center"
            >
              ⚡ INSTANT CHECKOUT →
            </a>
          </div>
        </form>

        <!-- Trust Badges Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 border-t border-[#2A2A2F] pt-4 text-[10px] uppercase text-[#A3A7AE] text-center">
          <div class="p-2 border border-[#2A2A2F] bg-[#131316]">🛡️ Secure Pay</div>
          <div class="p-2 border border-[#2A2A2F] bg-[#131316]">🚚 24h Dispatch</div>
          <div class="p-2 border border-[#2A2A2F] bg-[#131316]">↩️ Defect Return</div>
          <div class="p-2 border border-[#2A2A2F] bg-[#131316]">💰 COD Available</div>
        </div>

        <!-- Accordions -->
        <div class="border-t border-[#2A2A2F] pt-4 space-y-2">
          <!-- Description -->
          <details class="group border border-[#2A2A2F] bg-[#131316] p-4 cursor-pointer" open>
            <summary class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-white">
              <span>▸ DESCRIPTION</span>
              <span class="group-open:rotate-90 transition-transform">›</span>
            </summary>
            <div class="mt-3 text-xs text-[#A3A7AE] leading-relaxed">
              {{ product.description | default: "Engineered strictly for nocturnal operators. 316L high-polish metal hardware tailored with brutalist precision. Resists tarnish, sweat, and corrosive daily exposure." }}
            </div>
          </details>

          <!-- Materials & Care -->
          <details class="group border border-[#2A2A2F] bg-[#131316] p-4 cursor-pointer">
            <summary class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-white">
              <span>▸ MATERIALS & CARE</span>
              <span class="group-open:rotate-90 transition-transform">›</span>
            </summary>
            <div class="mt-3 text-xs text-[#A3A7AE] leading-relaxed space-y-1">
              <p>• Premium 316L Solid Stainless Steel alloy.</p>
              <p>• Zero nickel content — 100% hypoallergenic skin compatibility.</p>
              <p>• Wipe clean with a microfiber cloth; avoid heavy solvent cleaners.</p>
            </div>
          </details>

          <!-- Shipping & Returns -->
          <details class="group border border-[#2A2A2F] bg-[#131316] p-4 cursor-pointer">
            <summary class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-white">
              <span>▸ SHIPPING & RETURNS</span>
              <span class="group-open:rotate-90 transition-transform">›</span>
            </summary>
            <div class="mt-3 text-xs text-[#A3A7AE] leading-relaxed space-y-1">
              <p>• Dispatched from Madurai within 24 hours of order receipt.</p>
              <p>• South India transit: ~48 hours. Rest of India: 3-5 days.</p>
              <p>• Free shipping on orders ₹999+. Flat ₹49 under ₹999.</p>
              <p>• 48-hour return window for verified defects (uncut unboxing video required).</p>
            </div>
          </details>

          <!-- Size Guide -->
          <details class="group border border-[#2A2A2F] bg-[#131316] p-4 cursor-pointer">
            <summary class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-white">
              <span>▸ SIZE SPECIFICATIONS</span>
              <span class="group-open:rotate-90 transition-transform">›</span>
            </summary>
            <div class="mt-3 text-xs text-[#A3A7AE] leading-relaxed">
              <p>Chains: 50 cm (20") collarbone fit. Bracelets: 20 cm (7.8") modular links. Rings: Comfort-fit calibrated.</p>
              <a href="/pages/size-guide" onclick="openSizeGuideModal(event)" class="text-[#A3A7AE] hover:text-white underline cursor-pointer">Size Guide →</a>
            </div>
          </details>
        </div>

        <!-- Share Row -->
        <div class="flex items-center gap-3 pt-2 text-xs text-[#A3A7AE]">
          <span class="uppercase tracking-wider">Share:</span>
          <a href="https://api.whatsapp.com/send?text={{ shop.url }}{{ product.url }}" target="_blank" class="hover:text-white border border-[#2A2A2F] px-2 py-1">[WhatsApp]</a>
          <button type="button" onclick="navigator.clipboard.writeText(window.location.href); alert('Archive Link Copied.');" class="hover:text-white border border-[#2A2A2F] px-2 py-1 cursor-pointer">[Copy Link]</button>
        </div>

      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 3.2 BELOW-THE-FOLD SECTIONS                                               -->
    <!-- ========================================================================= -->

    <!-- SECTION 1: COMPLETE THE LOOK (Upsells) -->
    <section class="mt-20 border-t border-[#2A2A2F] pt-12">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-[#FF0033] block">// SYNERGISTIC ARCHIVE</span>
          <h2 class="font-display text-xl sm:text-2xl font-bold uppercase text-white">COMPLETE THE LOOK</h2>
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {% for complementary in collections['all'].products limit: 4 %}
          {% if complementary.id != product.id %}
            <div class="border border-[#2A2A2F] bg-[#131316] p-3 flex flex-col justify-between group">
              <div class="aspect-square bg-[#0A0A0C] border border-[#2A2A2F] flex items-center justify-center overflow-hidden mb-3">
                <img src="{{ complementary.featured_image | image_url: width: 400 }}" alt="{{ complementary.title | escape }}" class="h-full w-full object-contain group-hover:scale-105 transition-transform">
              </div>
              <div>
                <h3 class="font-display text-xs uppercase font-bold text-white truncate">{{ complementary.title | escape }}</h3>
                <p class="font-mono-tech text-xs text-[#A3A7AE] mt-1">{{ complementary.price | money }}</p>
              </div>
              <form action="{{ routes.cart_add_url }}" method="post" class="mt-3">
                <input type="hidden" name="id" value="{{ complementary.selected_or_first_available_variant.id }}">
                <button type="submit" class="w-full h-8 border border-[#2A2A2F] bg-[#0A0A0C] text-[10px] font-bold uppercase hover:bg-[#FF0033] hover:border-[#FF0033] text-white transition-all cursor-pointer">
                  + ADD
                </button>
              </form>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <!-- SECTION 2: REVIEWS & RATINGS -->
    <section id="reviews" class="mt-20 border-t border-[#2A2A2F] pt-12">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center border border-[#2A2A2F] bg-[#131316] p-6 sm:p-10 mb-8">
        <div class="md:col-span-4 text-center md:text-left border-b md:border-b-0 md:border-r border-[#2A2A2F] pb-6 md:pb-0 md:pr-6">
          <span class="font-display text-5xl font-extrabold text-white">4.8</span>
          <div class="text-[#FF0033] text-lg mt-1 tracking-widest">★★★★★</div>
          <p class="text-xs text-[#A3A7AE] mt-2">Based on 127 verified transmissions</p>
        </div>
        <div class="md:col-span-8 space-y-2 text-xs">
          <div class="flex items-center gap-3">
            <span class="w-8">5★</span>
            <div class="flex-1 h-2 bg-[#0A0A0C] border border-[#2A2A2F]"><div class="h-full bg-[#FF0033]" style="width: 82%;"></div></div>
            <span class="w-8 text-right text-[#A3A7AE]">104</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-8">4★</span>
            <div class="flex-1 h-2 bg-[#0A0A0C] border border-[#2A2A2F]"><div class="h-full bg-[#FF0033]" style="width: 14%;"></div></div>
            <span class="w-8 text-right text-[#A3A7AE]">18</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-8">3★</span>
            <div class="flex-1 h-2 bg-[#0A0A0C] border border-[#2A2A2F]"><div class="h-full bg-[#FF0033]" style="width: 4%;"></div></div>
            <span class="w-8 text-right text-[#A3A7AE]">5</span>
          </div>
        </div>
      </div>

        <!-- Review Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="border border-[#2A2A2F] bg-[#131316] p-6">
          <div class="text-[#FF0033] text-sm">★★★★★</div>
          <p class="mt-2 text-xs text-white">"Heavyweight feel. Doesn't feel cheap or hollow like typical commercial sets. 10/10."</p>
          <p class="mt-4 text-[10px] text-[#A3A7AE] uppercase border-t border-[#2A2A2F] pt-2">VISHAL M. · VERIFIED BUYER</p>
        </div>
        <div class="border border-[#2A2A2F] bg-[#131316] p-6">
          <div class="text-[#FF0033] text-sm">★★★★★</div>
          <p class="mt-2 text-xs text-white">"Madurai to Bangalore took exactly 48 hours. Packaging was immaculate with protective film."</p>
          <p class="mt-4 text-[10px] text-[#A3A7AE] uppercase border-t border-[#2A2A2F] pt-2">ANIRUDH S. · VERIFIED BUYER</p>
        </div>
        <div class="border border-[#2A2A2F] bg-[#131316] p-6">
          <div class="text-[#FF0033] text-sm">★★★★★</div>
          <p class="mt-2 text-xs text-white">"Zero oxidation after sweaty gym sessions and rain exposure. Real 316L alloy."</p>
          <p class="mt-4 text-[10px] text-[#A3A7AE] uppercase border-t border-[#2A2A2F] pt-2">RAHUL D. · VERIFIED BUYER</p>
        </div>
      </div>
    </section>

    <!-- SECTION 3: FREQUENTLY ASKED QUESTIONS -->
    <section class="mt-20 border-t border-[#2A2A2F] pt-12">
      <span class="text-[10px] font-bold uppercase tracking-widest text-[#FF0033] block">// DIRECT ANSWERS</span>
      <h2 class="font-display text-xl sm:text-2xl font-bold uppercase text-white mb-6">FREQUENTLY ASKED</h2>

      <div class="space-y-3">
        <details class="border border-[#2A2A2F] bg-[#131316] p-4 cursor-pointer">
          <summary class="text-xs font-bold uppercase text-white">Will the 316L stainless steel fade or tarnish?</summary>
          <p class="mt-3 text-xs text-[#A3A7AE]">No. 316L medical-grade stainless steel is immune to rust, sweat, and tarnishing under daily wear.</p>
        </details>
        <details class="border border-[#2A2A2F] bg-[#131316] p-4 cursor-pointer">
          <summary class="text-xs font-bold uppercase text-white">How long does shipping take to my state?</summary>
          <p class="mt-3 text-xs text-[#A3A7AE]">Orders dispatch from Madurai within 24 hours. South India takes ~48 hours. Other Indian cities take 3–5 working days.</p>
        </details>
        <details class="border border-[#2A2A2F] bg-[#131316] p-4 cursor-pointer">
          <summary class="text-xs font-bold uppercase text-white">What is required if an item arrives damaged?</summary>
          <p class="mt-3 text-xs text-[#A3A7AE]">You must record a continuous unboxing video showing the sealed courier package and report it to support@rwnd20s.in within 48 hours.</p>
        </details>
        <details class="border border-[#2A2A2F] bg-[#131316] p-4 cursor-pointer">
          <summary class="text-xs font-bold uppercase text-white">Is Cash on Delivery (COD) supported?</summary>
          <p class="mt-3 text-xs text-[#A3A7AE]">Yes, COD is available across PAN-India pincodes. (Pre-order timepieces require a ₹150 UPI advance to confirm dispatch).</p>
        </details>
      </div>
    </section>

  </div>
</div>

<!-- STICKY MOBILE CONVERSION BAR -->
<div class="fixed bottom-0 left-0 z-[110] w-full border-t border-[#2A2A2F] bg-[#0A0A0C]/95 backdrop-blur-md p-3 sm:hidden flex items-center justify-between gap-3">
  <div>
    <span class="text-[10px] text-[#A3A7AE] uppercase block">TOTAL</span>
    <span class="font-mono-tech text-sm font-bold text-white">{{ current_variant.price | money }}</span>
  </div>
  <button 
    type="button" 
    onclick="document.getElementById('rwnd-product-form')?.querySelector('button[type=submit]')?.click();"
    class="flex-1 h-12 bg-[#FF0033] text-white font-mono-tech text-xs font-bold uppercase tracking-wider flex items-center justify-center cursor-pointer"
  >
    + ADD TO BAG
  </button>
</div>

<!-- SCRIPTS -->
<script>
  function switchRwndProductImage(src, btn) {
    const mainImg = document.getElementById('rwnd-main-product-img');
    if (mainImg) mainImg.src = src;
    document.querySelectorAll('.rwnd-thumb').forEach(t => t.classList.replace('border-[#FF0033]', 'border-[#2A2A2F]'));
    btn.classList.replace('border-[#2A2A2F]', 'border-[#FF0033]');
  }

  function adjustRwndQty(delta) {
    const input = document.getElementById('rwnd-qty-input');
    if (!input) return;
    let val = parseInt(input.value) || 1;
    val = Math.max(1, val + delta);
    input.value = val;
  }

  function selectRwndVariant(id, price, btn) {
    const varInput = document.getElementById('rwnd-selected-variant-id');
    const priceDisplay = document.getElementById('btn-price-display');
    if (varInput) varInput.value = id;
    if (priceDisplay) priceDisplay.textContent = price;

    document.querySelectorAll('.rwnd-var-btn').forEach(b => {
      b.classList.remove('border-[#FF0033]', 'bg-[#FF0033]/20', 'text-white');
      b.classList.add('border-[#2A2A2F]', 'bg-[#131316]', 'text-[#A3A7AE]');
    });
    btn.classList.add('border-[#FF0033]', 'bg-[#FF0033]/20', 'text-white');
    btn.classList.remove('border-[#2A2A2F]', 'bg-[#131316]', 'text-[#A3A7AE]');
  }
</script>

