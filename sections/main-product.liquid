<!-- sections/main-home.liquid -->
<div class="relative w-full bg-transparent text-[#E9E3D5] pb-24 font-mono-tech">
  <section class="relative px-4 pt-8 md:px-8 lg:px-12">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-white/15 pb-8">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-red-900/40 bg-black/60 px-3.5 py-1 font-mono-tech text-[11px] font-bold uppercase tracking-wider text-red-500 backdrop-blur-md">
            <span class="h-2 w-2 rounded-full bg-red-600 animate-pulse"></span>
            <span>RWND20S // OLD VIBE. NEW YOU.</span>
          </div>
          <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-extrabold uppercase tracking-tight mt-3 text-white drop-shadow-md">
            {{ section.settings.hero_title | default: 'RWND20S. ARCHIVE' }}
          </h1>
          <p class="mt-2 font-mono-tech text-xs sm:text-sm text-zinc-400 max-w-xl">
            {{ section.settings.hero_subtitle | default: 'Y2K accessories with a dark street edge and chrome details.' }}
          </p>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-span-7 rounded-3xl border border-white/12 foggy-glass p-6 sm:p-10 shadow-xl relative overflow-hidden backdrop-blur-xl">
          <div class="absolute top-4 right-4 font-mono-tech text-[10px] font-bold text-red-400 uppercase tracking-widest border border-red-900/40 bg-black/60 rounded-full px-3 py-1 backdrop-blur-md">
            Y2K // DROP 01
          </div>
          <p class="font-mono-tech text-xs text-zinc-400 uppercase tracking-widest">3-Piece Y2K Cyber Set</p>
          <h2 class="font-display text-2xl sm:text-4xl font-bold uppercase text-white mt-1">Ring + chain + bracelet</h2>
          <p class="mt-3 text-xs sm:text-sm text-zinc-300">316L stainless steel pieces with an all-night silhouette and easy layering.</p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a href="/collections/all" class="rounded-full border border-red-900/60 bg-black/80 px-6 py-3 font-mono-tech text-xs font-bold text-red-100 uppercase tracking-wider hover:bg-red-900 hover:text-white transition-colors">
              Explore the archive
            </a>
            <span class="font-mono-tech text-xs font-bold text-white">From ₹1,199</span>
          </div>
        </div>

        <div class="lg:col-span-5 rounded-3xl border border-white/12 bg-black/60 p-6 sm:p-10 flex flex-col justify-between min-h-[280px] backdrop-blur-xl shadow-xl">
          <div class="flex items-center justify-between">
            <span class="font-mono-tech text-[10px] uppercase font-bold tracking-widest text-zinc-400">Shipping</span>
            <span class="font-mono-tech text-[10px] text-red-500 font-bold uppercase">Live</span>
          </div>
          <div class="my-auto py-6">
            <p class="font-mono-tech text-xs text-zinc-400 uppercase">Dispatch rule</p>
            <div class="mt-2 font-mono-tech text-xl sm:text-2xl font-extrabold text-white">
              Free delivery on ₹999 and above.
            </div>
            <div class="mt-2 font-mono-tech text-sm text-zinc-300">Below ₹999, ₹49.</div>
          </div>
          <p class="font-mono-tech text-[11px] text-zinc-500">Dispatched from Madurai.</p>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Homepage Main Stage",
  "settings": [
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Main Title",
      "default": "RWND20S. ARCHIVE"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Y2K accessories with a dark street edge and chrome details."
    }
  ],
  "presets": [
    {
      "name": "Homepage Main Stage"
    }
  ]
}
{% endschema %}
