<div class="relative w-full bg-[#DCDFE5] text-[#09090B] py-12 px-4 sm:px-6 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="mb-8 font-mono-tech text-xs text-[#52525B]">
      <ol class="flex items-center gap-2 uppercase tracking-wider">
        <li><a href="/" class="hover:text-[#09090B]">BASE</a></li>
        <li>/</li>
        <li><a href="/collections/all" class="hover:text-[#09090B]">ARCHIVE</a></li>
        <li>/</li>
        <li class="text-[#09090B] font-bold truncate max-w-[200px] sm:max-w-none">{{ product.title }}</li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Product Media Gallery (Left Column) -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        <div class="rounded-3xl border border-[#09090B]/20 bg-white p-4 sm:p-6 shadow-xl overflow-hidden relative">
          <div class="absolute top-4 left-4 z-10 font-mono-tech text-[10px] font-bold uppercase tracking-widest bg-[#09090B] text-white px-3 py-1 rounded-full">
            {% if product.compare_at_price > product.price %}ARCHIVE SALE{% else %}DROP 01 SPEC{% endif %}
          </div>
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" class="w-full h-[360px] sm:h-[520px] object-contain mix-blend-multiply transition-transform duration-300 hover:scale-105">
          {% else %}
            <div class="w-full h-[360px] sm:h-[520px] bg-[#D4D8E0] flex items-center justify-center font-mono-tech text-xs text-[#52525B]">
              NO IMAGE SPECIFIED
            </div>
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="grid grid-cols-4 gap-3">
            {% for media in product.media %}
              <div class="rounded-2xl border border-[#09090B]/15 bg-white p-2 cursor-pointer hover:border-[#09090B]">
                <img src="{{ media | image_url: width: 300 }}" alt="" class="w-full h-20 object-contain mix-blend-multiply">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Details & Buy Box (Right Column) -->
      <div class="lg:col-span-5 flex flex-col gap-6 sticky top-24">
        <div class="rounded-3xl border border-[#09090B]/20 bg-white p-6 sm:p-8 shadow-xl">
          <p class="font-mono-tech text-xs text-[#52525B] uppercase tracking-widest">
            {{ product.vendor | default: 'RWND20S HARDWARE' }}
          </p>
          <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-[#09090B] uppercase mt-1">
            {{ product.title }}
          </h1>

          <!-- Price Display -->
          <div class="mt-4 flex items-baseline gap-3">
            <span class="font-mono-tech text-2xl font-extrabold text-[#09090B]" id="rwnd-product-price">
              {{ product.selected_or_first_available_variant.price | money }}
            </span>
            {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
              <span class="font-mono-tech text-sm text-[#52525B] line-through">
                {{ product.selected_or_first_available_variant.compare_at_price | money }}
              </span>
            {% endif %}
          </div>

          <!-- Form / Variant Selection -->
          {% form 'product', product, class: 'mt-6' %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="rwnd-pdp-variant-select">

            {% unless product.has_only_default_variant %}
              <div class="space-y-4 mb-6">
                {% for option in product.options_with_values %}
                  <div>
                    <label class="block font-mono-tech text-xs font-bold text-[#09090B] uppercase mb-2">
                      {{ option.name }}:
                    </label>
                    <div class="flex flex-wrap gap-2">
                      {% for value in option.values %}
                        <button type="button" class="px-3.5 py-2 rounded-full border border-[#09090B]/20 font-mono-tech text-xs uppercase hover:border-[#09090B] transition-colors cursor-pointer {% if option.selected_value == value %}bg-[#09090B] text-white font-bold border-[#09090B]{% else %}bg-white text-[#3F3F46]{% endif %}">
                          {{ value }}
                        </button>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endunless %}

            <!-- Quantity Selector -->
            <div class="flex items-center gap-4 mb-6">
              <span class="font-mono-tech text-xs font-bold uppercase text-[#09090B]">QTY:</span>
              <div class="inline-flex items-center rounded-full border border-[#09090B]/20 bg-[#DCDFE5]/50 px-3 py-1">
                <button type="button" onclick="const q=document.getElementById('rwnd-pdp-quantity'); q.value=Math.max(1, Number(q.value)-1);" class="font-mono-tech text-xs font-bold px-2 cursor-pointer">-</button>
                <input type="number" id="rwnd-pdp-quantity" name="quantity" value="1" min="1" class="w-8 text-center bg-transparent font-mono-tech text-xs font-bold text-[#09090B] focus:outline-none">
                <button type="button" onclick="const q=document.getElementById('rwnd-pdp-quantity'); q.value=Number(q.value)+1;" class="font-mono-tech text-xs font-bold px-2 cursor-pointer">+</button>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="space-y-3">
              <button type="button" data-add-to-cart variant-id="{{ product.selected_or_first_available_variant.id }}" class="w-full rounded-full border border-[#09090B] bg-[#09090B] py-4 font-mono-tech text-xs font-bold text-white uppercase tracking-widest hover:bg-white hover:text-[#09090B] transition-colors cursor-pointer shadow-md">
                ADD TO HARDWARE BAG +
              </button>
              <button type="button" data-shopify-checkout class="w-full rounded-full border border-[#09090B] bg-white py-3.5 font-mono-tech text-xs font-bold text-[#09090B] uppercase tracking-widest hover:bg-[#09090B]/10 transition-colors cursor-pointer">
                INSTANT CHECKOUT // SECURE
              </button>
            </div>
          {% endform %}

          <!-- Shipping & Perks Info -->
          <div class="mt-8 pt-6 border-t border-[#09090B]/10 space-y-2 font-mono-tech text-[11px] text-[#52525B]">
            <p>✦ <strong>Free Express Shipping</strong> on all orders above ₹999.</p>
            <p>✦ <strong>Cash on Delivery</strong> available with zero advance fee.</p>
            <p>✦ <strong>Welcome Offer:</strong> Use your unlocked pass for instant discounts.</p>
          </div>
        </div>

        <!-- Description Box -->
        <div class="rounded-3xl border border-[#09090B]/20 bg-white p-6 sm:p-8 shadow-md">
          <h2 class="font-mono-tech text-xs font-bold uppercase tracking-widest text-[#09090B] mb-3">
            ARTIFACT SPECIFICATIONS
          </h2>
          <div class="prose font-mono-tech text-xs text-[#3F3F46] leading-relaxed">
            {{ product.description }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Main Spec",
  "settings": []
}
{% endschema %}
