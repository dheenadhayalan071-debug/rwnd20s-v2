<!-- sections/main-product.liquid -->
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign title_key = product.title | downcase %}
{% assign handle_key = product.handle | downcase %}

{% assign tags_key = product.tags | join: ' ' | downcase %}

{%- comment -%} Category comes from one shared snippet so the PDP, cards, search and filters can never disagree. {%- endcomment -%}
{%- capture p_cat -%}{%- render 'product-category', product: product -%}{%- endcapture -%}
{%- assign p_cat = p_cat | strip -%}

{% assign is_watch = false %}
{% if p_cat == 'watch' %}
  {% assign is_watch = true %}
{% endif %}

{% assign is_earphone = false %}
{% if p_cat == 'audio' %}
  {% assign is_earphone = true %}
{% endif %}

{% assign is_bundle = false %}
{% if p_cat == 'set' %}
  {% assign is_bundle = true %}
{% endif %}

{% assign is_ring = false %}
{% if p_cat == 'ring' %}
  {% assign is_ring = true %}
{% endif %}

{% assign is_bracelet = false %}
{% if p_cat == 'bracelet' %}
  {% assign is_bracelet = true %}
{% endif %}

{% assign is_necklace = false %}
{% if p_cat == 'necklace' %}
  {% assign is_necklace = true %}
{% endif %}

{%- comment -%} Category hardware shot, used only when the product has no media yet. {%- endcomment -%}
{% assign pdp_fallback = 'chain-fallback.webp' %}
{% if p_cat == 'ring' %}{% assign pdp_fallback = 'ring-fallback.webp' %}{% elsif p_cat == 'bracelet' %}{% assign pdp_fallback = 'bracelet-fallback.webp' %}{% endif %}

{%- comment -%} NATIVE METAOBJECT REVIEWS CALCULATION {%- endcomment -%}
{% assign meta_reviews = product.metafields.custom.reviews.value %}
{% assign review_count = 0 %}
{% assign rating_sum = 0 %}
{% assign count_5 = 0 %}
{% assign count_4 = 0 %}
{% assign count_3 = 0 %}

{% if meta_reviews != blank %}
  {% for rev in meta_reviews %}
    {% if rev.approved.value %}
      {% assign r_val = rev.rating.value.rating | default: rev.rating.value | default: 5 | round %}
      {% assign review_count = review_count | plus: 1 %}
      {% assign rating_sum = rating_sum | plus: r_val %}
      {% if r_val == 5 %}{% assign count_5 = count_5 | plus: 1 %}{% endif %}
      {% if r_val == 4 %}{% assign count_4 = count_4 | plus: 1 %}{% endif %}
      {% if r_val == 3 %}{% assign count_3 = count_3 | plus: 1 %}{% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if review_count > 0 %}
  {% assign avg_x10 = rating_sum | times: 10 | divided_by: review_count %}
  {% assign avg_whole = avg_x10 | divided_by: 10 %}
  {% assign avg_dec = avg_x10 | modulo: 10 %}
  {% assign avg_display = avg_whole | append: '.' | append: avg_dec %}
{% else %}
  {% assign review_count = 0 %}
  {% assign avg_display = '—' %}
{% endif %}

<style>
  .pdp-shell {
    width: 100%;
    background-color: #000000;
    color: #F0F0F0;
    padding: 16px 16px 96px;
  }
  @media (min-width: 1024px) {
    .pdp-shell { padding: 32px 32px 72px; }
  }
  .pdp-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .pdp-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
      align-items: start;
    }
  }
  .pdp-container {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .pdp-telemetry-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .pdp-status-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tech-chip {
    padding: 4px 8px;
    background-color: #121212;
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #A3A3A3;
  }
  .tech-chip--red {
    background-color: rgba(255, 0, 51, 0.12);
    border-color: rgba(255, 0, 51, 0.35);
    color: #FF0033;
  }
  .pdp-title {
    font-family: 'Druk Wide Bold', 'Syne', sans-serif;
    font-size: clamp(1.3rem, 5vw, 2rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: #FFFFFF;
    text-transform: uppercase;
    margin: 0;
  }
  .pdp-sub-row {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .pdp-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .loadout-manifest {
    background-color: #0A0A0A;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-left: 2px solid #FF0033;
    padding: 16px;
  }
  .manifest-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .manifest-list {
    list-style: none;
    margin: 12px 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .manifest-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  @media (min-width: 640px) {
    .trust-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 6px;
  }
  .accordion-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .accordion-trigger {
    list-style: none;
    padding: 15px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #FFFFFF;
  }
  .accordion-trigger::-webkit-details-marker { display: none; }
  .accordion-icon {
    color: #FF0033;
    font-size: 16px;
    transition: transform 150ms ease;
  }
  .accordion-item[open] .accordion-icon { transform: rotate(45deg); }
  .specs-table {
    width: 100%;
    border-collapse: collapse;
  }
  .specs-table td {
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    vertical-align: top;
  }
  .specs-table td:first-child {
    width: 36%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #737373;
    text-transform: uppercase;
  }
  .specs-table td:last-child {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #F0F0F0;
  }

  /* Variant Selector Chips (Single-Line, Zero Wrap) */
  .variant-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 4px;
  }
  .variant-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .size-guide-link {
    background: transparent;
    border: none;
    padding: 0;
    color: #FFFFFF;
    text-decoration: underline;
    cursor: pointer;
  }
  .variant-chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cyber-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 12px;
    background-color: #0A0A0A;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #A3A3A3;
    cursor: pointer;
    white-space: nowrap;
    max-width: 100%;
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }
  .cyber-chip:hover:not(.cyber-chip--disabled) {
    border-color: rgba(255, 0, 51, 0.6);
    color: #FFFFFF;
  }
  .cyber-chip--active {
    border-color: #FF0033;
    background-color: rgba(255, 0, 51, 0.12);
    color: #FFFFFF;
  }
  .cyber-chip--disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .cyber-chip .chip-input {
    display: none;
  }
  .cyber-chip .chip-pip {
    width: 6px;
    height: 6px;
    background-color: #737373;
    flex-shrink: 0;
  }
  .cyber-chip--active .chip-pip {
    background-color: #FF0033;
    box-shadow: 0 0 8px #FF0033;
  }
  .cyber-chip .chip-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cyber-chip .chip-tag {
    padding: 2px 5px;
    background-color: #181818;
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 9px;
    color: #A3A3A3;
    flex-shrink: 0;
  }
  .cyber-chip--active .chip-tag {
    border-color: rgba(255, 0, 51, 0.4);
    color: #FF0033;
  }

/* ==========================================================================
   INDUSTRIAL VECTOR TRUST GRID (MONOCHROME + RED ACCENTS)
   ========================================================================== */

.industrial-trust-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: rgba(255, 255, 255, 0.08); /* 1px crisp grid divider */
  border: 1px solid rgba(255, 255, 255, 0.08);
  margin: 20px 0 32px 0;
  width: 100%;
}

.trust-badge {
  background: #000000;
  padding: 12px 10px;
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.badge-icon-box {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trust-svg {
  width: 18px;
  height: 18px;
  stroke: var(--red-core, #FF0033);
}

.badge-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: hidden;
}

.badge-title {
  color: #FFFFFF;
  font-size: 0.65rem;
  font-weight: 700;
  white-space: nowrap;
  letter-spacing: 0.03em;
}

.badge-sub {
  font-size: 0.6rem;
  line-height: 1.25;
  color: #737373;
}

  /* ==========================================================================
     VIEWPORT OVERLAP HOTFIX & QUANTITY NORMALIZATION
     ========================================================================== */
  .pdp-shell {
    padding-bottom: 120px !important;
  }

  .qty-selector {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #0A0A0A;
    border: 1px solid rgba(255, 255, 255, 0.12);
    width: 100px;
    height: 52px;
    flex-shrink: 0;
  }

  .qty-btn {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    width: 32px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0 !important;
  }

  .qty-btn:active {
    background: rgba(255, 255, 255, 0.1);
  }

  .qty-input {
    width: 36px !important;
    height: 100% !important;
    background: transparent !important;
    border: none !important;
    color: #FFFFFF !important;
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.95rem !important;
    font-weight: 700 !important;
    text-align: center !important;
    padding: 0 !important;
    margin: 0 !important;
    line-height: 52px !important;
    -moz-appearance: textfield;
  }

  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

</style>

<div class="pdp-shell">
  <div class="pdp-grid">
    
    <!-- LEFT COLUMN: MEDIA GALLERY -->
    <div class="lg:sticky lg:top-24 flex flex-col-reverse md:flex-row gap-3">
      {% if product.images.size > 1 %}
        <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-y-auto max-h-[540px] pb-1 md:pb-0">
          {% for image in product.images %}
            <button 
              type="button" 
              onclick="switchRwndProductImage('{{ image | image_url: width: 1200 }}', this)" 
              class="rwnd-thumb relative aspect-square w-16 shrink-0 border {% if forloop.first %}border-brand{% else %}border-white/10{% endif %} bg-panel p-1 transition-colors hover:border-brand cursor-pointer"
            >
              <img src="{{ image | image_url: width: 160 }}" width="160" height="160" alt="{{ image.alt | default: product.title | escape }}" class="h-full w-full object-cover">
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <div class="rwnd-media relative aspect-square w-full flex-1 overflow-hidden border border-white/10 bg-panel p-4 sm:p-6 group">
        <span class="tech-chip tech-chip--red absolute left-3 top-3 z-10 max-w-[calc(100%-1.5rem)] truncate">
          {% if is_watch %}
            TIMEPIECE // W-01
          {% elsif is_earphone %}
            AUDIO // EAR-01
          {% elsif is_bundle %}
            MYSTERY VAULT
          {% else %}
            DROP 01
          {% endif %}
        </span>

        <div class="h-full w-full flex items-center justify-center overflow-hidden">
          {% if product.featured_image or product.images.size > 0 %}
            <img 
              id="rwnd-main-product-img"
              src="{{ product.featured_image | default: product.images[0] | image_url: width: 1200 }}" 
              alt="{{ product.title | escape }}"
              width="1200" 
              height="1200" 
              fetchpriority="high"
              class="rwnd-media-img h-full w-full object-contain"
            >
          {% else %}
            <img
              src="{{ pdp_fallback | asset_url }}"
              alt="{{ product.title | escape }} — 316L stainless steel hardware"
              width="1000"
              height="1000"
              class="rwnd-media-img h-full w-full object-contain opacity-95"
            >
          {% endif %}
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: REFACTORED BUY BOX ARCHITECTURE -->
    <section class="pdp-container">
      
      <!-- Breadcrumbs & Status Chips -->
      <div class="pdp-telemetry-bar">
        <a href="{{ routes.all_products_collection_url }}" class="font-mono-tech text-[11px] font-bold uppercase tracking-wider text-brand hover:underline">
          ← ARCHIVE
        </a>
        <div class="pdp-status-chips">
          <span class="tech-chip tech-chip--red">DROP 01</span>
          <span class="tech-chip">{% if is_earphone %}TYPE-C DAC{% elsif is_watch %}ANALOG-DIGITAL{% elsif is_bundle %}3-PIECE HARDWARE{% else %}316L SURGICAL STEEL{% endif %}</span>
          <span class="tech-chip">ADJUSTABLE FIT</span>
        </div>
      </div>

      <!-- Product Title & Rating -->
      <div>
        <h1 class="pdp-title">{{ product.title | escape }}</h1>
        <div class="pdp-sub-row">
          <a href="#reviews" class="inline-flex items-center gap-2">
            {% if review_count > 0 %}
              {% assign avg_r = rating_sum | divided_by: review_count | round %}
              <span class="text-xs tracking-wider" aria-label="{{ avg_display }} out of 5 stars">
                {% for i in (1..5) %}{% if i <= avg_r %}<span class="text-brand">★</span>{% else %}<span class="text-[#3A3A3F]">☆</span>{% endif %}{% endfor %}
              </span>
              <span class="font-mono-tech text-[11px] uppercase text-white">
                {{ avg_display }} <span class="text-muted">({{ review_count }} TRANSMISSIONS)</span>
              </span>
            {% else %}
              <span class="font-mono-tech text-[11px] uppercase text-muted">NO TRANSMISSIONS YET — BE THE FIRST</span>
            {% endif %}
          </a>
          <span class="font-mono-tech text-[10px] uppercase tracking-wider text-muted">MDU_DISPATCH // TAMIL NADU</span>
        </div>
      </div>

      <!-- Pricing Unit (Zero Box Bloat) -->
      <div class="pdp-price-row">
        <div class="flex items-baseline gap-2.5 font-mono-tech">
          <span class="text-2xl sm:text-3xl font-extrabold text-white" id="pdp-live-price">{{ current_variant.price | money }}</span>
          <span class="text-sm text-muted line-through" id="pdp-compare-at"{% unless current_variant.compare_at_price > current_variant.price %} style="display:none"{% endunless %}>{{ current_variant.compare_at_price | money }}</span>
        </div>
        <span class="tech-chip tech-chip--red" id="pdp-save-chip"{% unless current_variant.compare_at_price > current_variant.price %} style="display:none"{% endunless %}>
          {% if current_variant.compare_at_price > current_variant.price %}
            {% assign savings = current_variant.compare_at_price | minus: current_variant.price %}
            {% assign savings_pct = savings | times: 100 | divided_by: current_variant.compare_at_price %}
            SAVE {{ savings_pct }}% [{{ savings | money }} OFF]
          {% endif %}
        </span>
      </div>

      <!-- Inventory Ticker -->
      <div class="flex items-center gap-2 font-mono-tech text-[11px] uppercase tracking-wider text-muted" id="pdp-stock-status">
        <span class="h-2 w-2 bg-brand animate-pulse"></span>
        <span id="pdp-stock-text">
        {% if current_variant.available %}
          {% if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 %}
            <span><strong class="text-white">LOW STOCK:</strong> ONLY {{ current_variant.inventory_quantity }} LEFT</span>
          {% else %}
            <span><strong class="text-white">STATUS:</strong> IN STOCK · READY FOR 24H DISPATCH</span>
          {% endif %}
        {% else %}
          <span><strong class="text-brand">DEPLETED:</strong> BATCH SOLD OUT</span>
        {% endif %}
        </span>
      </div>

      <!-- Streamlined Loadout Box (Bundles Only) -->
      {% if is_bundle %}
        <div class="loadout-manifest">
          <div class="manifest-header">
            <span class="font-mono-tech text-[11px] font-bold uppercase tracking-wider text-brand">// VAULT CONTENTS (BLIND CURATION)</span>
            <span class="font-mono-tech text-[10px] uppercase text-muted">3 PIECES INCLUDED</span>
          </div>
          <ul class="manifest-list">
            <li>
              <span class="font-mono-tech text-[11px] font-bold text-brand pt-0.5">01</span>
              <div class="flex flex-col">
                <strong class="font-sans text-[13px] font-semibold text-white">Heavyweight Pendant Chain</strong>
                <span class="font-sans text-xs text-muted">50cm length · 316L Solid Stainless Steel</span>
              </div>
            </li>
            <li>
              <span class="font-mono-tech text-[11px] font-bold text-brand pt-0.5">02</span>
              <div class="flex flex-col">
                <strong class="font-sans text-[13px] font-semibold text-white">Industrial Link Bracelet</strong>
                <span class="font-sans text-xs text-muted">Universal adjustable clasp · Sweat/Waterproof</span>
              </div>
            </li>
            <li>
              <span class="font-mono-tech text-[11px] font-bold text-brand pt-0.5">03</span>
              <div class="flex flex-col">
                <strong class="font-sans text-[13px] font-semibold text-white">Cyber Chrome Statement Ring</strong>
                <span class="font-sans text-xs text-muted">Engineered open-band (Universal sizing)</span>
              </div>
            </li>
          </ul>
          <div class="pt-2.5 border-t border-white/10">
            <span class="font-mono-tech text-[10px] uppercase tracking-wider text-muted">
              ℹ Pieces curated at random from Drop 01 Vault. 100% tarnish-proof guarantee.
            </span>
          </div>
        </div>
      {% endif %}

      {% if is_earphone %}
        <div class="border-l-2 border-brand bg-panel p-3.5">
          <strong class="font-sans text-xs font-semibold text-white block">Type-C Native Digital DAC.</strong>
          <span class="font-sans text-xs text-muted">Compatible with Type-C Android and iPhone 15/16 series. Not for 3.5mm jacks.</span>
        </div>
      {% endif %}

      <!-- Actions / Buy Box -->
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="rwnd-product-form" class="flex flex-col gap-2.5">
        <input type="hidden" name="id" id="rwnd-selected-variant-id" value="{{ current_variant.id }}">

        <!-- SPECIFICATION & VARIANT SELECTOR -->
        <div class="variant-section">
          <div class="variant-header">
            <span class="font-mono-tech text-[11px] uppercase tracking-wider text-muted">SELECT SPECIFICATION:</span>
            <button type="button" onclick="openSizeGuideModal(event)" class="size-guide-link font-mono-tech text-[11px] uppercase" id="OpenSizeGuide">
              SIZE MATRIX [?]
            </button>
          </div>

          <div class="variant-chips-container" role="radiogroup" aria-label="Select Specification">
            {% if product.has_only_default_variant %}
              <label class="cyber-chip cyber-chip--active">
                <input type="radio" name="specification" value="{{ current_variant.title | escape }}" checked class="chip-input">
                <span class="chip-pip"></span>
                <span class="chip-label">
                  {% if is_earphone %}TYPE-C // DIGITAL DAC{% else %}SILVER // 316L SURGICAL STEEL{% endif %}
                </span>
                <span class="chip-tag font-mono-tech">{% if current_variant.available %}IN VAULT{% else %}SOLD OUT{% endif %}</span>
              </label>
            {% else %}
              {% for variant in product.variants %}
                {% assign v_id = variant.id %}
                {% assign v_available = variant.available %}
                {% assign v_price = variant.price %}
                {% assign v_compare = variant.compare_at_price %}
                {% assign v_has_compare = false %}
                {% if v_compare > v_price %}{% assign v_has_compare = true %}{% endif %}
                {% assign v_savings = 0 %}
                {% if v_has_compare %}{% assign v_savings = v_compare | minus: v_price %}{% endif %}
                {% assign v_savings_pct = 0 %}
                {% if v_savings > 0 %}{% assign v_savings_pct = v_savings | times: 100 | divided_by: v_compare %}{% endif %}
                {% assign v_low_stock = false %}
                {% if v_available and variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 5 %}
                  {% assign v_low_stock = true %}
                {% endif %}
                {% assign v_stock_text = '' %}
                {% if v_low_stock %}
                  {% assign v_stock_text = 'LOW STOCK: ONLY ' | append: variant.inventory_quantity | append: ' LEFT' %}
                {% elsif v_available %}
                  {% assign v_stock_text = 'STATUS: IN STOCK · READY FOR 24H DISPATCH' %}
                {% else %}
                  {% assign v_stock_text = 'DEPLETED: BATCH SOLD OUT' %}
                {% endif %}
                {% assign v_compare_text = '' %}
                {% if v_has_compare %}{% assign v_compare_text = v_compare | money %}{% endif %}
                {% assign v_save_text = '' %}
                {% if v_savings > 0 %}
                  {% assign v_savings_label = v_savings | money %}
                  {% assign v_save_text = 'SAVE ' | append: v_savings_pct | append: '% [' | append: v_savings_label | append: ' OFF]' %}
                {% endif %}
                {% assign v_add_text = '' %}
                {% if v_available %}
                  {% if is_bundle %}{% assign v_add_text = 'CLAIM HARDWARE LOADOUT' %}{% else %}{% assign v_add_text = 'ADD TO HARDWARE BAG' %}{% endif %}
                {% else %}
                  {% assign v_add_text = 'SOLD OUT' %}
                {% endif %}
                <label
                  class="rwnd-var-btn cyber-chip {% if variant.id == current_variant.id %}cyber-chip--active{% endif %} {% unless variant.available %}cyber-chip--disabled{% endunless %}"
                  data-variant-id="{{ v_id }}"
                  data-variant-price="{{ v_price | money }}"
                  {% if v_available %}data-variant-available="true"{% else %}data-variant-available="false"{% endif %}
                  data-compare-at-text="{{ v_compare_text }}"
                  data-save-text="{{ v_save_text }}"
                  data-stock-text="{{ v_stock_text }}"
                  data-add-text="{{ v_add_text }}"
                  {% if v_available %}
                    onclick="selectRwndVariant('{{ v_id }}')"
                  {% endif %}
                >
                  <input
                    type="radio"
                    name="specification"
                    value="{{ variant.title | escape }}"
                    {% if variant.id == current_variant.id %}checked{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                    class="chip-input"
                  >
                  <span class="chip-pip"></span>
                  <span class="chip-label">{{ variant.title | escape }}</span>
                  <span class="chip-tag font-mono-tech">{% if variant.available %}IN VAULT{% else %}SOLD OUT{% endif %}</span>
                </label>
              {% endfor %}
            {% endif %}
          </div>
        </div>

        <!-- Quantity & Primary CTA Row -->
                  <div class="qty-selector">
            <button type="button" onclick="adjustRwndQty(-1)" class="qty-btn" aria-label="Decrease quantity">−</button>
            <input type="number" id="rwnd-qty-input" name="quantity" value="1" min="1" max="10" readonly class="qty-input">
            <button type="button" onclick="adjustRwndQty(1)" class="qty-btn" aria-label="Increase quantity">+</button>
          </div>

          <button
            type="submit"
            name="add"
            id="AddToCart"
            {% unless current_variant.available %}disabled{% endunless %}
            class="flex-1 h-[52px] px-4 bg-brand border border-brand text-white font-mono-tech text-xs font-bold uppercase tracking-wider hover:bg-brand-dark transition-colors flex items-center justify-between gap-2 cursor-pointer disabled:opacity-40"
          >
            <span id="btn-label">{% if current_variant.available %}{% if is_bundle %}CLAIM HARDWARE LOADOUT{% else %}ADD TO HARDWARE BAG{% endif %}{% else %}SOLD OUT{% endif %}</span>
            <span id="btn-price-display" class="{% unless current_variant.available %}hidden{% endunless %}">{{ current_variant.price | money }}</span>
          </button>

        <!-- 1-Click Instant Checkout: adds the selected variant, then opens checkout -->
        <button
          type="button"
          data-rwnd-instant-checkout
          {% unless current_variant.available %}disabled{% endunless %}
          class="w-full h-12 bg-panel border border-white/10 hover:border-brand text-white font-mono-tech text-[11px] font-bold uppercase tracking-wider flex items-center justify-center transition-colors cursor-pointer disabled:cursor-not-allowed disabled:opacity-40"
        >
          INSTANT CHECKOUT (UPI / COD / CARDS)
        </button>
      </form>

      <!-- INDUSTRIAL TRUST GRID (ZERO SYSTEM EMOJIS) -->
      <div class="industrial-trust-grid">
        
        <!-- ITEM 1: MATERIAL / TARNISH -->
        <div class="trust-badge">
          <div class="badge-icon-box">
            <svg class="trust-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M12 2L3 6v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V6l-9-4z" stroke-width="1.5" stroke-linejoin="round"/>
              <polyline points="9 12 11 14 15 10" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
          </div>
          <div class="badge-text">
            <span class="badge-title mono-tag">SOLID 316L ALLOY</span>
            <span class="badge-sub">Never rusts or turns skin green</span>
          </div>
        </div>

        <!-- ITEM 2: LOGISTICS / DISPATCH -->
        <div class="trust-badge">
          <div class="badge-icon-box">
            <svg class="trust-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="1" y="4" width="14" height="12" stroke-width="1.5"/>
              <path d="M15 8h4l3 3v5h-7V8z" stroke-width="1.5" stroke-linejoin="round"/>
              <circle cx="5.5" cy="18.5" r="2.5" stroke-width="1.5"/>
              <circle cx="17.5" cy="18.5" r="2.5" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="badge-text">
            <span class="badge-title mono-tag">24-HR MDU DISPATCH</span>
            <span class="badge-sub">Direct from Tamil Nadu hub</span>
          </div>
        </div>

        <!-- ITEM 3: PAYMENT / COD -->
        <div class="trust-badge">
          <div class="badge-icon-box">
            <svg class="trust-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="2" y="5" width="20" height="14" rx="0" stroke-width="1.5"/>
              <circle cx="12" cy="12" r="3" stroke-width="1.5"/>
              <path d="M6 9h.01M18 15h.01" stroke-width="2" stroke-linecap="square"/>
            </svg>
          </div>
          <div class="badge-text">
            <span class="badge-title mono-tag">CASH ON DELIVERY</span>
            <span class="badge-sub">UPI &amp; COD options verified</span>
          </div>
        </div>

        <!-- ITEM 4: DEFECT REPLACEMENT -->
        <div class="trust-badge">
          <div class="badge-icon-box">
            <svg class="trust-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M21 2v6h-6" stroke-width="1.5" stroke-linecap="square"/>
              <path d="M3 12a9 9 0 0 1 15-6.7L21 8" stroke-width="1.5"/>
              <path d="M3 22v-6h6" stroke-width="1.5" stroke-linecap="square"/>
              <path d="M21 12a9 9 0 0 1-15 6.7L3 16" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="badge-text">
            <span class="badge-title mono-tag">DEFECT GUARANTEE</span>
            <span class="badge-sub">100% replacement protection</span>
          </div>
        </div>

      </div>

      <!-- Accordions (Clean Flush Line Dividers) -->
      <div class="flex flex-col">
        <details class="accordion-item" open>
          <summary class="accordion-trigger">
            <span>HARDWARE SPECIFICATIONS</span>
            <span class="accordion-icon">+</span>
          </summary>
          <div class="pb-4">
            {% if product.description != blank %}
              <div class="font-sans text-sm text-muted leading-relaxed mb-3">{{ product.description }}</div>
            {% endif %}
            <table class="specs-table">
              <tr>
                <td>MATERIAL</td>
                <td>{% if is_earphone %}High-Density Alloy + Braided Shielding{% else %}316L Surgical Grade Solid Stainless Steel{% endif %}</td>
              </tr>
              <tr>
                <td>COATING</td>
                <td>Vacuum PVD High-Polish Chrome (Zero fading)</td>
              </tr>
              <tr>
                <td>FIT PROFILE</td>
                <td>
                  {%- if is_ring -%}Open-band adjustable (one size fits most)
                  {%- elsif is_bracelet -%}Adjustable clasp + extender links
                  {%- elsif is_necklace -%}50 cm chain + 5 cm extender
                  {%- elsif is_watch -%}Standard 22 cm strap
                  {%- elsif is_earphone -%}In-ear, 1.2 m braided cable
                  {%- elsif is_bundle -%}Mixed fit — see the included pieces
                  {%- else -%}Universal Adjustable / Free Size
                  {%- endif -%}
                </td>
              </tr>
              <tr>
                <td>HYPOALLERGENIC</td>
                <td>100% Nickel &amp; Lead-Free (Zero skin greening)</td>
              </tr>
            </table>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-trigger">
            <span>SHIPPING &amp; DISPATCH PROTOCOL</span>
            <span class="accordion-icon">+</span>
          </summary>
          <div class="pb-4 font-sans text-sm text-muted leading-relaxed space-y-1.5">
            <p>All orders are packed in sealed security poly-mailers and dispatched directly from our Madurai fulfillment hub within 24 hours.</p>
            <ul class="list-disc pl-4 space-y-1">
              <li><strong class="text-white">South India:</strong> Delivered in 48–72 hours.</li>
              <li><strong class="text-white">Rest of India:</strong> Delivered in 3–5 business days.</li>
              <li>Free delivery on orders ₹999+ (₹49 flat under ₹999).</li>
            </ul>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-trigger">
            <span>REPLACEMENT &amp; WARRANTY</span>
            <span class="accordion-icon">+</span>
          </summary>
          <div class="pb-4 font-sans text-sm text-muted leading-relaxed">
            <p>
              {% if is_bundle %}Due to heavy discounting on Mystery Blind Drops, items cannot be swapped for personal aesthetic preference. {% endif %}
              If any piece arrives damaged, defective, or incorrect, we offer a <strong class="text-white">100% free immediate replacement</strong>. 
              Simply ping our WhatsApp support desk with your order number and uncut unboxing video within 48 hours of delivery.
            </p>
          </div>
        </details>
      </div>
    </section>
  </div>

  <!-- BELOW THE FOLD: COMPLETE THE LOOK & REVIEWS -->
  <div class="mx-auto max-w-7xl">
    
    <!-- COMPLETE THE LOOK -->
    <section class="mt-16 border-t border-white/10 pt-12">
      <div class="mb-6">
        <span class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-brand block">// SYNERGISTIC ARCHIVE</span>
        <h2 class="font-display text-xl sm:text-2xl font-black uppercase text-white mt-1">COMPLETE THE LOOK</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {% for complementary in collections['all'].products limit: 5 %}
          {% if complementary.id != product.id %}
            <div class="border border-white/10 bg-panel p-3 flex flex-col justify-between group hover:border-brand transition-colors">
              <a href="{{ complementary.url }}" class="block">
                <div class="aspect-square bg-[#000000] border border-white/5 flex items-center justify-center overflow-hidden mb-3">
                  <img src="{{ complementary.featured_image | image_url: width: 400 }}" width="400" height="400" alt="{{ complementary.title | escape }}" class="h-full w-full object-contain group-hover:scale-105 transition-transform">
                </div>
                <h3 class="font-sans text-xs font-bold text-white truncate">{{ complementary.title | escape }}</h3>
                <p class="font-mono-tech text-xs text-muted mt-1">{{ complementary.selected_or_first_available_variant.price | money }}</p>
              </a>
              <form action="{{ routes.cart_add_url }}" method="post" class="mt-3">
                <input type="hidden" name="id" value="{{ complementary.selected_or_first_available_variant.id }}">
                <button type="submit" class="w-full h-9 border border-white/10 bg-surface font-mono-tech text-[10px] font-bold uppercase hover:bg-brand hover:border-brand text-white transition-colors cursor-pointer">
                  + ADD
                </button>
              </form>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <!-- REVIEWS TERMINAL -->
    <section id="reviews" class="mt-16 border border-brand/40 border-t-2 border-t-brand bg-[#0D0D10] p-5 sm:p-8 shadow-[0_0_40px_rgba(255,0,51,0.08)]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-white/10 pb-5 mb-6">
        <div>
          <span class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-brand block">// OPERATOR TRANSMISSIONS</span>
          <h2 class="font-display text-xl sm:text-2xl font-black uppercase text-white mt-1">FIELD VERIFIED LOGS</h2>
        </div>
        <button
          type="button"
          onclick="openRwndReviewModal()"
          class="h-11 border border-brand bg-brand px-4 font-mono-tech text-[10px] font-bold uppercase tracking-wider text-white hover:bg-brand-dark transition-colors cursor-pointer"
        >
          + LOG TRANSMISSION
        </button>
      </div>

      <!-- Summary score -->
      <div class="review-score-hud">
        <div class="score-main">
          {% if review_count > 0 %}
            <span class="score-number">{{ avg_display }}</span>
            <div class="score-stars">
              {% assign avg_r = rating_sum | divided_by: review_count | round %}
              <span class="stars" aria-label="{{ avg_display }} out of 5 stars">{% for i in (1..5) %}{% if i <= avg_r %}★{% else %}<span class="text-[#3A3A3F]">☆</span>{% endif %}{% endfor %}</span>
              <span class="mono-tag text-muted">{{ review_count }} TRANSMISSIONS</span>
            </div>
          {% else %}
            <span class="mono-tag text-muted">NO APPROVED REVIEWS YET</span>
          {% endif %}
        </div>
      </div>

      <div id="rwnd-reviews-grid" class="reviews-stream">
        {% if meta_reviews != blank %}
          {% for rev in meta_reviews %}
            {% if rev.approved.value %}
              {% assign r_stars = rev.rating.value.rating | default: rev.rating.value | default: 5 | round %}
              <div class="review-entry">
                <div class="space-y-2.5">
                  <div class="entry-meta">
                    <span class="stars">{% for i in (1..r_stars) %}★{% endfor %}{% for i in (1..5) %}{% if i > r_stars %}<span class="text-[#3A3A3F]">☆</span>{% endif %}{% endfor %}</span>
                    <span class="entry-status mono-tag">CUSTOMER REVIEW</span>
                  </div>
                  <p class="entry-quote">"{{ rev.body.value | escape }}"</p>
                </div>
                <div class="entry-author mono-tag">
                  <span class="text-white font-bold">{{ rev.author.value | escape }}</span>
                  {% if rev.city.value != blank %}
                    <span class="text-muted"> · {{ rev.city.value | escape }}</span>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="review-entry">
            <p class="entry-quote">No approved reviews yet. Reviews appear here after moderation — submit yours with the button above.</p>
          </div>
        {% endif %}
      </div>
    </section>
  </div>

<!-- FULL-SCREEN WRITE REVIEW MODAL (z-210) -->
<div
  id="rwnd-review-modal"
  class="fixed inset-0 z-[210] hidden items-center justify-center bg-black/95 backdrop-blur-xl p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
>
  <div class="relative my-auto w-full max-w-lg border border-brand border-t-2 bg-[#0D0D10] p-5 sm:p-7 shadow-[0_0_50px_rgba(255,0,51,0.2)]">
    <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-5">
      <div>
        <span class="font-mono-tech text-[10px] uppercase text-brand block">// FIELD TRANSMISSION TERMINAL</span>
        <h3 class="font-display text-base sm:text-lg font-bold uppercase text-white mt-0.5 truncate max-w-[260px] sm:max-w-sm">REVIEW: {{ product.title | escape }}</h3>
      </div>
      <button type="button" onclick="closeRwndReviewModal()" class="h-9 w-9 border border-white/10 bg-surface text-xs font-bold text-muted hover:border-brand hover:text-brand cursor-pointer">✕</button>
    </div>

    <form id="rwnd-native-review-form" onsubmit="submitRwndNativeReview(event)" class="space-y-4">
      <input type="hidden" id="rwnd-rev-rating-input" value="5">

      <div>
        <span class="font-mono-tech text-[10px] uppercase text-muted block mb-1.5">SELECT RATING *</span>
        <div class="flex gap-2" role="group" aria-label="Select rating">
          {% for s in (1..5) %}
            <button type="button" data-star="{{ s }}" onclick="setRwndReviewStars({{ s }})" aria-label="{{ s }} star{% if s > 1 %}s{% endif %}" class="rwnd-star-btn h-11 flex-1 border border-brand bg-brand/20 text-base font-bold text-brand cursor-pointer">★</button>
          {% endfor %}
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="rwnd-rev-name" class="font-mono-tech text-[10px] uppercase text-muted block mb-1">YOUR NAME *</label>
          <input type="text" id="rwnd-rev-name" required placeholder="E.G. ARJUN K." class="h-11 w-full bg-surface border border-white/10 px-3 font-mono-tech text-xs text-white uppercase focus:border-brand focus:outline-none">
        </div>
        <div>
          <label for="rwnd-rev-city" class="font-mono-tech text-[10px] uppercase text-muted block mb-1">CITY *</label>
          <input type="text" id="rwnd-rev-city" required placeholder="E.G. CHENNAI" class="h-11 w-full bg-surface border border-white/10 px-3 font-mono-tech text-xs text-white uppercase focus:border-brand focus:outline-none">
        </div>
      </div>

      <div>
        <label for="rwnd-rev-email" class="font-mono-tech text-[10px] uppercase text-muted block mb-1">EMAIL (PRIVATE) *</label>
        <input type="email" id="rwnd-rev-email" required placeholder="YOUR@EMAIL.COM" class="h-11 w-full bg-surface border border-white/10 px-3 font-mono-tech text-xs text-white focus:border-brand focus:outline-none">
      </div>

      <div>
        <label for="rwnd-rev-body" class="font-mono-tech text-[10px] uppercase text-muted block mb-1">FIELD REPORT *</label>
        <textarea id="rwnd-rev-body" rows="3" required placeholder="Weight, 316L finish, delivery speed..." class="w-full bg-surface border border-white/10 p-3 font-sans text-sm text-white focus:border-brand focus:outline-none"></textarea>
      </div>

      <p id="rwnd-rev-status" class="font-mono-tech text-[10px] uppercase text-muted min-h-[16px]" role="status"></p>

      <p class="font-mono-tech text-[10px] uppercase tracking-wider text-muted">
        Reviews are moderated before publishing. Photos are not collected by this form.
      </p>

      <button type="submit" id="rwnd-rev-submit-btn" class="h-12 w-full bg-brand font-mono-tech text-xs font-bold uppercase tracking-widest text-white hover:bg-brand-dark cursor-pointer">
        TRANSMIT REVIEW →
      </button>
    </form>
  </div>
</div>

<!-- STICKY MOBILE CONVERSION BAR (z-110) -->
<div class="fixed bottom-0 left-0 z-[110] w-full border-t border-white/10 bg-panel/95 backdrop-blur-md p-3 sm:hidden flex items-center justify-between gap-3">
  <div>
    <span class="font-mono-tech text-[9px] uppercase text-muted block">TOTAL</span>
    <span class="font-mono-tech text-sm font-bold text-white" id="sticky-mobile-price">{{ current_variant.price | money }}</span>
  </div>
  <button 
    type="button" 
    onclick="document.getElementById('rwnd-product-form')?.querySelector('button[type=submit]')?.click();"
    class="flex-1 h-12 bg-brand text-white font-mono-tech text-xs font-bold uppercase tracking-wider flex items-center justify-center cursor-pointer"
  >
    + ADD TO BAG
  </button>
</div>
</div>

<script>
  function switchRwndProductImage(src, btn) {
    const mainImg = document.getElementById('rwnd-main-product-img');
    if (mainImg) mainImg.src = src;
    document.querySelectorAll('.rwnd-thumb').forEach(t => t.classList.remove('border-brand', 'border-white/10'));
    btn.classList.remove('border-white/10');
    btn.classList.add('border-brand');
  }

  function adjustRwndQty(delta) {
    const input = document.getElementById('rwnd-qty-input');
    if (!input) return;
    let val = parseInt(input.value) || 1;
    val = Math.min(10, Math.max(1, val + delta));
    input.value = val;
  }

  function updateVariantUI(variantId) {
    const varInput = document.getElementById('rwnd-selected-variant-id');
    if (varInput) varInput.value = variantId;

    const label = document.querySelector('.rwnd-var-btn[data-variant-id="' + variantId + '"]');
    const price = label ? (label.getAttribute('data-variant-price') || '') : '';
    const available = label ? label.getAttribute('data-variant-available') === 'true' : false;
    const compareText = label ? (label.getAttribute('data-compare-at-text') || '') : '';
    const saveText = label ? (label.getAttribute('data-save-text') || '') : '';
    const stockText = label ? (label.getAttribute('data-stock-text') || '') : '';
    const addText = label ? (label.getAttribute('data-add-text') || '') : '';

    document.querySelectorAll('.rwnd-var-btn').forEach(b => b.classList.remove('cyber-chip--active'));
    if (label) label.classList.add('cyber-chip--active');

    ['pdp-live-price', 'btn-price-display', 'sticky-mobile-price'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = price;
    });

    const cmpEl = document.getElementById('pdp-compare-at');
    if (cmpEl) {
      cmpEl.style.display = compareText ? '' : 'none';
      if (compareText) cmpEl.textContent = compareText;
    }

    const saveEl = document.getElementById('pdp-save-chip');
    if (saveEl) {
      saveEl.style.display = saveText ? '' : 'none';
      if (saveText) saveEl.textContent = saveText;
    }

    const ticker = document.getElementById('pdp-stock-text');
    if (ticker) ticker.textContent = stockText;

    const addBtn = document.getElementById('AddToCart');
    const addLabel = document.getElementById('btn-label');
    const priceSpan = document.getElementById('btn-price-display');
    if (addBtn) addBtn.disabled = !available;
    if (addLabel) addLabel.textContent = addText;
    if (priceSpan) priceSpan.classList.toggle('hidden', !available);
  }

  function selectRwndVariant(id) {
    if (id) updateVariantUI(id);
  }

  document.addEventListener('change', (event) => {
    const radio = event.target;
    if (!radio || radio.name !== 'specification') return;
    const label = radio.closest('.rwnd-var-btn');
    if (label && label.getAttribute('data-variant-id')) updateVariantUI(label.getAttribute('data-variant-id'));
  });

  function openRwndReviewModal() {
    const modal = document.getElementById('rwnd-review-modal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeRwndReviewModal() {
    const modal = document.getElementById('rwnd-review-modal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.getElementById('rwnd-review-modal')?.addEventListener('click', (e) => {
    if (e.target.id === 'rwnd-review-modal') closeRwndReviewModal();
  });

  function setRwndReviewStars(rating) {
    document.getElementById('rwnd-rev-rating-input').value = rating;
    document.querySelectorAll('.rwnd-star-btn').forEach(btn => {
      const s = parseInt(btn.dataset.star);
      if (s <= rating) {
        btn.classList.add('border-brand', 'bg-brand/20', 'text-brand');
        btn.classList.remove('border-white/10', 'bg-surface', 'text-muted');
      } else {
        btn.classList.remove('border-brand', 'bg-brand/20', 'text-brand');
        btn.classList.add('border-white/10', 'bg-surface', 'text-muted');
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeRwndReviewModal();
  });

  async function submitRwndNativeReview(e) {
    e.preventDefault();
    const statusEl = document.getElementById('rwnd-rev-status');
    const btn = document.getElementById('rwnd-rev-submit-btn');

    const rating = parseInt(document.getElementById('rwnd-rev-rating-input').value, 10) || 5;
    const name = document.getElementById('rwnd-rev-name').value.trim().toUpperCase();
    const city = document.getElementById('rwnd-rev-city').value.trim().toUpperCase();
    const email = document.getElementById('rwnd-rev-email').value.trim();
    const body = document.getElementById('rwnd-rev-body').value.trim();

    const compiledBody =
      'PRODUCT: ' + {{ product.title | json }} + ' (' + {{ product.handle | json }} + ')\n' +
      `RATING: ${rating}/5\nAUTHOR: ${name}\nCITY: ${city}\nREVIEW: ${body}`;

    btn.disabled = true;
    btn.textContent = '[ TRANSMITTING... ]';
    statusEl.textContent = '';
    statusEl.style.color = '#A3A3A3';

    try {
      const payload = new URLSearchParams();
      payload.append('form_type', 'contact');
      payload.append('utf8', '✓');
      payload.append('contact[subject]', 'NEW PRODUCT REVIEW: ' + {{ product.title | json }});
      payload.append('contact[name]', name);
      payload.append('contact[email]', email);
      payload.append('contact[body]', compiledBody);

      const response = await fetch('/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'text/html' },
        body: payload.toString()
      });

      if (!response.ok) throw new Error('Transmission failed.');

      const html = await response.text();
      if (html.includes('form-status--error') || html.includes('class="errors"')) {
        throw new Error('Review was rejected. Check your details and try again.');
      }

      e.target.reset();
      setRwndReviewStars(5);
      statusEl.textContent = '✓ REVIEW SUBMITTED FOR MODERATION — IT WILL APPEAR ONCE APPROVED.';
      statusEl.style.color = '#00FF88';
      window.setTimeout(closeRwndReviewModal, 2200);
    } catch (error) {
      statusEl.textContent = '✕ ' + (error.message || 'TRANSMISSION ERROR — TRY AGAIN');
      statusEl.style.color = '#FF0033';
    } finally {
      btn.disabled = false;
      btn.textContent = 'TRANSMIT REVIEW →';
    }
  }
</script>

