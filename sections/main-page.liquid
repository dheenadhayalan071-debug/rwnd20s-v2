<div class="relative w-full bg-[#DCDFE5] text-[#09090B] py-12 px-4 sm:px-6 lg:px-12">
  <div class="mx-auto max-w-4xl">
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="mb-8 font-mono-tech text-xs text-[#52525B]">
      <ol class="flex items-center gap-2 uppercase tracking-wider">
        <li><a href="/" class="hover:text-[#09090B]">BASE</a></li>
        <li>/</li>
        <li class="text-[#09090B] font-bold">{{ page.title }}</li>
      </ol>
    </nav>

    <!-- Page Container -->
    <div class="rounded-3xl border border-[#09090B]/20 bg-white p-6 sm:p-12 shadow-2xl">
      <div class="border-b border-[#09090B]/10 pb-6 mb-8">
        <span class="font-mono-tech text-[10px] font-bold uppercase tracking-widest bg-[#09090B] text-white px-3 py-1 rounded-full">
          OFFICIAL ARCHIVE DOC
        </span>
        <h1 class="font-display text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-[#09090B] mt-3">
          {{ page.title }}
        </h1>
      </div>

      <!-- Page Content Body -->
      <div class="prose font-mono-tech text-xs sm:text-sm text-[#3F3F46] leading-relaxed space-y-4">
        {% if page.content != blank %}
          {{ page.content }}
        {% else %}
          <p>No content specified for this page spec yet.</p>
        {% endif %}
      </div>

      <!-- Footer Navigation -->
      <div class="mt-12 pt-6 border-t border-[#09090B]/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/" class="rounded-full border border-[#09090B] bg-[#09090B] px-6 py-3 font-mono-tech text-xs font-bold text-white uppercase tracking-wider hover:bg-white hover:text-[#09090B] transition-colors">
          RETURN TO STOREFRONT BASE
        </a>
        <a href="/collections/all" class="rounded-full border border-[#09090B]/20 bg-white px-6 py-3 font-mono-tech text-xs font-bold text-[#09090B] uppercase tracking-wider hover:border-[#09090B] transition-colors">
          EXPLORE DROP 01 HARDWARE
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page Main View",
  "settings": []
}
{% endschema %}
