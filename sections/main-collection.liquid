<!-- sections/main-collection.liquid -->
<section class="collection-page"><header><p class="eyebrow">Y2K · DROP 01</p><h1>{{ collection.title | escape }}</h1><p>Free delivery on ₹999 and above. Below ₹999, ₹49.</p></header><div class="product-grid">{% for product in collection.products %}<article class="product-card"><a href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 640 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="640" height="640" loading="lazy">{% endif %}<h2>{{ product.title | escape }}</h2></a><p>{{ product.price | money }}</p><a class="text-link" href="{{ product.url }}">View product</a></article>{% endfor %}</div></section>
{% schema %}{"name":"Collection","settings":[]}{% endschema %}
