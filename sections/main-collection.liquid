<!-- sections/main-collection.liquid -->
<section class="relative w-full bg-transparent px-4 py-10 text-[#E9E3D5] sm:px-6 sm:py-12 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <header class="mb-8 flex flex-col justify-between gap-6 border-b border-red-900/40 pb-7 md:flex-row md:items-end">
      <div>
        <div class="inline-flex items-center gap-2 border border-red-900/40 bg-black/60 px-3.5 py-1 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-red-400"><span class="h-2 w-2 animate-pulse bg-red-600"></span>ARCHIVE VAULT // ALL ARTIFACTS</div>
        <h1 class="mt-3 font-display text-4xl font-extrabold uppercase tracking-tight text-white sm:text-5xl">{{ collection.title | default: 'DROP 01 CATALOG' }}</h1>
        <p class="mt-2 max-w-xl font-mono-tech text-xs uppercase tracking-widest text-zinc-400" id="rwnd-showing-count">SHOWING {{ collection.products.size }} PIECES · FREE SHIPPING ABOVE ₹999</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <input type="text" id="rwnd-archive-search" placeholder="SEARCH SPEC..." class="rounded-full border border-red-900/40 bg-black/70 px-4 py-2 font-mono-tech text-xs uppercase tracking-widest text-white placeholder-zinc-600 focus:border-red-600 focus:outline-none">
        <select id="rwnd-archive-sort" class="rounded-full border border-red-900/40 bg-black/70 px-4 py-2 font-mono-tech text-xs uppercase tracking-widest text-white focus:border-red-600 focus:outline-none cursor-pointer">
          <option value="featured" class="bg-black">SORT: FEATURED SPEC</option>
          <option value="price-asc" class="bg-black">PRICE: LOW TO HIGH</option>
          <option value="price-desc" class="bg-black">PRICE: HIGH TO LOW</option>
        </select>
      </div>
    </header>

    <div class="mb-8 flex flex-wrap items-center gap-2" role="tablist" aria-label="Product categories">
      <button type="button" role="tab" aria-selected="true" data-filter-category="all" class="border border-red-600 bg-red-950/60 px-4 py-2 font-mono-tech text-xs font-bold uppercase tracking-widest text-white">ALL SPEC</button>
      <button type="button" role="tab" aria-selected="false" data-filter-category="hardware" class="border border-red-900/30 bg-black/40 px-4 py-2 font-mono-tech text-xs font-medium uppercase tracking-widest text-zinc-400 hover:border-red-700 hover:text-white">316L HARDWARE</button>
      <button type="button" role="tab" aria-selected="false" data-filter-category="earphones" class="border border-red-900/30 bg-black/40 px-4 py-2 font-mono-tech text-xs font-medium uppercase tracking-widest text-zinc-400 hover:border-red-700 hover:text-white">CHROME AUDIO</button>
      <button type="button" role="tab" aria-selected="false" data-filter-category="watch" class="border border-red-900/30 bg-black/40 px-4 py-2 font-mono-tech text-xs font-medium uppercase tracking-widest text-zinc-400 hover:border-red-700 hover:text-white">TIMEPIECES</button>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" id="rwnd-product-grid">
      {% for product in collection.products %}
        <article data-product-card data-category="{{ product.type | handle }}" data-tags="{{ product.tags | join: ' ' | handle }}" data-title="{{ product.title | escape }}" data-price="{{ product.price }}" class="group relative flex flex-col justify-between overflow-hidden border border-red-900/30 bg-black/40 p-4 backdrop-blur-xl transition-all duration-300 hover:border-red-700/70">
          <div>
            <div class="relative flex aspect-square items-center justify-center overflow-hidden border border-red-900/30 bg-black/60 p-4">
              <span class="absolute left-3 top-3 z-10 rounded-full border border-red-800/50 bg-red-950 px-2.5 py-1 font-mono-tech text-[9px] font-bold uppercase tracking-widest text-red-200">{% if product.compare_at_price > product.price %}SALE{% else %}DROP 01{% endif %}</span>
              <button type="button" data-toggle-wishlist aria-label="Save to Wishlist" class="absolute right-3 top-3 z-10 flex h-8 w-8 items-center justify-center rounded-full border border-red-900/50 bg-black/80 font-mono-tech text-sm text-red-300 hover:border-red-600 hover:text-white">♡</button>
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="h-full w-full object-contain contrast-125 transition-transform duration-500 group-hover:scale-105">
              {% else %}
                <div class="font-mono-tech text-xs uppercase tracking-widest text-zinc-500">NO ASSET</div>
              {% endif %}
            </div>
            <div class="mt-4">
              <p class="font-mono-tech text-[10px] uppercase tracking-widest text-zinc-500">{{ product.vendor | default: 'RWND20S' }}</p>
              <h2 class="mt-1 line-clamp-2 font-display text-sm font-bold uppercase text-white">{{ product.title }}</h2>
            </div>
          </div>
          <div class="relative z-10 mt-5 flex items-center justify-between gap-2 border-t border-red-900/30 pt-4">
            <div>
              <span class="font-mono-tech text-sm font-extrabold uppercase tracking-widest text-[#E9E3D5]">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}<span class="mt-1 block font-mono-tech text-[10px] uppercase tracking-widest text-zinc-500 line-through">{{ product.compare_at_price | money }}</span>{% endif %}
            </div>
            <a href="{{ product.url }}" class="rounded-full border border-red-900/50 bg-black/80 px-3.5 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-[#E9E3D5] transition-colors hover:border-red-600 hover:bg-red-950/60 hover:text-white">INSPECT →</a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Main Catalog",
  "settings": []
}
{% endschema %}
