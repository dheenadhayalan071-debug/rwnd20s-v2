<!-- sections/main-collection.liquid -->
{% paginate collection.products by section.settings.products_per_page %}
<section class="relative w-full bg-card px-4 py-6 font-mono-tech text-bone sm:px-6 sm:py-10 lg:px-8">
  <div class="mx-auto max-w-7xl">
    
    <!-- 5.1 BREADCRUMBS & HEADER -->
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-xs uppercase tracking-wider text-muted">
      <a href="{{ routes.root_url }}" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="{{ routes.all_products_collection_url }}" class="hover:text-white transition-colors">Shop</a>
      <span>/</span>
      <span class="text-white font-bold">{{ collection.title | default: 'All Hardware' }}</span>
    </nav>

    <header class="mb-8 border-b border-line pb-6">
      <div class="inline-flex items-center gap-2 border border-brand/60 bg-surface px-3.5 py-1 text-[10px] font-bold uppercase tracking-[1.5px] text-white">
        <span class="h-1.5 w-1.5 bg-brand animate-pulse"></span>
        DROP 01 // ARCHIVE COLLECTION
      </div>
      <h1 class="mt-3 font-display text-3xl sm:text-5xl lg:text-6xl font-extrabold uppercase tracking-tight text-white">
        {{ collection.title | default: 'Y2K HARDWARE ARCHIVE' }}
      </h1>
      <p class="mt-2 text-xs uppercase tracking-wider text-muted">
        <span id="rwnd-product-count">{{ collection.all_products_count | default: collection.products.size }}</span> PIECES · ALL 316L STAINLESS & NOCTURNAL AUDIO · DISPATCHED FROM MADURAI
      </p>
    </header>

    <!-- 5.2 STICKY FILTER & SORT BAR -->
    {% if section.settings.show_category_tabs %}
    <div id="rwnd-sticky-filter-bar" class="sticky top-[88px] z-30 mb-8 border border-line bg-card/95 backdrop-blur-md p-3 sm:p-4 transition-all">
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        
        <!-- Tag Filter Buttons -->
        <div class="flex flex-wrap items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0" role="group" aria-label="Filter by category">
          <button type="button" data-tag-filter="all" aria-pressed="true" class="rwnd-filter-btn active border border-brand bg-brand px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider text-white cursor-pointer">
            ALL SPEC
          </button>
          <button type="button" data-tag-filter="chains" aria-pressed="false" class="rwnd-filter-btn border border-line bg-surface px-3 py-1.5 text-[11px] font-medium uppercase tracking-wider text-muted hover:border-brand hover:text-white cursor-pointer">
            CHAINS
          </button>
          <button type="button" data-tag-filter="rings" aria-pressed="false" class="rwnd-filter-btn border border-line bg-surface px-3 py-1.5 text-[11px] font-medium uppercase tracking-wider text-muted hover:border-brand hover:text-white cursor-pointer">
            RINGS
          </button>
          <button type="button" data-tag-filter="bracelets" aria-pressed="false" class="rwnd-filter-btn border border-line bg-surface px-3 py-1.5 text-[11px] font-medium uppercase tracking-wider text-muted hover:border-brand hover:text-white cursor-pointer">
            BRACELETS
          </button>
          <button type="button" data-tag-filter="earphones" aria-pressed="false" class="rwnd-filter-btn border border-line bg-surface px-3 py-1.5 text-[11px] font-medium uppercase tracking-wider text-muted hover:border-brand hover:text-white cursor-pointer">
            AUDIO
          </button>
          <button type="button" data-tag-filter="watch" aria-pressed="false" class="rwnd-filter-btn border border-line bg-surface px-3 py-1.5 text-[11px] font-medium uppercase tracking-wider text-muted hover:border-brand hover:text-white cursor-pointer">
            TIMEPIECES
          </button>
          <button type="button" id="rwnd-filter-clear" class="rwnd-filter-btn hidden border border-white/20 bg-transparent px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider text-white cursor-pointer">
            ✕ CLEAR
          </button>
        </div>

        <!-- Filter Selectors & Sort Dropdown -->
        <div class="flex items-center gap-2">
          <!-- Price Sort -->
          <select id="rwnd-archive-sort" class="flex-1 lg:flex-none border border-line bg-surface px-3 py-2 text-[11px] font-bold uppercase tracking-wider text-white focus:border-brand focus:outline-none cursor-pointer">
            <option value="featured">SORT: FEATURED ▾</option>
            <option value="price-asc">PRICE: LOW TO HIGH ▾</option>
            <option value="price-desc">PRICE: HIGH TO LOW ▾</option>
          </select>

          <!-- Quick Search -->
          <input 
            type="text" 
            id="rwnd-archive-search" 
            placeholder="FILTER SPEC..." 
            class="hidden sm:block w-36 border border-line bg-surface px-3 py-2 text-[11px] uppercase tracking-wider text-white focus:border-brand focus:outline-none"
          >
        </div>

      </div>
    </div>
    {% endif %}

    <!-- 5.3 PRODUCT GRID (2 cols mobile / 3 cols tablet / 4 cols desktop) -->
    <div id="rwnd-collection-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6">
      {% for product in collection.products %}
        {% assign is_bundle = false %}
        {% assign p_handle = product.handle | downcase %}
        {% assign p_title = product.title | downcase %}
        {% if p_handle contains 'cyber-set' or p_title contains 'cyber set' or product.tags contains 'bundle' %}
          {% assign is_bundle = true %}
        {% endif %}

        {% assign is_watch = false %}
        {% if p_title contains 'watch' or p_handle contains 'w-01' or p_title contains 'chronograph' %}
          {% assign is_watch = true %}
        {% endif %}

        <article 
          data-product-card
          data-title="{{ product.title | escape }}"
          data-tags="{{ product.tags | join: ' ' | downcase }}"
          data-price="{{ product.price_min }}"
          class="group relative flex flex-col justify-between border border-line bg-surface p-3 sm:p-4 transition-all hover:border-brand"
        >
          <!-- 4:5 Image Canvas -->
          <div class="relative aspect-[4/5] w-full overflow-hidden border border-line bg-card flex items-center justify-center">
            <a href="{{ product.url }}" class="flex h-full w-full items-center justify-center">
              {% if product.featured_image %}
                <img 
                  src="{{ product.featured_image | image_url: width: 600 }}" 
                  alt="{{ product.title | escape }}" 
                  width="600" 
                  height="750" 
                  loading="lazy" 
                  class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                >
              {% else %}
                <span class="text-[10px] text-muted uppercase">{{ product.title | escape }}</span>
              {% endif %}
            </a>

            <!-- Status Badges -->
            {% assign collection_saving = 0 %}
            {% if product.price_varies %}
              {% if product.compare_at_price_min > product.price_min %}
                {% assign collection_saving = product.compare_at_price_min | minus: product.price_min %}
              {% endif %}
            {% elsif product.compare_at_price > product.price %}
              {% assign collection_saving = product.compare_at_price | minus: product.price %}
            {% endif %}
            {% if collection_saving > 0 %}
              <span class="absolute top-2 left-2 border border-brand bg-card px-1.5 py-0.5 text-[9px] font-bold text-brand">
                SAVE {{ collection_saving | money }}
              </span>
            {% elsif is_watch %}
              <span class="absolute top-2 left-2 border border-brand bg-brand/20 px-1.5 py-0.5 text-[9px] font-bold text-brand">
                PRE-ORDER
              </span>
            {% else %}
              <span class="absolute top-2 right-2 border border-line bg-card px-1.5 py-0.5 text-[9px] font-bold text-muted">
                DROP 01
              </span>
            {% endif %}
          </div>

          <!-- Product Details -->
          <div class="mt-3 flex flex-1 flex-col justify-between">
            <div>
              <p class="text-[9px] uppercase tracking-wider text-muted">
                {% if is_watch %}ANALOG-DIGITAL{% elsif is_bundle %}3-PIECE HARDWARE{% else %}316L ALLOY{% endif %}
              </p>
              <h3 class="mt-1 font-display text-xs sm:text-sm font-bold uppercase text-white line-clamp-1">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>
              
              <div class="mt-1 flex items-baseline gap-2 font-mono-tech text-xs sm:text-sm font-bold text-white">
                {% if product.price_varies %}
                  <span>FROM {{ product.price_min | money }}</span>
                  {% if product.compare_at_price_min > product.price_min %}
                    <span class="text-[10px] text-muted line-through">{{ product.compare_at_price_min | money }}</span>
                  {% endif %}
                {% else %}
                  <span>{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="text-[10px] text-muted line-through">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                {% endif %}
              </div>
            </div>

            {% if product.price_varies %}
              <a href="{{ product.url }}" class="mt-3 flex h-9 w-full items-center justify-center border border-line bg-card text-[10px] font-bold uppercase tracking-wider text-white hover:border-brand transition-colors">
                VIEW OPTIONS
              </a>
            {% elsif product.available %}
              <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="mt-3">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button
                  type="submit"
                  class="w-full h-9 border border-line bg-card text-[10px] font-bold uppercase tracking-wider text-white hover:bg-brand hover:border-brand transition-colors cursor-pointer"
                >
                  + QUICK ADD
                </button>
              </form>
            {% else %}
              <button type="button" disabled class="mt-3 w-full h-9 border border-line bg-card text-[10px] font-bold uppercase tracking-wider text-muted cursor-not-allowed">
                SOLD OUT
              </button>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- 5.3b EMPTY STATE (shown when no product matches the filter) -->
    <div id="rwnd-no-results" class="hidden mt-4 border border-line bg-surface p-10 text-center">
      <span class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-brand">// NO MATCHES</span>
      <p class="mt-2 font-mono-tech text-xs text-muted uppercase tracking-wider">Nothing fits this filter &amp; query.</p>
      <button type="button" id="rwnd-filter-reset-inline" class="mt-4 h-10 border border-brand bg-brand px-6 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-white hover:bg-brand-dark transition-colors cursor-pointer">
        RESET FILTERS →
      </button>
    </div>

    <!-- 5.4 CRAWLABLE PAGINATION (progressively enhanced by JS) -->
    <div id="rwnd-pagination-container" class="mt-12 flex flex-col items-center justify-center gap-4 border-t border-line pt-8">
      {% if paginate.pages > 1 %}
        <nav aria-label="Collection pagination" class="flex flex-wrap items-center justify-center gap-2 font-mono-tech text-xs uppercase tracking-widest">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" rel="prev" class="flex h-11 items-center border border-line px-4 text-white hover:border-brand transition-colors">← PREV</a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="flex h-11 min-w-11 items-center justify-center border border-line px-3 text-muted hover:border-brand hover:text-white transition-colors">{{ part.title }}</a>
            {% else %}
              <span class="flex h-11 min-w-11 items-center justify-center border border-brand bg-brand px-3 text-white" aria-current="page">{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a
              href="{{ paginate.next.url }}"
              rel="next"
              id="rwnd-load-more-btn"
              data-next-url="{{ paginate.next.url }}"
              class="flex h-11 items-center border border-brand px-4 text-white hover:bg-brand transition-colors"
            >
              [ LOAD MORE PIECES + ]
            </a>
          {% endif %}
        </nav>
      {% else %}
        <span class="text-[11px] uppercase tracking-widest text-muted">// END OF TRANSMISSION // ALL ARTIFACTS LOADED</span>
      {% endif %}
    </div>

  </div>
</section>
{% endpaginate %}

<!-- FILTER, SORT & LOAD MORE SCRIPTS -->
<script>
  (() => {
    let currentFilter = 'all';
    let searchQuery = '';

    // Synonym map so a tab matches any of its related category words,
    // whichever ones the shop actually uses.
    const FILTER_SYNONYMS = {
      all: [],
      rings: ['ring'],
      chains: ['chain'],
      bracelets: ['bracelet'],
      earphones: ['earphone', 'audio'],
      watch: ['watch', 'chronograph', 'timepiece'],
    };

    const filterBtns = document.querySelectorAll('[data-tag-filter]');
    const sortSelect = document.getElementById('rwnd-archive-sort');
    const searchInput = document.getElementById('rwnd-archive-search');
    const grid = document.getElementById('rwnd-collection-grid');
    const loadMoreBtn = document.getElementById('rwnd-load-more-btn');
    const countEl = document.getElementById('rwnd-product-count');
    const clearInline = document.getElementById('rwnd-filter-reset-inline');
    const clearBtn = document.getElementById('rwnd-filter-clear');
    const noResults = document.getElementById('rwnd-no-results');

    function syncActiveButtons() {
      filterBtns.forEach((b) => {
        const isActive = b.dataset.tagFilter === currentFilter;
        b.setAttribute('aria-pressed', String(isActive));
        b.classList.toggle('active', b.dataset.tagFilter === currentFilter);
        if (b.dataset.tagFilter === currentFilter) {
          b.classList.add('border-brand', 'bg-brand', 'text-white');
          b.classList.remove('border-line', 'bg-surface', 'text-muted');
        } else {
          b.classList.remove('active', 'border-brand', 'bg-brand', 'text-white');
          b.classList.add('border-line', 'bg-surface', 'text-muted');
        }
      });
    }

    function resetFilters() {
      currentFilter = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (sortSelect) sortSelect.value = 'featured';
      syncActiveButtons();
      applyFilterAndSort();
    }

    function applyFilterAndSort() {
      const cards = [...grid.querySelectorAll('[data-product-card]')];
      let visible = 0;

      const synonyms = FILTER_SYNONYMS[currentFilter] || [currentFilter];

      cards.forEach((card) => {
        const title = (card.dataset.title || '').toLowerCase();
        const tags = (card.dataset.tags || '').toLowerCase();

        const matchesTag = currentFilter === 'all'
          || synonyms.some((s) => tags.includes(s) || title.includes(s));

        const matchesSearch = !searchQuery
          || title.includes(searchQuery)
          || tags.includes(searchQuery);

        if (matchesTag && matchesSearch) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      // Sort visible cards
      const sortVal = sortSelect?.value || 'featured';
      const visibleCards = cards.filter(c => c.style.display !== 'none');
      if (sortVal === 'price-asc') {
        visibleCards.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
      } else if (sortVal === 'price-desc') {
        visibleCards.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
      }
      visibleCards.forEach(c => grid.appendChild(c));

      if (countEl) countEl.textContent = String(visible);

      const hasActive = currentFilter !== 'all' || !!searchQuery;
      if (clearBtn) clearBtn.classList.toggle('hidden', !hasActive);
      if (noResults) noResults.classList.toggle('hidden', visible > 0);
    }

    // Tag filter click
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentFilter = btn.dataset.tagFilter;
        syncActiveButtons();
        applyFilterAndSort();
      });
    });

    clearBtn?.addEventListener('click', resetFilters);
    clearInline?.addEventListener('click', resetFilters);

    // Search input
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      applyFilterAndSort();
    });

    // Sort select
    sortSelect?.addEventListener('change', applyFilterAndSort);

    // AJAX Load More Action
    loadMoreBtn?.addEventListener('click', async (event) => {
      event.preventDefault();
      const nextUrl = loadMoreBtn.dataset.nextUrl;
      if (!nextUrl) return;

      loadMoreBtn.disabled = true;
      loadMoreBtn.textContent = '[ FETCHING NEXT DISPATCH... ]';

      try {
        const res = await fetch(nextUrl);
        if (!res.ok) throw new Error('Could not load the next page.');
        const html = await res.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const newCards = doc.querySelectorAll('#rwnd-collection-grid [data-product-card]');
        newCards.forEach((c) => grid.appendChild(c));

        const nextNextBtn = doc.getElementById('rwnd-load-more-btn');
        if (nextNextBtn && nextNextBtn.dataset.nextUrl) {
          loadMoreBtn.dataset.nextUrl = nextNextBtn.dataset.nextUrl;
          loadMoreBtn.disabled = false;
          loadMoreBtn.textContent = '[ LOAD MORE PIECES + ]';
        } else {
          loadMoreBtn.remove();
          const pagContainer = document.getElementById('rwnd-pagination-container');
          if (pagContainer) {
            pagContainer.innerHTML = '<span class="text-[11px] uppercase tracking-widest text-muted">// END OF TRANSMISSION // ALL ARTIFACTS LOADED</span>';
          }
        }

        applyFilterAndSort();
      } catch (err) {
        console.error('Failed to load more products:', err);
        loadMoreBtn.textContent = '[ RETRY LOAD ]';
        loadMoreBtn.disabled = false;
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_category_tabs",
      "label": "Show category filters",
      "default": true
    }
  ]
}
{% endschema %}
