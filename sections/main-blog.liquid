<!-- sections/main-blog.liquid -->
<!-- DARK THEME REFACTOR - Aligned with night-calls/main-storefront/main-home aesthetic -->
<div class="relative w-full bg-[#050505] text-[#F5F5F7] py-12 px-4 sm:px-6 lg:px-12 font-mono-tech">
  <div class="mx-auto max-w-7xl">
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="mb-8 font-mono-tech text-xs text-[#A3A7AE]">
      <ol class="flex items-center gap-2 uppercase tracking-wider">
        <li><a href="{{ routes.root_url }}" class="hover:text-[#FF0033] transition-colors">BASE</a></li>
        <li class="text-[#FF0033]">/</li>
        <li class="text-[#F5F5F7] font-bold">ARCHIVE JOURNAL // BLOG</li>
      </ol>
    </nav>

    <!-- Blog Header -->
    <div class="border-b border-[#2A2A2F] pb-8 mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#FF0033]/60 bg-[#FF0033]/10 px-3 py-1 font-mono-tech text-[11px] font-bold uppercase tracking-wider text-[#F5F5F7]">
        <span class="h-2 w-2 rounded-full bg-[#FF0033] animate-pulse"></span>
        SYSTEM LOGS & DROP DISPATCHES
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold uppercase tracking-tight mt-3 text-[#F5F5F7]">
        {{ blog.title | default: 'ARCHIVE JOURNAL' }}
      </h1>
      <p class="mt-2 font-mono-tech text-xs sm:text-sm text-[#A3A7AE] max-w-xl">
        Official release notes, engineering logs, and community transmissions from the Madurai dispatch hub.
      </p>
    </div>

    <!-- Articles Grid -->
    {% paginate blog.articles by 12 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for article in blog.articles %}
        <article class="group rounded-none border border-[#2A2A2F] bg-[#131316] p-6 shadow-2xl flex flex-col justify-between transition-all duration-300 hover:shadow-[0_0_40px_rgba(255,0,51,0.15)] hover:border-[#FF0033]/50">
          <div>
            {% if article.image %}
              <div class="rounded-none bg-[#0A0A0C] overflow-hidden aspect-video mb-6 border border-[#2A2A2F]">
                <img src="{{ article.image | image_url: width: 800 }}" width="800" height="450" alt="{{ article.title | escape }}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105">
              </div>
            {% endif %}

            <div class="flex items-center justify-between font-mono-tech text-[10px] text-[#A3A7AE] uppercase tracking-widest mb-2">
              <span>{{ article.published_at | date: "%d %b %Y" }}</span>
              <span>{{ article.author | default: 'RWND20S' }}</span>
            </div>

            <h2 class="font-display text-lg sm:text-xl font-bold uppercase text-[#F5F5F7] group-hover:text-[#FF0033] transition-colors">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h2>

            <p class="mt-3 font-mono-tech text-xs text-[#A3A7AE] line-clamp-3">
              {{ article.excerpt_or_content | strip_html | truncatewords: 25 }}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-[#2A2A2F] flex items-center justify-between">
            <a href="{{ article.url }}" class="font-mono-tech text-xs font-bold uppercase tracking-wider text-[#A3A7AE] flex items-center gap-1 group-hover:text-[#FF0033] group-hover:translate-x-1 transition-all">
              READ TRANSMISSION →
            </a>
            <span class="font-mono-tech text-[10px] text-[#FF0033]/70">LOG #{{ forloop.index0 | plus: 101 }}</span>
          </div>
        </article>
      {% else %}
        <div class="col-span-full flex h-64 flex-col items-center justify-center text-center rounded-none border border-[#2A2A2F] bg-[#131316] p-8 shadow-2xl">
          <p class="font-display text-base font-bold text-[#FF0033] uppercase">NO TRANSMISSIONS LOGGED YET</p>
          <p class="mt-1 text-xs text-[#A3A7AE]">Check back soon for Drop 01 release notes and engineering logs.</p>
        </div>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav aria-label="Blog pagination" class="mt-12 flex flex-wrap items-center justify-center gap-2 border-t border-[#2A2A2F] pt-8 text-xs uppercase tracking-widest">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" rel="prev" class="h-11 border border-[#FF0033]/60 bg-[#FF0033]/10 px-4 text-[#F5F5F7] hover:bg-[#FF0033] hover:text-white transition-all">← PREV</a>
        {% endif %}
        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" class="h-11 min-w-11 flex items-center justify-center border border-[#2A2A2F] bg-[#131316] px-3 text-[#A3A7AE] hover:border-[#FF0033] hover:text-[#F5F5F7] transition-all">{{ part.title }}</a>
          {% else %}
            <span class="h-11 min-w-11 flex items-center justify-center border border-[#FF0033] bg-[#FF0033] px-3 text-white" aria-current="page">{{ part.title }}</span>
          {% endif %}
        {% endfor %}
        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" rel="next" class="h-11 border border-[#FF0033]/60 bg-[#FF0033]/10 px-4 text-[#F5F5F7] hover:bg-[#FF0033] hover:text-white transition-all">NEXT →</a>
        {% endif %}
      </nav>
    {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Blog Main Feed",
  "settings": []
}
{% endschema %}