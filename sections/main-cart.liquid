<!-- sections/main-cart.liquid -->
<section class="relative mx-auto w-full max-w-7xl px-4 py-8 font-mono-tech text-[#F5F5F7] sm:px-6 sm:py-12 lg:px-8">
  <header class="mb-8 flex items-end justify-between border-b border-[#2A2A2F] pb-4">
    <div>
      <span class="text-[10px] font-bold uppercase tracking-widest text-[#FF0033] block">// ARCHIVE ORDER MANIFEST</span>
      <h1 class="mt-1 font-display text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-[#F5F5F7]">YOUR HARDWARE BAG</h1>
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="border border-[#2A2A2F] bg-[#131316] px-4 py-2 font-mono-tech text-xs uppercase tracking-wider text-[#F5F5F7] transition-colors hover:border-[#FF0033] hover:text-[#FF0033]">
      + ADD MORE PIECES
    </a>
  </header>

  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-10">
    <!-- Cart items: rendered by Liquid so /cart works without JavaScript -->
    <div id="rwnd-main-cart-items" class="lg:col-span-8 flex min-w-0 flex-col gap-4" aria-live="polite">
      {% if cart.item_count == 0 %}
        <div class="flex min-h-[300px] flex-col items-center justify-center border border-[#2A2A2F] bg-[#131316] p-8 text-center">
          <span class="text-[10px] font-bold uppercase tracking-widest text-[#FF0033]">// TRANSMISSION SILENT</span>
          <p class="mt-2 font-display text-xl font-bold uppercase tracking-wider text-[#F5F5F7]">YOUR HARDWARE BAG IS EMPTY</p>
          <p class="mt-1 font-mono-tech text-xs text-[#A3A7AE]">No archive components currently secured.</p>
          <a href="{{ routes.all_products_collection_url }}" class="mt-6 inline-flex h-12 items-center justify-center border border-[#FF0033] bg-[#FF0033] px-8 font-mono-tech text-xs font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:bg-[#CC0029]">
            EXPLORE ARCHIVE →
          </a>
        </div>
      {% else %}
        {% for item in cart.items %}
          <article class="flex flex-col gap-4 border border-[#2A2A2F] bg-[#131316] p-4 sm:flex-row sm:items-center">
            <div class="flex h-24 w-24 shrink-0 items-center justify-center border border-[#2A2A2F] bg-[#0A0A0C] p-2">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="96" height="96" class="h-full w-full object-contain">
              {% else %}
                <span class="text-[9px] text-[#A3A7AE]">NO IMG</span>
              {% endif %}
            </div>

            <div class="flex w-full min-w-0 flex-1 flex-col justify-between gap-3">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="font-display text-sm font-bold uppercase text-[#F5F5F7] tracking-tight sm:text-base">
                    <a href="{{ item.url }}" class="hover:text-[#FF0033] transition-colors">{{ item.product.title | escape }}</a>
                  </h3>
                  {% unless item.product.has_only_default_variant %}
                    <p class="mt-0.5 font-mono-tech text-xs text-[#A3A7AE] uppercase">{{ item.variant.title | escape }}</p>
                  {% endunless %}
                  {% if item.product.title contains 'earphone' or item.product.title contains 'Earphone' or item.handle contains 'ear-01' %}
                    <aside class="mt-2 border-l border-[#FF0033] bg-[#0A0A0C] p-2.5 text-[11px] text-[#A3A7AE]">
                      <p class="font-bold text-[#F5F5F7]">Type-C only. Not compatible with iPhone 14 and older, or phones with a 3.5mm jack.</p>
                    </aside>
                  {% endif %}
                </div>
                <span class="shrink-0 font-mono-tech text-sm font-bold text-[#F5F5F7] sm:text-base">{{ item.final_line_price | money }}</span>
              </div>

              <div class="mt-auto flex items-center justify-between border-t border-[#2A2A2F] pt-3">
                <div class="flex items-center border border-[#2A2A2F] bg-[#0A0A0C]">
                  <form action="{{ routes.cart_change_url }}" method="post">
                    <input type="hidden" name="id" value="{{ item.key }}">
                    <input type="hidden" name="line" value="{{ forloop.index }}">
                    <input type="hidden" name="quantity" value="{{ item.quantity | minus: 1 }}">
                    <button type="submit" aria-label="Decrease quantity" class="flex h-10 w-10 items-center justify-center font-mono-tech text-sm font-bold text-[#A3A7AE] transition-colors hover:text-[#F5F5F7] cursor-pointer select-none">−</button>
                  </form>
                  <span class="w-8 text-center font-mono-tech text-xs font-bold text-[#F5F5F7]">{{ item.quantity }}</span>
                  <form action="{{ routes.cart_change_url }}" method="post">
                    <input type="hidden" name="id" value="{{ item.key }}">
                    <input type="hidden" name="line" value="{{ forloop.index }}">
                    <input type="hidden" name="quantity" value="{{ item.quantity | plus: 1 }}">
                    <button type="submit" aria-label="Increase quantity" class="flex h-10 w-10 items-center justify-center font-mono-tech text-sm font-bold text-[#A3A7AE] transition-colors hover:text-[#F5F5F7] cursor-pointer select-none">+</button>
                  </form>
                </div>

                <form action="{{ routes.cart_change_url }}" method="post">
                  <input type="hidden" name="id" value="{{ item.key }}">
                  <input type="hidden" name="line" value="{{ forloop.index }}">
                  <input type="hidden" name="quantity" value="0">
                  <button type="submit" class="font-mono-tech text-xs uppercase tracking-wider text-[#A3A7AE] transition-colors hover:text-[#FF0033] cursor-pointer">[ REMOVE ]</button>
                </form>
              </div>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Order Summary Aside -->
    <aside class="relative z-20 w-full lg:col-span-4 lg:sticky lg:top-28">
      <div class="border border-[#2A2A2F] bg-[#131316] p-6 shadow-2xl">
        <h2 class="border-b border-[#2A2A2F] pb-3 font-mono-tech text-xs font-bold uppercase tracking-[0.14em] text-[#C8CDD3]">
          ORDER SUMMARY
        </h2>

        <!-- Promo code: validated by Shopify at checkout -->
        <div class="pt-4 pb-2">
          <label for="cart-promo-code" class="block text-[10px] uppercase tracking-wider text-[#A3A7AE] mb-1.5">PROMO CODE</label>
          <div class="flex gap-2">
            <input
              type="text"
              id="cart-promo-code"
              placeholder="ENTER CODE..."
              autocomplete="off"
              class="flex-1 h-10 bg-[#0A0A0C] border border-[#2A2A2F] px-3 font-mono-tech text-xs text-white uppercase focus:border-[#FF0033] focus:outline-none"
            >
            <button
              type="button"
              id="cart-apply-btn"
              onclick="window.handlePromoApply(event)"
              class="h-10 px-4 bg-[#2A2A2F] font-mono-tech text-[10px] font-bold uppercase tracking-wider text-white hover:bg-[#FF0033] transition-colors cursor-pointer"
            >
              APPLY
            </button>
          </div>
          <p id="promo-status-msg" class="text-[10px] mt-1.5 hidden font-mono-tech uppercase tracking-wider"></p>
        </div>

        <div class="space-y-3 py-4 font-mono-tech text-xs border-t border-[#2A2A2F]">
          <div class="flex justify-between gap-3 text-[#A3A7AE]">
            <span>ITEMS SUBTOTAL</span>
            <span id="rwnd-main-cart-subtotal" class="font-bold text-[#F5F5F7]">{{ cart.items_subtotal_price | money }}</span>
          </div>

          <div id="rwnd-promo-discount-row" class="{% if cart.total_discount > 0 %}flex{% else %}hidden{% endif %} justify-between gap-3 text-[#00FF88]">
            <span>SHOPIFY DISCOUNT</span>
            <span id="rwnd-promo-discount-amount" class="font-bold">−{{ cart.total_discount | money }}</span>
          </div>

          <div class="flex justify-between gap-3 text-[#A3A7AE]">
            <span>SHIPPING / FEE</span>
            <span id="rwnd-cart-shipping-msg" class="font-bold text-[#F5F5F7]">CALCULATED AT CHECKOUT</span>
          </div>

          <div class="space-y-1.5 pt-1">
            <div class="h-1.5 w-full border border-[#2A2A2F] bg-[#0A0A0C] overflow-hidden">
              {% assign main_prog = cart.total_price | times: 100 | divided_by: 99900 %}
              {% if main_prog > 100 %}{% assign main_prog = 100 %}{% endif %}
              <div id="rwnd-cart-shipping-bar" class="h-full bg-[#FF0033] transition-all duration-300" style="width:{{ main_prog }}%"></div>
            </div>
            <p id="rwnd-shipping-threshold-text" class="text-[10px] text-[#A3A7AE] uppercase tracking-wider">
              {% if cart.total_price >= 99900 %}
                ✓ FREE DELIVERY THRESHOLD MET (₹999+)
              {% else %}
                {% assign main_needed = 99900 | minus: cart.total_price %}
                ADD {{ main_needed | money }} FOR FREE DELIVERY (₹999+)
              {% endif %}
            </p>
          </div>

          <div class="flex justify-between gap-3 border-t border-[#2A2A2F] pt-3 text-[#A3A7AE]">
            <span>COD CHARGE</span>
            <span class="font-bold text-[#F5F5F7]">CALCULATED AT CHECKOUT</span>
          </div>
        </div>

        <!-- DISPATCH PROTOCOL SELECTOR -->
        <div class="border-t border-[#2A2A2F] py-4 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="font-mono-tech text-[10px] font-bold uppercase tracking-wider text-[#FF0033]">
              // DISPATCH PROTOCOL
            </span>
            <span class="font-mono-tech text-[9px] uppercase text-[#737373]">SELECT MODE</span>
          </div>

          <div class="grid grid-cols-1 gap-2">
            <label class="flex items-center justify-between gap-2 border border-[#2A2A2F] bg-[#0A0A0C] p-2.5 cursor-pointer transition-colors has-[:checked]:border-[#FF0033] has-[:checked]:bg-[#FF0033]/10">
              <div class="flex items-start gap-2.5">
                <input
                  type="radio"
                  name="rwnd_dispatch_mode"
                  value="Standard Courier (PAN-India)"
                  checked
                  class="mt-0.5 accent-[#FF0033]"
                >
                <div>
                  <span class="font-mono-tech text-[11px] font-bold uppercase text-white block">STANDARD COURIER</span>
                  <span class="font-sans text-[11px] text-[#A3A7AE]">24h MDU dispatch · Rate shown at checkout</span>
                </div>
              </div>
              <span class="shrink-0 font-mono-tech text-[10px] font-bold text-white">RATE AT CHECKOUT / FREE</span>
            </label>

            <label class="flex items-center justify-between gap-2 border border-[#2A2A2F] bg-[#0A0A0C] p-2.5 cursor-pointer transition-colors has-[:checked]:border-[#FF0033] has-[:checked]:bg-[#FF0033]/10">
              <div class="flex items-start gap-2.5">
                <input
                  type="radio"
                  name="rwnd_dispatch_mode"
                  value="Hand Delivery by Founders (Madurai Only)"
                  class="mt-0.5 accent-[#FF0033]"
                >
                <div>
                  <span class="font-mono-tech text-[11px] font-bold uppercase text-white block">HAND DELIVERY BY FOUNDERS</span>
                  <span class="font-sans text-[11px] text-[#A3A7AE]">Personal drop-off · Madurai 625001–625020 only</span>
                </div>
              </div>
              <span class="shrink-0 border border-[#FF0033]/50 bg-[#FF0033]/15 px-1.5 py-0.5 font-mono-tech text-[10px] font-bold text-[#FF0033]">MDU · RATE AT CHECKOUT</span>
            </label>
          </div>

          <div id="rwnd-main-mdu-pin-wrap" class="hidden pt-1 space-y-1.5">
            <label for="rwnd-main-mdu-pin-input" class="sr-only">Madurai delivery PIN code</label>
            <input
              type="text"
              id="rwnd-main-mdu-pin-input"
              maxlength="6"
              inputmode="numeric"
              placeholder="ENTER MADURAI PIN (E.G. 625020)"
              class="h-10 w-full border border-white/15 bg-[#000000] px-3 font-mono-tech text-xs text-white uppercase focus:border-[#FF0033] focus:outline-none"
            >
            <p id="rwnd-main-mdu-pin-status" class="font-mono-tech text-[10px] uppercase text-[#A3A7AE]">
              ● ENTER 6-DIGIT MADURAI PINCODE (625001–625020)
            </p>
          </div>
        </div>

        <div class="mb-5 flex items-baseline justify-between border-t border-[#2A2A2F] pt-4">
          <span class="font-display text-sm font-bold uppercase text-[#F5F5F7]">SHOPIFY TOTAL</span>
          <span id="rwnd-main-cart-total" class="font-mono-tech text-2xl font-extrabold text-[#F5F5F7]">{{ cart.total_price | money }}</span>
        </div>

        <a
          href="/checkout"
          id="rwnd-checkout-action-btn"
          onclick="window.handleMainCartCheckout(event)"
          class="flex h-14 w-full items-center justify-center border border-[#FF0033] bg-[#FF0033] px-4 font-mono-tech text-xs font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:bg-[#CC0029] cursor-pointer shadow-lg select-none"
        >
          CONTINUE TO CHECKOUT →
        </a>

        <p class="mt-2 font-mono-tech text-[9px] uppercase tracking-wider text-[#737373]">
          Final prices, discounts, shipping and COD fees are calculated by Shopify at checkout.
        </p>

        <!-- Monochrome Vector Trust Row -->
        <div class="mt-6 grid grid-cols-3 gap-1 border-t border-[#2A2A2F] pt-4 text-[9px] uppercase tracking-wider text-[#A3A7AE] text-center">
          <div class="flex items-center justify-center gap-1.5 p-2 border border-[#2A2A2F] bg-[#0A0A0C]">
            <svg class="h-3.5 w-3.5 shrink-0 stroke-[#FF0033]" viewBox="0 0 24 24" fill="none" stroke-width="1.75" aria-hidden="true">
              <path d="M12 2L3 6v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V6l-9-4z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <span>SECURE</span>
          </div>
          <div class="flex items-center justify-center gap-1.5 p-2 border border-[#2A2A2F] bg-[#0A0A0C]">
            <svg class="h-3.5 w-3.5 shrink-0 stroke-[#FF0033]" viewBox="0 0 24 24" fill="none" stroke-width="1.75" aria-hidden="true">
              <rect x="2" y="5" width="20" height="14"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <span>COD AVAIL</span>
          </div>
          <div class="flex items-center justify-center gap-1.5 p-2 border border-[#2A2A2F] bg-[#0A0A0C]">
            <svg class="h-3.5 w-3.5 shrink-0 stroke-[#FF0033]" viewBox="0 0 24 24" fill="none" stroke-width="1.75" aria-hidden="true">
              <rect x="1" y="4" width="14" height="12"/>
              <path d="M15 8h4l3 3v5h-7V8z"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="17.5" cy="18.5" r="2.5"/>
            </svg>
            <span>24H MDU</span>
          </div>
        </div>

        <div class="mt-4 space-y-1.5 border-t border-[#2A2A2F] pt-4 text-[10px] uppercase tracking-wider text-[#A3A7AE]">
          <p>• Standard delivery and founder hand-delivery rates are set in Shopify admin.</p>
          <p>• Founder hand delivery is limited to Madurai PIN codes 625001–625020.</p>
          <p>• COD verification is required before dispatch.</p>
        </div>
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
