<!-- sections/main-cart.liquid -->
<div class="relative w-full min-h-screen bg-transparent text-[#E9E3D5] py-16 px-4 sm:px-6 lg:px-12 font-mono-tech">
  <div class="max-w-5xl mx-auto">
    
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="mb-8 font-mono-tech text-xs text-zinc-400">
      <ol class="flex items-center gap-2 uppercase tracking-wider">
        <li><a href="/" class="hover:text-white transition-colors">BASE</a></li>
        <li>/</li>
        <li class="text-white font-bold">HARDWARE BAG</li>
      </ol>
    </nav>

    <div class="border-b border-white/15 pb-6 mb-8">
      <h1 class="font-display text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-white drop-shadow-md">
        YOUR HARDWARE BAG
      </h1>
      <p class="mt-1 font-mono-tech text-xs text-zinc-400">
        Review your selected Drop 01 artifacts and proceed to secure checkout.
      </p>
    </div>

    <!-- Free Shipping Progress Bar (Smoky Frosted Glass) -->
    <div class="mb-8 rounded-2xl border border-white/12 foggy-glass p-4 shadow-sm backdrop-blur-md">
      <div class="flex items-center justify-between font-mono-tech text-xs mb-2">
        <span id="rwnd-shipping-message" class="text-zinc-300">Calculating shipping threshold...</span>
        <span class="font-bold text-white">FREE SHIPPING @ ₹999</span>
      </div>
      <div class="h-2 w-full rounded-full bg-black/60 overflow-hidden border border-white/10">
        <div id="rwnd-shipping-bar" class="h-full bg-red-600 transition-all duration-300 shadow-[0_0_10px_rgba(220,38,38,0.8)]" style="width: 0%;"></div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Cart Items List (Left Column) -->
      <div class="lg:col-span-7 space-y-4" id="rwnd-cart-items">
        <div class="flex h-48 flex-col items-center justify-center text-center rounded-3xl border border-white/12 foggy-glass p-6 shadow-sm">
          <p class="font-display text-base font-bold text-white uppercase tracking-wider">LOADING BAG SPEC...</p>
        </div>
      </div>

      <!-- Cart Summary & Checkout Box (Right Column) -->
      <div class="lg:col-span-5 sticky top-24">
        <div class="rounded-3xl border border-white/12 foggy-glass p-6 sm:p-8 shadow-xl space-y-4 backdrop-blur-xl">
          <h2 class="font-mono-tech text-xs font-bold uppercase tracking-widest text-white pb-3 border-b border-white/10">
            TRANSMISSION SUMMARY
          </h2>

          <div class="space-y-2 font-mono-tech text-xs">
            <div class="flex justify-between text-zinc-300">
              <span>BAG SUBTOTAL</span>
              <span id="rwnd-cart-subtotal" class="font-bold text-white">₹0.00</span>
            </div>
            <div id="rwnd-cart-discount-row" class="hidden justify-between text-emerald-400">
              <span>WELCOME PASS (5% OFF)</span>
              <span id="rwnd-cart-discount-amount" class="font-bold">-₹0.00</span>
            </div>
            <div class="flex justify-between text-zinc-300">
              <span>EXPRESS SHIPPING</span>
              <span class="font-bold text-emerald-400">FREE</span>
            </div>
          </div>

          <div class="pt-4 border-t border-white/10 flex justify-between items-baseline">
            <span class="font-display text-sm font-bold uppercase text-white">TOTAL AMOUNT</span>
            <span id="rwnd-cart-total" class="font-mono-tech text-xl font-extrabold text-white">₹0.00</span>
          </div>

          <div class="pt-4 space-y-3">
            <button type="button" data-shopify-checkout class="w-full rounded-full border border-red-900/60 bg-black/80 py-4 font-mono-tech text-xs font-bold text-red-100 uppercase tracking-widest hover:bg-red-900 hover:text-white transition-all cursor-pointer shadow-[0_0_20px_rgba(220,38,38,0.3)] backdrop-blur-md">
              PROCEED TO SECURE CHECKOUT //
            </button>
            <a href="/collections/all" class="block text-center rounded-full border border-white/20 bg-white/5 py-3 font-mono-tech text-xs font-bold text-[#E9E3D5] uppercase tracking-wider hover:border-white hover:bg-white hover:text-black transition-all backdrop-blur-md">
              CONTINUE BROWSING CATALOG
            </a>
          </div>

          <div class="pt-4 border-t border-white/10 font-mono-tech text-[10px] text-zinc-500 text-center">
            ✦ Encrypted 256-bit SSL transaction via Shopify Checkout.
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart Main Layout",
  "settings": []
}
{% endschema %}
