<!-- sections/main-cart.liquid -->
<section class="relative mx-auto w-full max-w-7xl px-4 py-8 font-mono-tech text-[#F5F5F7] sm:px-6 sm:py-12 lg:px-8">
  <header class="mb-8 flex items-end justify-between border-b border-[#2A2A2F] pb-4">
    <div>
      <span class="text-[10px] font-bold uppercase tracking-widest text-[#FF0033] block">// ARCHIVE ORDER MANIFEST</span>
      <h1 class="mt-1 font-display text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-[#F5F5F7]">YOUR HARDWARE BAG</h1>
    </div>
    <a href="/collections/all" class="border border-[#2A2A2F] bg-[#131316] px-4 py-2 font-mono-tech text-xs uppercase tracking-wider text-[#F5F5F7] transition-colors hover:border-[#FF0033] hover:text-[#FF0033]">
      + ADD MORE PIECES
    </a>
  </header>

  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-10">
    <!-- Dynamic Cart Items Container (8 Cols) -->
    <div id="rwnd-main-cart-items" class="lg:col-span-8 flex min-w-0 flex-col gap-4" aria-live="polite"></div>

    <!-- Order Summary Aside (4 Cols) -->
    <aside class="relative z-20 w-full lg:col-span-4 lg:sticky lg:top-28">
      <div class="border border-[#2A2A2F] bg-[#131316] p-6 shadow-2xl">
        <h2 class="border-b border-[#2A2A2F] pb-3 font-mono-tech text-xs font-bold uppercase tracking-[0.14em] text-[#C8CDD3]">
          ORDER SUMMARY
        </h2>

        <!-- Promo Code Input with In-Page Logic -->
        <div class="pt-4 pb-2">
          <label for="cart-promo-code" class="block text-[10px] uppercase tracking-wider text-[#A3A7AE] mb-1.5">PROMO CODE</label>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="cart-promo-code" 
              placeholder="ENTER CODE..." 
              value="RWND10"
              class="flex-1 h-10 bg-[#0A0A0C] border border-[#2A2A2F] px-3 font-mono-tech text-xs text-white uppercase focus:border-[#FF0033] focus:outline-none"
            >
            <button 
              type="button" 
              id="cart-apply-btn"
              onclick="window.handlePromoApply(event)"
              class="h-10 px-4 bg-[#2A2A2F] font-mono-tech text-[10px] font-bold uppercase tracking-wider text-white hover:bg-[#FF0033] transition-colors cursor-pointer"
            >
              APPLY
            </button>
          </div>
          <p id="promo-status-msg" class="text-[10px] mt-1.5 hidden font-mono-tech uppercase tracking-wider"></p>
        </div>

        <div class="space-y-3 py-4 font-mono-tech text-xs border-t border-[#2A2A2F]">
          <div class="flex justify-between gap-3 text-[#A3A7AE]">
            <span>SUBTOTAL</span>
            <span id="rwnd-main-cart-subtotal" class="font-bold text-[#F5F5F7]">₹0</span>
          </div>

          <!-- Dynamic Promo Row -->
          <div id="rwnd-promo-discount-row" class="hidden justify-between gap-3 text-[#00FF88]">
            <span id="rwnd-promo-discount-label">DISCOUNT (10%)</span>
            <span id="rwnd-promo-discount-amount" class="font-bold">-₹0</span>
          </div>

          <div class="flex justify-between gap-3 text-[#A3A7AE]">
            <span>SHIPPING</span>
            <span id="rwnd-cart-shipping-msg" class="font-bold text-[#F5F5F7]">CALCULATING...</span>
          </div>

          <!-- Free Shipping Threshold Meter -->
          <div class="space-y-1.5 pt-1">
            <div class="h-1.5 w-full border border-[#2A2A2F] bg-[#0A0A0C] overflow-hidden">
              <div id="rwnd-cart-shipping-bar" class="h-full bg-[#FF0033] transition-all duration-300" style="width:0%"></div>
            </div>
            <p id="rwnd-shipping-threshold-text" class="text-[10px] text-[#A3A7AE] uppercase tracking-wider"></p>
          </div>

          <div class="flex justify-between gap-3 border-t border-[#2A2A2F] pt-3 text-[#A3A7AE]">
            <span>COD CHARGE</span>
            <span class="font-bold text-[#F5F5F7]">CALCULATED AT CHECKOUT</span>
          </div>
        </div>

        <div class="mb-5 flex items-baseline justify-between border-t border-[#2A2A2F] pt-4">
          <span class="font-display text-sm font-bold uppercase text-[#F5F5F7]">ESTIMATED TOTAL</span>
          <span id="rwnd-main-cart-total" class="font-mono-tech text-2xl font-extrabold text-[#F5F5F7]">₹0</span>
        </div>

        <!-- Safe Checkout Button (Direct Link, Zero Form Bubbling) -->
        <a
          href="/checkout"
          id="rwnd-checkout-action-btn"
          class="flex h-14 w-full items-center justify-center border border-[#FF0033] bg-[#FF0033] px-4 font-mono-tech text-xs font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:bg-[#CC0029] cursor-pointer shadow-lg select-none"
        >
          CONTINUE TO CHECKOUT →
        </a>

        <!-- Trust Row -->
        <div class="mt-6 grid grid-cols-3 gap-1 border-t border-[#2A2A2F] pt-4 text-[9px] uppercase tracking-wider text-[#A3A7AE] text-center">
          <div class="p-1.5 border border-[#2A2A2F] bg-[#0A0A0C]">🛡️ Secure</div>
          <div class="p-1.5 border border-[#2A2A2F] bg-[#0A0A0C]">💰 COD Avail</div>
          <div class="p-1.5 border border-[#2A2A2F] bg-[#0A0A0C]">🚚 24h MDU</div>
        </div>

        <div class="mt-4 space-y-1.5 border-t border-[#2A2A2F] pt-4 text-[10px] uppercase tracking-wider text-[#A3A7AE]">
          <p>• Free delivery on ₹999 and above. Below ₹999, ₹49 flat.</p>
          <p>• Dispatched from Madurai; delivered in ~48 hours across South India.</p>
          <p>• COD verification required before dispatch.</p>
        </div>
      </div>
    </aside>
  </div>
</section>

<script>
  (() => {
    let currentCartData = null;
    let appliedDiscountCode = 'RWND10';

    const formatINR = (cents) => '₹' + Math.round(Number(cents || 0) / 100).toLocaleString('en-IN');

    const escapeHTML = (str) =>
      String(str ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      })[char]);

    async function fetchMainCartData() {
      try {
        const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('Failed to load bag.');
        currentCartData = await response.json();
        renderMainCartUI(currentCartData);
      } catch (error) {
        console.error('Cart fetch error:', error);
      }
    }

    async function updateMainCartItem(event, lineKey, quantity) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }

      const container = document.getElementById('rwnd-main-cart-items');
      if (container) container.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: lineKey, quantity: Math.max(0, quantity) })
        });
        if (!response.ok) throw new Error('Failed to update line item.');
        currentCartData = await response.json();
        renderMainCartUI(currentCartData);

        // Keep cart drawer synced if loaded
        if (typeof window.fetchDrawerCart === 'function') {
          window.fetchDrawerCart();
        }
      } catch (error) {
        console.error('Cart update error:', error);
      } finally {
        if (container) container.removeAttribute('aria-busy');
      }
    }

    function renderMainCartUI(cart) {
      const container = document.getElementById('rwnd-main-cart-items');
      if (!container) return;

      const rawTotalPrice = cart.total_price || 0;
      const thresholdCents = 99900; // ₹999
      const isFreeShipping = rawTotalPrice >= thresholdCents;
      const shippingCents = isFreeShipping || rawTotalPrice === 0 ? 0 : 4900;

      // Promo discount calculation
      let discountCents = 0;
      if (appliedDiscountCode === 'RWND10' && rawTotalPrice > 0) {
        discountCents = Math.round(rawTotalPrice * 0.10);
      }

      const finalEstimatedTotal = Math.max(0, rawTotalPrice - discountCents + shippingCents);

      // DOM Updates
      document.getElementById('rwnd-main-cart-subtotal').textContent = formatINR(rawTotalPrice);
      document.getElementById('rwnd-main-cart-total').textContent = formatINR(finalEstimatedTotal);

      // Discount row presentation
      const discountRow = document.getElementById('rwnd-promo-discount-row');
      const discountAmountEl = document.getElementById('rwnd-promo-discount-amount');
      if (discountCents > 0) {
        discountRow.classList.remove('hidden');
        discountRow.classList.add('flex');
        discountAmountEl.textContent = '-' + formatINR(discountCents);
      } else {
        discountRow.classList.add('hidden');
        discountRow.classList.remove('flex');
      }

      // Shipping UI
      const shippingMsg = document.getElementById('rwnd-cart-shipping-msg');
      const thresholdText = document.getElementById('rwnd-shipping-threshold-text');
      const shippingBar = document.getElementById('rwnd-cart-shipping-bar');

      if (isFreeShipping && rawTotalPrice > 0) {
        shippingMsg.textContent = 'FREE';
        shippingMsg.className = 'font-bold text-[#00FF88]';
        thresholdText.textContent = '✓ FREE DELIVERY QUALIFIED (OVER ₹999)';
        shippingBar.style.width = '100%';
      } else if (rawTotalPrice === 0) {
        shippingMsg.textContent = '₹0';
        shippingMsg.className = 'font-bold text-[#A3A7AE]';
        thresholdText.textContent = 'ADD ₹999 FOR FREE DELIVERY';
        shippingBar.style.width = '0%';
      } else {
        shippingMsg.textContent = '₹49';
        shippingMsg.className = 'font-bold text-[#A3A7AE]';
        const diff = thresholdCents - rawTotalPrice;
        thresholdText.textContent = `ADD ${formatINR(diff)} MORE FOR FREE DELIVERY`;
        shippingBar.style.width = `${Math.min(100, Math.round((rawTotalPrice / thresholdCents) * 100))}%`;
      }

      // Sync badge counters
      document.querySelectorAll('[data-cart-count]').forEach((el) => {
        el.textContent = String(cart.item_count || 0);
      });

      // Pass discount parameter into checkout URL
      const checkoutBtn = document.getElementById('rwnd-checkout-action-btn');
      if (checkoutBtn) {
        checkoutBtn.href = appliedDiscountCode 
          ? `/checkout?discount=${encodeURIComponent(appliedDiscountCode)}`
          : '/checkout';
      }

      if (!cart.items || cart.items.length === 0) {
        container.innerHTML = `
          <div class="flex min-h-[300px] flex-col items-center justify-center border border-[#2A2A2F] bg-[#131316] p-8 text-center">
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#FF0033]">// TRANSMISSION SILENT</span>
            <p class="mt-2 font-display text-xl font-bold uppercase tracking-wider text-[#F5F5F7]">YOUR HARDWARE BAG IS EMPTY</p>
            <p class="mt-1 font-mono-tech text-xs text-[#A3A7AE]">No archive components currently secured.</p>
            <a href="/collections/all" class="mt-6 inline-flex h-12 items-center justify-center border border-[#FF0033] bg-[#FF0033] px-8 font-mono-tech text-xs font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:bg-[#CC0029]">
              EXPLORE ARCHIVE →
            </a>
          </div>
        `;
        return;
      }

      container.innerHTML = cart.items
        .map((item) => {
          const key = escapeHTML(item.key);
          const title = escapeHTML(item.product_title);
          const variant = item.variant_title && item.variant_title !== 'Default Title'
            ? `<p class="mt-0.5 font-mono-tech text-xs text-[#A3A7AE] uppercase">${escapeHTML(item.variant_title)}</p>`
            : '';
          const image = item.image
            ? `<img src="${escapeHTML(item.image)}" alt="${escapeHTML(item.title)}" width="96" height="96" class="h-full w-full object-contain">`
            : '<span class="text-[9px] text-[#A3A7AE]">NO IMG</span>';

          const isEarphone = /earphone|ear-01/i.test((item.product_title || '') + ' ' + (item.handle || ''));
          const earphoneWarning = isEarphone
            ? `
              <aside class="mt-2 border-l border-[#FF0033] bg-[#0A0A0C] p-2.5 text-[11px] text-[#A3A7AE] space-y-0.5">
                <p class="font-bold text-[#F5F5F7]">Type-C only. Not compatible with iPhone 14 and older, or phones with a 3.5mm jack.</p>
                <p>Verify USB-C DAC compatibility before dispatch confirmation.</p>
              </aside>
            `
            : '';

          return `
            <article class="flex flex-col gap-4 border border-[#2A2A2F] bg-[#131316] p-4 sm:flex-row sm:items-center">
              <div class="flex h-24 w-24 shrink-0 items-center justify-center border border-[#2A2A2F] bg-[#0A0A0C] p-2">
                ${image}
              </div>

              <div class="flex w-full min-w-0 flex-1 flex-col justify-between gap-3">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="font-display text-sm font-bold uppercase text-[#F5F5F7] tracking-tight sm:text-base">${title}</h3>
                    ${variant}
                    ${earphoneWarning}
                  </div>
                  <span class="shrink-0 font-mono-tech text-sm font-bold text-[#F5F5F7] sm:text-base">${formatINR(item.final_line_price)}</span>
                </div>

                <div class="mt-auto flex items-center justify-between border-t border-[#2A2A2F] pt-3">
                  <div class="flex items-center border border-[#2A2A2F] bg-[#0A0A0C]">
                    <button
                      type="button"
                      onclick="window.handleLineChange(event, '${key}', ${Math.max(0, item.quantity - 1)})"
                      aria-label="Decrease quantity"
                      class="flex h-10 w-10 items-center justify-center font-mono-tech text-sm font-bold text-[#A3A7AE] transition-colors hover:text-[#F5F5F7] cursor-pointer select-none"
                    >−</button>
                    <span class="w-8 text-center font-mono-tech text-xs font-bold text-[#F5F5F7]">${item.quantity}</span>
                    <button
                      type="button"
                      onclick="window.handleLineChange(event, '${key}', ${item.quantity + 1})"
                      aria-label="Increase quantity"
                      class="flex h-10 w-10 items-center justify-center font-mono-tech text-sm font-bold text-[#A3A7AE] transition-colors hover:text-[#F5F5F7] cursor-pointer select-none"
                    >+</button>
                  </div>

                  <button
                    type="button"
                    onclick="window.handleLineChange(event, '${key}', 0)"
                    class="font-mono-tech text-xs uppercase tracking-wider text-[#A3A7AE] transition-colors hover:text-[#FF0033] cursor-pointer"
                  >[ REMOVE ]</button>
                </div>
              </div>
            </article>
          `;
        })
        .join('');
    }

    // Exposed Handlers (Explicitly prevent default click bubbles)
    window.handleLineChange = function(e, lineKey, qty) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      updateMainCartItem(e, lineKey, qty);
    };

    window.handlePromoApply = function(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }

      const input = document.getElementById('cart-promo-code');
      const msg = document.getElementById('promo-status-msg');
      if (!input || !msg) return;

      const code = input.value.trim().toUpperCase();
      if (!code) {
        msg.textContent = 'ENTER A VALID CODE';
        msg.className = 'text-[10px] mt-1.5 font-mono-tech uppercase tracking-wider text-[#FF0033] block';
        appliedDiscountCode = null;
        renderMainCartUI(currentCartData);
        return;
      }

      if (code === 'RWND10') {
        appliedDiscountCode = 'RWND10';
        msg.textContent = '✓ RWND10 APPLIED · 10% OFF APPLIED TO TOTAL';
        msg.className = 'text-[10px] mt-1.5 font-mono-tech uppercase tracking-wider text-[#00FF88] block';
      } else {
        appliedDiscountCode = null;
        msg.textContent = '✕ INVALID ARCHIVE CODE';
        msg.className = 'text-[10px] mt-1.5 font-mono-tech uppercase tracking-wider text-[#FF0033] block';
      }

      if (currentCartData) renderMainCartUI(currentCartData);
    };

    window.fetchMainCartData = fetchMainCartData;

    // Mount Cart on Load & Auto-apply preset code
    document.addEventListener('DOMContentLoaded', () => {
      fetchMainCartData().then(() => {
        const input = document.getElementById('cart-promo-code');
        if (input && input.value.trim().toUpperCase() === 'RWND10') {
          window.handlePromoApply();
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
