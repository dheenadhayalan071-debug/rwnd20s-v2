<!-- sections/main-cart.liquid -->
<section class="cart-page"><h1>Your bag</h1><div id="rwnd-cart-items" aria-live="polite"></div><aside class="cart-summary"><h2>Order summary</h2><p><span>Subtotal</span><strong id="cart-subtotal">₹0</strong></p><p><span>Shipping</span><strong id="cart-shipping">₹49</strong></p><p><span>COD charge</span><strong>{{COD_CHARGE}}</strong></p><p class="fine-print">Free delivery on ₹999 and above. Below ₹999, ₹49. The COD charge is separate and shown before payment.</p><a class="button-primary" href="/checkout">Continue to checkout</a></aside></section>
<script>
(()=>{const rupees=(cents)=>'₹'+Math.round(Number(cents||0)/100).toLocaleString('en-IN');const escape=(s)=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));async function render(){const r=await fetch('/cart.js',{headers:{Accept:'application/json'}});if(!r.ok)return;const cart=await r.json();const root=document.getElementById('rwnd-cart-items');document.getElementById('cart-subtotal').textContent=rupees(cart.total_price);document.getElementById('cart-shipping').textContent=cart.total_price>=99900?'Free': '₹49';root.innerHTML=(cart.items||[]).map(item=>{const title=escape(item.product_title),isEarphone=/earphone|ear-01/i.test(item.product_title+' '+item.handle);return `<article class="cart-item"><img src="${escape(item.image)}" alt="${escape(item.title)}" width="96" height="96"><div><h2>${title}</h2><p>${rupees(item.final_line_price)}</p>${isEarphone?'<aside class="compatibility-warning"><p>Type-C only. Not compatible with iPhone 14 and older, or with phones that have a 3.5mm jack.</p><p>Check that your phone supports USB-C audio before ordering.</p></aside>':''}<label>Quantity <input type="number" min="1" value="${Number(item.quantity)}" data-line="${escape(item.key)}"></label></div></article>`}).join('')||'<p>Your bag is empty.</p>';root.querySelectorAll('input[data-line]').forEach(i=>i.addEventListener('change',async()=>{await fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({id:i.dataset.line,quantity:Number(i.value)})});render()}))}render()})();
</script>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
