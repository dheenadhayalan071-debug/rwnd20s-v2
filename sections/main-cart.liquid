<!-- sections/main-cart.liquid -->
<section class="relative mx-auto w-full max-w-7xl px-4 py-8 font-mono-tech text-bone sm:px-6 sm:py-12 sm:pb-12 lg:px-8{% if cart.item_count > 0 %} pb-28{% endif %}">
  <header class="mb-8 flex items-end justify-between border-b border-line pb-4">
    <div>
      <span class="text-[10px] font-bold uppercase tracking-widest text-brand block">// ARCHIVE ORDER MANIFEST</span>
      <h1 class="mt-1 font-display text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-bone">YOUR HARDWARE BAG</h1>
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="border border-line bg-surface px-4 py-2 font-mono-tech text-xs uppercase tracking-wider text-bone transition-colors hover:border-brand hover:text-brand">
      + ADD MORE PIECES
    </a>
  </header>

  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-10">
    <!-- Cart items: rendered by Liquid so /cart works without JavaScript -->
    <div id="rwnd-main-cart-items" class="lg:col-span-8 flex min-w-0 flex-col gap-4" aria-live="polite">
      {% if cart.item_count == 0 %}
        <div class="flex min-h-[300px] flex-col items-center justify-center border border-line bg-surface p-8 text-center">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand">// TRANSMISSION SILENT</span>
          <p class="mt-2 font-display text-xl font-bold uppercase tracking-wider text-bone">BAG'S EMPTY</p>
          <p class="mt-1 font-mono-tech text-xs text-muted">Grab Drop 01 — or sit in silence. Your call.</p>
          <a href="{{ routes.all_products_collection_url }}" class="mt-6 inline-flex h-12 items-center justify-center border border-brand bg-brand px-8 font-mono-tech text-xs font-bold uppercase tracking-widest text-bone transition-all hover:bg-brand-dark">
            EXPLORE ARCHIVE →
          </a>
        </div>
      {% else %}
        {% for item in cart.items %}
          <article class="flex flex-col gap-4 border border-line bg-surface p-4 sm:flex-row sm:items-center">
            <div class="flex h-24 w-24 shrink-0 items-center justify-center border border-line bg-card p-2">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="96" height="96" decoding="async" class="h-full w-full object-contain">
              {% else %}
                <span class="text-[9px] text-muted">NO IMG</span>
              {% endif %}
            </div>

            <div class="flex w-full min-w-0 flex-1 flex-col justify-between gap-3">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="font-display text-sm font-bold uppercase text-bone tracking-tight sm:text-base">
                    <a href="{{ item.url }}" class="hover:text-brand transition-colors">{{ item.product.title | escape }}</a>
                  </h3>
                  {% unless item.product.has_only_default_variant %}
                    <p class="mt-0.5 font-mono-tech text-xs text-muted uppercase">{{ item.variant.title | escape }}</p>
                  {% endunless %}
                  {% if item.product.title contains 'earphone' or item.product.title contains 'Earphone' or item.handle contains 'ear-01' %}
                    <aside class="mt-2 border-l border-brand bg-card p-2.5 text-[11px] text-muted">
                      <p class="font-bold text-bone">Type-C only. Not compatible with iPhone 14 and older, or phones with a 3.5mm jack.</p>
                    </aside>
                  {% endif %}
                </div>
                <span class="shrink-0 font-mono-tech text-sm font-bold text-bone sm:text-base">{{ item.final_line_price | money }}</span>
              </div>

              <div class="mt-auto flex items-center justify-between border-t border-line pt-3">
                <div class="flex items-center border border-line bg-card">
                  <form action="{{ routes.cart_change_url }}" method="post">
                    <input type="hidden" name="id" value="{{ item.key }}">
                    <input type="hidden" name="line" value="{{ forloop.index }}">
                    <input type="hidden" name="quantity" value="{{ item.quantity | minus: 1 }}">
                    <button type="submit" aria-label="Decrease quantity" class="flex h-10 w-10 items-center justify-center font-mono-tech text-sm font-bold text-muted transition-colors hover:text-bone cursor-pointer select-none">−</button>
                  </form>
                  <span class="w-8 text-center font-mono-tech text-xs font-bold text-bone">{{ item.quantity }}</span>
                  <form action="{{ routes.cart_change_url }}" method="post">
                    <input type="hidden" name="id" value="{{ item.key }}">
                    <input type="hidden" name="line" value="{{ forloop.index }}">
                    <input type="hidden" name="quantity" value="{{ item.quantity | plus: 1 }}">
                    <button type="submit" aria-label="Increase quantity" class="flex h-10 w-10 items-center justify-center font-mono-tech text-sm font-bold text-muted transition-colors hover:text-bone cursor-pointer select-none">+</button>
                  </form>
                </div>

                <form action="{{ routes.cart_change_url }}" method="post">
                  <input type="hidden" name="id" value="{{ item.key }}">
                  <input type="hidden" name="line" value="{{ forloop.index }}">
                  <input type="hidden" name="quantity" value="0">
                  <button type="submit" class="font-mono-tech text-xs uppercase tracking-wider text-muted transition-colors hover:text-brand cursor-pointer">[ REMOVE ]</button>
                </form>
              </div>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Order Summary Aside -->
    <aside class="relative z-20 w-full lg:col-span-4 lg:sticky lg:top-28">
      <div class="border border-line bg-surface p-6 shadow-2xl">
        <h2 class="border-b border-line pb-3 font-mono-tech text-xs font-bold uppercase tracking-[0.14em] text-ice">
          ORDER SUMMARY
        </h2>

        <!-- Promo code: validated by Shopify at checkout -->
        <div class="pt-4 pb-2">
          <label for="cart-promo-code" class="block text-[10px] uppercase tracking-wider text-muted mb-1.5">PROMO CODE</label>
          <div class="flex gap-2">
            <input
              type="text"
              id="cart-promo-code"
              placeholder="ENTER CODE..."
              autocomplete="off"
              class="flex-1 h-10 bg-card border border-line px-3 font-mono-tech text-xs text-white uppercase focus:border-brand focus:outline-none"
            >
            <button
              type="button"
              id="cart-apply-btn"
              onclick="window.handlePromoApply(event)"
              class="h-10 px-4 bg-line font-mono-tech text-[10px] font-bold uppercase tracking-wider text-white hover:bg-brand transition-colors cursor-pointer"
            >
              APPLY
            </button>
          </div>
          <p id="promo-status-msg" class="text-[10px] mt-1.5 hidden font-mono-tech uppercase tracking-wider"></p>
        </div>

        <div class="space-y-3 py-4 font-mono-tech text-xs border-t border-line">
          <div class="flex justify-between gap-3 text-muted">
            <span>ITEMS SUBTOTAL</span>
            <span id="rwnd-main-cart-subtotal" class="font-bold text-bone">{{ cart.items_subtotal_price | money }}</span>
          </div>

          <div id="rwnd-promo-discount-row" class="{% if cart.total_discount > 0 %}flex{% else %}hidden{% endif %} justify-between gap-3 text-success">
            <span>SHOPIFY DISCOUNT</span>
            <span id="rwnd-promo-discount-amount" class="font-bold">−{{ cart.total_discount | money }}</span>
          </div>

          <div class="flex justify-between gap-3 text-muted">
            <span>SHIPPING / FEE</span>
            <span id="rwnd-cart-shipping-msg" class="font-bold text-bone">CALCULATED AT CHECKOUT</span>
          </div>

          <div class="space-y-1.5 pt-1">
            <div class="h-1.5 w-full border border-line bg-card overflow-hidden">
              {% assign main_prog = cart.total_price | times: 100 | divided_by: 99900 %}
              {% if main_prog > 100 %}{% assign main_prog = 100 %}{% endif %}
              <div id="rwnd-cart-shipping-bar" class="h-full bg-brand transition-all duration-300" style="width:{{ main_prog }}%"></div>
            </div>
            <p id="rwnd-shipping-threshold-text" class="text-[10px] text-muted uppercase tracking-wider">
              {% if cart.total_price >= 99900 %}
                ✓ FREE DELIVERY THRESHOLD MET (₹999+)
              {% else %}
                {% assign main_needed = 99900 | minus: cart.total_price %}
                ADD {{ main_needed | money }} FOR FREE DELIVERY (₹999+)
              {% endif %}
            </p>
          </div>

          <div class="flex justify-between gap-3 border-t border-line pt-3 text-muted">
            <span>COD CHARGE</span>
            <span class="font-bold text-bone">CALCULATED AT CHECKOUT</span>
          </div>
        </div>

        <!-- DISPATCH PROTOCOL SELECTOR -->
        <div class="border-t border-line py-4 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="font-mono-tech text-[10px] font-bold uppercase tracking-wider text-brand">
              // DISPATCH PROTOCOL
            </span>
            <span class="font-mono-tech text-[9px] uppercase text-muted">SELECT MODE</span>
          </div>

          <div class="grid grid-cols-1 gap-2">
            <label class="flex items-center justify-between gap-2 border border-line bg-card p-2.5 cursor-pointer transition-colors has-[:checked]:border-brand has-[:checked]:bg-brand/10">
              <div class="flex items-start gap-2.5">
                <input
                  type="radio"
                  name="rwnd_dispatch_mode"
                  value="Standard Courier (PAN-India)"
                  checked
                  class="mt-0.5 accent-brand"
                >
                <div>
                  <span class="font-mono-tech text-[11px] font-bold uppercase text-white block">STANDARD COURIER</span>
                  <span class="font-sans text-[11px] text-muted">24h MDU dispatch · Rate shown at checkout</span>
                </div>
              </div>
              <span class="shrink-0 font-mono-tech text-[10px] font-bold text-white">RATE AT CHECKOUT / FREE</span>
            </label>

            <label class="flex items-center justify-between gap-2 border border-line bg-card p-2.5 cursor-pointer transition-colors has-[:checked]:border-brand has-[:checked]:bg-brand/10">
              <div class="flex items-start gap-2.5">
                <input
                  type="radio"
                  name="rwnd_dispatch_mode"
                  value="Hand Delivery by Founders (Madurai Only)"
                  class="mt-0.5 accent-brand"
                >
                <div>
                  <span class="font-mono-tech text-[11px] font-bold uppercase text-white block">HAND DELIVERY BY FOUNDERS</span>
                  <span class="font-sans text-[11px] text-muted">Personal drop-off · Madurai 625001–625020 only</span>
                </div>
              </div>
              <span class="shrink-0 border border-brand/50 bg-brand/15 px-1.5 py-0.5 font-mono-tech text-[10px] font-bold text-brand">MDU · RATE AT CHECKOUT</span>
            </label>
          </div>

          <div id="rwnd-main-mdu-pin-wrap" class="hidden pt-1 space-y-1.5">
            <label for="rwnd-main-mdu-pin-input" class="sr-only">Madurai delivery PIN code</label>
            <input
              type="text"
              id="rwnd-main-mdu-pin-input"
              maxlength="6"
              inputmode="numeric"
              placeholder="ENTER MADURAI PIN (E.G. 625020)"
              class="h-10 w-full border border-white/15 bg-[#000000] px-3 font-mono-tech text-xs text-white uppercase focus:border-brand focus:outline-none"
            >
            <p id="rwnd-main-mdu-pin-status" class="font-mono-tech text-[10px] uppercase text-muted">
              ● ENTER 6-DIGIT MADURAI PINCODE (625001–625020)
            </p>
          </div>
        </div>

        <div class="mb-3 flex items-baseline justify-between border-t border-line pt-4">
          <span class="font-display text-sm font-bold uppercase text-bone">SHOPIFY TOTAL</span>
          <span id="rwnd-main-cart-total" class="font-mono-tech text-2xl font-extrabold text-bone">{{ cart.total_price | money }}</span>
        </div>

        <div class="mb-4 border border-brand/50 bg-brand/10 px-3 py-2.5">
          <div id="rwnd-main-cart-est-fee-row" class="hidden mb-1.5 flex items-baseline justify-between gap-3 border-b border-brand/30 pb-1.5">
            <span class="font-mono-tech text-[10px] uppercase tracking-wider text-brand">FOUNDER HAND-DELIVERY</span>
            <span id="rwnd-main-cart-est-fee" class="font-mono-tech text-xs font-bold text-brand">+ ₹{{ settings.founder_delivery_fee | default: 499 }}</span>
          </div>
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-mono-tech text-[11px] font-bold uppercase tracking-wider text-bone">ESTIMATED TOTAL</span>
            <span id="rwnd-main-cart-estimated-total" class="font-mono-tech text-lg font-extrabold text-brand">{{ cart.total_price | money }}</span>
          </div>
        </div>

        <a
          href="/checkout"
          id="rwnd-checkout-action-btn"
          onclick="window.handleMainCartCheckout(event)"
          class="rwnd-lift shadow-[0_0_32px_rgba(255,0,51,0.30)] flex h-14 w-full items-center justify-center border border-brand bg-brand px-4 font-mono-tech text-xs font-bold uppercase tracking-widest text-bone transition-all hover:bg-brand-dark cursor-pointer shadow-lg select-none"
        >
          CONTINUE TO CHECKOUT →
        </a>

        <p class="mt-2 font-mono-tech text-[9px] uppercase tracking-wider text-muted">
          Checkout is authoritative — final prices, discounts, shipping and COD are calculated by Shopify at checkout. ESTIMATED TOTAL is indicative.
        </p>

        <!-- Monochrome Vector Trust Row -->
        <div class="mt-6 grid grid-cols-3 gap-1 border-t border-line pt-4 text-[9px] uppercase tracking-wider text-muted text-center">
          <div class="flex items-center justify-center gap-1.5 p-2 border border-line bg-card">
            <svg class="h-3.5 w-3.5 shrink-0 stroke-brand" viewBox="0 0 24 24" fill="none" stroke-width="1.75" aria-hidden="true">
              <path d="M12 2L3 6v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V6l-9-4z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <span>SECURE</span>
          </div>
          <div class="flex items-center justify-center gap-1.5 p-2 border border-line bg-card">
            <svg class="h-3.5 w-3.5 shrink-0 stroke-brand" viewBox="0 0 24 24" fill="none" stroke-width="1.75" aria-hidden="true">
              <rect x="2" y="5" width="20" height="14"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <span>COD AVAIL</span>
          </div>
          <div class="flex items-center justify-center gap-1.5 p-2 border border-line bg-card">
            <svg class="h-3.5 w-3.5 shrink-0 stroke-brand" viewBox="0 0 24 24" fill="none" stroke-width="1.75" aria-hidden="true">
              <rect x="1" y="4" width="14" height="12"/>
              <path d="M15 8h4l3 3v5h-7V8z"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="17.5" cy="18.5" r="2.5"/>
            </svg>
            <span>24H MDU</span>
          </div>
        </div>

        <div class="mt-4 space-y-1.5 border-t border-line pt-4 text-[10px] uppercase tracking-wider text-muted">
          <p>• Standard delivery and founder hand-delivery rates are set in Shopify admin.</p>
          <p>• Founder hand delivery is limited to Madurai PIN codes 625001–625020.</p>
          <p>• COD verification is required before dispatch.</p>
        </div>
      </div>
    </aside>
  </div>

  <!-- STICKY MOBILE CHECKOUT BAR (sm:hidden) — mirrors the PDP conversion bar.
       JS toggles between hidden and flex based on cart contents. -->
  <div
    id="rwnd-main-cart-mobile-checkout-bar"
    class="rwnd-mobile-checkout-bar fixed bottom-0 left-0 z-[110] flex w-full items-center justify-between gap-3 border-t border-white/10 bg-panel/95 p-3 backdrop-blur-md sm:hidden{% if cart.item_count == 0 %} hidden{% endif %}"
  >
    <div class="min-w-0">
      <span class="block font-mono-tech text-[9px] uppercase text-muted">ESTIMATED TOTAL</span>
      <span class="font-mono-tech text-sm font-bold text-bone" id="rwnd-main-cart-mobile-total">{{ cart.total_price | money }}</span>
    </div>
    <a
      href="/checkout"
      id="rwnd-main-cart-mobile-checkout"
      onclick="window.handleMainCartCheckout(event)"
      class="rwnd-lift flex h-12 flex-1 items-center justify-center gap-2 bg-brand font-mono-tech text-xs font-bold uppercase tracking-wider text-white transition-all hover:bg-brand-dark cursor-pointer select-none"
    >
      CONTINUE TO CHECKOUT →
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
