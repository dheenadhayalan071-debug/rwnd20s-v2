<!-- sections/main-cart.liquid -->
<div class="relative w-full px-4 sm:px-6 lg:px-12 py-8 text-[#E9E3D5] font-mono-tech max-w-7xl mx-auto">
  
  <div class="border-b border-white/10 pb-4 mb-6 flex justify-between items-end">
    <div>
      <h1 class="font-display text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
        HARDWARE BAG
      </h1>
      <p class="font-mono-tech text-[10px] text-zinc-400 mt-1 uppercase tracking-widest">
        Review your Drop 01 selection.
      </p>
    </div>
    <a href="/collections/all" class="hidden sm:inline-block font-mono-tech text-xs text-red-400 hover:text-white transition-colors uppercase border-b border-red-900/50 pb-0.5">
      + ADD MORE
    </a>
  </div>

  <!-- The Grid Setup: Items left, Sticky summary right -->
  <div class="flex flex-col lg:flex-row gap-8 items-start relative">
    
    <!-- LEFT COLUMN: CART ITEMS -->
    <div class="w-full lg:w-2/3 flex flex-col space-y-4" id="rwnd-main-cart-items">
      <div class="flex h-32 flex-col items-center justify-center text-center rounded-2xl border border-white/10 bg-black/40 p-6">
        <p class="font-mono-tech text-xs text-zinc-400 uppercase tracking-widest animate-pulse">Scanning Archive...</p>
      </div>
    </div>

    <!-- RIGHT COLUMN: STICKY CHECKOUT SUMMARY -->
    <div class="w-full lg:w-1/3 sticky bottom-4 lg:top-8 z-40">
      <div class="rounded-3xl border border-red-900/40 bg-[#060606] p-6 shadow-[0_0_40px_rgba(0,0,0,0.9)] backdrop-blur-2xl">
        
        <h2 class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-zinc-400 pb-3 border-b border-white/10">
          TRANSMISSION SUMMARY
        </h2>

        <div class="py-4 space-y-3 font-mono-tech text-xs">
          <div class="flex justify-between text-zinc-300">
            <span>SUBTOTAL</span>
            <span id="rwnd-main-cart-subtotal" class="font-bold text-white">₹0.00</span>
          </div>
          
          <div class="flex items-center justify-between text-zinc-300">
            <span>MDU DISPATCH</span>
            <span id="rwnd-cart-shipping-msg" class="font-bold text-emerald-400">CALCULATING...</span>
          </div>
          
          <!-- Shipping Bar -->
          <div class="h-1.5 w-full rounded-full bg-black/80 overflow-hidden border border-white/5">
            <div id="rwnd-cart-shipping-bar" class="h-full bg-red-600 transition-all duration-500 shadow-[0_0_10px_rgba(220,38,38,1)]" style="width: 0%;"></div>
          </div>
        </div>

        <div class="pt-3 border-t border-white/10 flex justify-between items-baseline mb-4">
          <span class="font-display text-sm font-bold uppercase text-white">TOTAL</span>
          <span id="rwnd-main-cart-total" class="font-mono-tech text-xl font-extrabold text-white">₹0.00</span>
        </div>

        <form action="/checkout" method="post">
          <button type="submit" name="checkout" class="w-full rounded-full border border-red-900/60 bg-red-950/80 py-4 font-mono-tech text-xs font-bold text-red-100 uppercase tracking-widest hover:bg-red-900 hover:text-white transition-all shadow-[0_0_30px_rgba(220,38,38,0.4)] cursor-pointer">
            PROCEED TO CHECKOUT →
          </button>
        </form>
        
        <p class="font-mono-tech text-[9px] text-zinc-500 text-center mt-3 uppercase tracking-wider">
          Taxes calculated at checkout.
        </p>
      </div>
    </div>

  </div>
</div>

<!-- Main Cart Live Fetch Engine -->
<script>
  document.addEventListener('DOMContentLoaded', fetchMainCartData);

  async function fetchMainCartData() {
    try {
      const res = await fetch('/cart.js');
      const cart = await res.json();
      renderMainCartUI(cart);
    } catch (err) {
      console.error('Main cart fetch error:', err);
    }
  }

  async function updateMainCartItem(lineKey, quantity) {
    try {
      const res = await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: lineKey, quantity: quantity })
      });
      const cart = await res.json();
      renderMainCartUI(cart);
      if (typeof fetchDrawerCart === 'function') fetchDrawerCart();
    } catch (err) {}
  }

  function renderMainCartUI(cart) {
    const container = document.getElementById('rwnd-main-cart-items');
    const subtotalEl = document.getElementById('rwnd-main-cart-subtotal');
    const totalEl = document.getElementById('rwnd-main-cart-total');
    const shippingMsg = document.getElementById('rwnd-cart-shipping-msg');
    const shippingBar = document.getElementById('rwnd-cart-shipping-bar');

    if (!container) return;

    const formattedSubtotal = '₹' + (cart.total_price / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 });
    if (subtotalEl) subtotalEl.textContent = formattedSubtotal;
    if (totalEl) totalEl.textContent = formattedSubtotal;

    // Shipping Logic
    const threshold = 99900;
    const currentPrice = cart.total_price;
    const percent = Math.min(100, Math.round((currentPrice / threshold) * 100));
    if (shippingBar) shippingBar.style.width = percent + '%';

    if (shippingMsg) {
      if (currentPrice >= threshold) {
        shippingMsg.textContent = 'FREE OVER ₹999';
        shippingMsg.classList.replace('text-zinc-300', 'text-emerald-400');
      } else {
        const remaining = '₹' + ((threshold - currentPrice) / 100).toLocaleString('en-IN');
        shippingMsg.textContent = `ADD ${remaining} FOR FREE`;
        shippingMsg.classList.replace('text-emerald-400', 'text-zinc-300');
      }
    }

    if (!cart.items || cart.items.length === 0) {
      container.innerHTML = `
        <div class="flex h-48 flex-col items-center justify-center text-center rounded-2xl border border-white/10 bg-black/40 p-6">
          <p class="font-display text-sm font-bold text-white uppercase tracking-wider mb-3">YOUR HARDWARE BAG IS EMPTY</p>
          <a href="/collections/all" class="rounded-full border border-red-900/60 bg-red-950/40 px-6 py-2.5 font-mono-tech text-xs font-bold text-red-200 uppercase tracking-widest hover:bg-red-900 hover:text-white transition-all cursor-pointer">
            EXPLORE CATALOG →
          </a>
        </div>
      `;
      return;
    }

    let html = '';
    cart.items.forEach(item => {
      const itemPrice = '₹' + (item.final_line_price / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 });
      html += `
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-2xl border border-white/10 bg-black/60 p-4 shadow-lg backdrop-blur-md">
          <div class="h-24 w-24 shrink-0 overflow-hidden rounded-xl border border-white/10 bg-black p-2 flex items-center justify-center">
            <img src="${item.image}" alt="${item.title}" class="h-full w-full object-contain filter contrast-125">
          </div>
          
          <div class="flex flex-1 flex-col justify-between w-full h-full space-y-3">
            <div class="flex justify-between items-start">
              <div>
                <h3 class="font-display text-sm font-bold text-white uppercase line-clamp-1">${item.product_title}</h3>
                ${item.variant_title && item.variant_title !== 'Default Title' ? `<p class="text-[10px] text-zinc-400 mt-0.5">${item.variant_title}</p>` : ''}
              </div>
              <span class="font-mono-tech text-sm font-bold text-white pl-2">${itemPrice}</span>
            </div>
            
            <div class="flex items-center justify-between border-t border-white/10 pt-3 mt-auto">
              <div class="flex items-center rounded-full border border-white/20 bg-black/80 px-2 py-1 font-mono-tech text-xs">
                <button type="button" onclick="updateMainCartItem('${item.key}', ${item.quantity - 1})" class="text-zinc-400 hover:text-white px-2.5 font-bold cursor-pointer transition-colors">-</button>
                <span class="mx-2 font-bold text-white w-4 text-center">${item.quantity}</span>
                <button type="button" onclick="updateMainCartItem('${item.key}', ${item.quantity + 1})" class="text-zinc-400 hover:text-white px-2.5 font-bold cursor-pointer transition-colors">+</button>
              </div>
              <button type="button" onclick="updateMainCartItem('${item.key}', 0)" class="font-mono-tech text-[10px] font-bold text-red-500 hover:text-red-400 uppercase tracking-widest cursor-pointer transition-colors">
                REMOVE
              </button>
            </div>
          </div>
        </div>
      `;
    });
    container.innerHTML = html;
  }
</script>

{% schema %}
{
  "name": "Dedicated Cart Page",
  "settings": []
}
{% endschema %}
