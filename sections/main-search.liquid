<!-- sections/main-search.liquid -->
<div class="relative w-full min-h-screen bg-transparent py-10 px-4 sm:px-6 lg:px-12 font-mono-tech text-[#F5F5F7]">
  <div class="mx-auto max-w-7xl">
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="mb-6 font-mono-tech text-xs text-[#A3A7AE]">
      <ol class="flex items-center gap-2 uppercase tracking-[0.12em]">
        <li><a href="{{ routes.root_url }}" class="hover:text-[#F5F5F7] transition-colors">BASE</a></li>
        <li class="text-[#2A2A2F]">/</li>
        <li class="text-[#F5F5F7] font-bold">SEARCH VAULT</li>
      </ol>
    </nav>

    <!-- Search Header & Input Bar -->
    <div class="border-b border-[#2A2A2F] pb-8 mb-8">
      <div class="inline-flex items-center gap-2 border border-[#FF0033]/60 bg-[#131316] px-3.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#C8CDD3] rounded-none mb-3">
        <span class="h-1.5 w-1.5 bg-[#FF0033] animate-pulse"></span>
        RWND20S.SYS // QUERY ENGINE
      </div>
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-[#F5F5F7]">
        SEARCH ARCHIVE
      </h1>

      {% if search.performed %}
        <p class="mt-2 font-mono-tech text-xs sm:text-sm text-[#A3A7AE]">
          Query results for: <strong class="text-[#F5F5F7]">"{{ search.terms | escape }}"</strong>
        </p>
      {% endif %}

      <form action="{{ routes.search_url }}" method="get" class="mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 max-w-xl">
        <label for="rwnd-search-input" class="sr-only">Search products</label>
        <input
          type="search"
          id="rwnd-search-input"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="RINGS, CHAINS, WATCHES, AUDIO..."
          autocomplete="off"
          class="flex-1 h-14 border border-[#2A2A2F] bg-[#0A0A0C] px-4 font-mono-tech text-xs uppercase text-[#F5F5F7] placeholder-[#A3A7AE] focus:border-[#FF0033] focus:outline-none rounded-none"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button
          type="submit"
          class="h-14 border border-[#FF0033] bg-[#FF0033] px-8 font-mono-tech text-xs font-bold uppercase tracking-widest text-[#F5F5F7] hover:bg-[#CC0029] transition-all rounded-none cursor-pointer"
        >
          SEARCH //
        </button>
      </form>
    </div>

    <!-- Search Results Grid -->
    {% if search.performed %}
      {% paginate search.results by 24 %}
        {% assign product_results_count = search.results_count %}

        <div class="mb-6 font-mono-tech text-xs text-[#A3A7AE] uppercase tracking-[0.12em]">
          Found {{ product_results_count }} matching piece{{ product_results_count | pluralize: '', 's' }}{% if paginate.pages > 1 %} · page {{ paginate.current_page }} of {{ paginate.pages }}{% endif %}
        </div>

        {% if product_results_count > 0 %}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="rwnd-product-grid">
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% assign p_title = item.title | downcase %}
                {% assign p_handle = item.handle | downcase %}
                {% assign is_watch = false %}
                {% if p_title contains 'watch' or p_handle contains 'w-01' or p_title contains 'chronograph' %}
                  {% assign is_watch = true %}
                {% endif %}

                {% assign is_earphone = false %}
                {% if p_title contains 'earphone' or p_handle contains 'ear-01' or p_title contains 'audio' %}
                  {% assign is_earphone = true %}
                {% endif %}

                {% assign search_saving = 0 %}
                {% if item.price_varies %}
                  {% if item.compare_at_price_min > item.price_min %}
                    {% assign search_saving = item.compare_at_price_min | minus: item.price_min %}
                  {% endif %}
                {% elsif item.compare_at_price > item.price %}
                  {% assign search_saving = item.compare_at_price | minus: item.price %}
                {% endif %}

                <article class="group flex flex-col justify-between border border-[#2A2A2F] bg-[#131316] p-4 transition-all duration-300 hover:border-[#FF0033] rounded-none">
                  <div>
                    <div class="relative flex aspect-square w-full items-center justify-center overflow-hidden border border-[#2A2A2F] bg-[#0A0A0C] p-4 rounded-none">
                      <!-- Taxonomy Badges -->
                      {% if search_saving > 0 %}
                        <span class="absolute left-3 top-3 z-10 border border-[#FF0033] bg-[#0A0A0C] px-2 py-0.5 font-mono-tech text-[10px] font-bold uppercase text-[#FF0033] rounded-none">
                          SAVE {{ search_saving | money }}
                        </span>
                      {% elsif is_watch %}
                        <span class="absolute left-3 top-3 z-10 border border-[#FF0033] bg-[#FF0033]/20 px-2 py-0.5 font-mono-tech text-[10px] font-bold uppercase text-[#FF0033] rounded-none">
                          PRE-ORDER
                        </span>
                      {% elsif is_earphone %}
                        <span class="absolute left-3 top-3 z-10 border border-[#2A2A2F] bg-[#0A0A0C] px-2 py-0.5 font-mono-tech text-[10px] font-bold uppercase text-[#C8CDD3] rounded-none">
                          TYPE-C
                        </span>
                      {% else %}
                        <span class="absolute left-3 top-3 z-10 border border-[#2A2A2F] bg-[#0A0A0C] px-2 py-0.5 font-mono-tech text-[10px] font-bold uppercase text-[#A3A7AE] rounded-none">
                          DROP 01
                        </span>
                      {% endif %}

                      <a href="{{ item.url }}" class="flex h-full w-full items-center justify-center">
                        {% if item.featured_image %}
                          <img
                            src="{{ item.featured_image | image_url: width: 600 }}"
                            alt="{{ item.featured_image.alt | default: item.title | escape }}"
                            width="600"
                            height="600"
                            loading="lazy"
                            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                          >
                        {% else %}
                          <div class="font-mono-tech text-xs uppercase tracking-widest text-[#A3A7AE]">NO ASSET</div>
                        {% endif %}
                      </a>
                    </div>

                    <div class="mt-4">
                      <p class="font-mono-tech text-[10px] uppercase font-bold tracking-[0.12em] text-[#C8CDD3]">
                        {{ item.vendor | default: 'RWND20S' | escape }}
                      </p>
                      <h2 class="mt-1 line-clamp-2 font-display text-sm font-bold uppercase text-[#F5F5F7] tracking-tight">
                        <a href="{{ item.url }}">{{ item.title | escape }}</a>
                      </h2>
                    </div>
                  </div>

                  <div class="mt-5 pt-4 border-t border-[#2A2A2F] flex items-center justify-between gap-2">
                    <span class="font-mono-tech text-sm font-extrabold text-[#F5F5F7]">
                      {% if item.price_varies %}FROM {{ item.price_min | money }}{% else %}{{ item.price | money }}{% endif %}
                    </span>

                    <div class="flex items-center gap-2">
                      <a
                        href="{{ item.url }}"
                        class="inline-flex items-center justify-center border border-[#2A2A2F] bg-[#0A0A0C] px-3.5 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:border-[#C8CDD3] rounded-none"
                      >
                        VIEW
                      </a>
                      {% if item.price_varies %}
                        <a href="{{ item.url }}" class="inline-flex items-center justify-center border border-[#FF0033] bg-[#FF0033] px-3.5 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:bg-[#CC0029] rounded-none">
                          OPTIONS
                        </a>
                      {% elsif item.available %}
                        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                          <input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}">
                          <button
                            type="submit"
                            name="add"
                            class="inline-flex items-center justify-center border border-[#FF0033] bg-[#FF0033] px-3.5 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:bg-[#CC0029] rounded-none cursor-pointer"
                          >
                            + BAG
                          </button>
                        </form>
                      {% else %}
                        <button type="button" disabled class="inline-flex items-center justify-center border border-[#2A2A2F] bg-[#0A0A0C] px-3.5 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-[#737373] rounded-none cursor-not-allowed">
                          SOLD OUT
                        </button>
                      {% endif %}
                    </div>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          <div class="flex min-h-[260px] flex-col items-center justify-center text-center border border-[#2A2A2F] bg-[#131316] p-8 rounded-none">
            <p class="font-display text-base font-bold text-[#F5F5F7] uppercase tracking-wider">NO ARTIFACTS MATCHED YOUR QUERY</p>
            <p class="mt-2 text-xs text-[#A3A7AE] font-mono-tech">Check keywords like 'rings', 'chains', 'bracelets', 'earphones', or 'watches'.</p>
            <a href="{{ routes.all_products_collection_url }}" class="mt-6 inline-flex h-12 items-center justify-center border border-[#FF0033] bg-[#FF0033] px-6 font-mono-tech text-xs font-bold text-[#F5F5F7] uppercase tracking-widest hover:bg-[#CC0029] transition-all rounded-none">
              BROWSE FULL DROP 01 ARCHIVE →
            </a>
          </div>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav aria-label="Search pagination" class="mt-12 flex flex-wrap items-center justify-center gap-2 border-t border-[#2A2A2F] pt-8 font-mono-tech text-xs uppercase tracking-widest">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" rel="prev" class="flex h-11 items-center border border-[#2A2A2F] px-4 text-white hover:border-[#FF0033] transition-colors">← PREV</a>
            {% endif %}
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}" class="flex h-11 min-w-11 items-center justify-center border border-[#2A2A2F] px-3 text-[#A3A7AE] hover:border-[#FF0033] hover:text-white transition-colors">{{ part.title }}</a>
              {% else %}
                <span class="flex h-11 min-w-11 items-center justify-center border border-[#FF0033] bg-[#FF0033] px-3 text-white" aria-current="page">{{ part.title }}</span>
              {% endif %}
            {% endfor %}
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" rel="next" class="flex h-11 items-center border border-[#FF0033] px-4 text-white hover:bg-[#FF0033] transition-colors">NEXT →</a>
            {% endif %}
          </nav>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Search Main Catalog",
  "settings": []
}
{% endschema %}
