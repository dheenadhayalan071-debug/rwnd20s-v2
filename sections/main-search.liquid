<!-- sections/main-search.liquid -->
<div class="relative w-full min-h-screen bg-transparent py-10 px-4 sm:px-6 lg:px-12 font-mono-tech text-bone">
  <div class="mx-auto max-w-7xl">
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="mb-6 font-mono-tech text-xs text-muted">
      <ol class="flex items-center gap-2 uppercase tracking-[0.12em]">
        <li><a href="{{ routes.root_url }}" class="hover:text-bone transition-colors">BASE</a></li>
        <li class="text-line">/</li>
        <li class="text-bone font-bold">SEARCH VAULT</li>
      </ol>
    </nav>

    <!-- Search Header & Input Bar -->
    <div class="border-b border-line pb-8 mb-8">
      <div class="inline-flex items-center gap-2 border border-brand/60 bg-surface px-3.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-ice rounded-none mb-3">
        <span class="h-1.5 w-1.5 bg-brand animate-pulse"></span>
        RWND20S.SYS // QUERY ENGINE
      </div>
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-bone">
        SEARCH ARCHIVE
      </h1>

      {% if search.performed %}
        <p class="mt-2 font-mono-tech text-xs sm:text-sm text-muted">
          Query results for: <strong class="text-bone">"{{ search.terms | escape }}"</strong>
        </p>
      {% endif %}

      <form action="{{ routes.search_url }}" method="get" class="mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 max-w-xl">
        <label for="rwnd-search-input" class="sr-only">Search products</label>
        <input
          type="search"
          id="rwnd-search-input"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="CHAINS, RINGS, BRACELETS..."
          autocomplete="off"
          class="flex-1 h-14 border border-line bg-card px-4 font-mono-tech text-xs uppercase text-bone placeholder-muted focus:border-brand focus:outline-none rounded-none"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button
          type="submit"
          class="h-14 border border-brand bg-brand px-8 font-mono-tech text-xs font-bold uppercase tracking-widest text-bone hover:bg-brand-dark transition-all rounded-none cursor-pointer"
        >
          SEARCH //
        </button>
      </form>
    </div>

    <!-- Search Results Grid -->
    {% if search.performed %}
      {% paginate search.results by 24 %}
        {% assign product_results_count = search.results_count %}

        <div class="mb-6 font-mono-tech text-xs text-muted uppercase tracking-[0.12em]">
          Found {{ product_results_count }} matching piece{{ product_results_count | pluralize: '', 's' }}{% if paginate.pages > 1 %} · page {{ paginate.current_page }} of {{ paginate.pages }}{% endif %}
        </div>

        {% if product_results_count > 0 %}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="rwnd-product-grid">
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% assign p_title = item.title | downcase %}
                {% assign p_handle = item.handle | downcase %}
                {% assign p_tags = item.tags | join: ' ' | downcase %}
                {%- capture p_cat -%}{%- render 'product-category', product: item -%}{%- endcapture -%}
                {%- assign p_cat = p_cat | strip -%}
                {% assign is_watch = false %}
                {% if p_cat == 'watch' %}{% assign is_watch = true %}{% endif %}
                {% assign is_earphone = false %}
                {% if p_cat == 'audio' %}{% assign is_earphone = true %}{% endif %}
                {% assign is_bundle = false %}
                {% if p_cat == 'set' %}{% assign is_bundle = true %}{% endif %}
                {%- assign fallback_asset = 'chain-fallback.webp' -%}
                {%- if p_cat == 'ring' -%}{%- assign fallback_asset = 'ring-fallback.webp' -%}{%- elsif p_cat == 'bracelet' -%}{%- assign fallback_asset = 'bracelet-fallback.webp' -%}{%- endif -%}

                {% assign search_saving = 0 %}
                {% if item.price_varies %}
                  {% if item.compare_at_price_min > item.price_min %}
                    {% assign search_saving = item.compare_at_price_min | minus: item.price_min %}
                  {% endif %}
                {% elsif item.compare_at_price > item.price %}
                  {% assign search_saving = item.compare_at_price | minus: item.price %}
                {% endif %}

                <article class="group flex flex-col justify-between border border-line bg-surface p-4 transition-all duration-300 hover:border-brand rounded-none">
                  <div>
                    <div class="rwnd-media relative flex aspect-square w-full items-center justify-center overflow-hidden border border-line bg-card p-4 rounded-none">
                      <!-- Taxonomy Badges -->
                      {%- comment -%} SAVE keeps the left slot; taxonomy badge takes the right. {%- endcomment -%}
                      {% if search_saving > 0 %}
                        <span class="absolute left-3 top-3 z-10 border border-brand bg-card px-2 py-0.5 font-mono-tech text-[10px] font-bold uppercase text-brand rounded-none">
                          SAVE {{ search_saving | money }}
                        </span>
                      {% endif %}
                      <span class="absolute right-3 top-3 z-10 border px-2 py-0.5 font-mono-tech text-[10px] font-bold uppercase rounded-none {% if is_watch or is_bundle %}border-brand bg-brand/20 text-brand{% elsif is_earphone %}border-line bg-card text-ice{% else %}border-line bg-card text-muted{% endif %}">
                        {% if is_bundle %}MYSTERY VAULT{% elsif is_watch %}PRE-ORDER{% elsif is_earphone %}TYPE-C AUDIO{% else %}DROP 01{% endif %}
                      </span>

                      <a href="{{ item.url }}" class="flex h-full w-full items-center justify-center">
                        {% if item.featured_image %}
                          <img
                            src="{{ item.featured_image | image_url: width: 600 }}"
                            alt="{{ item.featured_image.alt | default: item.title | escape }}"
                            width="600"
                            height="600"
                            loading="lazy"
                            class="rwnd-media-img h-full w-full object-contain"
                          >
                          {%- if item.images.size > 1 -%}
                            <img
                              src="{{ item.images[1] | image_url: width: 600 }}"
                              alt="{{ item.images[1].alt | default: item.title | escape }}"
                              width="600"
                              height="600"
                              loading="lazy"
                              class="rwnd-media-img rwnd-media-alt h-full w-full object-contain"
                            >
                          {%- endif -%}
                        {% else %}
                          <img
                            src="{{ fallback_asset | asset_url }}"
                            alt="{{ item.title | escape }} — 316L stainless steel hardware"
                            width="1000"
                            height="1000"
                            loading="lazy"
                            class="rwnd-media-img h-full w-full object-contain opacity-95"
                          >
                        {% endif %}
                      </a>
                    </div>

                    <div class="mt-4">
                      <p class="font-mono-tech text-[10px] uppercase font-bold tracking-[0.12em] text-muted">
                        {% case p_cat %}
                          {% when 'watch' %}TIMEPIECES
                          {% when 'set' %}JEWELRY SETS
                          {% when 'audio' %}AUDIO
                          {% when 'bracelet' %}BRACELETS
                          {% when 'ring' %}RINGS
                          {% else %}CHAINS &amp; PENDANTS
                        {% endcase %}
                        <span class="text-line">//</span>
                        <span class="text-ice">{{ item.vendor | default: 'RWND20S' | escape }}</span>
                      </p>
                      <h2 class="mt-1 line-clamp-2 font-display text-sm font-bold uppercase text-bone tracking-tight">
                        <a href="{{ item.url }}">{{ item.title | escape }}</a>
                      </h2>
                    </div>
                  </div>

                  <div class="mt-5 pt-4 border-t border-line flex items-center justify-between gap-2">
                    <span class="font-mono-tech text-sm font-extrabold text-bone">
                      {% if item.price_varies %}FROM {{ item.price_min | money }}{% else %}{{ item.price | money }}{% endif %}
                    </span>

                    <div class="flex items-center gap-2">
                      <a
                        href="{{ item.url }}"
                        class="inline-flex items-center justify-center border border-line bg-card px-3.5 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-bone transition-all hover:border-ice rounded-none"
                      >
                        VIEW
                      </a>
                      {% if item.price_varies %}
                        <a href="{{ item.url }}" class="inline-flex items-center justify-center border border-brand bg-brand px-3.5 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-bone transition-all hover:bg-brand-dark rounded-none">
                          OPTIONS
                        </a>
                      {% elsif item.available %}
                        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                          <input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}">
                          <button
                            type="submit"
                            name="add"
                            class="inline-flex items-center justify-center border border-brand bg-brand px-3.5 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-bone transition-all hover:bg-brand-dark rounded-none cursor-pointer"
                          >
                            + BAG
                          </button>
                        </form>
                      {% else %}
                        <button type="button" disabled class="inline-flex items-center justify-center border border-line bg-card px-3.5 py-2 font-mono-tech text-[10px] font-bold uppercase tracking-widest text-muted rounded-none cursor-not-allowed">
                          SOLD OUT
                        </button>
                      {% endif %}
                    </div>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          <div class="flex min-h-[260px] flex-col items-center justify-center text-center border border-line bg-surface p-8 rounded-none">
            <p class="font-display text-base font-bold text-bone uppercase tracking-wider">NO ARTIFACTS MATCHED YOUR QUERY</p>
            <p class="mt-2 text-xs text-muted font-mono-tech">Check keywords like 'chains', 'rings', 'bracelets', 'pendants', or 'earphones'.</p>
            <a href="{{ routes.all_products_collection_url }}" class="mt-6 inline-flex h-12 items-center justify-center border border-brand bg-brand px-6 font-mono-tech text-xs font-bold text-bone uppercase tracking-widest hover:bg-brand-dark transition-all rounded-none">
              BROWSE FULL DROP 01 ARCHIVE →
            </a>
          </div>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav aria-label="Search pagination" class="mt-12 flex flex-wrap items-center justify-center gap-2 border-t border-line pt-8 font-mono-tech text-xs uppercase tracking-widest">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" rel="prev" class="flex h-11 items-center border border-line px-4 text-white hover:border-brand transition-colors">← PREV</a>
            {% endif %}
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}" class="flex h-11 min-w-11 items-center justify-center border border-line px-3 text-muted hover:border-brand hover:text-white transition-colors">{{ part.title }}</a>
              {% else %}
                <span class="flex h-11 min-w-11 items-center justify-center border border-brand bg-brand px-3 text-white" aria-current="page">{{ part.title }}</span>
              {% endif %}
            {% endfor %}
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" rel="next" class="flex h-11 items-center border border-brand px-4 text-white hover:bg-brand transition-colors">NEXT →</a>
            {% endif %}
          </nav>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Search Main Catalog",
  "settings": []
}
{% endschema %}
