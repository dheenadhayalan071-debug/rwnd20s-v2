<!-- sections/main-search.liquid -->
<section class="search-page"><h1>Search the collection</h1><form action="{{ routes.search_url }}" method="get"><label for="search-q">Search products</label><input id="search-q" type="search" name="q" value="{{ search.terms | escape }}"><button class="button-primary" type="submit">Search</button></form>{% if search.performed %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}<article class="product-card"><a href="{{ item.url }}">{% if item.featured_image %}<img src="{{ item.featured_image | image_url: width: 640 }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" width="640" height="640" loading="lazy">{% endif %}<h2>{{ item.title | escape }}</h2></a><p>{{ item.price | money }}</p></article>{% endif %}{% endfor %}</div>{% endif %}</section>
{% schema %}{"name":"Search","settings":[]}{% endschema %}
