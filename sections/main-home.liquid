            02 // CHROME AUDIO
          </button>
          <button type="button" role="tab" aria-selected="false" data-hero-stage-btn="3" class="border border-[#2A2A2F] bg-[#131316] px-4 py-2.5 font-mono-tech text-xs font-medium tracking-wider text-[#A3A7AE] uppercase hover:border-[#C8CDD3] hover:text-[#F5F5F7] cursor-pointer transition-all rounded-none">
