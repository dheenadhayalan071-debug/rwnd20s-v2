<!-- sections/header.liquid -->
<div class="relative z-40 w-full border-b border-red-950/40 bg-[#030303] px-3 py-2 text-center">
  <div class="mx-auto flex max-w-7xl items-center justify-center gap-3">
    <p class="truncate font-mono-tech text-[10px] font-medium uppercase tracking-[0.16em] text-zinc-300 sm:text-[11px]">{{ section.settings.announcement_text | escape }}</p>
    <button id="rwnd-open-welcome-popup" type="button" class="hidden items-center rounded-full border border-red-900/60 bg-red-950/40 px-2.5 py-0.5 font-mono-tech text-[10px] font-semibold text-red-300 hover:border-red-500">OPEN</button>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-white/10 bg-[#030303]/90 backdrop-blur-2xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name | default: 'rwnd20s.' | escape }}" class="inline-flex shrink-0 items-center whitespace-nowrap transition-opacity hover:opacity-80">
      <span class="font-display text-xl font-extrabold tracking-tighter text-white drop-shadow-sm sm:text-2xl">{{ settings.brand_name | default: 'rwnd20s.' | escape }}</span>
    </a>

    <nav aria-label="Main Navigation" class="hidden items-center gap-7 lg:flex xl:gap-9">
      <a href="{{ routes.root_url }}" class="border-b border-red-600 pb-0.5 text-xs font-semibold uppercase tracking-widest text-white">Home</a>
      <a href="/collections/rings" class="text-xs font-semibold uppercase tracking-widest text-zinc-400 transition-colors hover:text-white">Rings</a>
      <a href="/collections/chains" class="text-xs font-semibold uppercase tracking-widest text-zinc-400 transition-colors hover:text-white">Chains</a>
      <a href="/collections/bracelets" class="text-xs font-semibold uppercase tracking-widest text-zinc-400 transition-colors hover:text-white">Bracelets</a>
      <a href="/collections/earphones" class="text-xs font-semibold uppercase tracking-widest text-zinc-400 transition-colors hover:text-white">Earphones</a>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <button type="button" data-toggle-search aria-controls="rwnd-search-panel" aria-expanded="false" aria-label="Open search" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-black/40 text-white hover:border-red-500">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21L16.65 16.65M10.5 18A7.5 7.5 0 1 1 10.5 3A7.5 7.5 0 0 1 10.5 18Z"></path></svg>
      </button>

      <a href="/pages/wishlist" aria-label="Wishlist" class="hidden items-center gap-1.5 rounded-full border border-white/15 bg-black/40 px-3 py-1.5 font-mono-tech text-[11px] font-semibold text-white hover:border-red-500">
        <span>Wishlist</span>
      </a>

      <a href="{{ routes.cart_url }}" aria-label="Shopping Bag" class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-black/40 px-3 py-1.5 font-mono-tech text-[11px] font-semibold text-white hover:border-red-500">
        <svg class="h-3.5 w-3.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h2l2 10h10l2-8H7"></path><circle cx="10" cy="17.5" r="1.3"></circle><circle cx="16" cy="17.5" r="1.3"></circle></svg>
        <span data-cart-count class="inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-red-600 px-1 font-mono-tech text-[10px] font-bold text-white">{{ cart.item_count }}</span>
      </a>

      <button type="button" data-toggle-mobile-menu aria-label="Open Menu" aria-controls="rwnd-mobile-menu" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-white/15 bg-black/40 text-white hover:border-red-500">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
</header>

<div id="rwnd-search-panel" class="fixed inset-0 z-[150] hidden items-start justify-center bg-black/80 px-4 pt-[15vh] backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Search the archive">
  <div class="w-full max-w-xl rounded-2xl border border-red-800/50 bg-[#040404]/[.98] p-4 shadow-2xl sm:p-6">
    <div class="mb-4 flex items-center justify-between">
      <p class="font-mono-tech text-xs font-bold uppercase tracking-[0.2em] text-red-300">Search the archive</p>
      <button type="button" data-close-search aria-label="Close search" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/20 text-white hover:border-red-500">×</button>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="flex gap-2">
      <label class="sr-only" for="rwnd-search-input">Search products</label>
      <input id="rwnd-search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="RINGS, CHAINS, AUDIO..." autocomplete="off" class="min-h-12 min-w-0 flex-1 border border-white/10 bg-black/70 px-3 text-sm text-white outline-none focus:border-red-500">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="min-h-12 border border-red-500 bg-red-600 px-5 font-mono-tech text-xs font-bold uppercase tracking-wider text-white hover:bg-red-700">Search</button>
    </form>
  </div>
</div>

<div id="rwnd-mobile-menu" role="dialog" aria-modal="true" aria-label="Mobile Navigation" class="fixed inset-0 z-[120] hidden flex-col justify-between bg-[#030303]/[.98] p-6 text-white backdrop-blur-xl">
  <div class="flex items-center justify-between border-b border-white/10 pb-4">
    <span class="font-display text-xl font-extrabold tracking-tighter text-white">{{ settings.brand_name | default: 'rwnd20s.' | escape }}</span>
    <button type="button" data-toggle-mobile-menu aria-label="Close Menu" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-black/60 text-white hover:border-red-500">×</button>
  </div>
  <nav aria-label="Mobile collections" class="my-auto flex flex-col">
    <a href="{{ routes.root_url }}" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold uppercase tracking-tight text-white transition-colors hover:text-red-300">Home</a>
    <a href="/collections/rings" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold uppercase tracking-tight text-white transition-colors hover:text-red-300">Rings</a>
    <a href="/collections/chains" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold uppercase tracking-tight text-white transition-colors hover:text-red-300">Chains</a>
    <a href="/collections/bracelets" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold uppercase tracking-tight text-white transition-colors hover:text-red-300">Bracelets</a>
    <a href="/collections/earphones" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold uppercase tracking-tight text-white transition-colors hover:text-red-300">Earphones</a>
    <a href="{{ routes.cart_url }}" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold uppercase tracking-tight text-white transition-colors hover:text-red-300">Bag</a>
    <a href="{{ routes.root_url }}#about" data-toggle-mobile-menu class="border-b border-white/10 py-3 font-display text-2xl font-extrabold uppercase tracking-tight text-white transition-colors hover:text-red-300">About</a>
  </nav>
  <div class="border-t border-white/10 pt-4 font-mono-tech text-[11px] uppercase tracking-wider text-zinc-400">Free delivery on ₹999 and above. Below ₹999, ₹49.</div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const panel = document.getElementById('rwnd-search-panel');
    const input = document.getElementById('rwnd-search-input');
    const toggle = document.querySelector('[data-toggle-search]');
    const close = panel?.querySelector('[data-close-search]');

    const openSearch = () => {
      if (!panel) return;
      panel.classList.remove('hidden');
      panel.classList.add('flex');
      toggle?.setAttribute('aria-expanded', 'true');
      window.setTimeout(() => input?.focus(), 0);
    };
    const closeSearch = () => {
      panel?.classList.add('hidden');
      panel?.classList.remove('flex');
      toggle?.setAttribute('aria-expanded', 'false');
    };

    toggle?.addEventListener('click', openSearch);
    close?.addEventListener('click', closeSearch);
    panel?.addEventListener('click', (event) => { if (event.target === panel) closeSearch(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeSearch(); });
  });
</script>

{% schema %}
{
  "name": "Header & Announcement",
  "settings": [
    { "type": "text", "id": "announcement_text", "label": "Top Announcement Bar Text", "default": "Free delivery on ₹999 and above. Below ₹999, ₹49." }
  ]
}
{% endschema %}
