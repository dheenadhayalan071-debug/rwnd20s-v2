            <span class="h-1.5 w-1.5 bg-[#C8102E] animate-pulse"></span>
            DROP 01 · DISPATCHED FROM MADURAI
          </div>
          <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-extrabold uppercase tracking-tight mt-3 text-[#F5F5F7]">
            {{ section.settings.hero_title | default: 'Y2K steel for the hours after dark.' }}
          </h1>
          <p class="mt-2 font-mono-tech text-xs sm:text-sm text-[#A3A7AE] max-w-xl">
            {{ section.settings.hero_subtitle | default: 'After dark, no rules. High-polish stainless steel and nocturnal audio for those who operate off the grid.' }}
          </p>
        </div>

        <!-- Hero Stage Switcher Tabs (Strict 0px, Monochrome with Chrome accents) -->
        <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Hero Stages">
