        <div class="lg:col-span-7 border border-[#2A2A2F] bg-[#131316] p-6 sm:p-8 relative rounded-none flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono-tech text-[10px] uppercase font-bold tracking-[0.12em] text-[#C8CDD3]">TIMEPIECE SPEC // W-01</span>
              <span class="font-mono-tech text-[10px] font-bold text-[#C8102E] uppercase tracking-widest border border-[#C8102E] bg-[#0A0A0C] px-2 py-0.5 rounded-none">
