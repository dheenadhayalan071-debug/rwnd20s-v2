<!-- sections/main-home.liquid -->
<div class="relative w-full bg-transparent text-[#F5F5F7] pb-16 font-mono-tech">
  <!-- Hero Stage Header & Switcher -->
  <section class="relative px-4 pt-6 sm:pt-8 md:px-8 lg:px-12">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-[#2A2A2F] pb-8">
        <div>
