        <div class="lg:col-span-5 border border-[#2A2A2F] bg-[#131316] p-6 sm:p-8 flex flex-col justify-between rounded-none">
          <div>
            <span class="font-mono-tech text-[10px] uppercase font-bold tracking-[0.12em] text-[#C8CDD3]">PRE-ORDER FULFILLMENT</span>
            <div class="mt-4 space-y-3 font-mono-tech text-xs text-[#A3A7AE]">
