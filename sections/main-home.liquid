            </div>
          </div>
          <div class="pt-6 border-t border-[#2A2A2F] mt-6">
            <p class="font-mono-tech text-[10px] text-[#A3A7AE] uppercase tracking-wider">LIMITED ARCHIVE ALLOCATION · ZERO STOCK COUNT SHOWN</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand Manifesto Section (Option B: Cyber-Noir, Strict 0px) -->
  <section class="mt-16 px-4 md:px-8 lg:px-12">
    <div class="mx-auto max-w-7xl border border-[#2A2A2F] bg-[#131316] p-8 sm:p-12 rounded-none">
      <p class="font-mono-tech text-[10px] font-bold uppercase tracking-[0.12em] text-[#C8102E]">
        [ RWND20S.SYS // BRAND MANIFESTO ]
      </p>
      <h3 class="font-display text-2xl sm:text-3xl font-extrabold uppercase text-[#F5F5F7] mt-3 tracking-tight">
        AFTER DARK, NO RULES.
      </h3>
      <p class="mt-4 font-mono-tech text-sm sm:text-base text-[#F5F5F7] max-w-3xl leading-relaxed">
        After dark, no rules. High-polish stainless steel and nocturnal audio for those who operate off the grid.
      </p>

      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4 border-t border-[#2A2A2F] pt-8">
        <div>
          <p class="font-mono-tech text-sm font-bold text-[#F5F5F7]">316L</p>
          <p class="font-mono-tech text-[11px] text-[#A3A7AE] mt-1">Stainless Steel Chains & Bracelets</p>
        </div>
        <div>
          <p class="font-mono-tech text-sm font-bold text-[#F5F5F7]">TYPE-C</p>
          <p class="font-mono-tech text-[11px] text-[#A3A7AE] mt-1">Pink Chrome Audio</p>
        </div>
        <div>
          <p class="font-mono-tech text-sm font-bold text-[#C8102E]">SAVE ₹248</p>
          <p class="font-mono-tech text-[11px] text-[#A3A7AE] mt-1">3-Piece Cyber Set</p>
        </div>
        <div>
          <p class="font-mono-tech text-sm font-bold text-[#F5F5F7]">₹999+</p>
          <p class="font-mono-tech text-[11px] text-[#A3A7AE] mt-1">Free Delivery Rule</p>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('[data-hero-stage-btn]');
    const slides = document.querySelectorAll('[data-hero-stage-slide]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const stage = tab.getAttribute('data-hero-stage-btn');

        // Update button states
        tabs.forEach((t) => {
          t.setAttribute('aria-selected', 'false');
          t.className = 'border border-[#2A2A2F] bg-[#131316] px-4 py-2.5 font-mono-tech text-xs font-medium tracking-wider text-[#A3A7AE] uppercase hover:border-[#C8CDD3] hover:text-[#F5F5F7] cursor-pointer transition-all rounded-none';
        });

        tab.setAttribute('aria-selected', 'true');
        tab.className = 'border border-[#C8102E] bg-[#C8102E] px-4 py-2.5 font-mono-tech text-xs font-bold tracking-wider text-[#F5F5F7] uppercase cursor-pointer transition-all rounded-none';

        // Update slides visibility
        slides.forEach((slide) => {
          if (slide.getAttribute('data-hero-stage-slide') === stage) {
            slide.classList.remove('hidden');
            slide.classList.add('grid');
          } else {
            slide.classList.add('hidden');
            slide.classList.remove('grid');
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Homepage Main Stage",
  "settings": [
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Main Title",
      "default": "Y2K steel for the hours after dark."
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "After dark, no rules. High-polish stainless steel and nocturnal audio for those who operate off the grid."
    }
  ],
  "presets": [
    {
      "name": "Homepage Main Stage"
    }
  ]
}
{% endschema %}
