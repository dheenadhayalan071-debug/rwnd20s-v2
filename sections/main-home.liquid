          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <a href="/products/y2k-watch" class="inline-flex h-14 items-center justify-center border border-[#C8102E] bg-[#C8102E] px-8 font-mono-tech text-xs font-bold uppercase tracking-widest text-[#F5F5F7] transition-all hover:bg-[#E0213F] rounded-none">
