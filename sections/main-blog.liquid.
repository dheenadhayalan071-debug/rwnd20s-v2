<div class="relative w-full bg-[#DCDFE5] text-[#09090B] py-12 px-4 sm:px-6 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="mb-8 font-mono-tech text-xs text-[#52525B]">
      <ol class="flex items-center gap-2 uppercase tracking-wider">
        <li><a href="/" class="hover:text-[#09090B]">BASE</a></li>
        <li>/</li>
        <li class="text-[#09090B] font-bold">ARCHIVE JOURNAL // BLOG</li>
      </ol>
    </nav>

    <!-- Blog Header -->
    <div class="border-b border-[#09090B]/20 pb-8 mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#09090B]/30 bg-white/70 px-3 py-1 font-mono-tech text-[11px] font-bold uppercase tracking-wider text-[#09090B]">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        SYSTEM LOGS & DROP DISPATCHES
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold uppercase tracking-tight mt-3 text-[#09090B]">
        {{ blog.title | default: 'ARCHIVE JOURNAL' }}
      </h1>
      <p class="mt-2 font-mono-tech text-xs sm:text-sm text-[#3F3F46] max-w-xl">
        Official release notes, engineering logs, and community transmissions from the Madurai dispatch hub.
      </p>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for article in blog.articles %}
        <article class="group rounded-3xl border border-[#09090B]/20 bg-white p-6 shadow-md flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:border-[#09090B]">
          <div>
            {% if article.image %}
              <div class="rounded-2xl bg-[#D4D8E0] overflow-hidden aspect-video mb-6 border border-[#09090B]/10">
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105">
              </div>
            {% endif %}

            <div class="flex items-center justify-between font-mono-tech text-[10px] text-[#52525B] uppercase tracking-widest mb-2">
              <span>{{ article.published_at | date: "%d %b %Y" }}</span>
              <span>{{ article.author | default: 'RWND20S' }}</span>
            </div>

            <h2 class="font-display text-lg sm:text-xl font-bold uppercase text-[#09090B] group-hover:text-emerald-700 transition-colors">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h2>

            <p class="mt-3 font-mono-tech text-xs text-[#3F3F46] line-clamp-3">
              {{ article.excerpt_or_content | strip_html | truncatewords: 25 }}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-[#09090B]/10 flex items-center justify-between">
            <a href="{{ article.url }}" class="font-mono-tech text-xs font-bold uppercase tracking-wider text-[#09090B] flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              READ TRANSMISSION →
            </a>
            <span class="font-mono-tech text-[10px] text-[#52525B]">LOG #{{ forloop.index0 | plus: 101 }}</span>
          </div>
        </article>
      {% else %}
        <div class="col-span-full flex h-64 flex-col items-center justify-center text-center rounded-3xl border border-[#09090B]/20 bg-white p-8 shadow-sm">
          <p class="font-display text-base font-bold text-[#09090B] uppercase">NO TRANSMISSIONS LOGGED YET</p>
          <p class="mt-1 text-xs text-[#3F3F46]">Check back soon for Drop 01 release notes and engineering logs.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog Main Feed",
  "settings": []
}
{% endschema %}
